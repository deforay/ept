// Participants on this platform for this sample. Falls back to no_of_responses so the layout
// still renders against data built before the count was added; they are equal except when
// platforms are pooled into a shared peer group.
if (!function_exists('vlPlatformParticipants')) {
    function vlPlatformParticipants(array $val): int
    {
        return (int) ($val['participants_on_platform'] ?? $val['no_of_responses'] ?? 0);
    }
}
if (!function_exists('vlPassPercent')) {
    function vlPassPercent(array $val): int
    {
        $n = vlPlatformParticipants($val);
        return $n > 0 ? (int) round((((int) ($val['NumberPassed'] ?? 0)) / $n) * 100) : 0;
    }
}

// The range participants were actually graded on: the manual figures when the admin set the
// sample to Manual, otherwise the calculated ones. Same switch as Application_Model_Vl::getVlRange().
if (!function_exists('vlIsoRange')) {
    function vlIsoRange(array $val): array
    {
        $manual = ($val['use_range'] ?? '') === 'manual';
        // Grading casts a blank manual median/SD to 0 (see Application_Model_Vl::evaluate()), so print it that way
        return [
            'median' => $manual ? (float) ($val['manual_median'] ?? 0) : $val['median'],
            // A manual range entered as limits has no Q1/Q3, so the entered limits are shown instead
            'low' => $manual ? ($val['manual_q1'] ?? $val['manual_low_limit'] ?? null) : $val['low_limit'],
            'high' => $manual ? ($val['manual_q3'] ?? $val['manual_high_limit'] ?? null) : $val['high_limit'],
            'sd' => $manual ? (float) ($val['manual_sd'] ?? 0) : $val['sd'],
        ];
    }
}
// Standard (mean ± SD) evaluation grades on the low/high limits, which are likewise the
// manual ones when the sample is set to Manual (see Application_Model_Vl::getVlRange()).
if (!function_exists('vlStandardRange')) {
    function vlStandardRange(array $val): array
    {
        $manual = ($val['use_range'] ?? '') === 'manual';
        return [
            'mean' => $manual ? ($val['manual_mean'] ?? null) : $val['mean'],
            'sd' => $manual ? ($val['manual_sd'] ?? null) : $val['sd'],
            'low' => $manual ? ($val['manual_low_limit'] ?? null) : $val['low_limit'],
            'high' => $manual ? ($val['manual_high_limit'] ?? null) : $val['high_limit'],
            'cv' => $manual ? ($val['manual_cv'] ?? null) : $val['cv'],
        ];
    }
}
// A platform the admin gave its own manual range was not graded on the reference values,
// so it is shown in its own table rather than pooled under them.
if (!function_exists('vlHasManualRange')) {
    function vlHasManualRange(array $vlCal): bool
    {
        foreach ($vlCal as $val) {
            if (is_array($val) && isset($val['median']) && ($val['use_range'] ?? '') === 'manual') {
                return true;
            }
        }
        return false;
    }
}

