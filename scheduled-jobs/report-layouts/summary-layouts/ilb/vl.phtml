                                        <th style="' . $th . 'width:13%;"><br/>Acceptable Lower Limit</th>
                                        <th style="' . $th . 'width:13%;"><br/>Acceptable Upper Limit</th>
                                        <th style="' . $th . 'width:10%;"><br/><br/>Robust SD' . $refMark . '</th>
                                        <th style="' . $th . 'width:22%;" colspan="2">Participants with Passing Result<br/>(z &lt; &plusmn;3.0)</th>
