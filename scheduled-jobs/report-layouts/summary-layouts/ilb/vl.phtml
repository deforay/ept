<?php

use mitoteam\jpgraph\MtJpGraph;

MtJpGraph::load(['bar', 'line', 'pie'], true);
if ($resultArray['shipment'] != "") {

    if (!file_exists($reportsPath . DIRECTORY_SEPARATOR . $resultArray['shipment']['shipment_code']) && !is_dir($reportsPath . DIRECTORY_SEPARATOR . $resultArray['shipment']['shipment_code'])) {
        mkdir($reportsPath . DIRECTORY_SEPARATOR . $resultArray['shipment']['shipment_code']);
    }

    // create new PDF document
    $reportService = new Application_Service_Reports();
    $reportFormat = $reportService->getReportConfigValue('report-format');

    $shipmentAttributes = Pt_Commons_JsonUtility::safeDecode($resultArray['shipment']['shipment_attributes']);
    $shipmentAttributes['shipment_id'] = $resultArray['shipment']['shipment_id'];
    $formVersion = $shipmentAttributes['formVersion'] ?? $shipmentAttributes['reportVersion'];
    $effectiveDate = $shipmentAttributes['effectiveDate'] ?? '';
    $issuingAuthority = $resultArray['shipment']['issuing_authority'] ?? '';

    // Build footer table row conditionally
    $footerCells = [];

    // Add form version if not empty
    if (!empty($formVersion)) {
        $footerCells[] = "<td align='left' style='text-align:left; font-size:14px;'>$formVersion</td>";
    } else {
        $footerCells[] = "<td></td>";
    }

    // Add issuing authority if not empty
    if (!empty($issuingAuthority)) {
        $footerCells[] = "<td align='center' style='text-align:center; font-size:14px;'>Issuing Authority: $issuingAuthority</td>";
    } else {
        $footerCells[] = "<td></td>";
    }

    // Add effective date if not empty
    if (!empty($effectiveDate)) {
        $footerCells[] = "<td align='right' style='text-align:right; font-size:14px;'>Effective Date: $effectiveDate</td>";
    } else {
        $footerCells[] = "<td></td>";
    }

    // Only create footer if we have at least one element
    $staticFooterHtml = '<hr style="border: 1px solid #000;">';
    if (!empty($footerCells)) {
        $staticFooterHtml .= '<table style="width:100%;" cellpadding="0" cellspacing="0" border="0">
                    <tr align="center" style="text-align:center;">
                        ' . implode('', $footerCells) . '
                    </tr>
                </table>';
    }
    $methodOfEvaluation = 'iso17043';
    if (isset($reportFormat) && !empty($reportFormat)) {
        $pdf = new Pt_Reports_FpdiReport(PDF_PAGE_ORIENTATION, PDF_UNIT, PDF_PAGE_FORMAT, true, 'UTF-8', false);
        $pdf->setParams($resultStatus, $evalRow['date_finalised'], "", $watermark, "SUMMARY", $layout, $resultArray['shipment']['scheme_name'], $resultArray['shipment']['scheme_type'], "", $staticFooterHtml);
    } else {
        $pdf = new Pt_Reports_SummaryPdf(PDF_PAGE_ORIENTATION, PDF_UNIT, PDF_PAGE_FORMAT, true, 'UTF-8', false);
        $methodOfEvaluation = isset($shipmentAttributes['methodOfEvaluation']) ? $shipmentAttributes['methodOfEvaluation'] : 'standard';

        $methodOfEvaluation = $methodOfEvaluation ?? 'iso17043';

        if ($methodOfEvaluation == 'iso17043') {
            $pdf->setSchemeName($header, $resultArray['shipment']['scheme_name'], $logo, $logoRight, $resultStatus, $resultArray['shipment']['scheme_type'], $evalRow['date_finalised'], "", $watermark, $evalRow['date_finalised'], $instituteAddressPosition, $layout);
        } else {
            $pdf->setSchemeName($header, $resultArray['shipment']['scheme_name'], $logo, $logoRight, $resultStatus, $resultArray['shipment']['scheme_type'], $evalRow['date_finalised'], "", $watermark, "", $instituteAddressPosition, $layout);
        }
    }

    // set default header data
    $pdf->SetHeaderData(PDF_HEADER_LOGO, PDF_HEADER_LOGO_WIDTH, PDF_HEADER_TITLE, PDF_HEADER_STRING);

    // set header and footer fonts
    $pdf->setHeaderFont(array('freesans', '', PDF_FONT_SIZE_MAIN));
    $pdf->setFooterFont(array('freesans', '', PDF_FONT_SIZE_DATA));

    // set default monospaced font
    $pdf->SetDefaultMonospacedFont(PDF_FONT_MONOSPACED);

    // set margins
    $mt = ($layout == 'zimbabwe') ? 55 : 45;
    if (isset($templateTopMargin) && !empty($templateTopMargin)) {
        $mt = $templateTopMargin;
    }
    $pdf->SetMargins(PDF_MARGIN_LEFT, $mt, PDF_MARGIN_RIGHT);
    $pdf->SetHeaderMargin(PDF_MARGIN_HEADER);
    $pdf->SetFooterMargin(PDF_MARGIN_FOOTER);

    // set auto page breaks
    $pdf->SetAutoPageBreak(true, PDF_MARGIN_BOTTOM);

    // set image scale factor
    $pdf->setImageScale(PDF_IMAGE_SCALE_RATIO);
    // add a page
    //$pdf->AddPage();
    // ---------------------------------------------------------

    $pdf->AddPage('P', 'A4');
    $pdf->SetFont('freesans', 'B', 11);

    if ($methodOfEvaluation == 'iso17043') {
        if ($layout != 'zimbabwe') {
            $htmlTitle = '<br><div style="font-weight:bold;text-align:center;font-size:13px;">Proficiency Testing Program for HIV-1 Viral Load using Dried Tube Specimen</div>';
            $pdf->writeHTML($htmlTitle, true, false, true, false, '');
        }
    }
    $pdf->SetFont('freesans', '', 11);
    $htmlTitle = '<br><br><span style="font-size:12px;"><strong>PT Panel Name and Results Due Date:</strong> ' . $resultArray['shipment']['distribution_code'] . ' (' . Pt_Commons_DateUtility::humanReadableDateFormat($resultArray['shipment']['response_deadline']) . ')</span>';
    $pdf->writeHTML($htmlTitle, true, false, true, false, '');
    if ($methodOfEvaluation == 'standard') {
        $referenceRes = '<table style="text-align:center;width:100%" align="left">';
        $referenceRes .= '<tr>';
        $referenceRes .= '<td style="font-weight:normal;width:20%;">PT Panel/Assay Name</td><td style="font-weight:normal;width:30%;">' . $resultArray['shipment']['distribution_code'] . '</td>';
        $referenceRes .= '</tr>';
        $referenceRes .= '<tr>';
        $referenceRes .= '<td style="font-weight:normal;width:20%;">Shipment Date</td><td style="font-weight:normal;width:30%;">' . Pt_Commons_DateUtility::humanReadableDateFormat($resultArray['shipment']['shipment_date']) . '</td>';
        $referenceRes .= '</tr>';
        $referenceRes .= '</table>';
        $pdf->writeHTML($referenceRes, true, false, true, false, '');

        if (count($resultArray['shipment']['vlCalculation']) > 0) {

            foreach ($resultArray['shipment']['vlCalculation'] as $vlCal) {

                if (isset($vlCal['participant_response_count']) && $vlCal['participant_response_count'] > 6) {
                    if (isset($vlCal['otherAssayName']) && count($vlCal['otherAssayName']) > 0) {
                        continue;
                    } else {
                        $calRes = '<h5>Summary of ' . $vlCal['vlAssay'] . ' Results | No. of Labs : ' . $vlCal['participant_response_count'] . ' </h5>';
                    }

                    $calRes .= '<table border="1" style="text-align:center;font-weight:bold;width:650px;font-size:11px;height:500px;">
                        <tr>
                            <!-- <td style="background-color:#BDD6EE;text-align:center;"><br><br>Platform </td> -->
                            <td style="background-color:#BDD6EE;text-align:center;width:16%;"><br><br>Sample ID </td>
                            <td style="background-color:#BDD6EE;text-align:center;width:100px;"><br><br>Mean<br/>(log<sub>10</sub> copies/mL)</td>
                            <td style="background-color:#BDD6EE;text-align:center;"><br><br>S.D.</td>
                            <td style="background-color:#BDD6EE;text-align:center;">Lowest Acceptable Limit</td>
                            <td style="background-color:#BDD6EE;text-align:center;">Highest Acceptable Limit</td>
                            <td style="background-color:#BDD6EE;text-align:center;"><br><br>CV</td>
                        </tr>';

                    $countCal = count($vlCal) - 1;
                    $otherList = "";

                    for ($c = 0; $c < $countCal; $c++) {
                        if (isset($vlCal[$c]['mean'])) {
                            $calRes .= '<tr>';
                            $calRes .= '<td>' . $vlCal[$c]['sample_label'] . '</td>
                                    <td style="text-align:center;">' . Pt_Commons_NumberUtility::decimal($vlCal[$c]['mean']) . '</td>
                                    <td style="text-align:center;">' . Pt_Commons_NumberUtility::decimal($vlCal[$c]['sd']) . '</td>
                                    <td style="text-align:center;">' . Pt_Commons_NumberUtility::decimal($vlCal[$c]['low_limit']) . '</td>
                                    <td style="text-align:center;">' . Pt_Commons_NumberUtility::decimal($vlCal[$c]['high_limit']) . '</td>
                                    <td style="text-align:center;">' . Pt_Commons_NumberUtility::decimal($vlCal[$c]['cv']) . '</td>
                                </tr>';
                        }
                    }

                    $calRes .= '</table>';

                    $pdf->writeHTML($calRes, true, false, true, false, '');
                }
            }
        }

        $footerHead = '<h5>0.00 = Target Not Detected or less than lower limit of detection</h5>';
        $footerHead .= '<small>Notes:<ol><li>Results from participants using Biocentric and "Other" Platforms were not used for results evaluation due to less than 6 participating labs in this PT event.</li><li>A VL platform with the most participants was used as a reference value to evaluate results for VL platforms with less than 6 participants on this PT round.</li></ol></small>';
        $pdf->writeHTML($footerHead, true, false, true, false, '');
    } elseif ($methodOfEvaluation == 'iso17043') {

        if (count($resultArray['shipment']['vlCalculation']) > 0) {

            $referenceRes = '<table style="text-align:center;width:100%" align="left">';
            $referenceRes .= '</table>';
            $pdf->writeHTML($referenceRes, true, false, true, false, '');
            $sample = [];
            $assayName = [];
            $pooledAssayNames = [];
            $assayNameList = [];
            $noOfPaResponseTxt = "";

            // Table opening shared by every platform table. $refMark flags the columns that
            // come from the reference platform (used for the "< 18 participants" table).
            $vlTableHeader = function ($platformName, $refMark = '') {
                $th = 'background-color:#B4C6E7;text-align:center;font-size:11px;font-weight:bold;';
                return '<table border="1" cellpadding="3" style="width:650px;">
                                    <tr>
                                        <th colspan="8" style="font-size:11px;font-weight:bold;">Platform/Assay Name: ' . $platformName . '</th>
                                    </tr>
                                    <tr>
                                        <th style="' . $th . 'width:15%;"><br/><br/>Sample ID</th>
                                        <th style="' . $th . 'width:13%;"><br/>Number of Participants</th>
                                        <th style="' . $th . 'width:14%;">Assigned Value<br/>(Log<sub>10</sub> copies/mL)' . $refMark . '</th>
                                        <th style="' . $th . 'width:13%;"><br/>Acceptable Lower Limit</th>
                                        <th style="' . $th . 'width:13%;"><br/>Acceptable Upper Limit</th>
                                        <th style="' . $th . 'width:10%;"><br/><br/>Robust SD' . $refMark . '</th>
                                        <th style="' . $th . 'width:22%;" colspan="2">Participants with Passing Result<br/>(z &lt; &plusmn;3.0)</th>
                                    </tr>';
            };
            $vlTableRow = function ($sampleLabel, $responses, $median, $lowLimit, $highLimit, $sd, $passed, $score) {
                $td = 'text-align:center;font-size:11px;';
                return '<tr>
                                    <td style="' . $td . 'font-weight:bold;width:15%;">' . $sampleLabel . '</td>
                                    <td style="' . $td . 'width:13%;">' . $responses . '</td>
                                    <td style="' . $td . 'width:14%;">' . Pt_Commons_NumberUtility::decimal($median) . '</td>
                                    <td style="' . $td . 'width:13%;">' . Pt_Commons_NumberUtility::decimal($lowLimit) . '</td>
                                    <td style="' . $td . 'width:13%;">' . Pt_Commons_NumberUtility::decimal($highLimit) . '</td>
                                    <td style="' . $td . 'width:10%;">' . Pt_Commons_NumberUtility::decimal($sd) . '</td>
                                    <td style="' . $td . 'width:11%;">' . $passed . '</td>
                                    <td style="' . $td . 'width:11%;">' . $score . '%</td>
                                </tr>';
            };

            foreach ($resultArray['shipment']['vlCalculation'] as $vlCal) {
                if (isset($vlCal['participant_response_count']) && $vlCal['participant_response_count'] < 18 || $vlCal['vlAssay'] == "Other") {
                    $t = 0;

                    foreach ($vlCal as $k => $val) {
                        // Only build a row for actual samples (which carry a median);
                        // skip meta keys like vlAssay/otherAssayName so they don't
                        // produce empty "0 | - | - ..." phantom rows.
                        if (isset($val['median'])) {
                            $sample[$k]['NumberPassed'] ??= 0;
                            $sample[$k]['response'] ??= 0;

                            $sample[$k]['response'] += $val['no_of_responses'];
                            $sample[$k]['median'] = $val['median'];
                            $sample[$k]['lowLimit'] = $val['low_limit'];
                            $sample[$k]['highLimit'] = $val['high_limit'];
                            $sample[$k]['sd'] = $val['sd'];
                            $sample[$k]['NumberPassed'] += !empty($val['NumberPassed']) ? $val['NumberPassed'] : 0;
                            $sample[$t]['label'] = $val['sample_label'];
                            $t++;
                        }
                    }
                    $pooledAssayNames[] = $vlCal['vlAssay'];
                    if ($vlCal['vlAssay'] == "Other") {
                        foreach ($vlCal['otherAssayName'] as $otherAssayName => $otherAssayCount) {
                            $assayNameList[] = "Other - $otherAssayName (n=$otherAssayCount)";
                        }
                    } else {
                        $assayNameList[] = $vlCal['vlAssay'] . ' (n=' . $vlCal[0]['no_of_responses'] . ')';
                    }
                } else {
                    $calRes = $vlTableHeader($vlCal['vlAssay']);
                    foreach ($vlCal as $key => $val) {
                        if (isset($val['median'])) {
                            $score = round((($val['NumberPassed'] / $val['no_of_responses']) * 100));
                            $calRes .= $vlTableRow($val['sample_label'], $val['no_of_responses'], $val['median'], $val['low_limit'], $val['high_limit'], $val['sd'], $val['NumberPassed'], $score);
                        }
                    }
                    $assayName[] = $vlCal['vlAssay'];
                    $calRes .= '</table>';

                    $pdf->writeHTML($calRes, true, false, true, false, '');
                }
            }
            if (isset($sample) && count($sample) > 0) {
                $calRes = $vlTableHeader('VL platforms with &lt; 18 participants', '*');
                foreach ($sample as $point => $label) {
                    if (!isset($label['median'])) {
                        continue;
                    }
                    $score = $label['response'] > 0 ? round(($label['NumberPassed'] / $label['response']) * 100) : 0;
                    $calRes .= $vlTableRow($label['label'], $label['response'], $label['median'], $label['lowLimit'], $label['highLimit'], $label['sd'], $label['NumberPassed'], $score);
                    $noOfPaResponseTxt = $label['response'];
                }
                $assayName[] = 'VL platforms with < 18 participants';
                $calRes .= '</table>';
                $pdf->writeHTML($calRes, true, false, true, false, '');
            }
            $note = '<span style="text-align:justify;font-size:11px;"><strong>Number of Participants for each VL platform with less than 18 participants (Total ' . $noOfPaResponseTxt . '):</strong> ' . implode('; ', $assayNameList) . '.</span>';
            $note .= '<br/><br/><span style="text-align:justify;font-size:11px;"><i>*Values from Abbott m2000 RealTime platform were used as a reference to evaluate results for VL platforms with less than 18 participants in this PT round.</i></span><hr>';
        }

        $pdf->writeHTML($note, true, false, true, false, '');

        //$pdf->AddPage();

        /* JPGraph start */

        $allParticipantChartLabels = $assayName;

        $noOfPaResponse = [];
        $participantScore = [];
        $scoreBelow = [];
        $avg = [];

        // Participants submitting / passing / failing per platform. Only the platforms shown in
        // the tables above are charted: each platform with its own table gets its own bar, and
        // the pooled platforms are summed into the "VL platforms with < 18 participants" bar.
        $db = Zend_Db_Table_Abstract::getDefaultAdapter();
        $platformCounts = $db->fetchAll($db->select()
            ->from(['sp' => 'shipment_participant_map'], [
                'submitted' => new Zend_Db_Expr('COUNT(*)'),
                'passed' => new Zend_Db_Expr('SUM(sp.final_result = 1)'),
                'failed' => new Zend_Db_Expr('SUM(sp.final_result = 2)'),
            ])
            ->join(['rvla' => 'r_vl_assay'], 'rvla.id = sp.attributes->>"$.vl_assay"', ['assay_name' => 'name'])
            ->where('sp.shipment_id = ?', $resultArray['shipment']['shipment_id'])
            ->where("sp.is_excluded not like 'yes' OR sp.is_excluded like '' OR sp.is_excluded is null")
            ->where('sp.final_result IN (1, 2)')
            ->group('rvla.id'));
        $platformCounts = array_column($platformCounts, null, 'assay_name');

        foreach ($allParticipantChartLabels as $i => $chartLabel) {
            $names = ($chartLabel == 'VL platforms with < 18 participants') ? $pooledAssayNames : [$chartLabel];
            $noOfPaResponse[$i] = $participantScore[$i] = $scoreBelow[$i] = 0;
            foreach ($names as $name) {
                $noOfPaResponse[$i] += (int) ($platformCounts[$name]['submitted'] ?? 0);
                $participantScore[$i] += (int) ($platformCounts[$name]['passed'] ?? 0);
                $scoreBelow[$i] += (int) ($platformCounts[$name]['failed'] ?? 0);
            }
            $avg[$i] = $noOfPaResponse[$i] > 0 ? round(($participantScore[$i] / $noOfPaResponse[$i]) * 100) : 0;
        }

        // Now let us create the last part of the barchart with totals
        $allParticipantChartLabels[] = 'All Participants';
        $totalBarResponses = array_sum($noOfPaResponse);
        $totalBarPassed = array_sum($participantScore);
        $totalBarFailed = array_sum($scoreBelow);
        $totalBarAvg = 0;
        if ($totalBarResponses > 0) {
            $totalBarAvg = round(($totalBarPassed / $totalBarResponses) * 100);
        }

        $noOfPaResponse[] = $totalBarResponses;
        $participantScore[] = $totalBarPassed;
        $scoreBelow[] = $totalBarFailed;
        $avg[] = $totalBarAvg;

        if (count($noOfPaResponse) > 0 && ($totalBarPassed) > 0) {
            /* JPGraph start */
            // Create the graph and specify the scale for both Y-axis
            $graph = new Graph(900, 400, 'auto');
            //$graph->graph_theme = null;
            $graph->SetScale("textlin");
            $graph->SetY2Scale("lin", 0, 100);
            $graph->SetY2OrderBack(false);

            $graph->img->SetMargin(70, 70, 90, 140);
            $graph->SetFrame(false);

            // Create the two linear plot
            $percentPlot = new LinePlot($avg);
            $graph->AddY2($percentPlot);

            $percentPlot->SetBarCenter(true);

            $percentPlot->SetWeight(0);
            $percentPlot->SetLineWeight(0);

            // $percentPlot->mark->SetType(MARK_IMG, WEB_ROOT . '/images/scatter.gif', 1.0);
            $percentPlot->mark->SetType(MARK_FILLEDCIRCLE, '', 4.0);
            $percentPlot->mark->SetWeight(10);
            $percentPlot->mark->SetWidth(14);
            $percentPlot->mark->setColor("#00B050");
            $percentPlot->mark->setFillColor("#00B050");
            $percentPlot->mark->SetSize(5);
            $percentPlot->value->SetFormat("%d%%");
            $percentPlot->value->SetMargin(14);

            $percentPlot->value->Show();
            $percentPlot->value->SetFont(FF_DEFAULT, FS_NORMAL, 10);
            $percentPlot->value->SetColor("black");
            //$percentPlot->value->SetMargin(5);

            $percentPlot->SetLegend('Percent of Participants Scoring "100%"');

            $graph->title->Set("All Participants Results Summary");
            $graph->title->SetMargin(10);
            $graph->title->SetFont(FF_DEFAULT, FS_BOLD, 15);

            $graph->yaxis->title->Set('Number of Participants', 'center');
            $graph->yaxis->title->SetMargin(20);
            $graph->yaxis->title->SetFont(FF_DEFAULT, FS_BOLD, 12);
            //$graph->yscale->SetAutoMax(250);
            $graph->yscale->SetAutoMin(0);

            $graph->yaxis->HideLine(false);
            $graph->yaxis->HideTicks(false, false);

            $graph->y2axis->title->SetFont(FF_DEFAULT, FS_BOLD, 12);
            $graph->y2axis->title->Set('Percent of Participants Scoring "100%"');
            $graph->y2axis->title->SetMargin(30);
            $graph->y2axis->SetLabelFormat('%d%%');

            $graph->y2axis->HideLine(false);
            $graph->y2axis->HideTicks(false, false);

            $graph->y2scale->SetAutoMax(100);
            $graph->y2scale->SetAutoMin(0);

            // Add the plot to the graph

            $graph->ygrid->SetFill(false);
            // Wrap long platform names onto several lines so the labels stay horizontal without overlapping
            $wrapAt = count($allParticipantChartLabels) > 4 ? 12 : 22;
            $graph->xaxis->SetTickLabels(array_map(fn($label) => wordwrap($label, $wrapAt, "\n", true), $allParticipantChartLabels));
            $graph->xaxis->SetTextLabelInterval(1);
            $graph->xaxis->HideLine(false);
            $graph->xaxis->HideTicks(false, false);

            // $graph->xaxis->SetTextLabelInterval(sizeof($allParticipantChartLabels) + 2);
            $graph->xaxis->SetLabelAlign('center');
            $graph->xaxis->SetFont(FF_DEFAULT, FS_BOLD, 11);
            // $graph->xaxis->scale->ticks->SetTextLabelStart(0.2);
            //$graph->xaxis->scale->ticks->SupressFirst();
            if (sizeof($allParticipantChartLabels) > 4) {
                $graph->xaxis->SetFont(FF_DEFAULT, FS_NORMAL, 9);
            }

            // Create the bar plots
            $b1plot = new BarPlot($noOfPaResponse);
            $b2plot = new BarPlot($participantScore);
            $b3plot = new BarPlot($scoreBelow);

            // Create the grouped bar plot
            $gbplot = new GroupBarPlot(array($b1plot, $b2plot, $b3plot));
            $b1plot->SetAlign('center');
            $b1plot->SetLegend("Number of Participants Submitting Results");

            $b1plot->SetAlign('center');
            $b2plot->SetLegend('Number of Participants Scoring "100%"');

            $b1plot->SetAlign('center');
            $b3plot->SetLegend('Number of Participants Scoring Below "100%"');

            $gbplot->SetWidth(0.5);



            $graph->Add($gbplot);

            $b1plot->SetAbsWidth(33);
            $b2plot->SetAbsWidth(33);
            $b3plot->SetAbsWidth(33);

            $b1plot->SetColor("#4472C4");
            $b2plot->SetColor("#92D050");
            $b3plot->SetColor("#FFC000");

            $b1plot->SetFillColor("#4472C4");
            $b2plot->SetFillColor("#92D050");
            $b3plot->SetFillColor("#FFC000");

            $graph->legend->SetFrameWeight(0);
            $graph->legend->SetColumns(2);
            $graph->legend->SetVColMargin(12);
            $graph->legend->SetFont(FF_DEFAULT, FS_NORMAL, 10);
            $graph->legend->SetPos(0.5, 0.97, 'center', 'bottom');

            $image_file = $reportsPath . DIRECTORY_SEPARATOR . $resultArray['shipment']['shipment_code'] . DIRECTORY_SEPARATOR . 'all-participants-chart.png';
            $graph->Stroke($image_file);

            //$pdf->Image($image_file, 5, $pdf->getY(), '', '', '', '', '', false, 300);

            if (file_exists($image_file)) {
                $graphImage = new \SplFileObject($image_file, 'r');
                $graphImageContents = base64_encode($graphImage->fread($graphImage->getSize()));
                $graphImageExtension = $graphImage->getExtension();

                $src = 'data:image/' . $graphImageExtension . ';base64,' . $graphImageContents;
                $img = '<img src="@' . preg_replace('#^data:image/[^;]+;base64,#', '', $src) . '">';
                $pdf->writeHTML($img, true, false, true, false, '');

                unlink($image_file);
            }
        }

        //$pdf->AddPage();
        /* JPGraph end */

        $note = '<h4>Information with respect to compliance with standards ISO 13528:2022(E) </h4>';

        $note .= '<h5>Preparation of Proficiency Test items:</h5>';
        $note .= '<span style="text-align:justify;font-size:11px;font-weight:normal;">The proficiency test items were prepared by the trained staff of CDC-ILB using inactivated, cultured HIV-1, following institutional SOPs. The PT samples were issued with instructions to report on detection using routine methods. The PT samples were tested for homogeneity prior to shipment and met program requirements.</span>';

        $note .= '<h5>Procedures used to establish the assigned value:</h5>';
        $note .= '<span style="text-align:justify;font-size:11px;font-weight:normal;">The results of participating laboratories using the same VL platform were grouped together and analyzed for peer-comparison using the normalized InterQuartile Range (nIQR) method. The nIQR method uses the median as the assigned value because it is a robust estimator of central tendency that is less influenced by outliers. This approach ensures that the assigned value remains representative of the central distribution of participant results, even when a proportion of results may be extreme or atypical. Assigned value, Robust Standard Deviation, Standard Uncertainty of assigned value, z score and performance score were derived as per the Standard ISO13528: 2022(E). A VL platform with the most participants was used as a reference value to evaluate results for VL platforms with less than eighteen participants in this PT round.</span>';

        $pdf->writeHTML($note, true, false, true, false, '');

        // Criteria and interval are indented with the formulas set apart in bold, as in the summary template
        $note = '<table cellpadding="2" style="width:100%;"><tr><td style="width:7%;"></td><td style="width:93%;font-size:12px;">';
        $note .= '<br/><strong>Acceptable Performance Criteria</strong><br/>';
        $note .= '<span style="text-align:justify;">Acceptable performance is defined as achieving a z-score with an absolute value less than 3.0 (|z| &lt; 3.0), where the z-score is calculated as:</span><br/>';
        $note .= '<strong>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;z = (Participant Result &ndash; Assigned Value) / Robust SD</strong><br/>';
        $note .= '<strong>Acceptable Result Interval</strong><br/>';
        $note .= 'For each sample, an Acceptable Result Interval is calculated and reported as:<br/>';
        $note .= '<strong>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Assigned Value &plusmn; (3 &times; Robust SD)</strong><br/>';
        $note .= 'Results falling within this interval are considered acceptable performance (|z| &lt; 3.0).';
        $note .= '</td></tr></table>';
        $pdf->writeHTML($note, true, false, true, false, '');

        $note = '<span style="text-align:justify;font-size:12px;color:#0A2F41;"><strong>(Robust Standard Deviation (SD)</strong> in the nIQR method is a dispersion estimate calculated as 0.7413 &times; (Q3 &minus; Q1), where Q1 and Q3 are the 25th and 75th percentiles of participant results. It provides a resistant estimate of variability that is less influenced by outliers than the classical standard deviation.)</span><br/>';

        /* $note .= '<h5>Subcontracting:</h5>';
