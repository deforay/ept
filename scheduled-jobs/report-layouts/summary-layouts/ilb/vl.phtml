                        // skip meta keys like vlAssay/otherAssayName so they don't
                        // produce empty "0 | - | - ..." phantom rows.
                        if (isset($val['median'])) {
                            $sample[$k]['NumberPassed'] ??= 0;
                            $sample[$k]['response'] ??= 0;

                            $range = vlIsoRange($val);
                            $sample[$k]['response'] += vlPlatformParticipants($val);
                            $sample[$k]['median'] = $range['median'];
                            $sample[$k]['lowLimit'] = $range['low'];
                            $sample[$k]['highLimit'] = $range['high'];
                            $sample[$k]['sd'] = $range['sd'];
