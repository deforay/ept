<?php

// Participants on this platform for this sample. Falls back to no_of_responses so the layout
// still renders against data built before the count was added; they are equal except when
// platforms are pooled into a shared peer group.
if (!function_exists('vlPlatformParticipants')) {
    function vlPlatformParticipants(array $val): int
    {
        return (int) ($val['participants_on_platform'] ?? $val['no_of_responses'] ?? 0);
    }
}
if (!function_exists('vlPassPercent')) {
    function vlPassPercent(array $val): int
    {
        $n = vlPlatformParticipants($val);
        return $n > 0 ? (int) round((((int) ($val['NumberPassed'] ?? 0)) / $n) * 100) : 0;
    }
}
// The range participants were actually graded on: the manual figures when the admin set the
// sample to Manual, otherwise the calculated ones. Same switch as Application_Model_Vl::getVlRange().
if (!function_exists('vlIsoRange')) {
    function vlIsoRange(array $val): array
    {
        $manual = ($val['use_range'] ?? '') === 'manual';
        // Grading casts a blank manual median/SD to 0 (see Application_Model_Vl::evaluate()), so print it that way
        return [
            'median' => $manual ? (float) ($val['manual_median'] ?? 0) : $val['median'],
            'low' => $manual ? ($val['manual_q1'] ?? null) : $val['low_limit'],
            'high' => $manual ? ($val['manual_q3'] ?? null) : $val['high_limit'],
            'sd' => $manual ? (float) ($val['manual_sd'] ?? 0) : $val['sd'],
        ];
    }
}

if ($resultArray['shipment'] != "") {

