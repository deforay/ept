            $groupedAssayIds = array_merge(...Application_Model_Vl::getVlAssayGroups($resultArray['shipment']['shipment_attributes'] ?? null) ?: [[]]);
            $referenceAssay = null;
            $referenceCount = 0;

            foreach ($resultArray['shipment']['vlCalculation'] as $assayId => $vlCal) {
                // A platform the admin gave its own manual range was not graded on the reference
                // values, so it is shown in its own table rather than pooled under them.
                $hasManualRange = false;
                foreach ($vlCal as $val) {
                    if (isset($val['median']) && ($val['use_range'] ?? '') === 'manual') {
                        $hasManualRange = true;
                    }
                }

                if (!$hasManualRange && (isset($vlCal['participant_response_count']) && $vlCal['participant_response_count'] < 18 || $vlCal['vlAssay'] == "Other")) {
