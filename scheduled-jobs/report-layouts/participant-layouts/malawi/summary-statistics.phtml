<?php
//----------------Summary Statistics for this survey  start----------------

// Initialize flags up front to avoid undefined-variable issues driving the chart positioning logic
$performance1 = false;
$performance2 = false;
$performance3 = false;

// Charts are written to temp PNGs and unlinked right after. Report generation runs many
// worker subprocesses over the same shipment in parallel, so a filename keyed only on
// shipment_code collides across workers (JpGraph 25111 on unlink; TCPDF "Unable to get
// the size of the image" when another worker deletes mid-render). Make the path unique
// per participant + worker so the temp files never overlap.
$chartUid = preg_replace('/[^A-Za-z0-9_-]/', '', (string)($result['unique_identifier'] ?? '')) . '_' . getmypid();

if (isset($result['statistics']) && !empty($result['statistics'])) {
    // Passing score is per-scheme (custom tests carry their own; built-ins read
    // SchemeConfig). Use the shared resolver so this label matches the score
    // buckets computed in Evaluation::getIndividualReportsDataForPDF().
    $score = Application_Service_Evaluation::getPassingScore($result);

    $ppOverview = '<br><table border="1" cellpadding="4" cellspacing="0" style="width:100%;font-size:12px;">';

    $ppOverview .= '<tr style="font-size:12px;font-weight:bold;text-align:center;">';
    $ppOverview .= '<td colspan="5" style="text-align:center;background-color:#dbe4ee;">STATISTICS FOR THIS SURVEY</td>';
    $ppOverview .= '</tr>';

    $ppOverview .= '<tr style="background-color:#dbe4ee;">';
    $ppOverview .= '<td width="20%" style="background-color:#dbe4ee;text-align:center;">Number of Participants that responded</td>';
    $ppOverview .= '<td width="20%" style="background-color:#dbe4ee;text-align:center;">Participants who scored 100%</td>';
    $ppOverview .= '<td width="20%" style="background-color:#dbe4ee;text-align:center;">Participants who scored &gt;= ' . $score . '%</td>';
    $ppOverview .= '<td width="20%" style="background-color:#dbe4ee;text-align:center;">Participants who scored &lt; ' . $score . '%</td>';
    $ppOverview .= '<td width="20%" style="background-color:#dbe4ee;text-align:center;">Providers that did not Respond</td>';
    $ppOverview .= '</tr>';

    $ppOverview .= '<tr>';
    $ppOverview .= '<td width="20%" style="text-align:center;font-weight:normal;">' . $result['statistics']['number_responded'] . '</td>';
    $ppOverview .= '<td width="20%" style="text-align:center;font-weight:normal;">' . $result['statistics']['providersWith100'] . '</td>';
    $ppOverview .= '<td width="20%" style="text-align:center;font-weight:normal;">' . $result['statistics']['providers>80'] . '</td>';
    $ppOverview .= '<td width="20%" style="text-align:center;font-weight:normal;">' . $result['statistics']['providers<80'] . '</td>';
    $ppOverview .= '<td width="20%" style="text-align:center;font-weight:normal;">' . $result['statistics']['number_not_responded'] . '</td>';
    $ppOverview .= '</tr>';

    $ppOverview .= '</table><br>';

    $pdf->writeHTML($ppOverview, true, false, true, false, '');
}

if (!$correctiveActions) {
    $pdf->AddPage();
}

$pdf->writeHTML('<span style="text-align:center;font-weight:bold;font-size:12px;">Qualitative Evaluation</span>', true, false, true, false, '');

// All three charts are drawn at the same Graph canvas size (680x200), so lock every
// rendered image to the same width and derive its height from that fixed aspect ratio.
// This keeps our height math and the actual TCPDF-rendered size in sync.
$chartWidthMM  = 200;
$chartHeightMM = ($chartWidthMM / 680) * 200;
$chartSpacing  = 5;

// Build the PT Scheme Manager Comments HTML now (before the page-break decision) so its
// height can be measured and included in the same up-front check as the charts. This is
// what keeps charts + comments together on one page instead of the comments spilling
// onto whichever page the charts happened to end on.
$eodReportText = "End of report";
if ($evalRow['report_type'] == 'finalized') {
    $eodReportText = "End of final report";
}

$commentsHtml = '<span style="font-size:11px;font-weight:bold;">PT Scheme Manager Comments:</span><br>';
$commentsHtml .= '<span style="font-size:11px;text">More information can be obtained from PT Participant manual: NPHQAP-PTS-MAN-003 or contact PT Scheme manager.<br>
This is the confidential report that summarizes your performance. The National Public Health Quality Assurance Program recommends that the results of this proficiency testing scheme comparison not be used as a sole criterion for judging the performance of any individual testing facility/Laboratory.</span><br>';
// if (trim($result['shipment_comment'] ?? '') != "") {
//     $commentsHtml .= '<span style="font-size:11px;"><b>Scheme Manager\'s Comments:</b> ' . $result['shipment_comment'] . '</span><br>';
// }
// $commentsHtml .= '<p style="font-size:11px;font-weight:bold;text-align:center;"><i>NPH PT all rights reserved.</i></p>';
// $commentsHtml .= '<p style="font-size:11px;font-weight:bold;">Report Print Date: ' . $commonService->humanReadableDateFormat(date('d-m-Y')) . '</p>';
$commentsHtml .= '<p style="font-size:11px;text-align:center;font-weight:bold;"><u>' . $eodReportText . '</u>.</p>';

// Measure the comments block's real rendered height without committing it to the PDF yet.
$pdf->startTransaction();
$measureStartY = $pdf->getY();
$pdf->writeHTML($commentsHtml, true, false, true, false, '');
$measureEndY = $pdf->getY();
$pdf = $pdf->rollbackTransaction();
$commentsHeight = $measureEndY - $measureStartY;

// Work out how much vertical space ALL requested charts plus the comments block will
// need together, so we can decide up front whether to break to a new page. Doing this
// once here — rather than per-chart or after the charts — is what keeps performance1/2/3
// AND the comments text printed together on a single page.
$neededHeight = 0;
if (isset($result['performance1']) && !empty($result['performance1'])) {
    $neededHeight += $chartHeightMM + $chartSpacing;
}
if (isset($result['performance2']) && !empty($result['performance2'])) {
    $neededHeight += $chartHeightMM + $chartSpacing;
}
if (isset($result['performance3']) && !empty($result['performance3'])) {
    $neededHeight += $chartHeightMM + $chartSpacing;
}
$neededHeight += $commentsHeight;

if ($neededHeight > 0 && ($pdf->getY() + $neededHeight) > ($pdf->getPageHeight() - $pdf->getBreakMargin())) {
    $pdf->AddPage();
}

if (isset($result['performance1']) && !empty($result['performance1'])) {
    $performance1 = true;
    $dataX = [];
    $dataY = [];
    foreach ($result['performance1'] as $key => $val) {
        $dataX[] = ($val['scored'] > 0) ? $val['scored'] : 0;
        $dataY[] = $val['distribution_code'];
    }

    $graph = new Graph(680, 200, 'auto');
    $graph->SetScale("textlin");

    $graph->SetBox(false);
    $graph->SetMargin(80, 30, 10, 50);

    $graph->ygrid->SetFill(false);
    $graph->xaxis->SetTickLabels($dataY);
    $graph->xaxis->SetPos(0.5);

    $graph->yaxis->HideLine(false);
    $graph->yaxis->HideTicks(false, false);
    $graph->yaxis->scale->SetAutoMin(0);
    $graph->yaxis->scale->SetAutoMax(100);

    $b1plot = new BarPlot($dataX);
    $gbplot = new GroupBarPlot(array($b1plot));
    $graph->Add($gbplot);

    $b1plot->value->Show();
    $b1plot->value->SetColor("black", "darkred");
    $b1plot->value->SetFormat("%3d%%");

    $b1plot->SetFillColor('#4F81BD');
    $b1plot->SetColor("white");

    $graph->title->Set("Your Performance for the last 5 surveys");
    $graph->subtitle->Set('.');
    $graph->xaxis->title->Set('PT Surveys');
    $graph->yaxis->title->Set('Percentage of Performance');
    $graph->yaxis->SetPos('min');
    $graph->title->SetFont(FF_DEFAULT, FS_BOLD, 10);
    $graph->xaxis->title->SetFont(FF_FONT0, FS_NORMAL, 12);
    $graph->yaxis->title->SetFont(FF_FONT0, FS_NORMAL, 12);
    $graph->yaxis->SetTitleMargin(40);
    $graph->xaxis->SetTitleMargin(15);
    $graph->xaxis->SetTickSide(SIDE_DOWN);
    $graph->yaxis->SetTickSide(SIDE_LEFT);

    $image_file = $reportsPath . DIRECTORY_SEPARATOR . $result['shipment_code'] . DIRECTORY_SEPARATOR . 'bar_chart_' . $chartUid . '.png';
    $graph->img->SetImgFormat('png');
    $graph->img->SetQuality(100);
    $graph->Stroke($image_file);

    $currentY = $pdf->getY();
    $pdf->Image($image_file, 5, $currentY, $chartWidthMM, '', '', '', '', false, 300);
    $pdf->SetY($currentY + $chartHeightMM + $chartSpacing);

    if (file_exists($image_file)) {
        unlink($image_file);
    }
}

if (isset($result['performance2']) && !empty($result['performance2'])) {
    $performance2 = true;
    $data1y = $data2y = $label = [];
    foreach ($result['performance2'] as $row) {
        $data1y[] = ($row['passed'] > 0) ? $row['passed'] : null;
        $data2y[] = ($row['failed'] > 0) ? $row['failed'] : null;
        $label[] = $row['distribution_code'];
    }

    $graph = new Graph(680, 200, 'auto');
    $graph->SetScale("textlin");

    $graph->SetBox(false);
    $graph->SetMargin(80, 30, 10, 50);
    $graph->ygrid->SetFill(false);
    $graph->xaxis->SetTickLabels($label);
    $graph->title->SetFont(FF_DEFAULT, FS_BOLD, 10);
    $graph->xaxis->title->SetFont(FF_FONT0, FS_NORMAL, 12);
    $graph->yaxis->title->SetFont(FF_FONT0, FS_NORMAL, 12);
    $graph->xaxis->HideLine(false);
    $graph->yaxis->HideLine(false);
    $graph->xaxis->HideTicks(false, false);
    $graph->yaxis->HideTicks(false, false);

    $b1plot = new BarPlot($data1y);
    $b2plot = new BarPlot($data2y);
    $gbplot = new GroupBarPlot(array($b1plot, $b2plot));
    $graph->Add($gbplot);

    $b1plot->value->Show();
    $b1plot->value->SetColor("black", "darkred");
    $b2plot->value->Show();
    $b2plot->value->SetColor("darkred", "black");
    $b1plot->value->SetFormat("%d");
    $b2plot->value->SetFormat("%d");

    $b1plot->SetFillColor('#4F81BD');
    $b1plot->SetColor("white");

    $b2plot->SetFillColor("red");
    $b2plot->SetColor("white");

    $b1plot->SetLegend('Passed');
    $b2plot->SetLegend('Failed');
    $graph->legend->SetShadow('gray@0.4', 5);
    $graph->legend->SetPos(0.5, 0.95, 'center', 'bottom');
    $graph->title->Set("Participants performance for the last 5 surveys");
    $graph->subtitle->Set('.');
    $graph->yaxis->title->Set('Number of Participants');
    $graph->xaxis->title->Set('PT Surveys');
    $graph->yaxis->SetTitleMargin(40);
    $graph->xaxis->SetTitleMargin(15);
    $graph->xaxis->SetTickSide(SIDE_DOWN);
    $graph->yaxis->SetTickSide(SIDE_LEFT);

    $performance_of_surveys = $reportsPath . DIRECTORY_SEPARATOR . $result['shipment_code'] . DIRECTORY_SEPARATOR . 'performance_of_surveys_' . $chartUid . '.png';
    $graph->img->SetImgFormat('png');
    $graph->img->SetQuality(100);
    $graph->Stroke($performance_of_surveys);

    $currentY = $pdf->getY();
    $pdf->Image($performance_of_surveys, 5, $currentY, $chartWidthMM, '', '', '', 'C', false, 300);
    $pdf->SetY($currentY + $chartHeightMM + $chartSpacing);

    if (file_exists($performance_of_surveys)) {
        unlink($performance_of_surveys);
    }
}

if (isset($result['performance3']) && !empty($result['performance3'])) {
    $performance3 = true;
    $surveyNo = "";
    $data1y = $data2y = $label = [];
    foreach ($result['performance3'] as $row) {
        $data1y[] = ($row['passed'] > 0) ? $row['passed'] : 0;
        $data2y[] = ($row['failed'] > 0) ? $row['failed'] : 0;
        $label[] = $row['sample_label'];
        $surveyNo = $row['distribution_code'];
    }

    $graph = new Graph(680, 200, 'auto');
    $graph->SetScale("textlin");

    $graph->SetBox(false);
    $graph->SetMargin(80, 30, 10, 50);
    $graph->ygrid->SetFill(false);
    $graph->xaxis->SetTickLabels($label);
    $graph->title->SetFont(FF_DEFAULT, FS_BOLD, 10);
    $graph->xaxis->title->SetFont(FF_FONT0, FS_NORMAL, 12);
    $graph->yaxis->title->SetFont(FF_FONT0, FS_NORMAL, 12);
    $graph->xaxis->HideLine(false);
    $graph->yaxis->HideLine(false);
    $graph->xaxis->HideTicks(false, false);
    $graph->yaxis->HideTicks(false, false);
    $b1plot = new BarPlot($data1y);
    $b2plot = new BarPlot($data2y);
    $gbplot = new GroupBarPlot(array($b1plot, $b2plot));
    $graph->Add($gbplot);

    $b1plot->value->Show();
    $b1plot->value->SetColor("black", "darkred");
    $b2plot->value->Show();
    $b2plot->value->SetColor("darkred", "black");
    $b1plot->value->SetFormat("%d");
    $b2plot->value->SetFormat("%d");

    $b1plot->SetFillColor('#4F81BD');
    $b1plot->SetColor("white");

    $b2plot->SetFillColor("red");
    $b2plot->SetColor("white");

    $graph->legend->SetShadow('gray@0.4', 5);
    $graph->legend->SetPos(0.5, 0.2, 'center', 'bottom');
    $graph->title->Set("Participants performance for the current survey panels");
    $graph->subtitle->Set('Survey No: ' . $surveyNo);
    $graph->subsubtitle->Set('.');
    $graph->yaxis->title->Set('Number of Participants');
    $graph->xaxis->title->Set('Samples');
    $graph->yaxis->SetTitleMargin(40);
    $graph->xaxis->SetTitleMargin(15);
    $graph->xaxis->SetTickSide(SIDE_DOWN);
    $graph->yaxis->SetTickSide(SIDE_LEFT);

    $performance_of_current_survey_anels = $reportsPath . DIRECTORY_SEPARATOR . $result['shipment_code'] . DIRECTORY_SEPARATOR . 'performance_of_current_survey_anels_' . $chartUid . '.png';
    $graph->img->SetImgFormat('png');
    $graph->img->SetQuality(100);
    $graph->Stroke($performance_of_current_survey_anels);

    $currentY = $pdf->getY();
    // Page-break decision for charts + comments already happened above, so just draw here.
    $pdf->Image($performance_of_current_survey_anels, 5, $currentY, $chartWidthMM, '', '', '', '', false, 300);
    $pdf->SetY($currentY + $chartHeightMM + $chartSpacing);

    if (file_exists($performance_of_current_survey_anels)) {
        unlink($performance_of_current_survey_anels);
    }
}

// PT Scheme Manager Comments — written directly after the charts, no separate page-break
// check needed here since $commentsHeight was already folded into the up-front decision.
$pdf->writeHTML($commentsHtml, true, false, true, false, '');

//----------------Summary Statistics for this survey  Ends----------------