<style>
    /* Job Tracking: list of background jobs (evaluation, reports, emails, ...).
       The card, header and filter band come from .data-list in admin.css. */
    .job-live {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #4a5568;
    }

    .job-live .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #38a169;
        box-shadow: 0 0 0 3px rgba(56, 161, 105, .18);
    }

    .job-live.is-paused .dot {
        background: #a0aec0;
        box-shadow: none;
    }

    .job-live .label {
        color: #2d3748;
        font-weight: 600;
    }

    .job-live .updated {
        color: #a0aec0;
    }

    /* DataTables shades the sorted column. Match the row stripes instead:
       transparent would show DataTables' lavender row colour underneath. */
    #jobsTable tbody tr:nth-child(odd) > td.sorting_1,
    #jobsTable tbody tr:nth-child(odd) > td.sorting_2 {
        background-color: #f9f9f9;
    }

    #jobsTable tbody tr:nth-child(even) > td.sorting_1,
    #jobsTable tbody tr:nth-child(even) > td.sorting_2 {
        background-color: #fff;
    }

    .job-status-filter {
        display: inline-flex;
        border: 1px solid #cbd5e0;
        border-radius: 6px;
        overflow: hidden;
        background: #fff;
        height: 34px;
    }

    .job-status-filter button {
        border: 0;
        background: transparent;
        padding: 0 12px;
        font-size: 13px;
        color: #4a5568;
        cursor: pointer;
    }

    .job-status-filter button + button {
        border-left: 1px solid #e2e8f0;
    }

    .job-status-filter button.is-active {
        background: #3a5a8a;
        color: #fff;
    }

    #jobsTable td {
        vertical-align: middle;
    }

    #jobsTable tr.job-row-failed > td:first-child {
        box-shadow: inset 3px 0 0 #e53e3e;
    }

    #jobsTable tr.job-row-running > td:first-child {
        box-shadow: inset 3px 0 0 #3182ce;
    }

    .job-type {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 500;
        color: #2d3748;
        white-space: nowrap;
    }

    .job-type .tile {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #edf2f7;
        color: #4a5568;
        font-size: 12px;
    }

    .job-type .tile.evaluation { background: #ebf4ff; color: #2b6cb0; }
    .job-type .tile.reports { background: #f0fff4; color: #2f855a; }
    .job-type .tile.email { background: #e6fffa; color: #2c7a7b; }
    .job-type .tile.certificate { background: #faf5ff; color: #6b46c1; }
    .job-type .tile.security { background: #fffaf0; color: #c05621; }

    .job-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 2px 9px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .job-pill.is-queued { background: #fefcbf; color: #975a16; }
    .job-pill.is-running { background: #ebf8ff; color: #2b6cb0; }
    .job-pill.is-done { background: #f0fff4; color: #276749; }
    .job-pill.is-failed { background: #fff5f5; color: #c53030; }
    .job-pill.is-cancelled { background: #edf2f7; color: #4a5568; }

    .job-reason {
        display: block;
        max-width: 260px;
        margin-top: 4px;
        font-size: 12px;
        color: #c53030;
        white-space: normal;
        word-break: break-word;
    }

    .job-time {
        white-space: nowrap;
        line-height: 1.3;
    }

    .job-time small {
        display: block;
        color: #a0aec0;
    }

    .job-progress {
        min-width: 130px;
    }

    .job-progress .bar {
        height: 6px;
        border-radius: 3px;
        background: #edf2f7;
        overflow: hidden;
    }

    .job-progress .bar span {
        display: block;
        height: 100%;
        background: #3182ce;
    }

    .job-progress .bar span.is-done {
        background: #38a169;
    }

    .job-progress small {
        display: block;
        margin-top: 3px;
        color: #718096;
    }

    .job-muted {
        color: #a0aec0;
    }
</style>

