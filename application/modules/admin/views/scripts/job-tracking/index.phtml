<script type="text/javascript" src="<?php echo $this->assetUrl('js/daterangepicker.js'); ?>"></script>
<script type="text/javascript" charset="utf-8">
    var oTable = null;
    var autoRefreshInterval = null;
    var currentRows = [];
    var lastUpdated = null;
    var paused = false;
    var startDate = "";
    var endDate = "";

    $(document).ready(function () {
        initDateRangePicker();
        initJobsTable();
        startAutoRefresh();

        $('#jobStatusFilter').on('click', 'button', function () {
            $('#jobStatusFilter button').removeClass('is-active');
            $(this).addClass('is-active');
            $('#filterStatus').val($(this).data('status'));
            applyFilters();
        });

        // No point polling a tab nobody is looking at.
        document.addEventListener('visibilitychange', function () {
            if (paused) return;
            if (document.hidden) {
                stopAutoRefresh();
            } else {
                refreshJobs();
                startAutoRefresh();
            }
        });

        setInterval(showUpdatedAgo, 1000);
    });

    function initDateRangePicker() {
        // Default: last 6 months to today
        var defaultStart = moment().subtract(6, 'months');
        var defaultEnd = moment();

        startDate = defaultStart.format('DD-MMM-YYYY');
        endDate = defaultEnd.format('DD-MMM-YYYY');
        $('#dateRange').val(startDate + ' to ' + endDate);

        $('#dateRange').daterangepicker({
            locale: {
                cancelLabel: 'Clear',
                format: 'DD-MMM-YYYY',
                separator: ' to ',
            },
            autoApply: true,
            showDropdowns: true,
            alwaysShowCalendars: true,
            autoUpdateInput: true,
            startDate: defaultStart,
            endDate: defaultEnd,
            ranges: eptDateRanges()
        }, function (start, end) {
            startDate = start.format('DD-MMM-YYYY');
            endDate = end.format('DD-MMM-YYYY');
            $('#dateRange').val(startDate + ' to ' + endDate);
            applyFilters();
        });

        $('#dateRange').on('cancel.daterangepicker', function () {
            startDate = "";
            endDate = "";
            $(this).val('');
            applyFilters();
        });
    }

    function initJobsTable() {
        oTable = $('#jobsTable').dataTable({

            "bJQueryUI": false,
            "bAutoWidth": false,
            "bInfo": true,
            "bScrollCollapse": true,
            "sPaginationType": "bootstrap",
            "bRetrieve": true,
            "aoColumns": [
                null,
                null,
                null,
                { "bSortable": false },
                null,
                null,
                null,
                { "bSortable": false },
                { "sClass": "center", "bSortable": false }
            ],
            "fnRowCallback": function (nRow, aData, iDisplayIndex) {
                var row = currentRows[iDisplayIndex] || {};
                $(nRow).toggleClass('job-row-failed', row.status === 'failed')
                    .toggleClass('job-row-running', RUNNING_STATUSES.indexOf(row.status) !== -1);
                return nRow;
            },
            "aaSorting": [[5, "desc"]],
            "bProcessing": true,
            "bServerSide": true,
            "sAjaxSource": "<?php echo $this->url(array('module' => 'admin', 'controller' => 'job-tracking', 'action' => 'get-all-jobs')); ?>",
            "fnServerParams": function (aoData) {
                aoData.push({ "name": "jobType", "value": $('#filterJobType').val() });
                aoData.push({ "name": "status", "value": $('#filterStatus').val() });
                aoData.push({ "name": "dateFrom", "value": startDate });
                aoData.push({ "name": "dateTo", "value": endDate });
            },
            "fnServerData": function (sSource, aoData, fnCallback) {
                $.ajax({
                    "dataType": 'json',
                    "type": "POST",
                    "url": sSource,
                    "data": aoData,
                    "success": function (json) {
                        // Transform data for display
                        if (json.aaData) {
                            currentRows = json.aaData;
                            markUpdated();
                            json.aaData = json.aaData.map(function (row) {
                                return [
                                    formatJobType(row),
                                    formatReference(row),
                                    formatStatusBadge(row),
                                    formatProgress(row),
                                    escapeHtml(row.requested_by_name) || '<?= $this->jsTranslate('System') ?>',
                                    formatStartedAt(row),
                                    formatEndedAt(row),
                                    formatDuration(row),
                                    formatActions(row)
                                ];
                            });
                        }
                        fnCallback(json);
                    }
                });
            }
        });
    }

    function formatJobType(row) {
        var jobType = row.job_type;
        var kinds = {
            'Report Generation': ['reports', 'icon-file-text'],
            'Evaluation': ['evaluation', 'icon-check'],
            'Certificate Generation': ['certificate', 'icon-certificate'],
            'Email Reports': ['email', 'icon-envelope'],
            'Send Emails': ['email', 'icon-envelope'],
            'TB Forms Generation': ['reports', 'icon-file-text'],
            'Bulk Password Reset': ['security', 'icon-key'],
            'Scheduled Job': ['', 'icon-cog']
        };
        var kind = kinds[jobType] || ['', 'icon-cog'];

        // Hover shows the job details: the report type or the queued command.
        var tooltipContent = '';
        if (row.queue_type === 'report_generation') {
            tooltipContent = '<?= $this->jsTranslate('Report Generation') ?>\n';
            tooltipContent += '<?= $this->jsTranslate('Shipment: ') ?>' + (row.shipment_code || '<?= $this->jsTranslate('N/A') ?>') + '\n';
            tooltipContent += '<?= $this->jsTranslate('Type: ') ?>' + (row.report_type || '<?= $this->jsTranslate('All') ?>');
        } else if (row.job) {
            tooltipContent = row.job;
        }

        return '<span class="job-type" title="' + escapeHtml(tooltipContent) + '">' +
            '<span class="tile ' + kind[0] + '"><i class="' + kind[1] + '"></i></span>' + escapeHtml(jobType) + '</span>';
    }

    function escapeHtml(text) {
        if (text === null || text === undefined || text === '') return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function formatReference(row) {
        if (row.shipment_code) {
            if (row.queue_type === 'report_generation') {
                return '<a href="/reports/distribution/shipment/sid/' + btoa(row.shipment_id) + '">' +
                    escapeHtml(row.shipment_code) + '</a>';
            }
            return escapeHtml(row.shipment_code);
        }
        return '<span class="job-muted">–</span>';
    }

    function formatStatusBadge(row) {
        var status = (typeof row === 'object' && row !== null) ? row.status : row;
        var statusConfig = {
            'pending': { cls: 'is-queued', icon: 'icon-time', label: '<?= $this->jsTranslate('Queued') ?>' },
            'generating': { cls: 'is-running', icon: 'icon-spinner icon-spin', label: '<?= $this->jsTranslate('Generating') ?>' },
            'finalizing': { cls: 'is-running', icon: 'icon-spinner icon-spin', label: '<?= $this->jsTranslate('Finalizing') ?>' },
            'processing': { cls: 'is-running', icon: 'icon-spinner icon-spin', label: '<?= $this->jsTranslate('Running') ?>' },
            'evaluated': { cls: 'is-done', icon: 'icon-ok', label: '<?= $this->jsTranslate('Completed') ?>' },
            'finalized': { cls: 'is-done', icon: 'icon-ok', label: '<?= $this->jsTranslate('Finalized') ?>' },
            'completed': { cls: 'is-done', icon: 'icon-ok', label: '<?= $this->jsTranslate('Completed') ?>' },
            'reports generated': { cls: 'is-done', icon: 'icon-ok', label: '<?= $this->jsTranslate('Reports Generated') ?>' },
            'failed': { cls: 'is-failed', icon: 'icon-warning-sign', label: '<?= $this->jsTranslate('Failed') ?>' },
            'cancelled': { cls: 'is-cancelled', icon: 'icon-ban-circle', label: '<?= $this->jsTranslate('Cancelled') ?>' }
        };
        var config = statusConfig[status] || { cls: 'is-cancelled', icon: 'icon-question-sign', label: status };
        var html = '<span class="job-pill ' + config.cls + '"><i class="' + config.icon + '"></i> ' + escapeHtml(config.label) + '</span>';

        // Show why a run failed right in the row, not only on hover.
        var reason = (typeof row === 'object' && row !== null) ? row.error_message : '';
        if (status === 'failed' && reason) {
            var shortReason = reason.length > 140 ? reason.substring(0, 140) + '…' : reason;
            html += '<span class="job-reason" title="' + escapeHtml(reason) + '">' + escapeHtml(shortReason) + '</span>';
        }
        return html;
    }

    function formatActions(row) {
        // Email queue jobs cannot be cancelled via this interface
        if (row.queue_type === 'email_queue') {
            return '<span class="job-muted">–</span>';
        }

        // Only show cancel button for cancellable statuses
        var cancellableStatuses = ['pending', 'generating', 'finalizing', 'processing'];
        if (cancellableStatuses.indexOf(row.status) === -1) {
            return '<span class="job-muted">–</span>';
        }

        return '<button class="btn btn-danger btn-xs btn-cancel-job" ' +
            'onclick="cancelJob(' + row.job_id + ', \'' + row.queue_type + '\')" ' +
            'title="<?= $this->jsTranslate("Cancel this job") ?>">' +
            '<i class="icon-remove"></i> <?= $this->jsTranslate("Cancel") ?></button>';
    }

    function cancelJob(jobId, queueType) {
        if (!confirm('<?= $this->jsTranslate('Are you sure you want to cancel this job?') ?>')) {
            return;
        }

        $.ajax({
            url: '<?php echo $this->url(array('module' => 'admin', 'controller' => 'job-tracking', 'action' => 'cancel-job')); ?>',
            type: 'POST',
            data: {
                jobId: jobId,
                queueType: queueType
            },
            dataType: 'json',
            success: function (response) {
                if (response.success) {
                    alert('<?= $this->jsTranslate('Job cancelled successfully') ?>');
                    refreshJobs();
                } else {
                    alert('<?= $this->jsTranslate('Failed to cancel job: ') ?>' + response.message);
                }
            },
            error: function () {
                alert('<?= $this->jsTranslate('Error cancelling job. Please try again.') ?>');
            }
        });
    }

    function formatProgress(row) {
        if (row.progress === null || row.progress === undefined) {
            return '<span class="job-muted">–</span>';
        }
        var percent = Math.max(0, Math.min(100, Math.round(row.progress)));
        var html = '<div class="job-progress"><div class="bar"><span class="' + (percent >= 100 ? 'is-done' : '') +
            '" style="width: ' + percent + '%;"></span></div><small>' + percent + '%';

        if (row.progress_completed !== null && row.progress_total !== null) {
            var unit = row.job_type === 'Send Emails' ? '<?= $this->jsTranslate('emails') ?>' : '<?= $this->jsTranslate('reports') ?>';
            html += ' · ' + row.progress_completed + '/' + row.progress_total + ' ' + unit;
        }
        html += '</small>';

        if (row.summary_status) {
            if (row.job_type === 'Send Emails' && row.summary_status.indexOf('failed') !== -1) {
                html += '<small style="color:#c53030;"><i class="icon-warning-sign"></i> ' + escapeHtml(row.summary_status) + '</small>';
            } else if (row.summary_status === 'completed') {
                html += '<small style="color:#2f855a;"><i class="icon-ok"></i> <?= $this->jsTranslate("Summary done") ?></small>';
            } else {
                html += '<small><i class="icon-time"></i> <?= $this->jsTranslate("Summary pending") ?></small>';
            }
        }
        return html + '</div>';
    }

    // Terminal states — the run is over, so an end time is expected.
    var TERMINAL_STATUSES = ['reports generated', 'finalized', 'evaluated', 'completed', 'failed', 'cancelled'];
    var RUNNING_STATUSES = ['pending', 'generating', 'finalizing', 'processing'];

    // Server DATETIMEs carry no zone. eptParseDbDate (date-range-presets.phtml)
    // reads them in the database's zone, so times are right in any browser.
    function parseDbDate(dateStr) {
        return window.eptParseDbDate(dateStr);
    }

    // Start of the run: durable processing_started_at, falling back to the request time
    // for historical rows recorded before that column was kept.
    function resolveStart(row) {
        return row.started_at || row.requested_on || null;
    }

    // End of the run: durable completed_at, falling back to last_updated_on for historical
    // terminal rows. Null while the job is still running.
    function resolveEnd(row) {
        if (row.completed_at) return row.completed_at;
        if (TERMINAL_STATUSES.indexOf(row.status) !== -1) return row.last_updated_on || null;
        return null;
    }

    // A queued job has not started: show when it was queued, not a start time.
    function formatStartedAt(row) {
        if (row.status === 'pending' && !row.started_at) {
            var queued = parseDbDate(row.requested_on);
            return queued
                ? '<span class="job-time job-muted"><?= $this->jsTranslate('Queued') ?><small>' + relativeTime(queued) + '</small></span>'
                : '<span class="job-muted">–</span>';
        }
        return formatDateTime(resolveStart(row));
    }

    function formatEndedAt(row) {
        var end = resolveEnd(row);
        if (end) return formatDateTime(end);
        if (row.status === 'pending') return '<span class="job-muted">–</span>';
        if (RUNNING_STATUSES.indexOf(row.status) !== -1) {
            return '<span class="job-pill is-running"><i class="icon-spinner icon-spin"></i> <?= $this->jsTranslate('running'); ?></span>';
        }
        return '<span class="job-muted">–</span>';
    }

    function humanizeDuration(secs) {
        if (secs < 60) return secs + 's';
        var m = Math.floor(secs / 60), s = secs % 60;
        if (m < 60) return s ? (m + 'm ' + s + 's') : (m + 'm');
        var h = Math.floor(m / 60); m = m % 60;
        if (h < 24) return m ? (h + 'h ' + m + 'm') : (h + 'h');
        var d = Math.floor(h / 24); h = h % 24;
        return h ? (d + 'd ' + h + 'h') : (d + 'd');
    }

    // How long the run took. end - start is timezone-safe (both are server-time strings
    // parsed the same way), so this is reliable even if the browser clock differs.
    function formatDuration(row) {
        if (row.status === 'pending' && !row.started_at) return '<span class="job-muted">–</span>';
        var startDate = parseDbDate(resolveStart(row));
        if (!startDate) return '<span class="job-muted">–</span>';

        var endStr = resolveEnd(row);
        var endDate = parseDbDate(endStr);
        var secs = Math.max(0, Math.floor(((endDate ? endDate.getTime() : Date.now()) - startDate.getTime()) / 1000));
        var human = humanizeDuration(secs);

        if (endDate) {
            return '<span title="' + escapeHtml('<?= $this->jsTranslate('Ended: ') ?>' + endStr) + '">' + human + '</span>';
        }
        if (RUNNING_STATUSES.indexOf(row.status) !== -1) {
            return '<span class="text-muted">' + human + ' &hellip;</span>';
        }
        return '<span class="job-muted">–</span>';
    }

    function formatDateTime(dateStr) {
        var date = parseDbDate(dateStr);
        if (!date) return '<span class="job-muted">–</span>';
        var m = moment(date);
        var absolute = m.format(m.year() === moment().year() ? 'D MMM, HH:mm' : 'D MMM YYYY, HH:mm');
        return '<span class="job-time" title="' + escapeHtml(m.format('D MMM YYYY, HH:mm:ss')) + '">' +
            absolute + '<small>' + relativeTime(date) + '</small></span>';
    }

    function relativeTime(date) {
        var diff = Math.max(0, Math.floor((Date.now() - date.getTime()) / 1000));
        if (diff < 60) return diff + '<?= $this->jsTranslate('s ago') ?>';
        if (diff < 3600) return Math.floor(diff / 60) + '<?= $this->jsTranslate('m ago') ?>';
        if (diff < 86400) return Math.floor(diff / 3600) + '<?= $this->jsTranslate('h ago') ?>';
        return Math.floor(diff / 86400) + '<?= $this->jsTranslate('d ago') ?>';
    }

    function markUpdated() {
        lastUpdated = new Date();
        showUpdatedAgo();
    }

    function showUpdatedAgo() {
        if (!lastUpdated) return;
        $('#jobUpdated').text('<?= $this->jsTranslate('Updated') ?> ' + relativeTime(lastUpdated));
    }

    function refreshJobs() {
        if (oTable) {
            oTable.fnDraw(false); // false = don't reset pagination
        }
    }

    function applyFilters() {
        if (oTable) {
            oTable.fnDraw();
        }
    }

    function resetFilters() {
        $('#filterJobType').val('');
        $('#filterStatus').val('');
        $('#jobStatusFilter button').removeClass('is-active').filter('[data-status=""]').addClass('is-active');
        // Reset date range to default (last 6 months)
        var defaultStart = moment().subtract(6, 'months');
        var defaultEnd = moment();
        startDate = defaultStart.format('DD-MMM-YYYY');
        endDate = defaultEnd.format('DD-MMM-YYYY');
        $('#dateRange').val(startDate + ' to ' + endDate);
        $('#dateRange').data('daterangepicker').setStartDate(defaultStart);
        $('#dateRange').data('daterangepicker').setEndDate(defaultEnd);
        applyFilters();
    }

    function startAutoRefresh() {
        stopAutoRefresh();
        autoRefreshInterval = setInterval(function () {
            refreshJobs();
        }, 5000); // Refresh every 5 seconds
    }

    function toggleAutoRefresh() {
        paused = !paused;
        if (paused) {
            stopAutoRefresh();
        } else {
            refreshJobs();
            startAutoRefresh();
        }
        $('#jobLive').toggleClass('is-paused', paused)
            .find('.label').text(paused ? '<?= $this->jsTranslate('Paused') ?>' : '<?= $this->jsTranslate('Live') ?>');
        $('#jobPauseBtn').html(paused
            ? '<i class="icon-play"></i> <span><?= $this->jsTranslate('Resume updates') ?></span>'
            : '<i class="icon-pause"></i> <span><?= $this->jsTranslate('Pause updates') ?></span>');
    }

    function stopAutoRefresh() {
        if (autoRefreshInterval) {
            clearInterval(autoRefreshInterval);
            autoRefreshInterval = null;
        }
    }

    // Clean up on page leave
    $(window).on('beforeunload', function () {
        stopAutoRefresh();
    });
</script>