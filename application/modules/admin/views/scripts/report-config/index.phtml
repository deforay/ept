<script type="text/javascript">
	duplicateName = true;

	// Sections, nav, scrollspy and search work as on Global Config.
	$(function () {
		$('.collapsible').on('click', function () {
			$(this).toggleClass('active');
			var content = $(this).next('.collapse-content');
			if (content.is(':visible')) {
				content.slideUp();
			} else {
				content.slideDown();
			}
		});

		$('#expandAll').on('click', function () {
			$('.collapse-content').slideDown();
			$('.collapsible').addClass('active');
		});

		$('#collapseAll').on('click', function () {
			$('.collapse-content').slideUp();
			$('.collapsible').removeClass('active');
		});

		// Sidebar nav: open the target section (it may be collapsed) and scroll to it.
		var navLinks = $('#configNavList a');
		navLinks.on('click', function (e) {
			e.preventDefault();
			var sectionId = $(this).data('section');
			var $section = $('#' + sectionId);
			if (!$section.length) {
				return;
			}
			$section.slideDown();
			$('.collapsible[data-target="#' + sectionId + '"]').addClass('active');
			// -76 keeps the section heading clear of the fixed navbar.
			$('html, body').animate({ scrollTop: $section.closest('.config-section').offset().top - 76 }, 400);
		});

		// Scrollspy: light up whichever section owns the top of the viewport.
		function syncActiveNavLink() {
			var probe = $(window).scrollTop() + 100;
			var currentId = null;
			navLinks.each(function () {
				var $wrap = $('#' + $(this).data('section')).closest('.config-section');
				if ($wrap.length && $wrap.offset().top <= probe) {
					currentId = $(this).data('section');
				}
			});
			// Above the first section: fall back to it so something is always lit.
			if (!currentId && navLinks.length) {
				currentId = navLinks.first().data('section');
			}
			navLinks.removeClass('current')
				.filter('[data-section="' + currentId + '"]').addClass('current');
		}

		// rAF-throttled: scroll fires far more often than we need to repaint.
		var spyQueued = false;
		$(window).on('scroll resize', function () {
			if (spyQueued) {
				return;
			}
			spyQueued = true;
			window.requestAnimationFrame(function () {
				syncActiveNavLink();
				spyQueued = false;
			});
		});
		syncActiveNavLink();

		$('#searchSettings').on('keyup', function () {
			var searchTerm = $(this).val().toLowerCase();
			if (searchTerm === '') {
				// Back to the default state: every section open.
				$('.collapse-content').slideDown();
				$('.collapsible').addClass('active');
				$('.search-highlight').removeClass('search-highlight');
				return;
			}
			$('.collapse-content').each(function () {
				var section = $(this);
				var hasMatch = false;
				section.find('label, input, textarea, select').each(function () {
					var text = $(this).text().toLowerCase() || ($(this).attr('placeholder') || '').toLowerCase();
					if (text.includes(searchTerm)) {
						hasMatch = true;
						$(this).addClass('search-highlight');
					} else {
						$(this).removeClass('search-highlight');
					}
				});
				if (hasMatch) {
					section.slideDown();
					section.prev('.collapsible').addClass('active');
				} else {
					section.slideUp();
					section.prev('.collapsible').removeClass('active');
				}
			});
		});
	});

	// Drives the YES/NO toggles: mirrors the selection into the hidden input the
	// form posts. Same helper the global-config page defines.
	function toggleRadios(obj) {
		var sel = $(obj).data('title');
		var tog = $(obj).data('toggle');
		$('#' + tog).prop('value', sel);

		$('a[data-toggle="' + tog + '"]').not('[data-title="' + sel + '"]').removeClass('active').addClass('notActive');
		$('a[data-toggle="' + tog + '"][data-title="' + sel + '"]').removeClass('notActive').addClass('active');
	}

	function validateNow() {
		flag = deforayValidator.init({
			formId: 'addReportConfig'
		});
		if (flag) {
			if (duplicateName) {
				$.blockUI();
				document.getElementById('addReportConfig').submit();
			}
		}
	}

	function removeReport() {
		$('.newReport').removeClass('hide');
		$('.oldReport').addClass('hide');
	}

	function deleteReport() {
		if (confirm("<?= $this->jsTranslate('Are you sure you want to remove the template? This action cannot be undone!'); ?>")) {
			$('#deleteTemplate').val('yes');
		}
	}
</script>
