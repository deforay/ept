<style>
	/* ── Single container card (no nested cards / wells), matching the
	   manage-test-results page. margin-bottom clears the floating save bar. ─── */
	.report-config-container {
		background: #fff;
		border-radius: 8px;
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
		padding: 0;
		margin-bottom: 90px;
	}

	/* Legend/Header styling */
	.report-config-container legend {
		background: linear-gradient(135deg, #4a6fa5 0%, #3a5a8a 100%);
		color: #fff;
		font-weight: 500;
		font-size: 16px;
		padding: 14px 20px;
		margin: 0;
		border: none;
		border-radius: 8px 8px 0 0;
	}

	.report-config-container legend i {
		margin-right: 8px;
	}

	.report-config-container legend .muted {
		color: rgba(255, 255, 255, 0.85);
		font-size: 13px;
	}

	.report-config-container legend .mandatory {
		color: #ffcdd2;
	}

	/* Form content area */
	.form-content {
		padding: 20px;
	}

	/* ── Sticky section nav, identical to global-config so the settings pages
	   share one way of getting around. Bootstrap 3 rows are float-based, so
	   .col-md-3 would only be as tall as the nav itself and position:sticky would
	   have no range to travel in; flex stretches the columns to the row height. */
	@media (min-width: 992px) {
		.config-layout {
			display: flex;
		}
	}

	.config-nav {
		position: sticky;
		top: 20px;
		background: #fff;
		border: 1px solid #e2e8f0;
		border-radius: 6px;
		overflow: hidden;
	}

	.config-nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.config-nav li a {
		display: block;
		padding: 10px 14px;
		font-size: 13px;
		color: #4a5568;
		text-decoration: none;
		border-left: 3px solid transparent;
		border-bottom: 1px solid #eef1f5;
		transition: background 0.15s ease;
	}

	.config-nav li:last-child a {
		border-bottom: none;
	}

	.config-nav li a:hover {
		background: #f7f9fc;
		color: #3a5a8a;
	}

	/* Set by the scrollspy as each section passes the top of the viewport. */
	.config-nav li a.current {
		background: #eef3f9;
		border-left-color: #4a6fa5;
		color: #3a5a8a;
		font-weight: 600;
	}

	/* Narrow: nav stops sticking and sits above the form. */
	@media (max-width: 991px) {
		.config-nav {
			position: static;
			margin-bottom: 20px;
		}
	}

	/* ── Sections: one card, but each block clearly bounded by a tinted header
	   band and a hairline frame — defined without stacking nested cards. ────── */
	.config-section {
		border: 1px solid #e2e8f0;
		border-radius: 6px;
		margin-bottom: 18px;
		overflow: hidden;
	}

	.config-section:last-of-type {
		margin-bottom: 0;
	}

	.config-section h5 {
		color: #3a5a8a;
		font-weight: 600;
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin: 0;
		padding: 10px 16px;
		background: #f4f7fb;
		border-bottom: 1px solid #e2e8f0;
	}

	.config-section h5 i {
		margin-right: 8px;
		color: #4a6fa5;
	}

	.config-section .section-body {
		padding: 16px;
	}

	/* Explains how a section relates to the others (e.g. template vs letterhead). */
	.config-section .section-note {
		font-size: 12px;
		color: #6b7280;
		margin: 0 0 14px 0;
		padding-left: 10px;
		border-left: 3px solid #cbd5e0;
	}

	/* Row spacing */
	.config-section .row {
		margin-bottom: 20px;
	}

	.config-section .row:last-child {
		margin-bottom: 0;
	}

	/* Label styling */
	.config-section label,
	.form-content label {
		font-size: 11px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: #6b7280;
		margin-bottom: 4px;
		display: block;
	}

	.config-section .form-control {
		font-size: 13px;
		padding: 4px 8px;
	}

	.config-section select.form-control,
	.config-section input[type="text"].form-control {
		height: 34px;
	}

	/* Inside an input group, Bootstrap's .input-group-sm sizes the control and its
	   addon together. The rule above is more specific and would hit only the input,
	   leaving the addon behind — hand sizing back to Bootstrap here. */
	.config-section .input-group-sm>input[type="text"].form-control {
		height: 33px;
	}

	/* Form control styling */
	.config-section .form-control:focus {
		border-color: #4a6fa5;
		box-shadow: 0 0 0 3px rgba(74, 111, 165, 0.1);
	}

	/* Block, so helper text sits under its field rather than wrapping around an
	   inline-block control like the YES/NO toggle. */
	.config-section small.text-muted {
		display: block;
		font-size: 12px;
	}

	/* File upload styling */
	.file-upload-section {
		background: #fff;
		border: 2px dashed #cbd5e0;
		border-radius: 8px;
		padding: 20px;
		text-align: center;
		transition: all 0.2s ease;
	}

	.file-upload-section:hover {
		border-color: #4a6fa5;
		background: #f0f7ff;
	}

	.file-upload-section .thumbnail {
		border: 1px solid #e2e8f0;
		border-radius: 6px;
		padding: 10px;
		background: #fff;
		margin: 0 auto 15px auto;
	}

	.file-upload-section .btn-file {
		background: #4a6fa5;
		color: #fff;
		border: none;
		border-radius: 4px;
		padding: 8px 16px;
		transition: all 0.2s ease;
	}

	.file-upload-section .btn-file:hover {
		background: #5a7fb5;
	}

	/* This page loads editor.css (Bootstrap 2) for the WYSIWYG, which clobbers the
	   admin theme's flat buttons with Bootstrap-2 gradients + text shadows — every
	   other admin page is flat. A background-image paints over background-color, so
	   it must be cleared explicitly. Restores the theme's own values (admin.css). */
	.btn {
		background-image: none;
		text-shadow: none;
		box-shadow: none;
	}

	.btn-primary {
		background-color: #2c3e50;
		border-color: #2c3e50;
	}

	.btn-primary:hover,
	.btn-primary:focus,
	.btn-primary:active {
		background-color: #1e2a36;
		border-color: #161f29;
	}

	.btn-danger {
		background-color: #e74c3c;
		border-color: #e74c3c;
	}

	.btn-danger:hover,
	.btn-danger:focus,
	.btn-danger:active {
		background-color: #df2e1b;
		border-color: #cd2a19;
	}

	/* The unselected side must read as OFF: grey, not blue — blue means "active"
	   everywhere else in this UI, so a blue outline made both sides look live. */
	.radioBtn .notActive {
		color: #aab3c0;
		background-color: #eef1f5;
		border-color: #dfe4ea;
		font-weight: 400;
	}

	/* Hover lifts it back toward "live" so it still reads as clickable. */
	.radioBtn .notActive:hover {
		color: #4a6fa5;
		background-color: #e4ebf4;
		border-color: #c3d0e0;
	}

	.radioBtn .active {
		color: #fff;
		background-color: #4a6fa5;
		border-color: #3a5a8a;
		font-weight: 700;
	}

	.radioBtn {
		margin-bottom: 6px;
	}

	/* Template preview styling */
	.template-preview {
		background: #fff;
		border: 1px solid #e2e8f0;
		border-radius: 6px;
		padding: 15px;
		margin-bottom: 15px;
	}

	.template-preview embed {
		border-radius: 4px;
		border: 1px solid #e2e8f0;
	}

	/* Button styling */
	.btn-actions {
		display: flex;
		gap: 10px;
		margin-top: 10px;
	}

	/* Floating action buttons */
	.floating-buttons {
		position: fixed;
		bottom: 20px;
		right: 30px;
		z-index: 1000;
		display: flex;
		gap: 10px;
		background: #fff;
		padding: 15px 20px;
		border-radius: 8px;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
		border: 1px solid #e2e8f0;
	}

	.floating-buttons .btn {
		padding: 10px 25px;
		font-size: 14px;
	}

	/* Small/muted text */
	.text-muted {
		color: #6b7280;
		font-size: 12px;
		margin-top: 5px;
	}

	/* Alert info boxes */
	.alert-info-custom {
		background-color: #e8f4fd;
		border: 1px solid #bee3f8;
		color: #2c5282;
		border-radius: 6px;
		padding: 12px 15px;
		margin-bottom: 20px;
	}

	.alert-info-custom i {
		margin-right: 8px;
	}

	/* Horizontal rule */
	hr {
		border: none;
		border-top: 1px solid #e2e8f0;
		margin: 25px 0;
	}
</style>

