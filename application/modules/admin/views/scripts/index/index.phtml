									<?php if ($card['neverRespondedCount'] > 0): ?>
										<a class="foot-value"
											href="<?php echo $drilldownUrl($card['shipmentId'], 'neverresponded'); ?>"><?php echo (int) $card['neverRespondedCount']; ?></a>
									<?php else: ?>
										<span class="foot-value foot-zero">0</span>
									<?php endif; ?>
									<?= $this->translate->_("across the last"); ?>
									<?php echo (int) $card['neverRespondedWindow']; ?>
									<?= $this->translate->_("rounds"); ?>
								<?php endif; ?>
							</span>
							<span class="foot-item">
								<?= $this->translate->_("Opened their report"); ?>
								<span
									class="foot-value <?php echo $card['reportOpenedCount'] > 0 ? '' : 'foot-zero'; ?>"><?php echo (int) $card['reportOpenedCount']; ?></span>
								<?= $this->translate->_("of"); ?>
								<?php echo (int) $card['tookPart']; ?>
							</span>
						</div>
					</div>
				<?php endforeach; ?>
			<?php else: ?>
				<div class="text-center" style="color:#999;padding:30px;">
					<?= $this->translate->_("No finalized rounds yet."); ?>
				</div>
			<?php endif; ?>
		</div>
	</div>
<?php endif; ?>

<div class="row">
	<div class="col-lg-12">
		<div class="panel panel-default" id="ept-overview-panel">
			<div class="panel-heading" style="cursor:pointer;" id="ept-overview-toggle" role="button"
				aria-expanded="false" aria-controls="ept-overview-body">
				<h3 class="panel-title">
					<i class="icon-bar-chart"></i>&nbsp;&nbsp;<?= $this->translate->_("ePT Overview"); ?>
					<i class="icon-chevron-down pull-right" id="ept-overview-chevron"></i>
				</h3>
			</div>
			<div class="panel-body" id="ept-overview-body" style="display:none;">
				<div id="ept-overview-content" class="text-center" style="padding:20px;color:#888;">
					<i class="icon-spinner icon-spin"></i>&nbsp;<?= $this->translate->_("Loading..."); ?>
				</div>
			</div>
		</div>
	</div>
</div>
<br />

<script>
	$(document).ready(function () {
		var loaded = false;
		$('#ept-overview-toggle').on('click', function () {
			var $body = $('#ept-overview-body');
			var $chev = $('#ept-overview-chevron');
			var isOpen = $body.is(':visible');
			if (isOpen) {
				$body.slideUp(200);
				$chev.removeClass('icon-chevron-up').addClass('icon-chevron-down');
				$(this).attr('aria-expanded', 'false');
				return;
			}
			$body.slideDown(200);
			$chev.removeClass('icon-chevron-down').addClass('icon-chevron-up');
			$(this).attr('aria-expanded', 'true');
			if (!loaded) {
				$.get("<?php echo $this->url(['module' => 'admin', 'controller' => 'index', 'action' => 'ept-overview'], 'default', true); ?>", {
					format: "html"
				}, function (data) {
					$('#ept-overview-content').html(data);
					loaded = true;
				}).fail(function () {
					$('#ept-overview-content').text('<?= $this->jsTranslate("Failed to load overview."); ?>');
				});
			}
		});
	});
</script>