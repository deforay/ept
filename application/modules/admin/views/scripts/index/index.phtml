	<!-- Task 4: between-rounds card -->
	<div class="row">
		<div class="col-lg-12">
			<?php if (!empty($this->betweenRounds)): ?>
				<?php
				// Proportional widths without percentage maths: flex-grow is the
				// count and flex-basis is 0 (set in the stylesheet), so segments
				// divide the bar in their own ratio. Zero-count segments are
				// omitted rather than rendered at min-width, which would read as
				// a real value.
				$barSegment = function ($count, $color) {
					if ((int) $count <= 0) {
						return '';
					}
					return '<span style="flex-grow:' . (int) $count . ';background:' . $color . ';"></span>';
				};
				$drilldownUrl = function ($shipmentId, $status) {
					return $this->url([
						'module' => 'admin',
						'controller' => 'shipment',
						'action' => 'round-participants',
						'id' => $shipmentId,
						'status' => $status,
					], 'default', true);
				};
				?>
				<div class="between-rounds-header">
					<?= $this->translate->_("No rounds open for response"); ?> ·
					<?= $this->translate->_("last finalized"); ?>
					<?php echo $this->escape($this->betweenRounds[0]['finalizedDate']); ?>
				</div>
				<?php foreach ($this->betweenRounds as $card): ?>
					<?php
					// Participation is measured against everyone enrolled in the
					// scheme, so a round that shipped to fewer labs than are
					// enrolled shows the shortfall as unfilled bar.
					$participationTotal = max((int) $card['enrolledCount'], (int) $card['inShipment']);
					$notShipped = $participationTotal - (int) $card['inShipment'];
					// Anything the evaluation never stamped a verdict on rides
					// with "not evaluated" — it is the same thing from the
					// admin's point of view, and leaving it out stopped the
					// results line reconciling with the shipment total.
					$pending = (int) $card['notEvaluated'] + (int) $card['unrecorded'];
					?>
					<div class="round-card">
						<div class="round-card-head">
							<div class="round-card-id">
								<span class="scheme"><?php echo $this->escape($card['schemeName']); ?></span>
								<span class="round">
									<?php echo $this->escape($card['roundCode']); ?> ·
									<?= $this->translate->_("finalized"); ?>
									<?php echo $this->escape($card['finalizedDate']); ?>
								</span>
							</div>
							<div class="round-card-score">
								<span class="score-value"><?php echo $this->escape($card['averageScore']); ?></span>
								<?php if ($card['scoreDelta'] !== null): ?>
									<span
										class="score-delta <?php echo $card['scoreDelta'] > 0 ? 'trend-up' : ($card['scoreDelta'] < 0 ? 'trend-down' : ''); ?>">
										<?php echo $card['scoreDelta'] > 0 ? '&uarr;' : ($card['scoreDelta'] < 0 ? '&darr;' : ''); ?>
										<?php echo abs($card['scoreDelta']); ?>
										<?= $this->translate->_("vs"); ?>
										<?php echo $this->escape($card['previousRoundCode']); ?>
									</span>
								<?php endif; ?>
								<span class="score-caption"><?= $this->translate->_("Average score"); ?></span>
							</div>
						</div>

						<div class="round-meter">
							<div class="meter-head">
								<span class="meter-title"><?= $this->translate->_("Participation"); ?></span>
								<span class="meter-headline">
									<?php echo (int) $card['tookPart']; ?>
									<?= $this->translate->_("of"); ?>
									<?php echo (int) $participationTotal; ?>
									<?= $this->translate->_("enrolled labs took part"); ?>
								</span>
							</div>
							<div class="meter-bar">
								<?php
								echo $barSegment($card['tookPart'], '#2b6cb0');
								echo $barSegment($card['unableToTest'], '#d68910');
								echo $barSegment($card['noResponse'], '#9aa4ae');
								echo $barSegment($notShipped, '#edf0f2');
