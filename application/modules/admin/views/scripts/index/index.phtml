									<span class="swatch" style="background:#2b6cb0;"></span>
									<span class="key-count"><?php echo (int) $card['tookPart']; ?></span>
									<?= $this->translate->_("took part"); ?>
								</span>
								<span class="key-item <?php echo $card['unableToTest'] > 0 ? '' : 'key-zero'; ?>">
									<span class="swatch" style="background:#d68910;"></span>
									<?php if ($card['unableToTest'] > 0): ?>
										<a class="key-count"
											href="<?php echo $drilldownUrl($card['shipmentId'], 'unabletotest'); ?>"><?php echo (int) $card['unableToTest']; ?></a>
