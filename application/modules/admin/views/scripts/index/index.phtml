				// slice still draws a border seam, which reads as real data.
				if ((int) $bucket['count'] <= 0) {
					return null;
				}
				return [
					'name' => $bucket['label'],
					'y' => (int) $bucket['count'],
					'color' => $engagementColours[$bucket['key']],
