			Highcharts.chart('engagementChart', {
				chart: { type: 'pie', height: 210, backgroundColor: 'transparent', style: { fontFamily: 'inherit' } },
				title: {
					// Highcharts has no first-class centre label, so the title is
					// floated into the hole.
					text: '<span class="donut-total"><?php echo $engagementTotal; ?></span>' +
						'<span class="donut-caption"><?= $this->jsTranslate("active labs"); ?></span>',
					align: 'center',
					verticalAlign: 'middle',
					y: 6,
					useHTML: true,
					floating: true
				},
				credits: { enabled: false },
				legend: { enabled: false },
				exporting: { enabled: false },
				tooltip: { pointFormat: '<b>{point.y}</b> (<b>{point.percentage:.0f}%</b>)' },
				plotOptions: {
					pie: {
						innerSize: '68%',
						borderWidth: 2,
						borderColor: '#fff',
						dataLabels: { enabled: false },
						states: { hover: { halo: { size: 6 } } }
					}
				},
				series: [{ name: '<?= $this->jsTranslate("Labs"); ?>', data: engagement }]
			});

			var schemeNames = <?php echo json_encode(array_column($schemeRows, 'schemeName'), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP); ?>;

			Highcharts.chart('schemeChart', {
				chart: {
					type: 'bar',
					// Grows a row at a time rather than stretching two schemes
					// over the height of eight.
					height: Math.max(150, 62 + 42 * schemeNames.length),
					// Reserves room for the last axis tick, which otherwise
					// truncates to "7..." once the counts run into thousands.
					marginRight: 24,
					backgroundColor: 'transparent',
					style: { fontFamily: 'inherit' }
				},
				title: { text: null },
				credits: { enabled: false },
				exporting: { enabled: false },
				xAxis: {
					categories: schemeNames,
					lineColor: '#e3e3e3',
					tickLength: 0,
					labels: { style: { color: '#555', fontSize: '12px' } }
				},
				yAxis: {
					min: 0,
					max: 100,
					title: { text: null },
					gridLineColor: '#f0f0f0',
					// Without this the first series stacks on the right, which
					// puts "actively participating" away from the axis.
					reversedStacks: false,
					labels: { format: '{value}%', style: { color: '#999', fontSize: '11px' } }
				},
				legend: {
					align: 'left',
					x: 4,
					verticalAlign: 'top',
					margin: 14,
					itemStyle: { color: '#6b7680', fontWeight: '400', fontSize: '12px' },
					symbolRadius: 2
				},
				tooltip: { shared: true },
				plotOptions: {
					series: {
						// Share, not count. On a linear count axis a scheme with
						// 17 labs sitting next to one with 12,000 drew as a 1px
						// mark — four of Zimbabwe's seven schemes were invisible.
						// Every bar is now full width and the segment labels
						// carry the actual numbers.
						stacking: 'percent',
						borderWidth: 0,
						pointPadding: 0.1,
						groupPadding: 0.12,
						dataLabels: {
							enabled: true,
							// Zero segments would otherwise print a "0" floating
							// on the segment next to them.
							filter: { property: 'y', operator: '>', value: 0 },
							style: { color: '#fff', fontWeight: '600', fontSize: '11px', textOutline: 'none' }
						}
					}
				},
				series: [
					{
						name: '<?= $this->jsTranslate("Actively participating"); ?>',
						color: '#2e9e5b',
						data: <?php echo json_encode(array_map('intval', array_column($schemeRows, 'participating'))); ?>
					},
					{
						name: '<?= $this->jsTranslate("In a scheme, not responding"); ?>',
						color: '#d68910',
						data: <?php echo json_encode(array_map('intval', array_column($schemeRows, 'notResponding'))); ?>
					}
				]
			});
		});
	</script>
<?php endif; ?>

