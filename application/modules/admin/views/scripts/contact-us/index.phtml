<style>
    #contactsTable .contact-meta {
        color: #6b7280;
        font-size: 12px;
    }

    #contactsTable .contact-message {
        max-width: 560px;
        white-space: normal;
        overflow-wrap: anywhere;
    }
</style>

<div class="data-list">
    <div class="data-list-head">
        <h2><?= $this->translate->_("Contact Messages"); ?></h2>
    </div>
    <div class="data-list-body">
        <p class="text-muted">
            <?= $this->translate->_("Messages sent from the Contact form on the home page, newest first. Web addresses are shown as plain text, for example hxxps://example[.]com, so a click cannot open them."); ?>
        </p>
        <table cellpadding="0" cellspacing="0" border="0" class="table table-striped table-bordered table-hover" id="contactsTable">
            <thead>
                <tr>
                    <th scope="col"><?= $this->translate->_("Received"); ?></th>
                    <th scope="col"><?= $this->translate->_("From"); ?></th>
                    <th scope="col"><?= $this->translate->_("Country"); ?></th>
                    <th scope="col"><?= $this->translate->_("Subject"); ?></th>
                    <th scope="col"><?= $this->translate->_("Message"); ?></th>
                    <th scope="col"><?= $this->translate->_("Action"); ?></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="6" class="dataTables_empty"><?= $this->translate->_("Loading data from server"); ?></td>
                </tr>
            </tbody>
        </table>
    </div><!-- /.data-list-body -->
</div><!-- /.data-list -->

<script type="text/javascript" charset="utf-8">
    var oTable = null;
    $(document).ready(function () {
        oTable = $('#contactsTable').dataTable({
            "bJQueryUI": false,
            "bAutoWidth": false,
            "bInfo": true,
            "bScrollCollapse": true,
            "sPaginationType": "bootstrap",
            "bRetrieve": true,
            "aoColumns": [
                { "sClass": "" },
                { "sClass": "" },
                { "sClass": "" },
                { "sClass": "" },
                { "sClass": "", "bSortable": false },
                { "sClass": "center", "bSortable": false }
            ],
            "aaSorting": [
                [0, "desc"]
            ],
            "bProcessing": true,
            "bServerSide": true,
            "sAjaxSource": "<?php echo $this->url(array('module' => 'admin', 'controller' => 'contact-us', 'action' => 'index', 'format' => 'html')); ?>",
            "fnServerData": function (sSource, aoData, fnCallback) {
                $.ajax({
                    "dataType": 'json',
                    "type": "POST",
                    "url": sSource,
                    "data": aoData,
                    "success": fnCallback
                });
            }
        });
    });
</script>
