                        </div>
                    </div>
                    <div id="previewUnmergedNote" class="alert alert-info" style="display:none;margin-bottom:10px;">
                        <?= $this->htmlTranslate("This is your draft as typed. Select shipments and recipients, then preview again to see the fields filled in for each recipient."); ?>
                    </div>
                    <div id="previewFieldWarning" class="alert alert-warning" style="display:none;margin-bottom:10px;"></div>
                    <div class="mail-head">
                        <div class="mail-subject" id="previewBodySubject"></div>
                        <dl>
                            <dt><?= $this->htmlTranslate("From"); ?></dt>
                            <dd id="previewBodyFrom"></dd>
                            <dt><?= $this->htmlTranslate("To"); ?></dt>
                            <dd id="previewBodyTo"></dd>
                            <dt class="row-cc"><?= $this->htmlTranslate("Cc"); ?></dt>
                            <dd class="row-cc" id="previewBodyCc"></dd>
                            <dt class="row-bcc"><?= $this->htmlTranslate("Bcc"); ?></dt>
                            <dd class="row-bcc" id="previewBodyBcc"></dd>
                        </dl>
                    </div>
                    <!-- Sandboxed so the admin stylesheet can't restyle the
                         message and nothing in the body can run -->
                    <iframe id="previewBodyFrame" sandbox="" title="<?= $this->htmlTranslate('Message preview'); ?>"></iframe>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" id="previewCopyBtn" onclick="copyPreviewEmails();"><?= $this->htmlTranslate("Copy all addresses"); ?></button>
                <button type="button" class="btn btn-default" data-dismiss="modal"><?= $this->htmlTranslate("Close"); ?></button>
                <button type="button" class="btn btn-primary" id="previewSendBtn" style="display:none;" onclick="sendFromPreview();"></button>
            </div>
        </div>
    </div>
</div>

<!-- include summernote css/js -->
<script src="<?php echo $this->baseUrl('/assets/dist/js/app.js'); ?>"></script>
<link rel="stylesheet" type="text/css" href="<?php echo $this->baseUrl('css/summernote.min.css'); ?>">
<script type="text/javascript" src="<?php echo $this->baseUrl('js/summernote.min.js'); ?>"></script>
<script type="text/javascript" src="<?php echo $this->baseUrl('js/bootstrap-select.min.js'); ?>"></script>
<script type="text/javascript">
    // The scheduled email being edited, or null when composing a new one
    var EDIT_EMAIL = <?= json_encode($editData, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;
    // The current time in the application time zone, as a datetime-local
    // value. The browser's own clock may be in another time zone.
    var SERVER_NOW = "<?= date('Y-m-d\TH:i') ?>";

    function toggleSchedulePanel() {
        $('#schedulePanel').toggle();
        if ($('#schedulePanel').is(':visible')) {
            $('#scheduledAt').focus();
        }
    }

    function validateNow(mode) {
        mode = mode || 'now';
        $("#message").val($("#messageEditor").summernote('code'));
        if (!$('#shipments').val() || $('#shipments').val().length === 0) {
            alert("<?= $this->jsTranslate("Select at least one shipment.") ?>");
            return false;
        }
        if (getSendMail().length === 0) {
            alert("<?= $this->jsTranslate("Select who gets the email.") ?>");
            return false;
        }
        if ($('#subject').val() == '') {
            alert("<?= $this->jsTranslate("Enter the subject.") ?>");
            return false;
        }
        if ($.trim($('#message').val()) == '') {
            $('#message').val('');
            alert("<?= $this->jsTranslate("Enter the message.") ?>");
            return false;
        }
        if (mode === 'schedule') {
            // datetime-local values sort as strings, so this compares times
            var when = $('#scheduledAt').val();
            if (!when) {
                alert("<?= $this->jsTranslate("Choose when to send the email.") ?>");
                $('#scheduledAt').focus();
                return false;
            }
            if (when <= SERVER_NOW) {
                alert("<?= $this->jsTranslate("Choose a send time in the future.") ?>");
                $('#scheduledAt').focus();
                return false;
            }
        } else if (EDIT_EMAIL && !confirm("<?= $this->jsTranslate("Send this email now instead of at its scheduled time?") ?>")) {
            return false;
        }
        $('#sendMode').val(mode);
        flag = deforayValidator.init({
            formId: 'emailParticipantForm'
        });
        if (flag) {
            $.blockUI();
            document.getElementById('emailParticipantForm').submit();
        }
    }
    $(document).ready(function() {
        if (EDIT_EMAIL) {
            $('#subject').val(EDIT_EMAIL.subject);
            $('#sendMailChoices input').each(function() {
                this.checked = EDIT_EMAIL.audiences.indexOf(this.value) !== -1;
            });
        }
        getShipmentCodes();
        $('#shipments').selectpicker();

        $('#messageEditor').summernote({
            placeholder: '<?= $this->jsTranslate("Write your message here") ?>',
            tabsize: 2,
            height: 300,
            // Typing {{ offers the merge fields, narrowed as you type
            hint: {
                match: /\{\{\s*(\w*)$/,
                search: function(keyword, callback) {
                    keyword = keyword.toLowerCase();
                    callback($.grep(MERGE_KEYS, function(key) {
                        return key.indexOf(keyword) !== -1;
                    }));
                },
                template: function(key) {
                    return '{{' + key + '}}';
                },
                content: function(key) {
                    return document.createTextNode('{{' + key + '}}');
                }
            },
            callbacks: {
                onFocus: function() {
                    lastTokenTarget = 'message';
                },
                onBlur: function() {
                    $('#messageEditor').summernote('saveRange');
                    editorHasCursor = true;
                }
            }
        });
        $('#subject').on('focus', function() {
            lastTokenTarget = 'subject';
        });

        $('#sendMailChoices input').on('change', function() {
            $(this).closest('.ep-choice').toggleClass('selected', this.checked);
        }).trigger('change');

        if (EDIT_EMAIL) {
            $('#messageEditor').summernote('code', EDIT_EMAIL.content);
        }
        showTab(EDIT_EMAIL ? 'compose' : "<?= $this->escape($this->tab ?? 'compose') ?>");
        // Fills the Scheduled count badge whichever tab is open
        if (!EDIT_EMAIL) {
            loadEmailList('scheduled');
        }
    });

    function getSendMail() {
        return $('#sendMailChoices input:checked').map(function() {
            return this.value;
        }).get();
    }

    // Where a clicked merge field lands: the subject or the message body,
    // whichever was focused last.
    var lastTokenTarget = 'message';
    // False until the message has been clicked into, so a field clicked
    // first lands at the end of the body rather than before the greeting.
    var editorHasCursor = false;

    function insertToken(token) {
        if (lastTokenTarget === 'subject') {
            var el = document.getElementById('subject');
            var start = el.selectionStart != null ? el.selectionStart : el.value.length;
            var end = el.selectionEnd != null ? el.selectionEnd : start;
            el.value = el.value.slice(0, start) + token + el.value.slice(end);
            el.focus();
            el.setSelectionRange(start + token.length, start + token.length);
            return;
        }
        if (editorHasCursor) {
            $('#messageEditor').summernote('restoreRange');
        } else {
            var editable = $('#messageEditor').next('.note-editor').find('.note-editable')[0];
            var last = editable.lastElementChild || editable;
            var range = document.createRange();
            range.selectNodeContents(last);
            range.collapse(false);
            var selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
            $('#messageEditor').summernote('editor.setLastRange');
        }
        $('#messageEditor').summernote('insertText', token);
    }

    function getShipmentCodes() {
        $.blockUI();
        $.post("<?php echo $this->url(array('module' => 'reports', 'controller' => 'common', 'action' => 'get-shipments-by-date')); ?>", {
                distributionId: $("#distributionId").val(),
                notFinalized: false,
                format: "html"
            },
            function(data) {
                if (data == 0) {
                    shipmentCode = false;
                    $("#shipments").html('');
                } else {
                    $("#shipments").html(data);
                    if (EDIT_EMAIL) {
                        $("#shipments").val(EDIT_EMAIL.shipments);
                    } else if ($('#shipmentSlectedId').val() != '') {
                        $("#shipments").val($('#shipmentSlectedId').val());
                        $("#templates").val('not_participated');
                        fillTemplate($("#templates").val());
                    }

                    shipmentCode = true;
                }
                $("#shipments").selectpicker('refresh');

                $.unblockUI();
            });
    }

    // Holds the last preview payload so the footer buttons and the per-row
    // "Preview" links can work off it without a second round trip.
    var previewData = null;
    var previewIndex = 0;

    // From and the standing Cc/Bcc from the mail settings — on every message
    var MAIL_SENDER = <?= json_encode($this->mailSender ?? [], JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;

    var ROLE_LABELS = {
        participant: "<?= $this->jsTranslate("Participant") ?>",
        datamanager: "<?= $this->jsTranslate("Data Manager") ?>",
        ptcc: "<?= $this->jsTranslate("PTCC Manager") ?>"
    };
    var ROLE_BREAKDOWN = {
        participant: "<?= $this->jsTranslate("%s to participants") ?>",
        datamanager: "<?= $this->jsTranslate("%s to data managers") ?>",
        ptcc: "<?= $this->jsTranslate("%s to PTCC managers") ?>"
    };

    /** Fill %s placeholders in order, so translations keep whole sentences. */
    function fmt(text) {
        var args = arguments,
            i = 1;
        return String(text).replace(/%s/g, function() {
            return args[i++];
        });
    }

    function roleLabel(role) {
        return ROLE_LABELS[role] || role;
    }

    function formatCount(n) {
        return Number(n).toLocaleString();
    }

    // {{key}} names and legacy ##TOKENS## the server knows how to fill
    var MERGE_KEYS = <?= json_encode(array_keys(Application_Service_Participants::MAIL_MERGE_FIELDS)) ?>;
    var MERGE_LEGACY = <?= json_encode(array_values(array_filter(Application_Service_Participants::MAIL_MERGE_FIELDS))) ?>;
    var MERGE_PATTERN = /\{\{\s*[A-Za-z_]+\s*\}\}|##[A-Z_]+##/g;

    /** Fields typed in the draft that nothing will fill — they'd go out as-is. */
    function unknownMergeFields(text) {
        var unknown = {};
        $.each(text.match(MERGE_PATTERN) || [], function(i, field) {
            var known = field.charAt(0) === '{' ?
                MERGE_KEYS.indexOf(field.replace(/[{}\s]/g, '').toLowerCase()) !== -1 :
                MERGE_LEGACY.indexOf(field) !== -1;
            if (!known) {
                unknown[field] = true;
            }
        });
        return Object.keys(unknown);
    }

    function showFieldWarning() {
        var unknown = unknownMergeFields($('#subject').val() + ' ' + $("#messageEditor").summernote('code'));
        $('#previewFieldWarning')
            .text(unknown.length ? fmt("<?= $this->jsTranslate("Not merge fields, so they are sent exactly as typed: %s") ?>", unknown.join(", ")) : '')
            .toggle(unknown.length > 0);
    }

    function hasSelection() {
        var shipments = $('#shipments').val();
        var audience = getSendMail();
        return shipments && shipments.length > 0 && audience && audience.length > 0;
    }

    /**
     * Dry-run the send on the server: the exact de-duplicated recipient list
     * for the current selection, each with its merged subject and body.
     */
    function fetchPreview(onDone) {
        $("#message").val($("#messageEditor").summernote('code'));
        $.blockUI();
        $.post("<?php echo $this->url(array('module' => 'admin', 'controller' => 'email-participants', 'action' => 'preview-recipients')); ?>", {
                shipments: $('#shipments').val(),
                sendMail: getSendMail(),
                subject: $('#subject').val(),
                message: $('#message').val(),
                format: "html"
            },
            function(data) {
                $.unblockUI();
                previewData = data;
                renderPreview(data);
                onDone(data);
            }, "json")
            .fail(function() {
                $.unblockUI();
                alert("<?= $this->jsTranslate("The preview failed to load. Try again. If it fails again, contact your system administrator.") ?>");
            });
    }

    /**
     * One dialog, two tabs: the message as it lands in an inbox, and who gets
     * it. Without shipments and an audience picked there is nobody to merge
     * against yet, so only the draft as typed can be shown.
     */
    function openPreview() {
        var hasMessage = !$('#messageEditor').summernote('isEmpty');
        showFieldWarning();

        if (!hasSelection()) {
            if (!hasMessage) {
                alert("<?= $this->jsTranslate("Enter a message, or select shipments and recipients, before you preview.") ?>");
                return false;
            }
            previewData = null;
            showMessage({
                subject: $('#subject').val(),
                to: "<?= $this->jsTranslate("(each recipient)") ?>",
                cc: [],
                body: $("#messageEditor").summernote('code').replace(MERGE_PATTERN, '<mark>$&</mark>')
            });
            $('#previewUnmergedNote').show();
            $('#previewStepper, #previewPosition, #previewCopyBtn, #previewSendBtn').hide();
            $('#previewRecipientCount').text('');
            $('#previewTabs li[data-pane="message"]').removeClass('disabled');
            $('#previewTabs li[data-pane="list"]').addClass('disabled');
            showPreviewTab('message');
            $('#recipientPreviewModal').modal('show');
            return;
        }

        fetchPreview(function(data) {
            var count = (data.recipients || []).length;
            $('#previewTabs li[data-pane="list"]').removeClass('disabled');
            $('#previewRecipientCount').text(formatCount(count));
            $('#previewCopyBtn').show();
            // Sending needs real recipients and a body; the form's own checks
            // (subject etc.) still run on the way out.
            $('#previewSendBtn')
                .text(fmt("<?= $this->jsTranslate("Send (%s)") ?>", formatCount(count)))
                // Not while editing: Send now and Save changes are on the form
                .toggle(hasMessage && count > 0 && !EDIT_EMAIL);
            if (hasMessage && count > 0) {
                showPreviewBody(0);
                showPreviewTab('message');
            } else {
                $('#previewTabs li[data-pane="message"]').toggleClass('disabled', count === 0 || !hasMessage);
                showPreviewTab('list');
            }
            $('#recipientPreviewModal').modal('show');
        });
    }

    function showPreviewTab(pane) {
        var tab = $('#previewTabs li[data-pane="' + pane + '"]');
        if (tab.hasClass('disabled')) {
            return;
        }
        $('#previewTabs li').removeClass('active');
        tab.addClass('active');
        $('#previewListPane').toggle(pane === 'list');
        $('#previewMessagePane').toggle(pane === 'message');
    }

    /**
     * A headline plus a details list that stays collapsed — these lists run to
     * hundreds of addresses and swamp the dialog if rendered inline.
     */
    function buildCollapsibleAlert(cssClass, headline, lines) {
        var box = $('<div class="alert ' + cssClass + '" style="margin-bottom:10px;">');
        var details = $('<div style="max-height:140px;overflow-y:auto;margin-top:8px;font-size:12px;display:none;">')
            .text(lines.join(", "));

        var toggle = $('<a href="javascript:void(0)" style="margin-left:6px;text-decoration:underline;">')
            .text("<?= $this->jsTranslate("show") ?>")
            .on('click', function() {
                details.toggle();
                $(this).text(details.is(':visible') ?
                    "<?= $this->jsTranslate("hide") ?>" :
                    "<?= $this->jsTranslate("show") ?>");
            });

        return box.append($('<span>').text(headline)).append(toggle).append(details);
    }

    /** Client-side filter over the rendered rows — the list runs to 1000+. */
    function filterPreview(term) {
        term = $.trim(term).toLowerCase();
        var shown = 0;
        $('#previewTable tbody tr').each(function() {
            var row = $(this);
            var match = term === '' || row.data('haystack').indexOf(term) !== -1;
            row.toggle(match);
            if (match) {
                shown++;
            }
        });

        var total = (previewData && previewData.recipients) ? previewData.recipients.length : 0;
        $('#previewFilterCount').text(term === '' ? '' : fmt("<?= $this->jsTranslate("Shown: %s of %s") ?>", formatCount(shown), formatCount(total)));
    }

    function renderPreview(data) {
        var recipients = data.recipients || [];
        var counts = data.counts || {};
        var roles = Object.keys(counts);

        $('#previewFilter').val('');
        $('#previewFilterCount').text('');

        // "Emails to queue: 1,287 (1,247 to participants, 40 to PTCC managers)"
        var breakdown = $.map(roles, function(role) {
            return fmt(ROLE_BREAKDOWN[role] || (role + ": %s"), formatCount(counts[role]));
        });
        var summary = $('<div class="alert alert-info" style="margin-bottom:10px;">')
            .append($('<strong>').text(fmt("<?= $this->jsTranslate("Emails to queue: %s") ?>", formatCount(recipients.length))))
            .append(document.createTextNode(breakdown.length > 1 ? " (" + breakdown.join(", ") + ")" : ""));

        var ccMessages = $.grep(recipients, function(r) {
            return r.cc && r.cc.length > 0;
        });
        if (ccMessages.length > 0) {
            summary.append($('<div>').text(fmt("<?= $this->jsTranslate("Emails that also Cc the lab's data managers: %s") ?>", formatCount(ccMessages.length))));
        }
        var standing = [];
        if (MAIL_SENDER.cc) {
            standing.push(fmt("<?= $this->jsTranslate("Cc %s") ?>", MAIL_SENDER.cc));
        }
        if (MAIL_SENDER.bcc) {
            standing.push(fmt("<?= $this->jsTranslate("Bcc %s") ?>", MAIL_SENDER.bcc));
        }
        if (standing.length > 0) {
            summary.append($('<div>').text(fmt("<?= $this->jsTranslate("Every email also goes to: %s") ?>", standing.join(", "))));
        }
        $('#previewSummary').html('').append(summary);

        var warnings = $('#previewWarnings').html('');

        // Addresses landing more than once in THIS send — typically someone who
        // runs their own lab and is Cc'd as the manager of neighbouring labs.
        var multiple = data.multiple || [];
        if (multiple.length > 0) {
            warnings.append(buildCollapsibleAlert(
                'alert-warning',
                fmt("<?= $this->jsTranslate("Addresses that get more than one email in this send: %s. Each gets their own lab's email plus a Cc for every lab they manage.") ?>", formatCount(multiple.length)),
                $.map(multiple, function(m) {
                    return m.email + " ×" + m.copies;
                })
            ));
        }

        if (data.invalid && data.invalid.length > 0) {
            warnings.append(buildCollapsibleAlert(
                'alert-danger',
                fmt("<?= $this->jsTranslate("Invalid addresses, skipped: %s") ?>", formatCount(data.invalid.length)),
                data.invalid
            ));
        }

        // Columns that would be empty or identical on every row only add noise
        $('#previewTable .col-type').toggle(roles.length > 1);
        $('#previewTable .col-cc').toggle(ccMessages.length > 0);

        var tbody = $('#previewTable tbody').empty();
        if (recipients.length === 0) {
            tbody.append($('<tr>').append(
                $('<td colspan="7" class="text-center">').text("<?= $this->jsTranslate("No recipients match this selection.") ?>")
            ));
            return;
        }

        $.each(recipients, function(i, r) {
            var viewBtn = $('<a href="javascript:void(0)" class="btn btn-xs btn-default">')
                .text("<?= $this->jsTranslate("Preview") ?>")
                .on('click', function() {
                    showPreviewBody(i);
                    showPreviewTab('message');
                });

            var cc = r.cc || [];
            var copies = r.copies || 1;

            var toCell = $('<td>').text(r.email);
            if (copies > 1) {
                toCell.append(
                    $('<span class="label label-warning" style="margin-left:6px;">')
                    .attr('title', "<?= $this->jsTranslate("This address also gets a Cc for every lab it manages.") ?>")
                    .text("×" + copies)
                );
            }

            var row = $('<tr>')
                .append($('<td>').text(i + 1))
                .append($('<td class="col-type">').text(roleLabel(r.role)).toggle(roles.length > 1))
                .append($('<td>').text(r.name || ''))
                .append(toCell)
                .append($('<td class="col-cc">').css('font-size', '12px').text(cc.join(', ')).toggle(ccMessages.length > 0))
                .append($('<td>').text(r.country || ''))
                .append($('<td>').append(viewBtn));

            // Precomputed so filtering stays cheap across 1000+ rows. The
            // "multiple" keyword is synthetic — it makes the duplicated
            // inboxes reachable from the filter box.
            row.data('haystack', [roleLabel(r.role), r.name || '', r.email, cc.join(' '), r.country || '',
                    copies > 1 ? 'multiple' : ''
                ]
                .join(' ').toLowerCase());

            tbody.append(row);
        });
    }

    /** Fill the inbox-style header and the sandboxed body frame. */
    function showMessage(msg) {
        var from = MAIL_SENDER.fromEmail || '';
        if (MAIL_SENDER.fromName) {
            from = MAIL_SENDER.fromName + (from ? " <" + from + ">" : "");
        }
        var cc = (msg.cc || []).slice();
        if (MAIL_SENDER.cc) {
            cc.unshift(MAIL_SENDER.cc);
        }

        $('#previewBodySubject').text(msg.subject || "<?= $this->jsTranslate("(no subject)") ?>");
        $('#previewBodyFrom').text(from || "<?= $this->jsTranslate("(not set in the mail settings)") ?>");
        $('#previewBodyTo').text(msg.to);
        $('#previewBodyCc').text(cc.join(", "));
        $('#previewMessagePane .row-cc').toggle(cc.length > 0);
        $('#previewBodyBcc').text(MAIL_SENDER.bcc || '');
        $('#previewMessagePane .row-bcc').toggle(!!MAIL_SENDER.bcc);

        // Mail clients render the body on a blank page with their own default
        // font, so give the frame the same plain baseline.
        $('#previewBodyFrame').attr('srcdoc',
            '<!doctype html><html><head><meta charset="utf-8"><style>' +
            'body{margin:16px;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.45;color:#222;}' +
            'img{max-width:100%;height:auto;}mark{background:#fff3b0;}' +
            '</style></head><body>' + (msg.body || '') + '</body></html>');
    }

    /** One recipient's fully merged message, exactly as it will be queued. */
    function showPreviewBody(index) {
        var list = (previewData && previewData.recipients) ? previewData.recipients : [];
        var r = list[index];
        if (!r) {
            return;
        }
        previewIndex = index;
        showMessage({
            subject: r.subject,
            to: r.name ? (r.name + " <" + r.email + ">") : r.email,
            cc: r.cc || [],
            body: r.body
        });

        $('#previewTabs li[data-pane="message"]').removeClass('disabled');
        $('#previewUnmergedNote').hide();
        $('#previewStepper, #previewPosition').show();
        $('#previewPosition').text(fmt("<?= $this->jsTranslate("Recipient %s of %s") ?>", formatCount(index + 1), formatCount(list.length)));
        $('#previewPrevBtn').prop('disabled', index === 0);
        $('#previewNextBtn').prop('disabled', index >= list.length - 1);
    }

    function stepPreviewBody(delta) {
        showPreviewBody(previewIndex + delta);
    }

    /** Send straight from the preview, once the admin has seen what goes out. */
    function sendFromPreview() {
        var count = (previewData && previewData.recipients) ? previewData.recipients.length : 0;
        if (count === 0) {
            return;
        }
        if (!confirm(fmt("<?= $this->jsTranslate("Queue this email now? Recipients: %s") ?>", formatCount(count)))) {
            return;
        }
        $('#recipientPreviewModal').modal('hide');
        validateNow();
    }

    function copyPreviewEmails() {
        if (!previewData || !previewData.recipients || previewData.recipients.length === 0) {
            return;
        }
        var emails = $.map(previewData.recipients, function(r) {
            return r.email;
        }).join(", ");

        var textarea = document.createElement('textarea');
        textarea.value = emails;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        try {
            document.execCommand('copy');
            alert(fmt("<?= $this->jsTranslate("Addresses copied to the clipboard: %s") ?>", formatCount(previewData.recipients.length)));
        } catch (err) {
            window.prompt("<?= $this->jsTranslate("Press Ctrl+C / Cmd+C to copy") ?>", emails);
        }
        document.body.removeChild(textarea);
    }

    function fillTemplate(value) {
        if (value === '') {
            return;
        }
        $.blockUI();
        $.post("<?php echo $this->url(array('module' => 'admin', 'controller' => 'email-participants', 'action' => 'get-mail-template')); ?>", {
                mailPurpose: value,
                format: "html"
            },
            function(data) {
                if (data != undefined && data != null && data != "") {
                    let obj = jQuery.parseJSON(data);
                    $('#subject').val(obj.subject);
                    let html = (obj.content + '<br><br>' + obj.footer);
                    $("#messageEditor").summernote('code', html);
                }

                $.unblockUI();
            });
    }

    /* ---------- Scheduled and History tabs ---------- */

    var STATUS_LABELS = {
        scheduled: ["<?= $this->jsTranslate("Scheduled") ?>", 'label-info'],
        paused: ["<?= $this->jsTranslate("Paused") ?>", 'label-warning'],
        dispatching: ["<?= $this->jsTranslate("Queuing") ?>", 'label-primary'],
        sending: ["<?= $this->jsTranslate("Sending") ?>", 'label-primary'],
        queued: ["<?= $this->jsTranslate("Sent") ?>", 'label-success'],
        cancelled: ["<?= $this->jsTranslate("Cancelled") ?>", 'label-default'],
        failed: ["<?= $this->jsTranslate("Failed") ?>", 'label-danger']
    };
    var listTimer = null;

    function showTab(tab) {
        $('#epTabs li').removeClass('active');
        $('#epTabs li[data-tab="' + tab + '"]').addClass('active');
        $('#paneCompose').toggle(tab === 'compose');
        $('#paneScheduled').toggle(tab === 'scheduled');
        $('#paneHistory').toggle(tab === 'history');

        clearInterval(listTimer);
        if (tab !== 'compose') {
            loadEmailList(tab);
            // Progress of a send still going out
            if (tab === 'scheduled') {
                listTimer = setInterval(function() {
                    loadEmailList('scheduled');
                }, 30000);
            }
        }
        if (!EDIT_EMAIL && window.history.replaceState) {
            window.history.replaceState(null, '', '/admin/email-participants' + (tab === 'compose' ? '' : '?tab=' + tab));
        }
    }

    function loadEmailList(view) {
        $.get("/admin/email-participants/list", {
            view: view
        }, function(data) {
            renderEmailList(view, data.rows || [], data.now);
        }, "json");
    }

    /** "2026-10-06 14:30:00" → "06-Oct-2026 14:30", in the app's time zone */
    function formatWhen(value) {
        if (!value) {
            return '';
        }
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var d = String(value);
        return d.substr(8, 2) + '-' + months[parseInt(d.substr(5, 2), 10) - 1] + '-' + d.substr(0, 4) + ' ' + d.substr(11, 5);
    }

    function displayStatus(row) {
        var p = row.progress || {};
        var unsent = (p.pending || 0) + (p['picked-to-process'] || 0) + (p.held || 0);
        if (row.status === 'queued' && unsent > 0) {
            return 'sending';
        }
        return row.status;
    }

    /** "312 sent · 4 failed · 180 waiting", or the total once counts are pruned */
    function progressText(row) {
        var p = row.progress || {};
        var parts = [];
        var waiting = (p.pending || 0) + (p['picked-to-process'] || 0);
        if (p.sent) {
            parts.push(fmt("<?= $this->jsTranslate("%s sent") ?>", formatCount(p.sent)));
        }
        if (waiting) {
            parts.push(fmt("<?= $this->jsTranslate("%s waiting") ?>", formatCount(waiting)));
        }
        if (p.held) {
            parts.push(fmt("<?= $this->jsTranslate("%s held") ?>", formatCount(p.held)));
        }
        if (p.failed || p.skipped) {
            parts.push(fmt("<?= $this->jsTranslate("%s failed") ?>", formatCount((p.failed || 0) + (p.skipped || 0))));
        }
        if (p.cancelled) {
            parts.push(fmt("<?= $this->jsTranslate("%s not sent") ?>", formatCount(p.cancelled)));
        }
        if (parts.length === 0 && row.queuedCount) {
            parts.push(fmt("<?= $this->jsTranslate("%s messages") ?>", formatCount(row.queuedCount)));
        }
        return parts.join(' · ');
    }

    function statusCell(row) {
        var key = displayStatus(row);
        var label = STATUS_LABELS[key] || [key, 'label-default'];
        var cell = $('<td>').append($('<span class="label">').addClass(label[1]).text(label[0]));
        if (row.inFlight && (row.status === 'paused' || row.status === 'cancelled')) {
            cell.append($('<div class="ep-list-sub">').text("<?= $this->jsTranslate("Partly sent") ?>"));
        }
        var progress = progressText(row);
        if (progress) {
            cell.append($('<div class="ep-list-sub">').text(progress));
        }
        if (row.failureReason) {
            cell.append($('<div class="ep-list-reason">').text(row.failureReason));
        }
        return cell;
    }

    function actionButton(label, css, onClick) {
        return $('<button type="button" class="btn btn-xs">').addClass(css).text(label).on('click', onClick);
    }

    function rowActions(row, now) {
        var box = $('<div class="ep-row-actions">');
        if (row.editable) {
            box.append(actionButton("<?= $this->jsTranslate("Edit") ?>", 'btn-default', function() {
                window.location.href = '/admin/email-participants?edit=' + row.id;
            }));
        }
        var waiting = row.status === 'scheduled' || (row.status === 'queued' && displayStatus(row) === 'sending');
        if (waiting) {
            box.append(actionButton("<?= $this->jsTranslate("Pause") ?>", 'btn-warning', function() {
                changeState(row, 'pause');
            }));
        }
        if (row.status === 'paused') {
            box.append(actionButton("<?= $this->jsTranslate("Resume") ?>", 'btn-success', function() {
                // A paused email whose time went by would go out the moment
                // it resumed, so ask rather than surprise
                if (!row.inFlight && row.scheduledAt <= now) {
                    if (confirm("<?= $this->jsTranslate("Its send time has passed. Send it now? Choose Cancel to set a new time instead.") ?>")) {
                        changeState(row, 'send-now');
                    } else {
                        window.location.href = '/admin/email-participants?edit=' + row.id;
                    }
                    return;
                }
                changeState(row, 'resume');
            }));
        }
        if (row.editable) {
            box.append(actionButton("<?= $this->jsTranslate("Send now") ?>", 'btn-primary', function() {
                if (confirm(fmt("<?= $this->jsTranslate("Send \"%s\" now instead of at its scheduled time?") ?>", row.subject))) {
                    changeState(row, 'send-now');
                }
            }));
        }
        if (row.editable || (row.inFlight && (row.status === 'queued' || row.status === 'paused') && displayStatus(row) !== 'queued')) {
            box.append(actionButton("<?= $this->jsTranslate("Cancel") ?>", 'btn-danger', function() {
                var question = row.inFlight ?
                    "<?= $this->jsTranslate("Cancel this email? Messages already sent cannot be recalled. The rest will not be sent.") ?>" :
                    "<?= $this->jsTranslate("Cancel this email? It will not be sent.") ?>";
                if (confirm(question)) {
                    changeState(row, 'cancel');
                }
            }));
        }
        return box;
    }

    function changeState(row, action) {
        $.blockUI();
        $.post("/admin/email-participants/change-state", {
            id: row.id,
            'do': action
        }, function(data) {
            $.unblockUI();
            alert(data.message);
            loadEmailList('scheduled');
        }, "json").fail(function() {
            $.unblockUI();
            alert("<?= $this->jsTranslate("That did not work. Reload the page and try again.") ?>");
        });
    }

    function audienceText(audiences) {
        return $.map(audiences || [], roleLabel).join(', ');
    }

    function renderEmailList(view, rows, now) {
        if (view === 'scheduled') {
            $('#scheduledCount').text(rows.length ? rows.length : '');
        }
        var tbody = $(view === 'scheduled' ? '#scheduledTable tbody' : '#historyTable tbody').empty();
        if (rows.length === 0) {
            tbody.append($('<tr>').append($('<td colspan="6" class="ep-list-empty">').text(view === 'scheduled' ?
                "<?= $this->jsTranslate("No emails are scheduled. Use Schedule… on the Compose tab to send one later.") ?>" :
                "<?= $this->jsTranslate("No emails have been sent from this page yet.") ?>")));
            return;
        }
        $.each(rows, function(i, row) {
            var subject = $('<td>').append($('<div>').text(row.subject));
            var by = row.createdBy + (row.updatedBy && row.updatedBy !== row.createdBy ? ' · ' + fmt("<?= $this->jsTranslate("edited by %s") ?>", row.updatedBy) : '');
            var tr = $('<tr>');
            if (view === 'scheduled') {
                subject.append($('<div class="ep-list-sub">').text(by));
                tr.append($('<td style="white-space:nowrap;">').text(row.scheduledAt ? formatWhen(row.scheduledAt) : formatWhen(row.dispatchedAt)))
                    .append(subject)
                    .append($('<td>').text(row.shipments.join(', ')))
                    .append($('<td>').text(audienceText(row.audiences)))
                    .append(statusCell(row))
                    .append($('<td>').append(rowActions(row, now)));
            } else {
                if (row.scheduledAt) {
                    subject.append($('<div class="ep-list-sub">').text(fmt("<?= $this->jsTranslate("Scheduled for %s") ?>", formatWhen(row.scheduledAt))));
                }
                tr.append($('<td style="white-space:nowrap;">').text(formatWhen(row.createdAt)))
                    .append(subject)
                    .append($('<td>').text(row.shipments.join(', ')))
                    .append($('<td>').text(audienceText(row.audiences)))
                    .append(statusCell(row))
                    .append($('<td>').text(by));
            }
            tbody.append(tr);
        });
    }

</script>
