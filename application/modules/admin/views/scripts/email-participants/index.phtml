<script type="text/javascript" src="<?php echo $this->baseUrl("js/jquery.quicksearch.js"); ?>"></script>
<script type="text/javascript">
    var startDate = "";
    var endDate = "";

    function validateNow() {
        $("#message").val($("#messageEditor").summernote('code'));
        if ($('#shipments').val() == '') {
            alert("Please select schipment code and TO for sending the mails");
            return false;
        }
        if ($('#sendMail').val() == '') {
            alert("Please select schipment code and TO for sending the mails");
            return false;
        }
        if ($('#subject').val() == '') {
            alert("Please enter the mail subject");
            return false;
        }
        if ($.trim($('#message').val()) == '') {
            $('#message').val('');
            alert("Please enter the mail content");
            return false;
        }
        flag = deforayValidator.init({
            formId: 'emailParticipantForm'
        });
        if (flag) {
            $.blockUI();
            document.getElementById('emailParticipantForm').submit();
        }
    }
    $(document).ready(function() {
        getShipmentCodes();
        $('#shipments, #sendMail').selectpicker();

        $('#messageEditor').summernote({
            placeholder: 'Please enter the Contact Information here',
            tabsize: 2,
            height: 200
        });

        $('#dateRange').daterangepicker({
                locale: {
                    cancelLabel: 'Clear',
                    format: 'DD-MMM-YYYY',
                    separator: ' to ',
                },
                autoApply: true,
                showDropdowns: true,
                alwaysShowCalendars: true,
                autoUpdateInput: true,
                startDate: moment().subtract(179, 'days'),
                endDate: moment(),
                maxDate: moment(),
                ranges: {
                    'This Month': [moment().startOf('month'), moment().endOf('month')],
                    'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')],
                    'Last 60 Days': [moment().subtract(59, 'days'), moment()],
                    'Last 90 Days': [moment().subtract(89, 'days'), moment()],
                    'Last 180 Days': [moment().subtract(179, 'days'), moment()],
                    'Last 12 Months': [moment().subtract(12, 'month'), moment()],
                    'Last 18 Months': [moment().subtract(18, 'month'), moment()],
                }
            },
            function(start, end) {
                startDate = start.format('DD-MMM-YYYY');
                endDate = end.format('DD-MMM-YYYY');
            });
    });

    function getShipmentCodes() {
        $('#shipmentId').select2('data', null);

        $.blockUI();
        $.post("<?php echo $this->url(array('module' => 'reports', 'controller' => 'common', 'action' => 'get-shipments-by-date')); ?>", {
                startDate: startDate,
                endDate: endDate,
                distributionId: $("#distributionId").val(),
                notFinalized: false,
                format: "html"
            },
            function(data) {
                if (data == 0) {
                    shipmentCode = false;
                    $("#shipments").html('');
                } else {
                    $("#shipments").html(data);
                    if ($('#shipmentSlectedId').val() != '') {
                        $("#shipments").val($('#shipmentSlectedId').val());
                        $("#templates").val('not_participated');
                        fillTemplate($("#templates").val());
                    }

                    shipmentCode = true;
                }
                $("#shipments").selectpicker('refresh');

                $.unblockUI();
            });
    }

    // Holds the last preview payload so the footer buttons and the per-row
    // "View" links can work off it without a second round trip.
    var previewData = null;

    var ROLE_LABELS = {
        participant: "<?= $this->translate->_("Participant"); ?>",
        datamanager: "<?= $this->translate->_("Data Manager"); ?>",
        ptcc: "<?= $this->translate->_("PTCC"); ?>"
    };

    function roleLabel(role) {
        return ROLE_LABELS[role] || role;
    }

    /**
     * Dry-run the send: ask the server for the exact de-duplicated recipient
     * list for the current shipment/audience selection and show it.
     */
    function previewRecipients() {
        $("#message").val($("#messageEditor").summernote('code'));

        if ($('#shipments').val() == '' || $('#shipments').val() == null) {
            alert("<?= $this->translate->_("Please select at least one shipment"); ?>");
            return false;
        }
        if ($('#sendMail').val() == '' || $('#sendMail').val() == null) {
            alert("<?= $this->translate->_("Please select who the email should go to"); ?>");
            return false;
        }

        $.blockUI();
        $.post("<?php echo $this->url(array('module' => 'admin', 'controller' => 'email-participants', 'action' => 'preview-recipients')); ?>", {
                shipments: $('#shipments').val(),
                sendMail: $('#sendMail').val(),
                skipEmail: $('#skipEmail').is(':checked') ? 'on' : '',
                subject: $('#subject').val(),
                message: $('#message').val(),
                format: "html"
            },
            function(data) {
                $.unblockUI();
                previewData = data;
                $('#previewFilter').val('');
                $('#previewFilterCount').text('');
                closePreviewBody(); // always reopen on the list, not a stale message
                renderPreview(data);
                $('#recipientPreviewModal').modal('show');
            }, "json")
            .fail(function() {
                $.unblockUI();
                alert("<?= $this->translate->_("Unable to build the preview. Please try again later or contact system admin for help"); ?>");
            });
    }

    /**
     * A headline plus a details list that stays collapsed — these lists run to
     * hundreds of addresses and swamp the dialog if rendered inline.
     */
    function buildCollapsibleAlert(cssClass, headline, lines) {
        var box = $('<div class="alert ' + cssClass + '" style="margin-bottom:10px;">');
        var details = $('<div style="max-height:140px;overflow-y:auto;margin-top:8px;font-size:12px;display:none;">')
            .text(lines.join(", "));

        var toggle = $('<a href="javascript:void(0)" style="margin-left:6px;text-decoration:underline;">')
            .text("<?= $this->translate->_("show"); ?>")
            .on('click', function() {
                details.toggle();
                $(this).text(details.is(':visible') ?
                    "<?= $this->translate->_("hide"); ?>" :
                    "<?= $this->translate->_("show"); ?>");
            });

        return box.append($('<span>').text(headline)).append(toggle).append(details);
    }

    /** Client-side filter over the rendered rows — the list runs to 1000+. */
    function filterPreview(term) {
        term = $.trim(term).toLowerCase();
        var shown = 0;
        $('#previewTable tbody tr').each(function() {
            var row = $(this);
            var match = term === '' || row.data('haystack').indexOf(term) !== -1;
            row.toggle(match);
            if (match) {
                shown++;
            }
        });

        var total = (previewData && previewData.recipients) ? previewData.recipients.length : 0;
        $('#previewFilterCount').text(term === '' ? '' : shown + " / " + total + " <?= $this->translate->_("shown"); ?>");
    }

    function renderPreview(data) {
        var recipients = data.recipients || [];
        var counts = data.counts || {};

        var breakdown = [];
        $.each(counts, function(role, count) {
            breakdown.push(count + " " + roleLabel(role));
        });

        var ccMessages = $.grep(recipients, function(r) {
            return r.cc && r.cc.length > 0;
        });
        var ccPeople = {};
        $.each(ccMessages, function(i, r) {
            $.each(r.cc, function(j, addr) {
                ccPeople[addr.toLowerCase()] = true;
            });
        });

        var summary = recipients.length + " <?= $this->translate->_("email(s) will be queued"); ?>" +
            (breakdown.length ? " — <?= $this->translate->_("addressed to"); ?> " + breakdown.join(", ") : "");
        if (ccMessages.length > 0) {
            summary += ". " + ccMessages.length + " <?= $this->translate->_("of them also Cc a data manager"); ?> (" +
                Object.keys(ccPeople).length + " <?= $this->translate->_("distinct manager(s)"); ?>)";
        }

        $('#previewSummary').html('').append(
            $('<div class="alert alert-info" style="margin-bottom:10px;">').text(summary)
        );

        var warnings = $('#previewWarnings').html('');

        // Only audiences outside this selection matter: those addresses would
        // get a second copy from a separate send. Same-selection overlaps are
        // already collapsed into one email and need no warning.
        var overlaps = $.grep(recipients, function(r) {
            return r.otherRoles && r.otherRoles.length > 0;
        });
        if (overlaps.length > 0) {
            var lines = $.map(overlaps, function(r) {
                return r.email + " (" + $.map(r.otherRoles, roleLabel).join(", ") + ")";
            });
            warnings.append(buildCollapsibleAlert(
                'alert-warning',
                overlaps.length + " <?= $this->translate->_("of these addresses also belong to an audience you did NOT select, so a separate send to that audience would reach them a second time"); ?>",
                lines
            ));
        }

        // Addresses landing more than once in THIS send — typically someone who
        // runs their own lab and is Cc'd as the manager of neighbouring labs.
        var multiple = data.multiple || [];
        if (multiple.length > 0) {
            warnings.append(buildCollapsibleAlert(
                'alert-warning',
                multiple.length + " <?= $this->translate->_("address(es) appear on more than one message in this send (own lab as To, plus Cc on labs they manage). Type multiple in the filter box to see them"); ?>",
                $.map(multiple, function(m) {
                    return m.email + " ×" + m.copies;
                })
            ));
        }

        if (data.invalid && data.invalid.length > 0) {
            warnings.append(buildCollapsibleAlert(
                'alert-danger',
                data.invalid.length + " <?= $this->translate->_("address(es) were dropped as invalid"); ?>",
                data.invalid
            ));
        }

        var tbody = $('#previewTable tbody').empty();
        if (recipients.length === 0) {
            tbody.append($('<tr>').append(
                $('<td colspan="7" class="text-center">').text("<?= $this->translate->_("No recipients match this selection"); ?>")
            ));
            return;
        }

        $.each(recipients, function(i, r) {
            var viewBtn = $('<a href="javascript:void(0)" class="btn btn-xs btn-default">')
                .text("<?= $this->translate->_("View"); ?>")
                .on('click', function() {
                    showPreviewBody(i);
                });

            var cc = r.cc || [];
            var copies = r.copies || 1;

            var toCell = $('<td>').text(r.email);
            if (copies > 1) {
                toCell.append(
                    $('<span class="label label-warning" style="margin-left:6px;">')
                        .attr('title', "<?= $this->translate->_("This inbox also receives Cc copies from labs it manages"); ?>")
                        .text("×" + copies)
                );
            }

            var row = $('<tr>')
                .append($('<td>').text(i + 1))
                .append($('<td>').text(roleLabel(r.role)))
                .append($('<td>').text(r.name || ''))
                .append(toCell)
                .append($('<td>').css('font-size', '12px').text(cc.join(', ')))
                .append($('<td>').text(r.country || ''))
                .append($('<td>').append(viewBtn));

            // Precomputed so filtering stays cheap across 1000+ rows. The
            // "multiple" keyword is synthetic — it makes the duplicated
            // inboxes reachable from the filter box.
            row.data('haystack', [roleLabel(r.role), r.name || '', r.email, cc.join(' '), r.country || '',
                    copies > 1 ? 'multiple' : ''
                ]
                .join(' ').toLowerCase());

            tbody.append(row);
        });
    }

    /**
     * Show the fully merged subject/body one recipient would actually get, by
     * swapping panes inside this modal rather than opening a second one.
     */
    function showPreviewBody(index) {
        var r = (previewData && previewData.recipients) ? previewData.recipients[index] : null;
        if (!r) {
            return;
        }
        var cc = r.cc || [];
        $('#previewBodyTo').text(r.name ? (r.name + " <" + r.email + ">") : r.email);
        $('#previewBodyCc').text(cc.length ? cc.join(", ") : "—");
        $('#previewBodySubject').text(r.subject || '');
        // Admin-authored HTML from the editor — render it as the recipient sees it
        $('#previewBodyContent').html(r.body || '');

        $('#previewListPane').hide();
        $('#previewMessagePane').show();
    }

    /** Return from a single message to the recipient list. */
    function closePreviewBody() {
        $('#previewMessagePane').hide();
        $('#previewListPane').show();
    }

    function copyPreviewEmails() {
        if (!previewData || !previewData.recipients || previewData.recipients.length === 0) {
            return;
        }
        var emails = $.map(previewData.recipients, function(r) {
            return r.email;
        }).join(", ");

        var textarea = document.createElement('textarea');
        textarea.value = emails;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        try {
            document.execCommand('copy');
            alert(previewData.recipients.length + " <?= $this->translate->_("address(es) copied to clipboard"); ?>");
        } catch (err) {
            window.prompt("<?= $this->translate->_("Press Ctrl+C / Cmd+C to copy"); ?>", emails);
        }
        document.body.removeChild(textarea);
    }

    function fillTemplate(value) {
        $.blockUI();
        $.post("<?php echo $this->url(array('module' => 'admin', 'controller' => 'email-participants', 'action' => 'get-mail-template')); ?>", {
                mailPurpose: value,
                format: "html"
            },
            function(data) {
                if (data != undefined && data != null && data != "") {
                    let obj = jQuery.parseJSON(data);
                    $('#subject').val(obj.subject);
                    let html = (obj.content + '<br><br>' + obj.footer);
                    $("#messageEditor").summernote('pasteHTML', html);
                }

                $.unblockUI();
            });
    }

</script>