<?php
$mappedDms = $this->mappedDms ?? [];
$dmCount = count($mappedDms);
$adminSession = new Zend_Session_Namespace('administrators');
$adminPrivileges = array_map('trim', explode(',', (string)($adminSession->privileges ?? '')));
$canViewAsParticipant = in_array('view-as-participant', $adminPrivileges, true);
// Active rows past this count stay folded until "Show all" is clicked or the filter is used
$visibleLimit = 10;
// Inactive managers cannot log in, so they get no row or actions. One line under
// the table names them, so the admin still sees who is mapped.
$activeDms = array_values(array_filter($mappedDms, fn ($dm) => strtolower($dm['status'] ?? '') === 'active'));
$inactiveDms = array_values(array_filter($mappedDms, fn ($dm) => strtolower($dm['status'] ?? '') !== 'active'));
$activeCount = count($activeDms);
$panelClass = 'dm-child-row' . ($activeCount > $visibleLimit ? ' is-collapsed' : '');
?>
<div class="<?= $panelClass; ?>">
    <?php if ($dmCount === 0) { ?>
        <em class="text-muted"><?= $this->translate->_('No data managers are currently mapped to this participant.'); ?></em>
    <?php } else { ?>
        <div class="child-row-header">
            <i class="icon-user"></i>
            <?php if ($activeCount > 0) { ?>
                <span><?= $activeCount === 1 ? $this->translate->_('1 data manager') : sprintf($this->translate->_('%d data managers'), $activeCount); ?></span>
            <?php } else { ?>
                <span><?= $this->translate->_('No active data manager'); ?></span>
            <?php } ?>
            <?php if ($activeCount > 5) { ?>
                <input type="text" class="form-control input-sm dm-filter-input" placeholder="<?= $this->htmlTranslate('Filter by name or email…'); ?>" />
            <?php } ?>
        </div>
        <div class="dm-list-wrap">
            <?php if ($activeCount > 0) { ?>
            <table class="table table-condensed child-list">
                <thead>
                    <tr>
                        <th scope="col" style="width:34%;"><?= $this->translate->_('Data Manager'); ?></th>
                        <th scope="col" style="width:30%;"><?= $this->translate->_('Contact'); ?></th>
                        <th scope="col"><?= $this->translate->_('Action'); ?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($activeDms as $i => $dm) {
                        $name = trim(($dm['first_name'] ?? '') . ' ' . ($dm['last_name'] ?? ''));
                        $isActive = strtolower($dm['status'] ?? '') === 'active';
                        $isPtcc = isset($dm['data_manager_type']) && $dm['data_manager_type'] === 'ptcc';
                        $editUrl = '/admin/data-managers/edit/id/' . (int)$dm['dm_id'] . ($isPtcc ? '/ptcc/1' : '');
                        $resetUrl = '/admin/data-managers/reset-password/id/' . (int)$dm['dm_id'];
                        $changeEmailUrl = '/admin/data-managers/change-primary-email/id/' . (int)$dm['dm_id'];
                        $searchBlob = strtolower($name . ' ' . ($dm['primary_email'] ?? '') . ' ' . ($dm['institute'] ?? ''));
                        $rowClass = 'dm-row' . ($i >= $visibleLimit ? ' is-overflow' : '');
                    ?>
                        <tr class="<?= $rowClass; ?>" data-dm-search="<?= htmlspecialchars($searchBlob, ENT_QUOTES, 'UTF-8'); ?>">
                            <td>
                                <a href="<?= $editUrl; ?>" class="child-list-name" title="<?= $this->htmlTranslate('Edit this data manager'); ?>"><?php if ($name === '') { ?><span class="dm-noname"><?= $this->translate->_('No name'); ?></span><?php } else { ?><?= htmlspecialchars($name, ENT_QUOTES, 'UTF-8', false); ?><?php } ?></a>
                                <?php if ($isPtcc) { ?>
                                    <span class="list-status-badge is-info">PTCC</span>
                                <?php } ?>
                                <?php if (!empty($dm['institute'])) { ?>
                                    <span class="list-cell-sub"><?= htmlspecialchars($dm['institute'], ENT_QUOTES, 'UTF-8', false); ?></span>
                                <?php } ?>
                            </td>
                            <td>
                                <?= htmlspecialchars($dm['primary_email'] ?? '', ENT_QUOTES, 'UTF-8', false); ?>
                                <?php if (!empty($dm['mobile'])) { ?>
                                    <span class="list-cell-sub is-numeric"><?= htmlspecialchars($dm['mobile'], ENT_QUOTES, 'UTF-8', false); ?></span>
                                <?php } ?>
                            </td>
                            <td>
                                <div class="row-action-line child-list-actions">
                                    <a href="<?= $editUrl; ?>" class="btn btn-default btn-xs is-edit" title="<?= $this->htmlTranslate('Edit this data manager'); ?>"><i class="icon-pencil"></i> <?= $this->translate->_('Edit'); ?></a>
                                    <a href="javascript:void(0);" class="btn btn-default btn-xs" title="<?= $this->htmlTranslate('Reset this user\'s password'); ?>" onclick="layoutModal('<?= $resetUrl; ?>','980','500');"><i class="icon-key"></i> <?= $this->translate->_('Password'); ?></a>
                                    <a href="javascript:void(0);" class="btn btn-default btn-xs" title="<?= $this->htmlTranslate('Change the primary email address'); ?>" onclick="layoutModal('<?= $changeEmailUrl; ?>','700','520');"><i class="icon-envelope"></i> <?= $this->translate->_('Email'); ?></a>
                                    <?php if ($canViewAsParticipant && $isActive) { ?>
                                        <a href="/admin/impersonate/start?dm_id=<?= (int)$dm['dm_id']; ?>" target="_blank" rel="noopener" class="btn btn-danger btn-xs" title="<?= $this->htmlTranslate('Opens the participant UI as this user. Audited.'); ?>"><i class="icon-eye-open"></i> <?= $this->translate->_('View as'); ?></a>
                                    <?php } ?>
                                </div>
                            </td>
                        </tr>
                    <?php } ?>
                </tbody>
            </table>
            <?php } ?>
            <?php if ($activeCount > $visibleLimit) { ?>
                <a href="javascript:void(0);" class="child-list-more"><?= sprintf($this->translate->_('Show all %d'), $activeCount); ?></a>
            <?php } ?>
            <?php if ($inactiveDms) {
                $inactiveLinks = [];
                foreach ($inactiveDms as $dm) {
                    $name = trim(($dm['first_name'] ?? '') . ' ' . ($dm['last_name'] ?? ''));
                    $label = htmlspecialchars($name !== '' ? $name : (string)($dm['primary_email'] ?? ''), ENT_QUOTES, 'UTF-8', false);
                    $isPtcc = ($dm['data_manager_type'] ?? '') === 'ptcc';
                    $editUrl = '/admin/data-managers/edit/id/' . (int)$dm['dm_id'] . ($isPtcc ? '/ptcc/1' : '');
                    $inactiveLinks[] = '<a href="' . $editUrl . '" class="inactive-chip" title="' . $this->htmlTranslate('Edit this data manager') . '">' . $label . ($isPtcc ? ' <span class="inactive-chip-tag">PTCC</span>' : '') . '</a>';
                }
            ?>
                <div class="child-list-inactive">
                    <span class="child-list-inactive-label"><?= $this->translate->_('Inactive'); ?> (<?= count($inactiveDms); ?>)</span>
                    <?= implode('', $inactiveLinks); ?>
                </div>
            <?php } ?>
        </div>
    <?php } ?>
</div>
