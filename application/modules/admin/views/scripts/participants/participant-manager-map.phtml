<script type="text/javascript" src="<?php echo $this->baseUrl('js/select2.min.js'); ?>"></script>
<script type="text/javascript" src="<?php echo $this->baseUrl('js/dual-mapper.js'); ?>"></script>
<script>
    var GET_PARTICIPANT_URL = "<?php echo $this->url(['module' => 'admin', 'controller' => 'participants', 'action' => 'get-participant']); ?>";
    var GET_DM_NAMES_URL = "<?php echo $this->url(['module' => 'admin', 'controller' => 'participants', 'action' => 'get-datamanager-names']); ?>";

    var MAP_I18N = {
        selectDmRequired: "<?= $this->jsTranslate("Please select PT Login to map the participants"); ?>",
        confirmEmpty: "<?= $this->jsTranslate("No participants are selected. Saving now will remove ALL participant mappings for this PT Login. Continue?"); ?>",
        confirmDiscard: "<?= $this->jsTranslate("You have unsaved changes. Discard them?"); ?>",
        noChanges: "<?= $this->jsTranslate("No unsaved changes"); ?>",
        changes: "<?= $this->jsTranslate("%1 to add, %2 to remove. Not saved yet."); ?>",
        nothingHere: "<?= $this->jsTranslate("No participants here"); ?>",
        noMatch: "<?= $this->jsTranslate("No participants match the search"); ?>",
        uploadFileRequired: "<?= $this->jsTranslate("Please upload the file to process."); ?>",
        bulkTitle: "<?= $this->jsTranslate("Bulk Import Mapping"); ?>",
        upload: "<?= $this->jsTranslate("Upload"); ?>",
        cancel: "<?= $this->jsTranslate("Cancel"); ?>",
        saved: "<?= $this->jsTranslate("Mapping saved"); ?>",
        saveFailed: "<?= $this->jsTranslate("Save failed. Please try again, or contact support if it keeps happening."); ?>",
        networkError: "<?= $this->jsTranslate("Could not reach the server. Check your connection and try again."); ?>",
        sessionExpired: "<?= $this->jsTranslate("Your session has expired. Please log in again and retry."); ?>",
        serverError: "<?= $this->jsTranslate("The server reported an error while saving."); ?>",
        traceIdLabel: "<?= $this->jsTranslate("Reference"); ?>"
    };

    var mapper = null;

    function currentDmId() {
        return $('#alldatamangers').val();
    }

    function getStats(cid) {
        if (!$('#province').length) return;
        $.post("<?php echo $this->url(['module' => 'default', 'controller' => 'common', 'action' => 'get-country-wise-states']); ?>", { cid: cid, format: "html" },
            function(data) {
                if (data != "" && data != undefined) { $('#province').html(data); }
            });
    }

    function getDistricts(pid) {
        if (!$('#district').length) return;
        $.post("<?php echo $this->url(['module' => 'default', 'controller' => 'common', 'action' => 'get-state-wise-districts']); ?>", { pid: pid, format: "html" },
            function(data) {
                if (data != "" && data != undefined) { $('#district').html(data); }
            });
    }

    function getInstitutes() {
        if (!$('#institute').length) return;
        $.post("<?php echo $this->url(['module' => 'default', 'controller' => 'common', 'action' => 'get-state-districts-wise-institute']); ?>", {
                pid: $('#province').val(),
                did: $('#district').val(),
                format: "html"
            },
            function(data) {
                if (data != "" && data != undefined) { $('#institute').html(data); }
            });
    }

    // keepPending is true for filter changes, so narrowing the list never throws
    // away moves the admin has not saved yet.
    function loadParticipants(keepPending) {
        var dmId = currentDmId();
        if (!dmId) {
            $('#mapForm').hide();
            $('#mapperEmpty').show();
            return;
        }
        $('#datamanagerId').val(dmId);
        $.blockUI();
        $.ajax({
            url: GET_PARTICIPANT_URL,
            type: 'POST',
            dataType: 'json',
            data: {
                datamanagerId: dmId,
                country: $('#country').val(),
                province: $('#province').val(),
                district: $('#district').val(),
                network: $('#networkTier').val(),
                affiliation: $('#affiliation').val(),
                institute: $('#institute').val(),
                format: 'html'
            }
        }).done(function(items) {
            $('#mapperEmpty').hide();
            $('#mapForm').show();
            mapper.load(items || [], keepPending !== false);
        }).always(function() {
            $.unblockUI();
        });
    }

    function validateNow() {
        if (!currentDmId()) {
            alert(MAP_I18N.selectDmRequired);
            return;
        }
        var $form = $('#submitParticipantMap');
        $form.find('input[name="allowEmptyMapping"]').remove();
        var selectedIds = mapper.getSelectedIds();
        if (selectedIds.length === 0) {
            if (!confirm(MAP_I18N.confirmEmpty)) return;
            $('<input>').attr({ type: 'hidden', name: 'allowEmptyMapping', value: '1' }).appendTo($form);
        }
        $('#selectedForMapping').val(JSON.stringify(selectedIds));
        saveMappingAjax();
    }

    function saveMappingAjax() {
        var form = document.getElementById('submitParticipantMap');
        $.blockUI();
        $.ajax({
            url: form.action,
            type: 'POST',
            data: new FormData(form),
            processData: false,
            contentType: false,
            dataType: 'json',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        }).done(function(resp) {
            $.unblockUI();
            if (resp && resp.success) {
                showMappingFlash(resp.message || MAP_I18N.saved, 'success');
                loadParticipants(false);
            } else {
                var msg = (resp && resp.message) ? resp.message : MAP_I18N.saveFailed;
                if (resp && resp.trace_id) {
                    msg += ' (' + MAP_I18N.traceIdLabel + ': ' + resp.trace_id + ')';
                }
                showMappingFlash(msg, 'danger');
            }
        }).fail(function(xhr) {
            $.unblockUI();
            showMappingFlash(humanizeAjaxFailure(xhr), 'danger');
        });
    }

    function humanizeAjaxFailure(xhr) {
        if (!xhr || xhr.status === 0) return MAP_I18N.networkError;
        if (xhr.status === 401 || xhr.status === 403) return MAP_I18N.sessionExpired;
        if (xhr.responseJSON && xhr.responseJSON.message) {
            var msg = xhr.responseJSON.message;
            if (xhr.responseJSON.trace_id) {
                msg += ' (' + MAP_I18N.traceIdLabel + ': ' + xhr.responseJSON.trace_id + ')';
            }
            return msg;
        }
        return MAP_I18N.serverError + ' (HTTP ' + xhr.status + ')';
    }

    function showMappingFlash(msg, level) {
        var $flash = $('#mappingFlash');
        if ($flash.length === 0) {
            $flash = $('<div id="mappingFlash" class="alert" style="margin:14px 0 0;"></div>').insertBefore('#mapForm .mapper-dual');
        }
        $flash.removeClass('alert-success alert-danger').addClass(level === 'danger' ? 'alert-danger' : 'alert-success').text(msg).show();
        clearTimeout(showMappingFlash._t);
        // Errors stay visible longer so the user can read the trace id
        showMappingFlash._t = setTimeout(function() { $flash.fadeOut(300); }, level === 'danger' ? 10000 : 3500);
    }

    function discardChanges() {
        if (mapper.isDirty() && !confirm(MAP_I18N.confirmDiscard)) return;
        loadParticipants(false);
    }

    function closeMapper() {
        if (mapper.isDirty() && !confirm(MAP_I18N.confirmDiscard)) return;
        if (window.parent && window.parent.closeLayoutModal) {
            window.parent.closeLayoutModal();
        } else {
            window.close();
        }
    }

    function openBulkImport() {
        bootbox.dialog({
            title: MAP_I18N.bulkTitle,
            message: $('#bulkImportTpl').html(),
            buttons: {
                cancel: { label: MAP_I18N.cancel, className: 'btn-default' },
                upload: {
                    label: MAP_I18N.upload,
                    className: 'btn-primary',
                    callback: function() {
                        if (!$('#bulkMap').val()) {
                            alert(MAP_I18N.uploadFileRequired);
                            return false;
                        }
                        $.blockUI();
                        // The dialog's form did not exist at page load, and submit() skips
                        // the submit handler that adds the token, so add it here.
                        addCsrfTokenToForm($('#bulkMapForm'));
                        document.getElementById('bulkMapForm').submit();
                    }
                }
            }
        });
    }

    function generateParticipantMapExport() {
        $.blockUI();
        $.post("<?php echo $this->url(['module' => 'admin', 'controller' => 'participants', 'action' => 'export-participants-map']); ?>", { format: "html" },
            function(data) {
                if (data != "") {
                    document.location.href = '/temporary/' + data;
                }
                $.unblockUI();
            });
    }

    function updateMoreFiltersCount() {
        var n = $('.more-filter').filter(function() { return !!$(this).val(); }).length;
        $('#moreFiltersCount').text(n).toggle(n > 0);
    }

    function updateSaveBar(c) {
        var dirty = c.add + c.remove > 0;
        $('#mapperSummary').toggleClass('is-dirty', dirty)
            .text(dirty ? MAP_I18N.changes.replace('%1', c.add).replace('%2', c.remove) : MAP_I18N.noChanges);
        $('#mapperSave, #mapperDiscard').prop('disabled', !dirty);
    }

    $(window).on('beforeunload', function() {
        if (mapper && mapper.isDirty()) return MAP_I18N.confirmDiscard;
    });

    $(document).ready(function() {
        $('#country').select2({ allowClear: true, placeholder: "<?= $this->jsTranslate("All countries"); ?>" });
        $('#province').select2({ allowClear: true, placeholder: "<?= $this->jsTranslate("All provinces"); ?>" });
        $('#district').select2({ allowClear: true, placeholder: "<?= $this->jsTranslate("All districts"); ?>" });
        $('#institute').select2({ allowClear: true, placeholder: "<?= $this->jsTranslate("All institutes"); ?>" });
        $('#networkTier').select2({ allowClear: true, placeholder: "<?= $this->jsTranslate("All network tiers"); ?>" });
        $('#affiliation').select2({ allowClear: true, placeholder: "<?= $this->jsTranslate("All affiliations"); ?>" });
        $('.more-filter').on('change', updateMoreFiltersCount);

        $('#moreFiltersBtn').on('click', function() {
            var open = $('#moreFilters').toggleClass('is-open').hasClass('is-open');
            $(this).toggleClass('is-open', open).attr('aria-expanded', open ? 'true' : 'false');
        });

        <?php if (!$isModal) { ?>
        $('#alldatamangers').select2({
            placeholder: "<?= $this->jsTranslate("Type a name or email to search"); ?>",
            allowClear: true,
            minimumInputLength: 1,
            ajax: {
                url: GET_DM_NAMES_URL,
                dataType: 'json',
                delay: 250,
                data: function(params) { return { search: (params && params.term) ? params.term : '' }; },
                processResults: function(data) { return { results: (data && data.result) ? data.result : [] }; },
                cache: true
            }
        }).on('select2:selecting select2:unselecting', function(e) {
            // Switching data manager reloads both lists, so ask before unsaved moves are lost.
            if (mapper.isDirty() && !confirm(MAP_I18N.confirmDiscard)) {
                e.preventDefault();
            }
        }).on('change', function() {
            loadParticipants(false);
        });
        <?php } ?>

        mapper = DualMapper.create('#mapForm', {
            nothingHere: MAP_I18N.nothingHere,
            noMatch: MAP_I18N.noMatch,
            onChange: updateSaveBar
        });

        <?php if (!empty($this->preselectedDmId)) { ?>
            loadParticipants(false);
        <?php } ?>
    });
</script>
