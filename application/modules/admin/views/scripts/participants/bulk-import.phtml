<script type="text/javascript">
    // No async duplicate-id check on this page (unlike add/edit), so it never blocks submit.
    var duplicated = false;

    var biBlockMessage = <?= json_encode(
        '<div style="padding:10px 6px;">'
        . '<div class="bi-spinner" style="width:38px;height:38px;margin:0 auto 14px;border:4px solid #e6e9ee;border-top-color:#337ab7;border-radius:50%;animation:bi-spin 0.8s linear infinite;"></div>'
        . '<h4 style="margin:0 0 6px;font-weight:600;">' . $this->htmlTranslate("Checking your participant file…") . '</h4>'
        . '<div style="color:#8a93a0;font-size:13px;line-height:1.5;">' . $this->htmlTranslate("Nothing is saved yet. This can take up to a minute for larger files.") . '<br>' . $this->htmlTranslate("Please keep this window open — do not refresh or close it.") . '</div>'
        . '</div>'
    ); ?>;

    function validateNow() {
        $(".bootstrap-select").removeClass('isRequired');
        var flag = deforayValidator.init({ formId: 'bulkParticipantForm' });
        if (flag && !duplicated) {
            var $btn = $('#biImportBtn');
            $btn.prop('disabled', true).html('<i class="icon-refresh"></i> <?= $this->jsTranslate("Checking…"); ?>');
            $.blockUI({
                message: biBlockMessage,
                css: {
                    border: 'none',
                    padding: '20px 26px',
                    borderRadius: '8px',
                    backgroundColor: '#fff',
                    color: '#333',
                    width: '340px',
                    left: '50%',
                    marginLeft: '-170px',
                    boxShadow: '0 4px 18px rgba(0,0,0,0.18)'
                },
                overlayCSS: { backgroundColor: '#000', opacity: 0.45 }
            });
            document.getElementById('bulkParticipantForm').submit();
        }
    }

    // resetPassword mirrors the old dropdown: the checkbox decides it in "Update all
    // details"; every other mode sends "yes" so new participants get a password.
    function syncImportChoices() {
        $('.bi-choice, .bi-switch label').each(function() {
            $(this).toggleClass('selected', $(this).find('input[type=radio]').is(':checked'));
        });
        var mode = $('input[name=bulkUploadDuplicateSkip]:checked').val();
        if (mode === 'update-on-unique-id-match') {
            $('#resetPassword').val($('#resetPasswordToggle').is(':checked') ? 'yes' : 'no');
        } else {
            $('#resetPassword').val('yes');
        }
    }

    function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1024 / 1024).toFixed(2) + ' MB';
    }

    $(document).ready(function() {
        $('input[name=bulkUploadDuplicateSkip], input[name=bulkUploadAllowEmailRepeat], #resetPasswordToggle').on('change', syncImportChoices);
        syncImportChoices();

        var $drop = $('#biDrop');
        var $input = $('#fileName');
        var $card = $('#biFileCard');
        var $name = $('#biFileName');
        var $size = $('#biFileSize');

        function showFile(file) {
            if (!file) {
                $card.removeClass('active');
                $drop.show();
                return;
            }
            $name.text(file.name);
            $size.text(formatBytes(file.size));
            $card.addClass('active');
            $drop.hide();
        }

        $input.on('change', function() {
            showFile(this.files && this.files[0]);
        });

        $('#biReplace').on('click', function(e) {
            e.preventDefault();
            $input.trigger('click');
        });

        $('#biRemove').on('click', function(e) {
            e.preventDefault();
            $input.val('');
            showFile(null);
        });

        $drop.on('dragover dragenter', function(e) {
            e.preventDefault(); e.stopPropagation();
            $(this).addClass('dragover');
        }).on('dragleave dragend drop', function(e) {
            e.preventDefault(); e.stopPropagation();
            $(this).removeClass('dragover');
        }).on('drop', function(e) {
            var files = e.originalEvent.dataTransfer && e.originalEvent.dataTransfer.files;
            if (files && files.length) {
                $input[0].files = files;
                showFile(files[0]);
            }
        });
    });
</script>
