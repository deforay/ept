<script type="text/javascript" src="<?php echo $this->baseUrl("assets/plugins/datatables/jquery.dataTables.min.js"); ?>"></script>
<script type="text/javascript" charset="utf-8">
    $(document).ready(function() {
        // Tiles filter the table by each row's data-status ('' = everything).
        var statusFilter = '';
        $.fn.dataTableExt.afnFiltering.push(function(oSettings, aData, iDataIndex) {
            if (oSettings.nTable.id !== 'reviewTable' || statusFilter === '') {
                return true;
            }
            var tr = oSettings.aoData[iDataIndex].nTr;
            return (' ' + tr.getAttribute('data-status') + ' ').indexOf(' ' + statusFilter + ' ') !== -1;
        });

        var $table = $('#reviewTable');
        var oTable = $table.length ? $table.dataTable({ "order": [[0, "asc"]], "iDisplayLength": 25 }) : null;

        $('.bi-tile').on('click', function() {
            statusFilter = $(this).data('filter') || '';
            $('.bi-tile').removeClass('selected');
            $(this).addClass('selected');
            if (oTable) {
                oTable.fnDraw();
            }
        });

        var blockMessage = <?= json_encode(
            '<div style="padding:10px 6px;">'
            . '<div style="width:38px;height:38px;margin:0 auto 14px;border:4px solid #e6e9ee;border-top-color:#337ab7;border-radius:50%;animation:bi-spin 0.8s linear infinite;"></div>'
            . '<h4 style="margin:0 0 6px;font-weight:600;">' . $this->htmlTranslate("Importing…") . '</h4>'
            . '<div style="color:#8a93a0;font-size:13px;line-height:1.5;">' . $this->htmlTranslate("Please keep this window open — do not refresh or close it.") . '</div>'
            . '</div>'
        ); ?>;

        $('#biConfirmForm').on('submit', function() {
            $('#biConfirmBtn').prop('disabled', true);
            $.blockUI({
                message: blockMessage,
                css: { border: 'none', padding: '20px 26px', borderRadius: '8px', backgroundColor: '#fff', color: '#333', width: '340px', left: '50%', marginLeft: '-170px' },
                overlayCSS: { backgroundColor: '#000', opacity: 0.45 }
            });
        });
    });
</script>
