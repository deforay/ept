<script>
	var duplicated = false;

	function checkDuplicate(tableName, fieldName, obj, fnct, msg) {
		if (obj.val() == "" || obj.val() == null) {
			return;
		}
		$.post("<?php echo $this->url(array('module' => 'default', 'controller' => 'common', 'action' => 'check-duplicate')); ?>", {
				tableName: tableName,
				fieldName: fieldName,
				value: obj.val(),
				fnct: fnct,
				format: "html"
			},
			function(data) {
				if (data > 0) {
					alert(msg, "err");
					duplicated = true;
					$(obj).val('');
				} else {
					duplicated = false;
				}
			});
	}


	<?php
	$vHelper = $this->getHelper('DateFormat');
	?>
	$(document).ready(function() {
		$(".datepicker").datepicker({
			dateFormat: '<?php echo $dtFormat; ?>'
		});

		// Response deadline: single date + time picker (exact close time).
		if ($('#lastDate').length && $.fn.daterangepicker) {
			$('#lastDate').daterangepicker({
				singleDatePicker: true,
				timePicker: true,
				timePicker24Hour: true,
				autoUpdateInput: false,
				startDate: ($('#lastDate').val() ? moment($('#lastDate').val(), 'DD-MMM-YYYY HH:mm') : moment().hour(23).minute(59).second(0)),
				locale: { format: 'DD-MMM-YYYY HH:mm', cancelLabel: 'Clear' }
			});
			$('#lastDate').on('apply.daterangepicker', function(ev, picker) {
				$(this).val(picker.startDate.format('DD-MMM-YYYY HH:mm'));
			});
			$('#lastDate').on('cancel.daterangepicker', function() {
				$(this).val('');
			});
		}

		$('#shipmentCode').on('input', function(event) {
			allowOnlyAlphaNumericAndHyphen('#shipmentCode');
		});
		$("body").on("change", 'select.controlOrNot', function() {
			var scoreElem = $(this).parent().parent().find('.score');
			if ($(this).val() == 1) {
				$(scoreElem).val(0);
				$(scoreElem).attr('readonly', 'readonly');
			} else {
				$(scoreElem).removeAttr('readonly');
			}

		});

		$('#captureAdditionalDetails').on("change", function() {
			if ($(this).val() == 'yes') {
				$("#additionalDetailLabel").attr("disabled", false);
				$("#additionalDetailLabel").addClass("isRequired");
			} else {
				$("#additionalDetailLabel").attr("disabled", true);
				$("#additionalDetailLabel").removeClass("isRequired");
			}

		});
	});



	function submitShipmentForm() {
		$.blockUI();
		document.getElementById('shipmentForm').submit();
	}

	function validateNow() {
		allowOnlyAlphaNumericAndHyphen('#shipmentCode');
		//checkDuplicate('shipment', 'shipment_code', $("#shipmentCode"), '<?php echo "shipment_id##" . $shipmentData['shipment']['shipment_id']; ?>', 'This Code already exists for another Shipment. Please try something else.')
		flag = deforayValidator.init({
			formId: 'shipmentForm'
		});
		if (!flag || duplicated) {
			return;
		}

		// Cloning creates a brand-new shipment, so the source's response-window state
		// is irrelevant — skip the re-open confirm entirely.
		if (<?php echo $cloneMode ? 'true' : 'false'; ?>) {
			submitShipmentForm();
			return;
		}

		// If the response window is currently closed (switch off) and the admin has
		// pushed the deadline out, re-opening must be confirmed first. A still-open
		// shipment, a finalized one, or a deadline that isn't extended just saves.
		var currentSwitch = '<?php echo $currentSwitch; ?>';
		var currentStatus = '<?php echo $currentStatus; ?>';
		var fmt = 'DD-MMM-YYYY HH:mm';
		var originalDeadline = '<?php echo $this->escape($deadlineDisplay); ?>';
		var newDeadline = $('#lastDate').val();
		var extendsDeadline = newDeadline && (!originalDeadline ||
			moment(newDeadline, fmt).isAfter(moment(originalDeadline, fmt)));

		if (currentSwitch === 'off' && currentStatus !== 'finalized' && extendsDeadline) {
			bootbox.confirm(
				"This shipment's response window is currently <strong>closed</strong>. " +
				"Extending the deadline to <strong>" + newDeadline + "</strong> will re-open it so " +
				"participants can submit responses until the new deadline.<br><br>Re-open and save?",
				function(result) {
					if (result) {
						$('#reopenResponseSwitch').val('yes');
						submitShipmentForm();
					}
				}
			);
			return;
		}

		submitShipmentForm();
	}
</script>

<?php if ($cloneMode): ?>
	<script>
		// "Add New PT Survey" modal on the clone screen. Same behaviour as the full
		// /admin/distributions/add page, but the date-clash warning is shown INLINE
		// inside this modal (a warning panel in the body) rather than as a second
		// bootbox popup - stacking a modal on top of a modal is fragile on this page,
		// which already juggles conflicting Bootstrap modal/backdrop z-indexes.
		$(function () {
			var takenDates = [<?php echo '"' . implode('","', array_map('addslashes', (array) $this->distributionDates)) . '"'; ?>];
			var autoGenerateCode = <?php echo (isset($this->autogeneratePtCode) && $this->autogeneratePtCode == 'yes') ? 'true' : 'false'; ?>;
			var conflictIntro = "<?= $this->jsTranslate("There is already another PT Survey on this date. You can still save, but here is what it clashes with:"); ?>";
			var conflictIntroMany = "<?= $this->jsTranslate("There are already %s other PT Surveys on this date. You can still save, but here is what it clashes with:"); ?>";
			var conflictSelectedDate = "<?= $this->jsTranslate("Selected date:"); ?>";
			var conflictNoShipments = "<?= $this->jsTranslate("No shipments have been added to that PT Survey yet."); ?>";
			var createFailedMsg = "<?= $this->jsTranslate("Could not create the PT Survey. Please try again."); ?>";
			var missingFieldsMsg = "<?= $this->jsTranslate("Please provide a PT Survey date and code."); ?>";

			function esc(str) {
				return $('<div/>').text(str == null ? '' : str).html();
			}

			function renderConflict(ptDate, surveys) {
				var $box = $('#quickPtConflict');
				if (!surveys || !surveys.length) {
					$box.hide().empty();
					return;
				}
				var intro = surveys.length > 1 ? conflictIntroMany.replace('%s', surveys.length) : conflictIntro;
				var html = '<p>' + conflictSelectedDate + ' <strong>' + esc(ptDate) + '</strong></p>';
				html += '<p>' + intro + '</p>';
				surveys.forEach(function (survey) {
					html += '<p style="margin-bottom:2px;"><strong>' + esc(survey.distribution_code) + '</strong></p>';
					if (survey.shipments && survey.shipments.length) {
						html += '<ul>';
						survey.shipments.forEach(function (shipment) {
							var line = esc(shipment.shipment_code);
							if (shipment.scheme_name) {
								line += ' – ' + esc(shipment.scheme_name);
							}
							html += '<li>' + line + '</li>';
						});
						html += '</ul>';
					} else {
						html += '<p><em>' + conflictNoShipments + '</em></p>';
					}
				});
				$box.html(html).show();
			}

			function checkConflict(ptDate) {
				if (!ptDate) {
					$('#quickPtConflict').hide().empty();
					return;
				}
				$.post("<?php echo $this->url(array('module' => 'admin', 'controller' => 'distributions', 'action' => 'date-conflict')); ?>", {
					distributionDate: ptDate,
					format: "html"
				}, function (data) {
					var surveys = data;
					if (typeof data === 'string') {
						try {
							surveys = JSON.parse(data);
						} catch (e) {
							return;
						}
					}
					renderConflict(ptDate, surveys);
				});
			}

			function generateCode(ptDate) {
				if (!autoGenerateCode || !ptDate) {
					return;
				}
				$.post("<?php echo $this->url(array('module' => 'admin', 'controller' => 'distributions', 'action' => 'generate-survey-code')); ?>", {
					ptDate: ptDate,
					format: "html"
				}, function (data) {
					if (data) {
						$('#quickPtCode').val($.trim(data));
					}
				});
			}

			var $modal = $('#quickAddPtSurveyModal');

			// This page loads the jschr bootstrap-modal + modalmanager plugin, which
			// physically moves the modal (and #quickPtDate with it) into a scroll
			// container on every open and back again on every close. A jQuery UI
			// datepicker bound to an input that gets reparented like that goes dead -
			// stale _lastInput/_curInst pointers mean _showDatepicker() silently
			// no-ops on the second open. So build the picker fresh once the modal has
			// settled in place ('shown') and tear it down before it moves back
			// ('hide'). Note: this plugin fires un-namespaced show/shown/hide/hidden.
			function buildDatepicker() {
				destroyDatepicker();
				$('#quickPtDate').datepicker({
					dateFormat: '<?php echo $dtFormat; ?>',
					beforeShowDay: function (date) {
						var string = jQuery.datepicker.formatDate('dd-M-yy', date);
						return [true, takenDates.indexOf(string) === -1 ? '' : 'pt-date-taken'];
					},
					onSelect: function (dateText) {
						checkConflict(dateText);
						generateCode(dateText);
					}
				});
			}

			function destroyDatepicker() {
				if ($('#quickPtDate').hasClass('hasDatepicker')) {
					try {
						$('#quickPtDate').datepicker('hide').datepicker('destroy');
					} catch (e) {}
				}
				try {
					$.datepicker._lastInput = null;
					$.datepicker._curInst = null;
				} catch (e) {}
			}

			$('#quickPtCode').on('input', function () {
				allowOnlyAlphaNumericAndHyphen('#quickPtCode');
			});

			$('#openQuickAddPtSurvey').on('click', function () {
				$modal.modal('show');
				// Safety net in case the plugin's 'shown' event does not fire.
				setTimeout(function () {
					if (!$('#quickPtDate').hasClass('hasDatepicker')) {
						buildDatepicker();
					}
				}, 400);
			});

			$modal.on('show', function () {
				$('#quickPtDate').val('');
				$('#quickPtCode').val('');
				$('#quickPtConflict').hide().empty();
				$('#quickPtError').hide().empty();
			});

			// Modal has finished moving into place - safe to attach the picker.
			$modal.on('shown', function () {
				buildDatepicker();
			});

			// Fires before the plugin moves the modal back out - detach first.
			$modal.on('hide', function () {
				destroyDatepicker();
			});

			$('#quickPtSave').on('click', function () {
				var date = $.trim($('#quickPtDate').val());
				var code = $.trim($('#quickPtCode').val());
				$('#quickPtError').hide().empty();
				if (!date || !code) {
					$('#quickPtError').text(missingFieldsMsg).show();
					return;
				}
				var $btn = $(this).prop('disabled', true);
				$.post("<?php echo $this->url(array('module' => 'admin', 'controller' => 'distributions', 'action' => 'quick-add')); ?>", {
					distributionDate: date,
					distributionCode: code,
					format: "html"
				}, function (data) {
					var res = data;
					if (typeof data === 'string') {
						try {
							res = JSON.parse(data);
						} catch (e) {
							res = { success: false, message: createFailedMsg };
						}
					}
					if (res && res.success) {
						var label = res.distribution_code + '   (' + res.distribution_date + ')';
						$('#distribution')
							.append($('<option>', { value: res.distribution_id, text: label }))
							.val(res.distribution_id)
							.trigger('change');
						var pickedDate = $('#quickPtDate').datepicker('getDate');
						if (pickedDate) {
							takenDates.push(jQuery.datepicker.formatDate('dd-M-yy', pickedDate));
						}
						$modal.modal('hide');
					} else {
						$('#quickPtError').text((res && res.message) || createFailedMsg).show();
					}
				}).fail(function () {
					$('#quickPtError').text(createFailedMsg).show();
				}).always(function () {
					$btn.prop('disabled', false);
				});
			});
		});
	</script>
<?php endif; ?>