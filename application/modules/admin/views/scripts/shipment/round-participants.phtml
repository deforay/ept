<script type="text/javascript" src="<?php echo $this->baseUrl('js/select2.min.js'); ?>"></script>
<script type="text/javascript" charset="utf-8">
	/* Table initialisation */
    var oTable = null;
    $(document).ready(function() {
        oTable = $('#labList').dataTable({

            "bJQueryUI": false,
            "bAutoWidth": false,
            "bInfo": true,
            "bScrollCollapse": true,
            "sPaginationType": "bootstrap",
            "bRetrieve": true,
            "bSortCellsTop": true,
            "aoColumns": [
                null, null, null, null, null, null, null
            ],
            "aaSorting": [
                [0, "asc"]
            ],
            "bProcessing": true,
            "bServerSide": true,
            "sAjaxSource": "<?php echo $this->url(array(
				'module' => 'admin',
				'controller' => 'shipment',
				'action' => 'round-participants',
				'id' => $this->shipment['shipmentId'],
				'status' => $this->status,
				'format' => 'html'
			), 'default', true); ?>",
			"fnServerParams": function(aoData) {
				labName = $("#labId").val();
				country = $("#country").val();
				aoData.push({ "name": "pid", "value": labName });
				aoData.push({ "name": "country", "value": country });
				aoData.push({ "name": "pstatus", "value": $("#pstatus").val() || "" });
				// no mappingFilter here — that's a participants.phtml-only concept
			},
            "fnServerData": function(sSource, aoData, fnCallback) {
                $.ajax({
                    "dataType": 'json',
                    "type": "POST",
                    "url": sSource,
                    "data": aoData,
                    "success": fnCallback
                });
            }
        });

        bindColSearch('#labList', function(value, colIdx) {
            oTable.fnFilter(value, colIdx);
        });

		$("#country").select2({
            placeholder: "<?= $this->jsTranslate("Choose one or more Countries"); ?>",
            minimumInputLength: 3,
            width: '100%',
            allowClear: true,
            ajax: {
                placeholder: "<?= $this->jsTranslate("Type Country name to search"); ?>",
                url: "<?php echo $this->url(array('module' => 'default', 'controller' => 'common', 'action' => 'get-all-countries')); ?>",
                dataType: 'json',
                delay: 250,
                data: function(params) {
                    return {
                        search: params.term, // search term
                        page: params.page
                    };
                },
                processResults: function(data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.result,
                        pagination: {
                            more: (params.page * 30) < data.total_count
                        }
                    };
                },
                //cache: true
            },
            escapeMarkup: function(markup) {
                return markup;
            }
        });

        $("#labId").select2({
            placeholder: "<?= $this->jsTranslate("Choose one or more option(s)"); ?>",
            minimumInputLength: 3,
            width: '100%',
            allowClear: true,
            id: function(bond) {
                return bond._id;
            },
            ajax: {
                placeholder: "<?= $this->jsTranslate("Type list to search"); ?>",
                url: "<?php echo $this->url(array('module' => 'reports', 'controller' => 'common', 'action' => 'get-ajax-drop-downs')); ?>",
                dataType: 'json',
                delay: 250,
                data: function(params) {
                    return {
                        tableName: 'participant',
                        returnId: 'institute_name',
                        fieldNames: 'institute_name',
                        concat: 'institute_name',
                        search: params.term, // search term
                        page: params.page
                    };
                },
                processResults: function(data, params) {
                    params.page = params.page || 1;
                    return {
                        results: data.result,
                        pagination: {
                            more: (params.page * 30) < data.total_count
                        }
                    };
                },
                //cache: true
            },
            escapeMarkup: function(markup) {
                return markup;
            }
        });
	});

	 function getDrawable() {
        $.blockUI();
        oTable.fnDraw();
        $.unblockUI();
    }
</script>