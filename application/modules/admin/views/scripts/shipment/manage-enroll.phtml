    /**
     * Fetch unique, deliverable participant + data manager emails for the
     * requested audience and copy them to the clipboard as one merged,
     * de-duplicated list.
     * @param {string} scope - 'enrolled', 'not-responded', 'not-enrolled' or
     *                         'ptcc' (MTBEPT only; PTCC logins mapped to the
     *                         enrolled participants, no participant emails)
     */
    function copyShipmentEmails(scope) {
        $.blockUI(); // Show loading overlay

        $.post("<?php echo $this->url(array('module' => 'admin', 'controller' => 'shipment', 'action' => 'manage-enroll-emails')); ?>", {
            shipmentId: "<?php echo $this->shipmentId; ?>",
            scope: scope
        },
            function (data) {
                $.unblockUI(); // Hide loading overlay

                var participantEmails = data.participantEmails || [];
                var dataManagerEmails = data.dataManagerEmails || [];

                // Merge the two lists, de-duplicating case-insensitively
                var seen = {};
                var emails = [];
                $.each(participantEmails.concat(dataManagerEmails), function (i, email) {
                    var key = email.toLowerCase();
                    if (!seen[key]) {
                        seen[key] = true;
                        emails.push(email);
                    }
                });

                if (emails.length === 0) {
                    alert("<?= $this->translate->_("No valid email addresses found for this selection"); ?>");
                    return;
                }

                copyTextToClipboard(emails.join(", "), function (copied) {
                    if (copied) {
                        var summary = emails.length + " <?= $this->translate->_("unique email address(es) copied to clipboard"); ?>";
                        if (scope === 'ptcc') {
                            summary += " (<?= $this->translate->_("PTCC"); ?>)";
                        } else {
                            summary += " (" + participantEmails.length + " <?= $this->translate->_("participant"); ?>, " +
                                dataManagerEmails.length + " <?= $this->translate->_("data manager"); ?>)";
                        }
                        alert(summary);
                    } else {
                        // Clipboard access denied - let the user copy manually
                        window.prompt("<?= $this->translate->_("Press Ctrl+C / Cmd+C to copy"); ?>", emails.join(", "));
                    }
                });
            }, "json")
            .fail(function () {
                $.unblockUI();
                alert("<?= $this->translate->_("Unable to fetch email addresses. Please try again later or contact system admin for help"); ?>");
            });
    }

    /**
     * Copy text to clipboard using the async Clipboard API when available,
     * falling back to a hidden textarea + execCommand for HTTP contexts.
     * @param {string} text - Text to copy
     * @param {function} done - Callback receiving true/false for success
     */
    function copyTextToClipboard(text, done) {
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(
                function () { done(true); },
                function () { done(legacyCopyToClipboard(text)); }
            );
        } else {
            done(legacyCopyToClipboard(text));
        }
    }

    function legacyCopyToClipboard(text) {
        var textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.focus();
        textarea.select();
        var copied = false;
        try {
            copied = document.execCommand('copy');
        } catch (err) {
            copied = false;
        }
        document.body.removeChild(textarea);
        return copied;
    }
</script>