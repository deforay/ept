    <script type="text/javascript">
        $(function () {
            var feedbackQuestionCount = <?php echo $feedbackQuestionCount; ?>;

            // Keep both halves of the setting visible: the form status while feedback is
            // on, and the "form exists but is switched off" warning while it is not.
            function syncFeedbackRows() {
                var isOn = $('#collectFeedBack').val() === 'yes';
                $('#feedbackFormStatusRow').toggleClass('hide', !isOn);
                $('#feedbackFormOffRow').toggleClass('hide', isOn);
            }

            $('#collectFeedBack').on('change', function () {
                // Switching off is not destructive, but it does hide a form somebody
                // built — make that an explicit choice rather than a silent one.
                if ($(this).val() !== 'yes' && feedbackQuestionCount > 0) {
                    var proceed = confirm(
                        "<?= $this->jsTranslate("This shipment has a feedback form. Turning Collect Feedback off means participants will never see it."); ?>\n\n"
                        + "<?= $this->jsTranslate("The form itself is kept, so you can switch this back on later. Continue?"); ?>"
                    );
                    if (!proceed) {
                        $(this).val('yes');
                    }
                }
                syncFeedbackRows();
            });

            syncFeedbackRows();
        });
    </script>
<?php } ?>
