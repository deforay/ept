    $(document).ready(function() {
        $(".datepicker").datepicker({
            dateFormat: '<?php echo $dtFormat; ?>'
        });

        // Interpreted result mirror: the single MTB Detected / Rif Resistance
        // select drives the hidden *Ultra field so both DB columns are saved.
        // Delegated so dynamically added sample cards are covered too.
        $(document).on('change', '.tb-mirror-src', function() {
            var target = $(this).data('mirror');
            if (target) {
                $('#' + target).val(this.value);
            }
        });
        // Initialise the hidden mirrors from the current select values on load.
        $('.tb-mirror-src').each(function() {
            var target = $(this).data('mirror');
            if (target) {
                $('#' + target).val(this.value);
            }
        });
    });

    function removeRow(obj) {
        $(obj.parentNode.parentNode).fadeOut("normal", function() {
            $(this).remove();
        });
    }
