<?php
$mappedParticipants = $this->mappedParticipants ?? [];
$pCount = count($mappedParticipants);
// Rows past this count stay folded until "Show all" is clicked or the filter is used
$visibleLimit = 10;
?>
<div class="participant-child-row<?= $pCount > $visibleLimit ? ' is-collapsed' : ''; ?>">
    <?php if ($pCount === 0) { ?>
        <em class="text-muted"><?= $this->translate->_('No participants are currently mapped to this data manager.'); ?></em>
    <?php } else { ?>
        <div class="child-row-header">
            <i class="icon-user"></i>
            <span><?= $pCount === 1 ? $this->translate->_('1 participant') : sprintf($this->translate->_('%d participants'), $pCount); ?></span>
            <?php if ($pCount > 5) { ?>
                <input type="text" class="form-control input-sm participant-filter-input" placeholder="<?= $this->htmlTranslate('Filter by ID, name, institute or email…'); ?>" />
            <?php } ?>
        </div>
        <div class="participant-list-wrap">
            <table class="table table-condensed child-list">
                <thead>
                    <tr>
                        <th scope="col"><?= $this->translate->_('Participant ID'); ?></th>
                        <th scope="col"><?= $this->translate->_('Lab Name/Participant Name'); ?></th>
                        <th scope="col"><?= $this->translate->_('Contact'); ?></th>
                        <th scope="col"><?= $this->translate->_('Country'); ?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($mappedParticipants as $i => $p) {
                        $contactName = trim(($p['first_name'] ?? '') . ' ' . ($p['last_name'] ?? ''));
                        $isActive = strtolower($p['status'] ?? '') === 'active';
                        $editUrl = '/admin/participants/edit/id/' . (int)$p['participant_id'];
                        $searchBlob = strtolower(
                            ($p['unique_identifier'] ?? '') . ' '
                            . $contactName . ' '
                            . ($p['institute_name'] ?? '') . ' '
                            . ($p['email'] ?? '')
                        );
                        $rowClass = 'participant-row' . ($isActive ? '' : ' is-inactive') . ($i >= $visibleLimit ? ' is-overflow' : '');
                    ?>
                        <tr class="<?= $rowClass; ?>" data-p-search="<?= htmlspecialchars($searchBlob, ENT_QUOTES, 'UTF-8'); ?>">
                            <td class="is-numeric"><?= htmlspecialchars($p['unique_identifier'] ?? '', ENT_QUOTES, 'UTF-8'); ?></td>
                            <td>
                                <a href="<?= $editUrl; ?>" class="child-list-name" title="<?= $this->htmlTranslate('Edit participant'); ?>"><?= htmlspecialchars($p['institute_name'] ?? '', ENT_QUOTES, 'UTF-8', false); ?></a>
                                <?php if (!$isActive) { ?>
                                    <span class="list-status-badge"><?= $this->translate->_(ucwords($p['status'] ?? '')); ?></span>
                                <?php } ?>
                            </td>
                            <td>
                                <?= htmlspecialchars($p['email'] ?? '', ENT_QUOTES, 'UTF-8', false); ?>
                                <?php if ($contactName !== '') { ?>
                                    <span class="list-cell-sub"><?= htmlspecialchars($contactName, ENT_QUOTES, 'UTF-8', false); ?></span>
                                <?php } ?>
                            </td>
                            <td><?= htmlspecialchars($p['iso_name'] ?? '', ENT_QUOTES, 'UTF-8'); ?></td>
                        </tr>
                    <?php } ?>
                </tbody>
            </table>
            <?php if ($pCount > $visibleLimit) { ?>
                <a href="javascript:void(0);" class="child-list-more"><?= sprintf($this->translate->_('Show all %d'), $pCount); ?></a>
            <?php } ?>
        </div>
    <?php } ?>
</div>
