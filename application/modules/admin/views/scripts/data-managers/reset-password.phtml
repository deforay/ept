            <?= $this->translate->_('Cancel'); ?>
        </button>
        <button type="button" id="primaryActionBtn" class="btn btn-primary" onclick="submitReset();">
            <i class="icon-key"></i> <span id="primaryActionLabel"><?= $this->translate->_('Reset & Copy password'); ?></span>
        </button>
    </div>
</form>

<script src="<?php echo $this->baseUrl('js/toastify-js.js'); ?>"></script>
<script type="text/javascript" src="<?php echo $this->baseUrl("js/deforayValidation.js"); ?>"></script>
<?php require_once WEB_ROOT . '/js/main.js.php'; ?>
<script type="text/javascript">
    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    var PASS_MIN = <?= $passLen; ?>;

    function getMode() {
        return $('#resetMode').val() || 'email';
    }

    function setMode(mode) {
        $('#resetMode').val(mode);
        $('.mode-card').removeClass('is-selected');
        $('.mode-card[data-mode="' + mode + '"]').addClass('is-selected').find('input').prop('checked', true);
        $('#recipientsBlock').toggleClass('is-open', mode === 'email');
        fitModal();

        var icon = 'icon-key';
        var label = "<?= $this->jsTranslate('Reset & Copy password'); ?>";
        if (mode === 'email') {
            icon = 'icon-envelope';
            label = "<?= $this->jsTranslate('Reset & Email to user'); ?>";
        } else if (mode === 'copy_email') {
            icon = 'icon-copy';
            label = "<?= $this->jsTranslate('Reset & Copy login message'); ?>";
        }
        $('#primaryActionBtn i').attr('class', icon);
        $('#primaryActionLabel').text(label);
    }

    // The modal opens at a fixed size. Fit it to the panel instead, within the
    // browser window, whenever the content changes height.
    function fitModal() {
        try {
            var frame = window.frameElement;
            var box = window.parent.document.getElementById('mbox');
            if (!frame || !box) {
                return;
            }
            var form = document.getElementById('resetForm');
            var wanted = Math.ceil(form.getBoundingClientRect().bottom + window.scrollY + 32);
            var height = Math.min(wanted, window.parent.innerHeight - 40);
            frame.style.height = height + 'px';
            box.style.height = height + 'px';
            box.style.top = Math.max(window.parent.scrollY + (window.parent.innerHeight - height) / 2 - 12, 0) + 'px';
        } catch (e) {
            // A modal from another origin cannot be resized, and keeps its size
        }
    }

    function showFieldError(groupId, errorId, message) {
        $('#' + groupId).addClass('has-error');
        $('#' + errorId).text(message);
        fitModal();
    }

    function clearFieldErrors() {
        $('#resetForm .has-error').removeClass('has-error');
        $('#resetForm .field-error').text('');
    }

    // Ticks the requirement list as the admin types
    function updatePasswordChecks() {
        var pwd = $('#password').val() || '';
        var checks = {
            length: pwd.length >= PASS_MIN,
            letter: /[a-zA-Z]/.test(pwd),
            number: /[0-9]/.test(pwd)
        };
        $.each(checks, function (name, met) {
            $('.pw-checks [data-check="' + name + '"]').toggleClass('is-met', met)
                .find('i').attr('class', met ? 'icon-ok-sign' : 'icon-circle-blank');
        });
    }

    function checkPasswordStrength(pwd) {
        var regex = new RegExp('^(?=.*[0-9])(?=.*[a-zA-Z])([a-zA-Z0-9!@#\\$%\\^\\&*\\)\\(+=. _-]+){' + PASS_MIN + ',}$');
        return regex.test(pwd);
    }

    var SUPPORT_EMAIL = <?= json_encode($adminEmail, JSON_HEX_TAG | JSON_HEX_AMP); ?>;
    // Plain-text twin of the credentials email, worded the same, for pasting
    // into the admin's own email or chat
    function buildEmailBody() {
        var lines = [
            "<?= $this->jsTranslate('Dear'); ?> " + <?= json_encode($displayName !== '' ? $displayName : $this->translate->_('Participant'), JSON_HEX_TAG | JSON_HEX_AMP); ?> + ",",
            "",
            "<?= $this->jsTranslate('Your password for ePT has been reset. Use these details to sign in.'); ?>",
            "",
            "<?= $this->jsTranslate('Sign-in page'); ?>: " + $('#loginUrl').val(),
            "<?= $this->jsTranslate('Login ID'); ?>: " + $('#primaryMail').val(),
            "<?= $this->jsTranslate('Password'); ?>: " + $('#password').val(),
            "",
            "<?= $this->jsTranslate('After you sign in, change this password.'); ?>",
            "<?= $this->jsTranslate('Do not share your password with anyone.'); ?>",
            "<?= $this->jsTranslate('The ePT team will never ask you for your password.'); ?>"
        ];
        if (SUPPORT_EMAIL) {
            lines.push("", "<?= $this->jsTranslate('If you did not expect this message, or need help, contact ePT Support at'); ?> " + SUPPORT_EMAIL + ".");
        } else {
            lines.push("", "<?= $this->jsTranslate('If you did not expect this message, or need help, contact ePT Support.'); ?>");
        }
        lines.push("", "<?= $this->jsTranslate('Thank you'); ?>,", "<?= $this->jsTranslate('ePT Support'); ?>");
        return lines.join("\n");
    }

    function copyTextToClipboard(text) {
        var t = document.createElement("textarea");
        t.style.position = "fixed";
        t.style.left = "0";
        t.style.top = "0";
        t.style.opacity = "0";
        t.value = text;
        document.body.appendChild(t);
        t.focus();
        t.select();
        var ok = false;
        try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
        document.body.removeChild(t);
        return ok;
    }

    function submitReset() {
        clearFieldErrors();
        var pwd = ($('#password').val() || '').trim();
        var cpwd = ($('#confirmPassword').val() || '').trim();
        if (!pwd) {
            showFieldError('passwordGroup', 'passwordError', "<?= $this->jsTranslate('Type a password or generate one.'); ?>");
            $('#password').focus();
            return;
        }
        if (!checkPasswordStrength(pwd)) {
            showFieldError('passwordGroup', 'passwordError', "<?= $this->jsTranslate('The password does not meet the requirements above.'); ?>");
            $('#password').focus();
            return;
        }
        if (pwd !== cpwd) {
            showFieldError('confirmGroup', 'confirmError', "<?= $this->jsTranslate('The two passwords do not match.'); ?>");
            $('#confirmPassword').focus();
            return;
        }

        var mode = getMode();

        if (mode === 'email') {
            var to = ($('#emailTo').val() || '').trim();
            if (!to) {
                showFieldError('emailToGroup', 'emailToError', "<?= $this->jsTranslate('Enter at least one email address.'); ?>");
                $('#emailTo').focus();
                return;
            }
            // Quick syntax check on the first To address.
            // Accept "Name <addr>" / "\"quoted\" <addr>" by extracting the bracketed address,
            // matching the backend's validateEmail() behaviour.
            var firstTo = to.split(',')[0].trim();
            var angleMatch = firstTo.match(/<([^>]+)>/);
            if (angleMatch) {
                firstTo = angleMatch[1].trim();
            }
            firstTo = firstTo.replace(/^["']+|["']+$/g, '');
            if (!EMAIL_RE.test(firstTo)) {
                showFieldError('emailToGroup', 'emailToError', "<?= $this->jsTranslate('The To address does not look like a valid email.'); ?>");
                $('#emailTo').focus();
                return;
            }
        }

        if (mode === 'copy_pass') {
            var okp = copyTextToClipboard(pwd);
            if (okp && typeof Toastify === 'function') {
                Toastify({ text: "<?= $this->jsTranslate('Password copied to clipboard'); ?>", duration: 2000 }).showToast();
            } else if (!okp) {
                window.prompt("<?= $this->jsTranslate('Copy the password below:'); ?>", pwd);
            }
        } else if (mode === 'copy_email') {
            var oke = copyTextToClipboard(buildEmailBody());
            if (oke && typeof Toastify === 'function') {
                Toastify({ text: "<?= $this->jsTranslate('Login message copied to clipboard'); ?>", duration: 2000 }).showToast();
            } else if (!oke) {
                window.prompt("<?= $this->jsTranslate('Copy the login message below:'); ?>", buildEmailBody());
            }
        }

        $.blockUI();
        document.getElementById('resetForm').submit();
    }

    function passwordType() {
        $.post("<?php echo $this->url(array('module' => 'reports', 'controller' => 'common', 'action' => 'generate-password', 'format' => 'html')); ?>", {
            csrf_token: $("#csrf_token").val(),
            size: 16
        }, function (data) {
            // A generated password needs no confirming, and is shown so it can be read out
            $("#password").val(data).attr('type', 'text');
            $('#togglePassword i').attr('class', 'icon-eye-close');
            $("#confirmPassword").val(data);
            $('#resetForm').addClass('is-generated');
            clearFieldErrors();
            updatePasswordChecks();
            fitModal();
            if (typeof Toastify === 'function') {
                Toastify({ text: "<?= $this->jsTranslate('Random password generated'); ?>", duration: 2000 }).showToast();
            }
        });
    }

    $(function () {
        $('.mode-card input').on('change', function () {
            setMode($(this).closest('.mode-card').data('mode'));
        });

        // Typing by hand needs the confirm field again
        $('#password').on('input', function () {
            if ($('#resetForm').hasClass('is-generated')) {
                $('#resetForm').removeClass('is-generated');
                $('#confirmPassword').val('');
                fitModal();
            }
            $('#passwordGroup').removeClass('has-error');
            updatePasswordChecks();
        });
        $('#confirmPassword').on('input', function () {
            $('#confirmGroup').removeClass('has-error');
        });
        $('#emailTo').on('input', function () {
            $('#emailToGroup').removeClass('has-error');
        });

        // A suggestion goes into To, or comes out again if it is already there
        function markUsedSuggestions() {
            var current = ($('#emailTo').val() || '').toLowerCase().split(/[\s,;]+/);
            $('.to-suggestion').each(function () {
                $(this).toggleClass('is-used', current.indexOf(String($(this).data('email')).toLowerCase()) !== -1);
            });
        }
        $('.to-suggestion').on('click', function () {
            var email = String($(this).data('email'));
            var list = ($('#emailTo').val() || '').split(/[\s,;]+/).filter(function (x) { return x !== ''; });
            var at = list.map(function (x) { return x.toLowerCase(); }).indexOf(email.toLowerCase());
            if (at === -1) {
                list.push(email);
            } else {
                list.splice(at, 1);
            }
            $('#emailTo').val(list.join(', '));
            $('#emailToGroup').removeClass('has-error');
            markUsedSuggestions();
        });
        $('#emailTo').on('input', markUsedSuggestions);
        markUsedSuggestions();

        $('#togglePassword').on('click', function () {
            var $pwd = $('#password');
            var show = $pwd.attr('type') === 'password';
            $pwd.attr('type', show ? 'text' : 'password');
            $(this).find('i').attr('class', show ? 'icon-eye-close' : 'icon-eye-open');
        });

        setMode('copy_pass');
        updatePasswordChecks();
        // Web fonts change line heights after the first fit
        $(window).on('load', fitModal);
    });
</script>
