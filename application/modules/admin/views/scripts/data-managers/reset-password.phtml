<?php
$fullName = trim(($this->user['first_name'] ?? '') . ' ' . ($this->user['last_name'] ?? ''));
$displayName = $fullName !== '' ? $fullName : $institute;

/* Recent activity. A recent sign-in or self-change means the user can probably
   get in already, so only that turns the box amber. Consecutive resets by the
   same actor collapse into one line. */
$recentActivity = $this->recentActivity ?? [];
$warnWindowDays = 30;
$recentSignIn = null;
$recentSelfChange = null;
$groups = [];
foreach ($recentActivity as $r) {
    $kind = $r['kind'] ?? 'reset';
    $ts = strtotime((string) ($r['when'] ?? ''));
    $isRecent = $ts && $ts >= strtotime("-{$warnWindowDays} days");
    if ($kind === 'login' && $isRecent && $recentSignIn === null) {
        $recentSignIn = $ts;
    }
    if ($kind === 'self_change' && $isRecent && $recentSelfChange === null) {
        $recentSelfChange = $ts;
    }
    $actor = trim((string) (($r['actorName'] ?? '') !== '' ? $r['actorName'] : ($r['actorEmail'] ?? '')));
    if ($actor === '') {
        $actor = 'System';
    }
    if (!empty($r['actorRole'])) {
        $actor .= ' (' . $r['actorRole'] . ')';
    }
    $key = $kind === 'reset' ? 'reset|' . (!empty($r['confirmed']) ? 'c' : 'l') . '|' . $actor : null;
    $last = count($groups) - 1;
    if ($key !== null && $last >= 0 && $groups[$last]['key'] === $key) {
        $groups[$last]['count']++;
        $groups[$last]['oldest'] = $ts;
        $groups[$last]['emailSent'] = $groups[$last]['emailSent'] || !empty($r['emailSent']);
        continue;
    }
    $groups[] = [
        'key' => $key ?? ($kind . '|' . count($groups)),
        'kind' => $kind,
        'newest' => $ts,
        'oldest' => $ts,
        'count' => 1,
        'actor' => $actor,
        'confirmed' => !empty($r['confirmed']),
        'emailSent' => !empty($r['emailSent']),
        'ip' => (string) ($r['ip'] ?? ''),
        'raw' => (string) ($r['when'] ?? ''),
    ];
}
$fmtDate = fn ($ts, $raw = '') => $ts ? date('d M Y, H:i', $ts) : $raw;
// A login ID that is not an email address cannot receive mail, so To starts
// with the first known address instead and the rest are offered below it.
$emailSuggestions = $this->emailSuggestions ?? [];
$loginIdIsEmail = Application_Service_Common::validateEmail($primaryEmail) !== null;
$defaultTo = $loginIdIsEmail ? $primaryEmail : ($emailSuggestions[0]['email'] ?? '');
// "Email to user" stays visible but cannot be chosen while ePT cannot send mail
$mailProblem = Application_Service_Common::mailDeliveryProblem();
$mailSettingsUrl = $this->url(['module' => 'admin', 'controller' => 'global-config', 'action' => 'index'], 'default', true) . '#emailConfig';
$visibleGroups = 3;
?>
