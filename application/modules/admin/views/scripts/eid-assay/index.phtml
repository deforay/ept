<script charset="utf-8">
    $(document).ready(function () {
        $('ul.tabs li').click(function () {
            var tab_id = $(this).attr('data-tab');

            $('ul.tabs li').removeClass('current');
            $('.tab-content').removeClass('current');

            $(this).addClass('current');
            $("#" + tab_id).addClass('current');
        })
    });

    /* Table initialisation */
    var exTable = null;
    var dtTable = null;
    $(document).ready(function () {
        exTable = $('#eidExtractionAssayTable').dataTable({

            "bJQueryUI": false,
            "bAutoWidth": false,
            "bInfo": true,
            "bScrollCollapse": true,
            "sPaginationType": "bootstrap",
            "bRetrieve": true,
            "aoColumns": [{
                "sClass": ""
            },
            {
                "sClass": "center"
            }
            ],
            "aaSorting": [
                [0, "ASC"]
            ],
            "bProcessing": true,
            "bServerSide": true,
            "sAjaxSource": "<?php echo $this->url(array('module' => 'admin', 'controller' => 'eid-assay', 'action' => 'index', 'format' => 'html')); ?>",
            "fnServerData": function (sSource, aoData, fnCallback) {
                aoData.push({
                    "name": "fromSource",
                    "value": "extraction"
                });
                $.ajax({
                    "dataType": 'json',
                    "type": "POST",
                    "url": sSource,
                    "data": aoData,
                    "success": fnCallback
                });
            }
        });

        dtTable = $('#eidDetectionAssayTable').dataTable({

            "bJQueryUI": false,
            "bAutoWidth": false,
            "bInfo": true,
            "bScrollCollapse": true,
            "sPaginationType": "bootstrap",
            "bRetrieve": true,
            "aoColumns": [{
                "sClass": ""
            },
            {
                "sClass": "center"
            }
            ],
            "aaSorting": [
                [0, "ASC"]
            ],
            "bProcessing": true,
            "bServerSide": true,
            "sAjaxSource": "<?php echo $this->url(array('module' => 'admin', 'controller' => 'eid-assay', 'action' => 'index', 'format' => 'html')); ?>",
            "fnServerData": function (sSource, aoData, fnCallback) {
                aoData.push({
                    "name": "fromSource",
                    "value": "detection"
                });
                $.ajax({
                    "dataType": 'json',
                    "type": "POST",
                    "url": sSource,
                    "data": aoData,
                    "success": fnCallback
                });
            }
        });

    });

    function changeNameStatus(formSource, eidId, switchStatus) {
        if (window.confirm("<?= $this->translate->_("Are you sure you wish to change this assay status to"); ?> " + switchStatus + " ?")) {
            $.blockUI();
            $.post("<?php echo $this->url(array('module' => 'admin', 'controller' => 'eid-assay', 'action' => 'change-status')); ?>", {
                formSource: formSource,
                id: eidId,
                switchStatus: switchStatus,
                format: "html"
            },
                function (data) {
                    if (data == 0) {
                        alert("Status not updated..Please try again once.");
                    }
                    if (formSource == "extraction") {
                        exTable.fnDraw();
                    } else if (formSource == "detection") {
                        dtTable.fnDraw();
                    }
                    $.unblockUI();
                });
        }
    }
</script>
