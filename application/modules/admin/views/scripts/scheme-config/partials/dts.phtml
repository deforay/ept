// which supplies the .well/fieldset/legend, sidebar and re-evaluation nudge.
//
// The .datepicker field is initialised by the admin layout's global
// $(".datepicker").datepicker() — no local init needed.
$dts = $this->dtsConfig ?? [];

// Stored as a comma-joined string; tolerate an already-split array.
$allowedAlgorithms = $dts['allowedAlgorithms'] ?? '';
if (!is_array($allowedAlgorithms)) {
    $allowedAlgorithms = ($allowedAlgorithms === '' || $allowedAlgorithms === null)
        ? []
        : explode(',', (string) $allowedAlgorithms);
}

// Country schemes that expose the sample-condition / repeat-test toggles.
