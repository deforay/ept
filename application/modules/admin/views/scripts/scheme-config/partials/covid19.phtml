<?php
// SARS-CoV-2 scheme config. Rendered inside scheme-config/index.phtml, which
// supplies the .well/fieldset/legend, sidebar and re-evaluation nudge.
//
// The .datepicker field is initialised by the admin layout's global
// $(".datepicker").datepicker(); the flash message is likewise rendered by the
// layout — neither needs a local copy.
$covid19Config = $this->covid19Config ?? [];

// Stored as a comma-joined string, but tolerate an array. The old view had this
// inverted (explode() on an array), which was a TypeError whenever the setting
// was unset — see git history for scheme-config/partials/covid19.phtml.
$allowedAlgorithms = $covid19Config['allowedAlgorithms'] ?? '';
if (is_array($allowedAlgorithms)) {
    $allowedAlgorithms = implode(',', $allowedAlgorithms);
}
?>
