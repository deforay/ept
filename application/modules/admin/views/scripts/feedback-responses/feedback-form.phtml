<?php

$isClone = isset($this->type) && $this->type == 'clone';
$sid = !empty($this->sid) ? (int) $this->sid : null;

$form = $this->result['feedback_form_results'] ?? null;
$formContent = $form['form_content'] ?? '';
$formShowTo = ($form['form_show_to'] ?? '') ?: 'all-participants';
$hasSavedForm = !empty($form) && !$isClone;

// Shipments, newest first, with the code of the one this page is for
$shipments = $this->shipments ?? [];
usort($shipments, fn($a, $b) => (int) $b['shipment_id'] <=> (int) $a['shipment_id']);
$shipmentCode = '';
foreach ($shipments as $row) {
    if ((int) $row['shipment_id'] === $sid) {
        $shipmentCode = $row['shipment_code'];
    }
}

// Shipments that already have a form, so picking one can say so
$shipmentsWithForm = [];
foreach ($this->copySources ?? [] as $row) {
    $shipmentsWithForm[(int) $row['shipment_id']] = true;
}
if ($sid && !empty($form)) {
    $shipmentsWithForm[$sid] = true;
}

// The question list in the same shape the copy request returns, so one render path
// serves the page load and a copy
$questionState = [];
foreach ($this->questions ?? [] as $row) {
    $questionState[] = [
        'questionId' => (int) $row['question_id'],
        'label' => $row['question_text'] . ' (' . $row['question_code'] . ')',
        'selected' => !empty($row['mappedShipmentId']),
        'mandatory' => ($row['is_response_mandatory'] ?? '') === 'yes',
        'sortOrder' => $row['sort_order'],
        'showTo' => ($row['question_show_to'] ?? '') ?: 'all-participants',
    ];
}

// How long the form stays open after finalization, and when this shipment's did open
$openForDays = (int) ($form['open_for_days'] ?? 0) > 0 ? (int) $form['open_for_days'] : Application_Service_FeedBack::DEFAULT_OPEN_FOR_DAYS;
$finalizedOn = (!$isClone && !empty($this->feedbackWindow['finalized_at'])) ? substr($this->feedbackWindow['finalized_at'], 0, 10) : '';

// Attachments belong to the shipment's own folder, so a copied form starts without them
$files = $isClone ? [] : ($this->result['feedback_form_files_results'] ?? []);

$audiences = [
    'all-participants' => [
        'label' => $this->htmlTranslate("All participants"),
        'hint' => $this->htmlTranslate("Every participant in the shipment."),
    ],
    'passing-participants' => [
        'label' => $this->htmlTranslate("Passing only"),
        'hint' => $this->htmlTranslate("Only participants who passed this shipment."),
    ],
    'failing-participants' => [
        'label' => $this->htmlTranslate("Failing only"),
        'hint' => $this->htmlTranslate("Only participants who failed this shipment."),
    ],
];
?>
