                <div class="ff-card">
                    <h4><i class="icon-info-sign"></i> <?= $this->htmlTranslate("Good to know"); ?></h4>
                    <p class="ff-side-text"><?= $this->htmlTranslate("Required questions must be answered before a participant can submit the form."); ?></p>
                    <p class="ff-side-text"><?= $this->htmlTranslate("A question marked Passing only or Failing only keeps that limit, even on a form shown to all participants."); ?></p>
                    <p class="ff-side-text"><?= $this->htmlTranslate("To change a question's wording, use Manage questions. The change shows on every form that uses it."); ?></p>
                </div>
            </div>
        </div>
    </form>
</div>

<script type="text/javascript" src="<?php echo $this->baseUrl('js/select2.min.js'); ?>"></script>
<script type="text/javascript" src="<?php echo $this->baseUrl('js/summernote.min.js'); ?>"></script>
<script type="text/javascript">
    var isCloneMode = <?= $isClone ? 'true' : 'false' ?>;
    var finalizedOn = <?= json_encode($finalizedOn) ?>;
    var currentShipmentId = <?= json_encode(($sid && !$isClone) ? (string) $sid : '') ?>;
    var questions = [];
    var fileRowKey = <?= count($files) ?>;
    var dirty = false;
    var AUDIENCE_LABELS = <?= json_encode(array_map(fn($a) => html_entity_decode($a['label'], ENT_QUOTES), $audiences)) ?>;
<?php if (!empty($this->copySources) && !$isClone) { ?>
    var EMPTY_QUESTIONS = '<?= $this->jsTranslate("No questions yet. Add them from the list below, or reuse an earlier form.") ?>';
<?php } else { ?>
    var EMPTY_QUESTIONS = '<?= $this->jsTranslate("No questions yet. Add them from the list below.") ?>';
<?php } ?>
    var FILE_ACCEPT = '.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.odt,.ods,.csv,.txt,.jpg,.jpeg,.png,.gif';

    $(document).ready(function() {
        $('#shipmentId').select2({
            placeholder: '<?= $this->jsTranslate("Pick a shipment") ?>',
            width: '100%'
        });

        $('#formContentEditor').summernote({
            placeholder: '<?= $this->jsTranslate("Optional. For example: Thank you for taking part in this round.") ?>',
            height: 160,
            toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'italic', 'underline', 'clear']],
                ['para', ['ul', 'ol']],
                ['insert', ['link']],
                ['view', ['codeview']]
            ],
            callbacks: {
                onChange: function() {
                    dirty = true;
                }
            }
        });
        $('#formContentEditor').summernote('code', $('#formContent').val());

        $('input[type=file]').attr('accept', FILE_ACCEPT);

        $('#formToChoices').on('change', 'input', function() {
            syncAudience();
            dirty = true;
        });
        $('#fileRows').on('change input', 'input, select', function() {
            dirty = true;
            updateSummary();
        });

        setQuestions(<?= json_encode($questionState) ?>);
        syncAudience();
        syncWindow();
        dirty = false;
    });

    function setDays(days) {
        $('#openForDays').val(days);
        syncWindow();
        dirty = true;
    }

    function formatDate(d) {
        return d.toLocaleDateString(undefined, {
            day: 'numeric',
            month: 'short',
            year: 'numeric'
        });
    }

    // Days as typed, kept to 1–365
    function openForDays() {
        var days = parseInt($('#openForDays').val(), 10);
        return (days >= 1 && days <= 365) ? days : 0;
    }

    function syncWindow() {
        var days = openForDays();
        $('.ff-chip').each(function() {
            $(this).toggleClass('selected', Number($(this).data('days')) === days);
        });
        var hint = '';
        if (!days) {
            hint = '<?= $this->jsTranslate("Enter a number of days from 1 to 365.") ?>';
        } else if (finalizedOn) {
            var opened = new Date(finalizedOn + 'T00:00:00');
            var closes = new Date(opened.getTime());
            closes.setDate(closes.getDate() + days);
            var closed = closes < new Date(new Date().toDateString());
            hint = (closed ?
                    '<?= $this->jsTranslate('Opened on %1$s and closed on %2$s. Saving with more days opens it again until the new date.') ?>' :
                    '<?= $this->jsTranslate('Opened on %1$s. Closes on %2$s.') ?>')
                .replace('%1$s', formatDate(opened)).replace('%2$s', formatDate(closes));
        } else {
            hint = '<?= $this->jsTranslate("Opens when the shipment is finalized.") ?>';
        }
        $('#windowHint').toggleClass('ff-warn', !days).text(hint);
        updateSummary();
    }

    window.addEventListener('beforeunload', function(e) {
        if (dirty) {
            e.preventDefault();
            e.returnValue = '';
        }
    });

    function escapeHtml(text) {
        return $('<div>').text(text == null ? '' : text).html();
    }

    function syncAudience() {
        var $picked = $('#formToChoices input:checked');
        $('#formToChoices .ff-choice').removeClass('selected');
        $picked.closest('.ff-choice').addClass('selected');
        $('#formToHint').text($picked.closest('.ff-choice').data('hint') || '');
        updateSummary();
    }

    // Selected questions first, in their saved order, then the rest as listed
    function setQuestions(list) {
        var selected = [];
        var rest = [];
        $.each(list || [], function(i, q) {
            q = $.extend({}, q, {
                questionId: String(q.questionId)
            });
            (q.selected ? selected : rest).push(q);
        });
        selected.sort(function(a, b) {
            var sa = (a.sortOrder === null || a.sortOrder === '' || a.sortOrder === undefined) ? Infinity : Number(a.sortOrder);
            var sb = (b.sortOrder === null || b.sortOrder === '' || b.sortOrder === undefined) ? Infinity : Number(b.sortOrder);
            return sa - sb;
        });
        questions = selected.concat(rest);
        renderQuestions();
    }

    function audienceTag(showTo) {
        if (!showTo || showTo === 'all-participants') {
            return '';
        }
        return '<span class="ff-tag">' + escapeHtml(AUDIENCE_LABELS[showTo] || showTo) + '</span>';
    }

    function renderQuestions() {
        var selected = questions.filter(function(q) {
            return q.selected;
        });
        var term = $.trim($('#questionSearch').val() || '').toLowerCase();
        var available = questions.filter(function(q) {
            return !q.selected;
        });

        var html = '';
        $.each(selected, function(i, q) {
            html += '<li data-id="' + q.questionId + '">' +
                '<span class="ff-pos">' + (i + 1) + '</span>' +
                '<span class="ff-qtext">' + escapeHtml(q.label) + audienceTag(q.showTo) + '</span>' +
                '<input type="hidden" name="question[]" value="' + q.questionId + '">' +
                '<input type="hidden" name="sortOrder[' + q.questionId + ']" value="' + (i + 1) + '">' +
                '<label class="ff-req" title="<?= $this->jsTranslate("Participants must answer this question") ?>"><input type="checkbox" name="mandatory[' + q.questionId + ']" value="yes"' + (q.mandatory ? ' checked' : '') + ' onchange="setMandatory(\'' + q.questionId + '\', this.checked);"> <?= $this->jsTranslate("Required") ?></label>' +
                '<span class="ff-btns">' +
                '<button type="button" class="ff-icon-btn" title="<?= $this->jsTranslate("Move up") ?>" onclick="moveQuestion(\'' + q.questionId + '\', -1);"' + (i === 0 ? ' disabled' : '') + '><i class="icon-arrow-up"></i></button>' +
                '<button type="button" class="ff-icon-btn" title="<?= $this->jsTranslate("Move down") ?>" onclick="moveQuestion(\'' + q.questionId + '\', 1);"' + (i === selected.length - 1 ? ' disabled' : '') + '><i class="icon-arrow-down"></i></button>' +
                '<button type="button" class="ff-icon-btn ff-remove" title="<?= $this->jsTranslate("Remove from the form") ?>" onclick="toggleQuestion(\'' + q.questionId + '\', false);"><i class="icon-remove"></i></button>' +
                '</span></li>';
        });
        $('#selectedQuestions').html(html || '<li class="ff-empty" style="display:block;">' + EMPTY_QUESTIONS + '</li>');

        var shown = 0;
        html = '';
        $.each(available, function(i, q) {
            if (term && q.label.toLowerCase().indexOf(term) === -1) {
                return;
            }
            shown++;
            html += '<li>' +
                '<span class="ff-qtext">' + escapeHtml(q.label) + audienceTag(q.showTo) + '</span>' +
                '<button type="button" class="ff-add-btn" onclick="toggleQuestion(\'' + q.questionId + '\', true);"><i class="icon-plus"></i> <?= $this->jsTranslate("Add") ?></button>' +
                '</li>';
        });
        if (!html) {
            html = '<li class="ff-empty" style="display:block;">' + (available.length ?
                '<?= $this->jsTranslate("No questions match your search.") ?>' :
                '<?= $this->jsTranslate("Every active question is on the form.") ?>') + '</li>';
        }
        $('#availableQuestions').html(html);
        $('#availableCount').text(available.length ? '(' + available.length + ')' : '');
        updateSummary();
    }

    function findQuestion(id) {
        for (var i = 0; i < questions.length; i++) {
            if (questions[i].questionId === id) {
                return i;
            }
        }
        return -1;
    }

    // Adding puts the question at the end of the form; removing returns it to the list
    function toggleQuestion(id, include) {
        var i = findQuestion(id);
        if (i === -1) {
            return;
        }
        var q = questions.splice(i, 1)[0];
        q.selected = include;
        var lastSelected = -1;
        $.each(questions, function(j, other) {
            if (other.selected) {
                lastSelected = j;
            }
        });
        questions.splice(lastSelected + 1, 0, q);
        dirty = true;
        renderQuestions();
    }

    function moveQuestion(id, step) {
        var i = findQuestion(id);
        var j = i + step;
        if (i === -1 || j < 0 || j >= questions.length || !questions[j].selected) {
            return;
        }
        var q = questions[i];
        questions[i] = questions[j];
        questions[j] = q;
        dirty = true;
        renderQuestions();
    }

    function setMandatory(id, value) {
        var i = findQuestion(id);
        if (i !== -1) {
            questions[i].mandatory = value;
            dirty = true;
            updateSummary();
        }
    }

    function updateSummary() {
        var picked = $('#shipmentId option:selected');
        $('#sumShipment').text(picked.val() ? $.trim(picked.text().split(' · ')[0]) : '—');
        var audience = $('#formToChoices input:checked').val();
        $('#sumAudience').text(AUDIENCE_LABELS[audience] || '—');
        var selected = questions.filter(function(q) {
            return q.selected;
        });
        var required = selected.filter(function(q) {
            return q.mandatory;
        }).length;
        $('#sumQuestions').text(selected.length ?
            selected.length + (required ? ' (' + required + ' <?= $this->jsTranslate("required") ?>)' : '') :
            '<?= $this->jsTranslate("None yet") ?>');
        var files = 0;
        $('#fileRows tr').each(function() {
            if ($(this).find('input[name^="formFiles[existing]"]').length || $(this).find('input[type=file]').val()) {
                files++;
            }
        });
        $('#sumFiles').text(files || '<?= $this->jsTranslate("None") ?>');
        var days = openForDays();
        $('#sumWindow').text(days ? '<?= $this->jsTranslate("%d days") ?>'.replace('%d', days) : '—');
    }

    function shipmentChanged(id) {
        updateSummary();
        if (isCloneMode) {
            // A copy keeps what it brought; just say if the target already has a form
            var hasForm = $('#shipmentId option:selected').data('has-form') == 1;
            $('#shipmentHint').toggleClass('ff-warn', hasForm).text(hasForm ?
                '<?= $this->jsTranslate("This shipment already has a feedback form. Saving replaces it with this one.") ?>' : '');
            return;
        }
        if (!id || id === currentShipmentId) {
            return;
        }
        if (dirty && !confirm('<?= $this->jsTranslate("Open the form for the other shipment? Changes you have not saved here will be lost.") ?>')) {
            $('#shipmentId').val(currentShipmentId).trigger('change.select2');
            updateSummary();
            return;
        }
        dirty = false;
        window.location.href = '/admin/feedback-responses/feedback-form/id/' + btoa(id);
    }

    function copyFeedbackFormFromShipment() {
        var sourceId = $('#copySource').val();
        if (!sourceId) {
            alert('<?= $this->jsTranslate("Pick the shipment to copy the feedback form from.") ?>');
            return;
        }
        var hasContent = questions.some(function(q) {
            return q.selected;
        }) || !$('#formContentEditor').summernote('isEmpty');
        if (hasContent && !confirm('<?= $this->jsTranslate("Replace the questions, introduction, audience and days open on this form with the copied ones? Files are kept.") ?>')) {
            return;
        }
        $.blockUI();
        $.post('<?= $this->url(array('module' => 'admin', 'controller' => 'feedback-responses', 'action' => 'get-questions'), 'default', true); ?>', {
                sid: sourceId
            })
            .done(function(data) {
                setQuestions(data.questions);
                $('#formContentEditor').summernote('code', data.formContent || '');
                $('#formToChoices input[value="' + (data.formShowTo || 'all-participants') + '"]').prop('checked', true);
                if (data.openForDays) {
                    $('#openForDays').val(data.openForDays);
                    syncWindow();
                }
                syncAudience();
                dirty = true;
            })
            .fail(function() {
                alert('<?= $this->jsTranslate("Could not load that feedback form. Please try again.") ?>');
            })
            .always(function() {
                $.unblockUI();
            });
    }

    function addFileRow() {
        fileRowKey++;
        var k = fileRowKey;
        var options = '';
        $.each(AUDIENCE_LABELS, function(value, label) {
            options += '<option value="' + value + '">' + escapeHtml(label) + '</option>';
        });
        $('#fileRows').append(
            '<tr>' +
            '<td><input type="file" name="formFiles[files][' + k + ']" accept="' + FILE_ACCEPT + '"></td>' +
            '<td><input type="text" name="formFiles[name][' + k + ']" class="form-control input-sm" maxlength="50" placeholder="<?= $this->jsTranslate("Same as the file") ?>"></td>' +
            '<td><select name="formFiles[filesTo][' + k + ']" class="form-control input-sm">' + options + '</select></td>' +
            '<td><input type="hidden" name="formFiles[sort][' + k + ']" class="ff-file-sort" value="">' +
            '<button type="button" class="ff-icon-btn ff-remove" title="<?= $this->jsTranslate("Remove this file from the form") ?>" onclick="removeFileRow(this);"><i class="icon-remove"></i></button></td>' +
            '</tr>'
        );
        $('#filesTable').show();
        $('#filesEmpty').hide();
        $('#fileRows tr:last input[type=file]').trigger('click');
    }

    function removeFileRow(btn) {
        $(btn).closest('tr').remove();
        if (!$('#fileRows tr').length) {
            $('#filesTable').hide();
            $('#filesEmpty').show();
        }
        dirty = true;
        updateSummary();
    }

    function validateNow() {
        if (!$('#shipmentId').val()) {
            alert('<?= $this->jsTranslate("Pick the shipment this feedback form is for.") ?>');
            return false;
        }
        if (!questions.some(function(q) {
                return q.selected;
            })) {
            alert('<?= $this->jsTranslate("Add at least one question to the feedback form.") ?>');
            return false;
        }
        if (!openForDays()) {
            alert('<?= $this->jsTranslate("Enter how many days the form stays open, from 1 to 365.") ?>');
            $('#openForDays').focus();
            return false;
        }
        if (isCloneMode && $('#shipmentId option:selected').data('has-form') == 1 &&
            !confirm('<?= $this->jsTranslate("This shipment already has a feedback form. Replace it with this one?") ?>')) {
            return false;
        }
        $('#formContent').val($('#formContentEditor').summernote('isEmpty') ? '' : $('#formContentEditor').summernote('code'));
        $('#fileRows tr').each(function(i) {
            $(this).find('.ff-file-sort').val(i + 1);
        });
        dirty = false;
        $.blockUI();
        return true;
    }
</script>
