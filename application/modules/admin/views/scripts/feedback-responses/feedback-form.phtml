<script src="<?php echo $this->baseUrl('/js/bootstrap-wysihtml5/bootstrap3-wysihtml5.all.min.js'); ?>" type="text/javascript"></script>
<script type="text/javascript">
    var duplicated = false;
    var tableRow = 1;
    // Mandatory flags / sort orders for questions already mapped, so re-rendering the
    // question table from the picker doesn't lose what was saved.
    var questionPrefill = {
        mandatory: <?php echo json_encode($mandatory); ?>,
        sortOrder: <?php echo json_encode($sortOrder); ?>
    };
    var isCloneMode = <?php echo $isClone ? 'true' : 'false'; ?>;

    $(document).ready(function() {
        $("#shipmentId").select2({
            placeholder: 'Select shipment to fetch questions',
            allowClear: true,
        });
        $("#formTo").select2({
            placeholder: 'Select form to show',
            allowClear: true,
        });
        $('#question').selectpicker();
        $("#formContent").wysihtml5();
    });

    function escapeHtml(text) {
        return $('<div>').text(text == null ? '' : text).html();
    }

    function checkDuplicate(tableName, fieldName, obj, fnct, msg) {
        $.post("<?php echo $this->url(array('module' => 'default', 'controller' => 'common', 'action' => 'check-duplicate')); ?>", {
                tableName: tableName,
                fieldName: fieldName,
                value: obj.value,
                fnct: fnct,
                format: "html"
            },
            function(data) {
                if (data > 0) {
                    alert(msg, "err");
                    duplicated = true;
                    $(obj).val('');
                } else {
                    duplicated = false;
                }
            });
    }

    function validateNow() {
        flag = deforayValidator.init({
            formId: 'addFeedbackQuestionsForm'
        });
        if (!flag || duplicated) {
            return;
        }
        if ($('#question > option:selected').length === 0) {
            alert("<?= $this->jsTranslate("Please select at least one question for this feedback form."); ?>");
            return;
        }
        $.blockUI();
        document.getElementById('addFeedbackQuestionsForm').submit();
    }

    // Push HTML back into the rich text editor as well as the underlying textarea.
    function setFormContent(html) {
        var $textarea = $('#formContent');
        $textarea.val(html || '');
        var wysihtml5Data = $textarea.data('wysihtml5');
        if (wysihtml5Data && wysihtml5Data.editor) {
            wysihtml5Data.editor.setValue(html || '', true);
        }
    }

    /**
     * Render a feedback form payload (question list + content + audience) into the page.
     * Used both when the target shipment changes and when copying an existing form.
     */
    function applyFormPayload(data, applyContent) {
        var options = '';
        var mandatory = [];
        var sortOrder = {};
        $.each(data.questions || [], function(i, q) {
            options += '<option value="' + q.questionId + '"' + (q.selected ? ' selected="selected"' : '') + '>' + escapeHtml(q.label) + '</option>';
            if (q.selected && q.mandatory) {
                mandatory.push(String(q.questionId));
            }
            if (q.selected && q.sortOrder !== null && q.sortOrder !== undefined) {
                sortOrder[String(q.questionId)] = q.sortOrder;
            }
        });
        questionPrefill = {
            mandatory: mandatory,
            sortOrder: sortOrder
        };

        $('#question').html(options);
        $('#question').selectpicker('refresh');
        $('.show-questions').removeClass('hide');
        loadQuestion();

        if (applyContent) {
            $('#formTo').val(data.formShowTo || '').trigger('change');
            setFormContent(data.formContent || '');
        }
    }

    function fetchFormPayload(shipmentId, applyContent) {
        $.blockUI();
        $.post("<?php echo $this->url(array('module' => 'admin', 'controller' => 'feedback-responses', 'action' => 'get-questions'), 'default', true); ?>", {
                sid: shipmentId
            })
            .done(function(data) {
                applyFormPayload(data, applyContent);
            })
            .fail(function() {
                alert("<?= $this->jsTranslate("Could not load the questions for that shipment. Please try again."); ?>");
            })
            .always(function() {
                $.unblockUI();
            });
    }

    function loadQuestions(id) {
        // In clone mode the questions are already prefilled from the source shipment —
        // picking the target shipment must not wipe them.
        if (isCloneMode || id === '') {
            return;
        }
        fetchFormPayload(id, true);
    }

    function copyFromShipment() {
        var sourceId = $('#copyFromShipment').val();
        if (!sourceId) {
            alert("<?= $this->jsTranslate("Please select the shipment to copy the feedback form from."); ?>");
            return;
        }
        fetchFormPayload(sourceId, true);
    }

    function checkType(value) {
        if (value == 'dropdown') {
            $('#optionTaple').removeClass('hide');
        } else {
            $('#optionTaple').addClass('hide');
        }
    }

    function loadQuestion() {
        var html = '';
        $('#questionTable').removeClass('hide');
        $('#question > option:selected').each(function() {
            var text = $(this).text();
            var val = $(this).val();
            var mandatory = questionPrefill.mandatory.indexOf(String(val)) !== -1 ? 'checked' : '';
            var sortOrder = questionPrefill.sortOrder[String(val)];
            if (sortOrder === undefined || sortOrder === null) {
                sortOrder = '';
            }
            html += '<tr> \
                    <td style="text-align:left !important;">' + escapeHtml(text) + '</td>\
                    <td><input type="checkbox" name="mandatory[' + val + ']"  ' + mandatory + ' id="mandatory' + val + '" title="Please select the mandatory or not" value="yes"/></td>\
                    <td><input type="text" class="form-control" value="' + sortOrder + '" name="sortOrder[' + val + ']" id="sortOrder' + val + '" title="Please enter the sort order" placeholder="Enter the sort order"/></td>\
                </tr>';
        });
        $('#questionRow').html(html);
    }

    function addRow() {
        tableRow++;
        $('#formRow').append(
            '<tr> \
                <td><input type="file" id="formFiles{{tableRow}}" name="formFiles[files][]" class="form-control option" placeholder="Select the form file" title="Please select the form file"></td>\
                <td><input type="text" id="formFilesName{{tableRow}}" name="formFiles[name][]" class="form-control option" placeholder="Enter the file name" title="Please enter the file name"></td>\
                <td>\
                    <select class="select2 form-control" id="filesTo{{tableRow}}" name="formFiles[filesTo][]" title="Please select where we show the question">\
                        <option value=""><?= $this->translate->_("--Select--"); ?></option>\
                        <option value="all-participants"><?= $this->translate->_("All Participants"); ?></option>\
                        <option value="passing-participants"><?= $this->translate->_("Only Passing Participants"); ?></option>\
                        <option value="failing-participants"><?= $this->translate->_("Only Failing Participants"); ?></option>\
                    </select>\
                </td>\
                <td><input type="text" id="formFilesSort{{tableRow}}" name="formFiles[sort][]" class="form-control option" placeholder="Enter the sort order" title="Please enter the sort order"></td>\
                <td style=" vertical-align: middle; text-align:center; "><a href="javascript:void(0);" onclick="addRow(this);" class="btn btn-xs btn-info"><i class="icon-plus"></i></a>&nbsp;&nbsp;<a  href="javascript:void(0);" onclick="removeRow(this)" class="btn btn-xs btn-danger"  title="Remove this row completely" alt="Remove this row completely"><i class="icon-minus"></i></a></td>\
            </tr>'
        );
    }

    function removeRow(obj) {
        $(obj.parentNode.parentNode).fadeOut("normal", function() {
            $(this).remove();
        });
        if ($("#formRow tr").length == 1) {
            addRow();
        }
    }
</script>
