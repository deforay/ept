<div class="config-list">
    <div class="config-list-head">
        <h2><?= $this->translate->_("List of All Gene Types"); ?></h2>
        <div class="config-list-actions">
            <a href="<?php echo $this->url(array('module' => 'admin', 'controller' => 'covid19-gene-type', 'action' => 'add'), 'default', true); ?>"
            class="btn btn-primary"><i class="icon-user"></i>&nbsp;&nbsp;Add New Gene Type</a>
        </div>
