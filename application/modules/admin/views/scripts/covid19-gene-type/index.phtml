    <div class="config-list-body">

<div class="config-filters">
    <div>
        <label for="status"><?= $this->htmlTranslate("Approval status"); ?></label>
        <select id="status" name="status" onchange="getApproval(this.value);" class="form-control input-sm">
        <option value=""><?= $this->translate->_("Show All"); ?></option>
        <option value="1"><?= $this->translate->_("Show Approved"); ?></option>
        <option value="0"><?= $this->translate->_("Show UnApproved"); ?></option>
        </select>
    </div>
</div>
<table cellpadding="0" cellspacing="0" border="0" class="table table-striped table-bordered table-hover"
    id="testPlatformTable">
    <thead>
        <tr>
            <th scope="col"><?= $this->translate->_("Gene type Name"); ?></th>
            <th scope="col"><?= $this->translate->_("Scheme Name"); ?></th>
            <th scope="col"><?= $this->translate->_("Created On"); ?></th>
            <th scope="col"><?= $this->translate->_("Action"); ?></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td colspan="4" class="dataTables_empty"><?= $this->translate->_("Loading data from server"); ?></td>
        </tr>
    </tbody>
</table>
    </div><!-- /.config-list-body -->
</div><!-- /.config-list -->
<script type="text/javascript" charset="utf-8">
    /* Table initialisation */
    var oTable = null;
    $(document).ready(function () {
        drawTable();
    });

    function getApproval(status) {
        $('#status').val(status);
        drawTable();
    }

    function drawTable() {
        oTable = $('#testPlatformTable').dataTable({

            "bJQueryUI": false,
            "bAutoWidth": false,
            "bInfo": true,
            "bScrollCollapse": true,
            "sPaginationType": "bootstrap",
            "bRetrieve": false,
            "bDestroy": true,
            "aoColumns": [{
                "sClass": ""
            },
            {
                "sClass": ""
            },
            {
                "sClass": ""
            },
            {
                "sClass": "center",
                "bSortable": false
            }
            ],
            "aaSorting": [
                [0, "asc"]
            ],
            "bProcessing": true,
            "bServerSide": true,
            "sAjaxSource": "<?php echo $this->url(array('module' => 'admin', 'controller' => 'covid19-gene-type', 'action' => 'index', 'format' => 'html')); ?>",
            "fnServerParams": function (aoData) {
                approvalStatus = $("#status").val();
                aoData.push({
                    "name": "status",
                    "value": approvalStatus
                });
            },
            "fnServerData": function (sSource, aoData, fnCallback) {
                $.ajax({
                    "dataType": 'json',
                    "type": "POST",
                    "url": sSource,
                    "data": aoData,
                    "success": fnCallback
                });
            }
        });
    }
</script>
<?php echo $this->render('partials/scheme-config-close.phtml'); ?>
