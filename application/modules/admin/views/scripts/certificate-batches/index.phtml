<script type="text/javascript" src="<?php echo $this->assetUrl('js/daterangepicker.js'); ?>"></script>
<script type="text/javascript" charset="utf-8">
    var oTable = null;
    var autoRefreshInterval = null;
    var startDate = "";
    var endDate = "";
    var hasActiveBatches = false;

    $(document).ready(function () {
        initDateRangePicker();
        initBatchesTable();
        startAutoRefresh();
    });

    function initDateRangePicker() {
        // No date filter by default: batches are made once a year, so a
        // recent-months window would hide last year's.
        $('#dateRange').daterangepicker({
            locale: {
                cancelLabel: 'Clear',
                format: 'DD-MMM-YYYY',
                separator: ' to ',
            },
            autoApply: true,
            showDropdowns: true,
            alwaysShowCalendars: true,
            autoUpdateInput: false,
            ranges: eptDateRanges()
        }, function (start, end) {
            startDate = start.format('DD-MMM-YYYY');
            endDate = end.format('DD-MMM-YYYY');
            $('#dateRange').val(startDate + ' to ' + endDate);
            applyFilters();
        });

        $('#dateRange').on('cancel.daterangepicker', function () {
            startDate = "";
            endDate = "";
            $(this).val('');
            applyFilters();
        });
    }

    function initBatchesTable() {
        oTable = $('#batchesTable').dataTable({
            "bJQueryUI": false,
            "bAutoWidth": false,
            "bInfo": true,
            "bScrollCollapse": true,
            "sPaginationType": "bootstrap",
            "bRetrieve": true,
            "aoColumns": [
                { "sClass": "center" },
                { "sClass": "center", "bSortable": false },
                { "sClass": "center" },
                { "sClass": "center" },
                { "sClass": "center" },
                { "sClass": "center" },
                { "sClass": "center" },
                { "sClass": "center", "bSortable": false }
            ],
            "aaSorting": [[6, "desc"]],
            "bProcessing": true,
            "bServerSide": true,
            "sAjaxSource": "<?php echo $this->url(array('module' => 'admin', 'controller' => 'certificate-batches', 'action' => 'get-all-batches')); ?>",
            "fnServerParams": function (aoData) {
                aoData.push({ "name": "status", "value": $('#filterStatus').val() });
                aoData.push({ "name": "dateFrom", "value": startDate });
                aoData.push({ "name": "dateTo", "value": endDate });
            },
            "fnServerData": function (sSource, aoData, fnCallback) {
                $.ajax({
                    "dataType": 'json',
                    "type": "POST",
                    "url": sSource,
                    "data": aoData,
                    "success": function (json) {
                        // Check for active batches
                        hasActiveBatches = false;

                        // Transform data for display
                        if (json.aaData) {
                            json.aaData = json.aaData.map(function (row) {
                                // A batch still moving on its own: keep refreshing.
                                if (['pending', 'generating', 'approved', 'distributing'].indexOf(row.status) !== -1) {
                                    hasActiveBatches = true;
                                }

                                return [
                                    formatBatchName(row),
                                    formatShipments(row),
                                    formatStatus(row),
                                    formatCount(row.excellence_count, 'excellence'),
                                    formatCount(row.participation_count, 'participation'),
                                    formatCount(row.skipped_count, 'skipped'),
                                    formatDateTime(row.created_on),
                                    formatActions(row)
                                ];
                            });
                        }

                        // Update auto-refresh indicator
                        updateAutoRefreshIndicator();

                        fnCallback(json);
                    }
                });
            }
        });
    }

    function formatBatchName(row) {
        var name = escapeHtml(row.batch_name);
        if (row.created_by_name) {
            name += '<br><small class="text-muted">by ' + escapeHtml(row.created_by_name) + '</small>';
        }
        if (row.error_message) {
            name += '<br><small class="text-danger"><i class="icon-warning-sign"></i> ' + escapeHtml(row.error_message) + '</small>';
        }
        return name;
    }

    function formatShipments(row) {
        if (!row.shipment_codes) {
            // Fallback: show shipment IDs count
            if (row.shipment_ids) {
                var ids = row.shipment_ids.split(',');
                return '<span class="text-muted">' + ids.length + ' shipment(s)</span>';
            }
            return '<span class="text-muted">-</span>';
        }

        var codes = row.shipment_codes.split(',');
        if (codes.length <= 3) {
            return codes.map(function(c) { return '<span class="label label-default">' + escapeHtml(c.trim()) + '</span>'; }).join(' ');
        }
        // Show first 2 and a count
        var html = '<span class="label label-default">' + escapeHtml(codes[0].trim()) + '</span> ';
        html += '<span class="label label-default">' + escapeHtml(codes[1].trim()) + '</span> ';
        html += '<span class="text-muted">+' + (codes.length - 2) + ' <?= $this->jsTranslate("more") ?></span>';
        return html;
    }

    function formatStatusBadge(status) {
        var statusConfig = {
            'pending': { cls: 'batch-status-pending', icon: 'icon-clock', label: '<?= $this->jsTranslate('Pending') ?>' },
            'generating': { cls: 'batch-status-generating', icon: 'icon-spinner icon-spin', label: '<?= $this->jsTranslate('Generating') ?>' },
            'generated': { cls: 'batch-status-generated', icon: 'icon-ok', label: '<?= $this->jsTranslate('Generated') ?>' },
            'approved': { cls: 'batch-status-approved', icon: 'icon-thumbs-up', label: '<?= $this->jsTranslate('Approved') ?>' },
            'distributing': { cls: 'batch-status-generating', icon: 'icon-spinner icon-spin', label: '<?= $this->jsTranslate('Distributing') ?>' },
            'distributed': { cls: 'batch-status-distributed', icon: 'icon-envelope', label: '<?= $this->jsTranslate('Distributed') ?>' },
            'failed': { cls: 'batch-status-failed', icon: 'icon-remove', label: '<?= $this->jsTranslate('Failed') ?>' },
            'rejected': { cls: 'batch-status-failed', icon: 'icon-ban-circle', label: '<?= $this->jsTranslate('Rejected') ?>' },
            'cancelled': { cls: 'batch-status-cancelled', icon: 'icon-ban-circle', label: '<?= $this->jsTranslate('Cancelled') ?>' }
        };

        var config = statusConfig[status] || { cls: 'batch-status-pending', icon: 'icon-question', label: status };
        return '<span class="status-badge ' + config.cls + '"><i class="' + config.icon + '"></i> ' + config.label + '</span>';
    }

    function formatStatus(row) {
        var html = formatStatusBadge(row.status);
        if (row.approved_by_name && ['approved', 'distributing', 'distributed'].indexOf(row.status) !== -1) {
            html += '<br><small class="text-muted"><?= $this->jsTranslate("by") ?> ' + escapeHtml(row.approved_by_name) + '</small>';
        }
        return html;
    }

    function formatCount(count, type) {
        count = parseInt(count) || 0;
        if (count === 0) {
            return '<span class="text-muted">-</span>';
        }
        return '<span class="count-badge count-' + type + '">' + count + '</span>';
    }

    function formatDateTime(dateStr) {
        if (!dateStr) return '<span class="text-muted">-</span>';

        var date = new Date(dateStr.replace(' ', 'T'));
        var now = new Date();
        var diff = Math.floor((now - date) / 1000);

        var timeAgo = '';
        if (diff < 60) {
            timeAgo = diff + '<?= $this->jsTranslate('s ago') ?>';
        } else if (diff < 3600) {
            timeAgo = Math.floor(diff / 60) + '<?= $this->jsTranslate('m ago') ?>';
        } else if (diff < 86400) {
            timeAgo = Math.floor(diff / 3600) + '<?= $this->jsTranslate('h ago') ?>';
        } else {
            timeAgo = Math.floor(diff / 86400) + '<?= $this->jsTranslate('d ago') ?>';
        }

        // Format as readable date
        var options = { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' };
        var formatted = date.toLocaleDateString('en-US', options);
        // Past a week, the date reads better than a count of days.
        if (diff >= 7 * 86400) {
            timeAgo = moment(date).format('DD-MMM-YYYY');
        }

        return '<span title="' + formatted + '">' + timeAgo + '</span>';
    }

    function formatActions(row) {
        var actions = [];

        // Download ZIP button (if download_url exists)
        if (row.download_url) {
            actions.push('<a href="<?= $this->baseUrl(); ?>' + row.download_url + '" class="btn btn-success btn-action" target="_blank" title="<?= $this->jsTranslate("Download ZIP") ?>">' +
                '<i class="icon-download"></i> <?= $this->jsTranslate("Download") ?></a>');
        }

        // Approving and discarding happen on the guided page only, so
        // there is one place to do them.
        if (['pending', 'generating', 'generated', 'approved', 'distributing'].indexOf(row.status) !== -1) {
            actions.push('<a class="btn btn-primary btn-action" href="<?= $certificatesUrl; ?>"><i class="icon-arrow-right"></i> <?= $this->jsTranslate("Open in Annual Certificates") ?></a>');
        }

        if (actions.length === 0) {
            return '<span class="text-muted">-</span>';
        }

        return actions.join(' ');
    }

    function escapeHtml(text) {
        if (!text) return '';
        return text
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function refreshBatches() {
        if (oTable) {
            oTable.fnDraw(false); // false = don't reset pagination
        }
    }

    function applyFilters() {
        if (oTable) {
            oTable.fnDraw();
        }
    }

    function resetFilters() {
        $('#filterStatus').val('');
        startDate = "";
        endDate = "";
        $('#dateRange').val('');
        applyFilters();
    }

    function startAutoRefresh() {
        autoRefreshInterval = setInterval(function () {
            if (hasActiveBatches) {
                refreshBatches();
            }
        }, 5000);
    }

    function stopAutoRefresh() {
        if (autoRefreshInterval) {
            clearInterval(autoRefreshInterval);
            autoRefreshInterval = null;
        }
    }

    function updateAutoRefreshIndicator() {
        $('#autoRefreshIndicator').toggle(hasActiveBatches);
    }

    // Clean up on page leave
    $(window).on('beforeunload', function () {
        stopAutoRefresh();
    });
</script>
