                </div>
                <div class="al-field">
                    <label for="requestId"><?= $this->translate->_("Request"); ?></label>
                    <input type="search" id="requestId" data-key="requestId" placeholder="<?= $this->htmlTranslate("16-char request ID"); ?>" autocomplete="off" />
                </div>
            </div>
        </div>
    </div>

    <div class="al-chips" id="alChips"></div>

    <div class="audit-search" id="searchWrap">
        <i class="fas fa-search"></i>
        <input type="search" id="searchBox" placeholder="<?= $this->htmlTranslate("Search actions, names, codes, changed values…"); ?>" autocomplete="off" />
        <button type="button" class="clear-search" id="clearSearch" title="<?= $this->htmlTranslate("Clear search"); ?>">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <div class="audit-feed" id="auditFeed">
        <div class="loading-state">
            <i class="fas fa-circle-notch fa-spin"></i>
            <?= $this->translate->_("Loading audit log…"); ?>
        </div>
    </div>

    <div class="audit-pagination" id="auditPagination" style="display:none;">
        <div class="page-info" id="pageInfo"></div>
        <div class="page-controls">
            <span><?= $this->translate->_("Per page"); ?></span>
            <select id="pageSize">
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <button type="button" id="prevBtn" title="<?= $this->htmlTranslate("Previous"); ?>"><i class="fas fa-chevron-left"></i></button>
            <button type="button" id="nextBtn" title="<?= $this->htmlTranslate("Next"); ?>"><i class="fas fa-chevron-right"></i></button>
        </div>
    </div>

    <div class="al-panel-backdrop" id="alPanelBackdrop" aria-hidden="true">
        <aside class="al-panel" role="dialog" aria-modal="true" aria-labelledby="alPanelTitle">
            <div class="al-panel-head">
                <h3 id="alPanelTitle"></h3>
                <div class="al-panel-time" id="alPanelTime"></div>
                <button type="button" class="al-panel-close" id="alPanelClose" aria-label="<?= $this->htmlTranslate('Close'); ?>">&times;</button>
            </div>
            <div class="al-panel-body" id="alPanelBody"></div>
            <div class="al-panel-actions">
                <button type="button" class="al-btn primary" id="alHistoryBtn"><i class="fas fa-history"></i> <?= $this->translate->_('History of this item'); ?></button>
                <button type="button" class="al-btn" id="alRequestBtn" title="<?= $this->htmlTranslate('Other entries written by the same click or save'); ?>"><i class="fas fa-mouse-pointer"></i> <?= $this->translate->_('Same click'); ?></button>
                <button type="button" class="al-btn" id="alSessionBtn"><i class="fas fa-fingerprint"></i> <?= $this->translate->_('Same session'); ?></button>
            </div>
        </aside>
    </div>
</div>

<script type="text/javascript" src="<?php echo $this->baseUrl('js/moment.min.js'); ?>"></script>
<script type="text/javascript" src="<?php echo $this->assetUrl('js/daterangepicker.js'); ?>"></script>
<script type="text/javascript">
(function() {
    var feedUrl = "<?php echo $this->url(['module' => 'admin', 'controller' => 'audit-log', 'action' => 'feed']); ?>";
    var exportUrl = "<?php echo $this->url(['module' => 'admin', 'controller' => 'audit-log', 'action' => 'export']); ?>";

    var T = {
        entries: "<?= $this->jsTranslate('entries') ?>",
        important: "<?= $this->jsTranslate('important') ?>",
        showing: "<?= $this->jsTranslate('Showing') ?>",
        of: "<?= $this->jsTranslate('of') ?>",
        loading: "<?= $this->jsTranslate('Loading…') ?>",
        none: "<?= $this->jsTranslate('No audit entries match the current filters.') ?>",
        failed: "<?= $this->jsTranslate('The audit log did not load. Try again.') ?>",
        empty: "<?= $this->jsTranslate('empty') ?>",
        moreChanges: "<?= $this->jsTranslate('more changes') ?>",
        oneMoreChange: "<?= $this->jsTranslate('1 more change') ?>",
        asAccount: "<?= $this->jsTranslate('as') ?>",
        viewAs: "<?= $this->jsTranslate('Done through View as, using this account') ?>",
        historyOf: "<?= $this->jsTranslate('Show the history of this item') ?>",
        whyImportant: "<?= $this->jsTranslate('Why this is flagged') ?>",
        changes: "<?= $this->jsTranslate('What changed') ?>",
        field: "<?= $this->jsTranslate('Field') ?>",
        before: "<?= $this->jsTranslate('Before') ?>",
        after: "<?= $this->jsTranslate('After') ?>",
        details: "<?= $this->jsTranslate('Details') ?>",
        listMore: "<?= $this->jsTranslate('This list keeps the first 1,000 rows. Total:') ?>",
        who: "<?= $this->jsTranslate('Who') ?>",
        where: "<?= $this->jsTranslate('Where') ?>",
        user: "<?= $this->jsTranslate('User') ?>",
        email: "<?= $this->jsTranslate('Email') ?>",
        role: "<?= $this->jsTranslate('Role') ?>",
        onBehalfOf: "<?= $this->jsTranslate('On behalf of') ?>",
        item: "<?= $this->jsTranslate('Item') ?>",
        context: "<?= $this->jsTranslate('Context') ?>",
        ip: "<?= $this->jsTranslate('IP address') ?>",
        browser: "<?= $this->jsTranslate('Browser') ?>",
        channel: "<?= $this->jsTranslate('Channel') ?>",
        page: "<?= $this->jsTranslate('Page') ?>",
        session: "<?= $this->jsTranslate('Session') ?>",
        request: "<?= $this->jsTranslate('Request') ?>",
        repeated: "<?= $this->jsTranslate('Repeated') ?>",
        chipDate: "<?= $this->jsTranslate('Date') ?>",
        chipUser: "<?= $this->jsTranslate('User') ?>",
        chipContext: "<?= $this->jsTranslate('Context') ?>",
        chipImportant: "<?= $this->jsTranslate('Important only') ?>",
        chipActor: "<?= $this->jsTranslate('Actor email') ?>",
        chipLab: "<?= $this->jsTranslate('Lab ID') ?>",
        chipBehalf: "<?= $this->jsTranslate('View as account') ?>",
        chipSession: "<?= $this->jsTranslate('Session') ?>",
        chipRequest: "<?= $this->jsTranslate('Request') ?>",
        chipSearch: "<?= $this->jsTranslate('Search') ?>",
        chipLogins: "<?= $this->jsTranslate('Logins') ?>",
        chipAll: "<?= $this->jsTranslate('Actions and logins') ?>",
        remove: "<?= $this->jsTranslate('Remove filter') ?>",
        channels: {
            web: "<?= $this->jsTranslate('Web') ?>",
            api: "<?= $this->jsTranslate('API') ?>",
            cli: "<?= $this->jsTranslate('Scheduled job') ?>"
        }
    };

    // Every filter the feed understands. The URL carries the same keys, so a
    // filtered view can be bookmarked, shared or linked from another page.
    var FILTER_KEYS = ['source', 'startDate', 'endDate', 'type', 'createdBy', 'important',
        'actorEmail', 'labId', 'onBehalfOf', 'sessionHash', 'requestId', 'search',
        'entityType', 'entityId', 'entityLabel'];
    var MORE_KEYS = ['actorEmail', 'labId', 'onBehalfOf', 'sessionHash', 'requestId'];

    function blankState() {
        var s = { page: 1, pageSize: 25 };
        FILTER_KEYS.forEach(function(k) { s[k] = ''; });
        s.source = 'actions';
        return s;
    }

    var state = blankState();

    var actionIcons = {
        create: 'fa-plus',
        update: 'fa-pencil-alt',
        delete: 'fa-trash-alt',
        cancel: 'fa-ban',
        close: 'fa-lock',
        import: 'fa-file-import',
        download: 'fa-download',
        message: 'fa-paper-plane',
        evaluate: 'fa-calculator',
        finalize: 'fa-check-double',
        submit: 'fa-clipboard-check',
        generate: 'fa-file-pdf',
        ship: 'fa-shipping-fast',
        impersonate: 'fa-user-secret',
        login: 'fa-sign-in-alt',
        logout: 'fa-sign-out-alt',
        'login-fail': 'fa-user-lock',
        password: 'fa-key',
        other: 'fa-circle'
    };

    var $feed = $('#auditFeed');
    var fetchSeq = 0;
    var currentItems = [];

    function esc(text) {
        if (text === null || text === undefined) return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function highlight(text, term) {
        var safe = esc(text);
        var trimmed = (term || '').trim();
        if (!trimmed) return safe;
        var parts = trimmed.split(/\s+/).map(function(p) {
            return esc(p).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }).filter(Boolean);
        if (!parts.length) return safe;
        return safe.replace(new RegExp('(' + parts.join('|') + ')', 'gi'), '<mark>$1</mark>');
    }

    function parseBrowserOS(ua) {
        if (!ua) return { browser: '', os: '' };
        var browser = 'Unknown';
        var os = '';
        if (/Edg\//.test(ua)) browser = 'Edge';
        else if (/OPR\/|Opera/.test(ua)) browser = 'Opera';
        else if (/Chrome\//.test(ua)) browser = 'Chrome';
        else if (/Safari\//.test(ua) && !/Chrome/.test(ua)) browser = 'Safari';
        else if (/Firefox\//.test(ua)) browser = 'Firefox';
        else if (/MSIE|Trident/.test(ua)) browser = 'IE';
        if (/Windows NT 10/.test(ua)) os = 'Windows';
        else if (/Windows/.test(ua)) os = 'Windows';
        else if (/Mac OS X/.test(ua)) os = 'macOS';
        else if (/Android/.test(ua)) os = 'Android';
        else if (/iPhone|iPad|iOS/.test(ua)) os = 'iOS';
        else if (/Linux/.test(ua)) os = 'Linux';
        return { browser: browser, os: os };
    }

    function deviceLabel(item) {
        var b = item.browser || '';
        var o = item.os || '';
        if (!b && !o) {
            var p = parseBrowserOS(item.userAgent);
            b = p.browser;
            o = p.os;
        }
        return b && o ? b + ' · ' + o : (b || o);
    }

    function roleSlug(role) {
        var r = String(role || '').toLowerCase();
        if (r === 'data manager') return 'datamanager';
        return r || 'system';
    }

    function valueHtml(v) {
        return v === '' || v === null || v === undefined
            ? '<span class="chg-empty">' + esc(T.empty) + '</span>'
            : esc(v);
    }

    function changeHtml(c) {
        return '<span class="chg-label">' + esc(c.label) + ':</span> '
            + '<span class="chg-from">' + valueHtml(c.from) + '</span> → '
            + '<span class="chg-to">' + valueHtml(c.to) + '</span>';
    }

    // Consecutive look-alike entries read as one row with a count. They must
    // match on everything the detail panel shows, so merging never hides a
    // different IP address, session, page or account.
    function collapseRepeats(items) {
        var out = [];
        items.forEach(function(item) {
            var prev = out[out.length - 1];
            var plain = !(item.changes && item.changes.length) && !item.list && !item.important
                && !(item.facts && item.facts.length) && item.source !== 'login';
            if (prev && plain && prev.__plain && prev.dateKey === item.dateKey
                && prev.action === item.action && prev.userEmail === item.userEmail
                && prev.entityId === item.entityId && prev.onBehalfOf === item.onBehalfOf
                && prev.sessionHash === item.sessionHash && prev.ipAddress === item.ipAddress
                && prev.userAgent === item.userAgent && prev.route === item.route) {
                prev.__repeat = (prev.__repeat || 1) + 1;
                prev.__times = (prev.__times || [prev.time]).concat([item.time]);
                return;
            }
            item.__plain = plain;
            out.push(item);
        });
        return out;
    }

    function renderItem(item, idx) {
        var term = state.search;
        var icon = actionIcons[item.actionType] || actionIcons.other;
        var html = '<div class="audit-item' + (item.important ? ' is-important' : '') + '" data-idx="' + idx + '" role="button" tabindex="0">'
            + '<div class="audit-icon ' + esc(item.actionType) + '"><i class="fas ' + icon + '"></i></div>'
            + '<div class="audit-body">'
            + '<div class="audit-action">' + highlight(item.action, term)
            + (item.__repeat ? '<span class="audit-repeat" title="' + esc(T.repeated + ': ' + item.__times.join(', ')) + '">×' + item.__repeat + '</span>' : '')
            + '</div>';
        if (item.important && item.reason) {
            html += '<div class="audit-flag"><i class="fas fa-flag"></i> ' + esc(item.reason) + '</div>';
        }
        if (item.changes && item.changes.length) {
            var extra = item.changes.length - 1;
            html += '<div class="audit-changes">' + changeHtml(item.changes[0])
                + (extra > 0 ? ' <span class="more">· ' + esc(extra === 1 ? T.oneMoreChange : extra + ' ' + T.moreChanges) + '</span>' : '')
                + '</div>';
        } else if (item.list && item.list.total) {
            html += '<div class="audit-changes"><span class="chg-label">' + esc(item.list.title) + ':</span> ' + esc(item.list.total) + '</div>';
        }
        html += '<div class="audit-meta">'
            + '<span class="audit-user" title="' + esc(item.userEmail) + '">'
            + '<span class="audit-avatar">' + esc(item.userInitials) + '</span>'
            + '<span>' + highlight(item.userName, term) + '</span></span>';
        if (item.userRole && item.userRole !== 'Unknown') {
            html += '<span class="audit-role ' + roleSlug(item.userRole) + '">' + esc(item.userRole) + '</span>';
        }
        if (item.onBehalfOf) {
            html += '<span class="audit-behalf" title="' + esc(T.viewAs) + '"><i class="fas fa-user-secret"></i> ' + esc(T.asAccount) + ' ' + esc(item.onBehalfOf) + '</span>';
        }
        if (item.entityType && item.entityId) {
            html += '<span class="audit-entity" data-idx="' + idx + '" title="' + esc(T.historyOf) + '">'
                + '<span class="etype">' + esc(item.entityTypeLabel) + '</span> ' + highlight(item.entityLabel || item.entityId, term) + '</span>';
        } else if (item.context) {
            html += '<span>' + esc(item.context) + '</span>';
        }
        html += '</div></div>'
            + '<div class="audit-time">' + esc(item.time) + '</div>'
            + '</div>';
        return html;
    }

    function renderFeed(payload) {
        currentItems = collapseRepeats(payload.items || []);
        var total = payload.total || 0;
        $('#auditSummary').html('<strong>' + total.toLocaleString() + '</strong> ' + esc(T.entries));
        if (!currentItems.length) {
            $feed.html('<div class="empty-state"><i class="far fa-folder-open"></i>' + esc(T.none) + '</div>');
            $('#auditPagination').hide();
            return;
        }
        var html = '';
        var day = null;
        var dayItems = [];
        function flush() {
            if (!day) return;
            html += '<div class="day-group"><div class="day-header">' + esc(day.label)
                + ' <span class="count">' + dayItems.length + '</span></div>' + dayItems.join('') + '</div>';
        }
        currentItems.forEach(function(item, i) {
            if (!day || day.key !== item.dateKey) {
                flush();
                day = { key: item.dateKey, label: item.dateLabel };
                dayItems = [];
            }
            dayItems.push(renderItem(item, i));
        });
        flush();
        $feed.html(html);

        var start = (payload.page - 1) * payload.pageSize + 1;
        var end = Math.min(start + (payload.items || []).length - 1, total);
        $('#pageInfo').html(esc(T.showing) + ' <strong>' + start + '</strong>–<strong>' + end + '</strong> ' + esc(T.of) + ' <strong>' + total.toLocaleString() + '</strong>');
        $('#prevBtn').prop('disabled', payload.page <= 1);
        $('#nextBtn').prop('disabled', payload.page >= payload.totalPages);
        $('#auditPagination').show();
    }

    function filterParams() {
        var p = {};
        FILTER_KEYS.forEach(function(k) {
            if (state[k] !== '' && state[k] !== null && state[k] !== undefined) p[k] = state[k];
        });
        if (p.source === 'actions') delete p.source;
        return p;
    }

    function syncUrl() {
        if (!window.history || !window.history.replaceState) return;
        var qs = $.param(filterParams());
        window.history.replaceState(null, '', window.location.pathname + (qs ? '?' + qs : ''));
    }

    function readUrl() {
        var params = new URLSearchParams(window.location.search);
        FILTER_KEYS.forEach(function(k) {
            if (params.has(k)) state[k] = params.get(k) || '';
        });
        if (['actions', 'logins', 'all'].indexOf(state.source) === -1) state.source = 'actions';
    }

    function syncControls() {
        $('#auditSource .src-btn').removeClass('is-active').filter('[data-source="' + state.source + '"]').addClass('is-active');
        $('#type').val(state.type);
        $('#createdBy').val(state.createdBy);
        $('#searchBox').val(state.search);
        $('#searchWrap').toggleClass('has-value', !!state.search);
        $('#dateRange').val(state.startDate && state.endDate ? state.startDate + ' – ' + state.endDate : '');
        MORE_KEYS.forEach(function(k) { $('#' + k).val(state[k]); });
        var on = state.important === '1';
        $('#importantBtn').toggleClass('is-on', on).attr('aria-pressed', on ? 'true' : 'false');
        var moreCount = MORE_KEYS.filter(function(k) { return state[k] !== ''; }).length;
        $('#moreCount').text(moreCount).toggle(moreCount > 0);
        if (state.entityType && state.entityId) {
            $('#alScopeType').text(state.entityTypeLabel || '');
            $('#alScopeLabel').text(state.entityLabel || state.entityId);
            $('#alScope').addClass('is-visible');
        } else {
            $('#alScope').removeClass('is-visible');
        }
        renderChips();
        $('#exportBtn').attr('href', exportUrl + (function(qs) { return qs ? '?' + qs : ''; })($.param(filterParams())));
    }

    function renderChips() {
        var chips = [];
        function add(key, label, value) { chips.push({ key: key, text: label + ': ' + value }); }
        if (state.source === 'logins') chips.push({ key: 'source', text: T.chipLogins });
        if (state.source === 'all') chips.push({ key: 'source', text: T.chipAll });
        if (state.startDate) add('date', T.chipDate, state.startDate + ' – ' + state.endDate);
        if (state.createdBy) add('createdBy', T.chipUser, $('#createdBy option:selected').text().trim() || state.createdBy);
        if (state.type) add('type', T.chipContext, $('#type option:selected').text().trim() || state.type);
        if (state.important === '1') chips.push({ key: 'important', text: T.chipImportant });
        if (state.actorEmail) add('actorEmail', T.chipActor, state.actorEmail);
        if (state.labId) add('labId', T.chipLab, state.labId);
        if (state.onBehalfOf) add('onBehalfOf', T.chipBehalf, state.onBehalfOf);
        if (state.sessionHash) add('sessionHash', T.chipSession, state.sessionHash.substring(0, 8));
        if (state.requestId) add('requestId', T.chipRequest, state.requestId.substring(0, 8));
        if (state.search) add('search', T.chipSearch, state.search);
        $('#alChips').html(chips.map(function(c) {
            return '<span class="al-chip">' + esc(c.text)
                + ' <button type="button" data-key="' + esc(c.key) + '" aria-label="' + esc(T.remove) + '">&times;</button></span>';
        }).join(''));
    }

    function clearFilter(key) {
        if (key === 'date') {
            state.startDate = '';
            state.endDate = '';
        } else if (key === 'source') {
            state.source = 'actions';
        } else if (key === 'entity') {
            state.entityType = '';
            state.entityId = '';
            state.entityLabel = '';
            state.entityTypeLabel = '';
        } else {
            state[key] = '';
        }
    }

    function refresh() {
        state.page = 1;
        syncControls();
        syncUrl();
        fetchFeed();
    }

    function fetchFeed() {
        var seq = ++fetchSeq;
        $feed.html('<div class="loading-state"><i class="fas fa-circle-notch fa-spin"></i>' + esc(T.loading) + '</div>');
        $.ajax({
            url: feedUrl,
            type: 'POST',
            dataType: 'json',
            data: $.extend({ page: state.page, pageSize: state.pageSize }, filterParams())
        }).done(function(payload) {
            if (seq !== fetchSeq) return;
            // The scope banner needs the type label, which the feed provides.
            if (state.entityType && !state.entityTypeLabel && payload.items && payload.items.length) {
                state.entityTypeLabel = payload.items[0].entityTypeLabel || '';
                if (!state.entityLabel) state.entityLabel = payload.items[0].entityLabel || '';
                syncControls();
            }
            renderFeed(payload);
        }).fail(function() {
            if (seq !== fetchSeq) return;
            $feed.html('<div class="empty-state"><i class="fas fa-exclamation-triangle"></i>' + esc(T.failed) + '</div>');
            $('#auditPagination').hide();
        });
    }

    function showEntity(item) {
        state = $.extend(blankState(), { pageSize: state.pageSize });
        state.entityType = item.entityType;
        state.entityId = item.entityId;
        state.entityLabel = item.entityLabel || item.entityId;
        state.entityTypeLabel = item.entityTypeLabel || '';
        closePanel();
        refresh();
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Detail panel
    var $panel = $('#alPanelBackdrop');
    var panelItem = null;

    function kv(label, value, mono) {
        if (value === '' || value === null || value === undefined) return '';
        return '<div class="k">' + esc(label) + '</div><div class="v' + (mono ? ' mono' : '') + '">' + esc(value) + '</div>';
    }

    function openPanel(item) {
        panelItem = item;
        $('#alPanelTitle').text(item.action || '');
        $('#alPanelTime').text(item.dateLabel + ' · ' + (item.__times ? item.__times.join(', ') : item.time));
        var body = '';
        if (item.important) {
            body += '<div class="al-section"><h4>' + esc(T.whyImportant) + '</h4><div class="al-reason"><i class="fas fa-flag"></i> '
                + esc(item.reason || T.important) + '</div></div>';
        }
        if (item.changes && item.changes.length) {
            body += '<div class="al-section"><h4>' + esc(T.changes) + '</h4><table class="al-table"><thead><tr><th>'
                + esc(T.field) + '</th><th>' + esc(T.before) + '</th><th>' + esc(T.after) + '</th></tr></thead><tbody>';
            item.changes.forEach(function(c) {
                body += '<tr><td>' + esc(c.label) + '</td><td class="chg-from">' + valueHtml(c.from) + '</td><td class="chg-to">' + valueHtml(c.to) + '</td></tr>';
            });
            body += '</tbody></table></div>';
        }
        if ((item.facts && item.facts.length) || item.list) {
            body += '<div class="al-section"><h4>' + esc(T.details) + '</h4>';
            if (item.facts && item.facts.length) {
                body += '<table class="al-table"><tbody>';
                item.facts.forEach(function(f) {
                    body += '<tr><td class="k">' + esc(f.label) + '</td><td>' + esc(f.value) + '</td></tr>';
                });
                body += '</tbody></table>';
            }
            if (item.list && item.list.rows && item.list.rows.length) {
                body += '<div style="margin-top:8px;font-weight:500;">' + esc(item.list.title) + ' (' + esc(item.list.total) + ')</div>'
                    + '<ul class="al-list">' + item.list.rows.map(function(r) { return '<li>' + esc(r) + '</li>'; }).join('') + '</ul>';
                if (item.list.total > item.list.rows.length) {
                    body += '<div class="al-list-note">' + esc(T.listMore) + ' ' + esc(item.list.total) + '</div>';
                }
            }
            body += '</div>';
        }
        body += '<div class="al-section"><h4>' + esc(T.who) + '</h4><div class="al-kv">'
            + kv(T.user, item.userName)
            + kv(T.email, item.userEmail, true)
            + kv(T.role, item.userRole)
            + kv(T.onBehalfOf, item.onBehalfOf, true)
            + kv(T.item, item.entityType ? (item.entityTypeLabel + ' ' + (item.entityLabel || item.entityId)) : '')
            + kv(T.context, item.context)
            + '</div></div>';
        body += '<div class="al-section"><h4>' + esc(T.where) + '</h4><div class="al-kv">'
            + kv(T.ip, item.ipAddress, true)
            + kv(T.browser, deviceLabel(item))
            + kv(T.channel, T.channels[item.channel] || item.channel)
            + kv(T.page, item.route, true)
            + kv(T.session, item.sessionHash, true)
            + kv(T.request, item.requestId, true)
            + '</div></div>';
        $('#alPanelBody').html(body).scrollTop(0);
        $('#alHistoryBtn').toggle(!!(item.entityType && item.entityId));
        $('#alRequestBtn').toggle(!!item.requestId);
        $('#alSessionBtn').toggle(!!item.sessionHash);
        $panel.addClass('is-open').attr('aria-hidden', 'false');
        $('#alPanelClose').trigger('focus');
    }

    function closePanel() {
        $panel.removeClass('is-open').attr('aria-hidden', 'true');
    }

    function onlyFilter(key, value) {
        state = $.extend(blankState(), { pageSize: state.pageSize, source: state.source });
        state[key] = value;
        closePanel();
        refresh();
    }

    $(document).ready(function() {
        readUrl();
        if (MORE_KEYS.some(function(k) { return state[k] !== ''; })) {
            $('#alMore').addClass('is-open');
            $('#moreBtn').attr('aria-expanded', 'true');
        }

        $('#dateRange').daterangepicker({
            locale: { cancelLabel: "<?= $this->jsTranslate('Clear') ?>", format: 'DD-MMM-YYYY', separator: ' – ' },
            autoApply: true,
            showDropdowns: true,
            alwaysShowCalendars: true,
            autoUpdateInput: false,
            ranges: eptDateRanges()
        }, function(start, end) {
            state.startDate = start.format('DD-MMM-YYYY');
            state.endDate = end.format('DD-MMM-YYYY');
            refresh();
        });
        $('#dateRange').on('cancel.daterangepicker', function() {
            clearFilter('date');
            refresh();
        });

        $('#type').on('change', function() { state.type = $(this).val(); refresh(); });
        $('#createdBy').on('change', function() { state.createdBy = $(this).val(); refresh(); });

        $('#importantBtn').on('click', function() {
            state.important = state.important === '1' ? '' : '1';
            refresh();
        });

        $('#moreBtn').on('click', function() {
            var open = !$('#alMore').hasClass('is-open');
            $('#alMore').toggleClass('is-open', open);
            $(this).attr('aria-expanded', open ? 'true' : 'false');
        });

        var debounce = {};
        $('#alMore input[data-key], #searchBox').on('input', function() {
            var key = $(this).data('key') || 'search';
            var val = $(this).val();
            if (key === 'search') $('#searchWrap').toggleClass('has-value', val.length > 0);
            clearTimeout(debounce[key]);
            debounce[key] = setTimeout(function() {
                state[key] = val.trim();
                refresh();
            }, 300);
        });

        $('#clearSearch').on('click', function() {
            state.search = '';
            refresh();
            $('#searchBox').trigger('focus');
        });

        $('#auditSource').on('click', '.src-btn', function() {
            var src = $(this).data('source');
            if (src === state.source) return;
            state.source = src;
            refresh();
        });

        $('#alChips').on('click', 'button[data-key]', function() {
            clearFilter($(this).data('key'));
            refresh();
        });

        $('#alScopeClear').on('click', function() {
            clearFilter('entity');
            refresh();
        });

        $feed.on('click', '.audit-entity', function(e) {
            e.stopPropagation();
            var item = currentItems[parseInt($(this).data('idx'), 10)];
            if (item) showEntity(item);
        });

        $feed.on('click', '.audit-item', function() {
            var item = currentItems[parseInt($(this).data('idx'), 10)];
            if (item) openPanel(item);
        });
        $feed.on('keydown', '.audit-item', function(e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                $(this).trigger('click');
            }
        });

        $('#alPanelClose').on('click', closePanel);
        $panel.on('click', function(e) { if (e.target === this) closePanel(); });
        $(document).on('keydown', function(e) {
            if (e.key === 'Escape' && $panel.hasClass('is-open')) closePanel();
        });
        $('#alHistoryBtn').on('click', function() { if (panelItem) showEntity(panelItem); });
        $('#alRequestBtn').on('click', function() { if (panelItem) onlyFilter('requestId', panelItem.requestId); });
        $('#alSessionBtn').on('click', function() { if (panelItem) onlyFilter('sessionHash', panelItem.sessionHash); });

        $('#pageSize').on('change', function() {
            state.pageSize = parseInt($(this).val(), 10) || 25;
            state.page = 1;
            fetchFeed();
        });
        $('#prevBtn').on('click', function() {
            if (state.page > 1) {
                state.page -= 1;
                fetchFeed();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        });
        $('#nextBtn').on('click', function() {
            state.page += 1;
            fetchFeed();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        syncControls();
        fetchFeed();
    });
})();
</script>
