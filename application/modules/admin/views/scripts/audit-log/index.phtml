    @media (max-width: 640px) {
        .audit-item {
            grid-template-columns: 28px 1fr;
        }

        .audit-icon {
            width: 28px;
            height: 28px;
            font-size: 12px;
        }

        .audit-time {
            grid-column: 2;
        }

        .al-kv {
            grid-template-columns: 1fr;
        }
