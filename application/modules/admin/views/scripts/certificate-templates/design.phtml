<script src="<?= $this->baseUrl('js/pdfjs/pdf.min.js'); ?>"></script>
<script type="text/javascript">
(function () {
    var page = <?= $json($this->pageSize); ?>;
    var layout = <?= $json($this->layout); ?>;
    var samples = <?= $json(array_values($this->samples)); ?>;
    var fieldLabels = <?= $json($fieldLabels); ?>;
    var fontLabels = <?= $json($fontLabels); ?>;
    var cssFonts = {
        helvetica: 'Helvetica, Arial, sans-serif',
        times: '"Times New Roman", Times, serif',
        dejavusans: '"DejaVu Sans", Verdana, sans-serif',
        dejavuserif: '"DejaVu Serif", Georgia, serif'
    };
    var PT_TO_MM = 0.3528;
    var elements = (layout.elements || []).map(function (el) { return $.extend({}, el); });
    var selected = -1;
    var sampleIndex = 0;
    var scale = 1; // screen pixels per mm
    var dirty = false;
    var $stage = $('#cdStage');
    var measure = document.createElement('canvas').getContext('2d');

    // Sample participants, and the details they fill in.
    $.each(samples, function (i, sample) {
        $('#cdSample').append($('<option/>').val(i).text(sample.participant_name || ("Sample " + (i + 1))));
    });
    $('#cdSample').append($('<option/>').val('fields').text("<?= $this->jsTranslate("Detail names"); ?>"));
    $('#cdSample').on('change', function () {
        sampleIndex = this.value;
        render();
    });

    $.each(fieldLabels, function (field, label) {
        $('<button type="button" class="btn"/>')
            .toggleClass('is-required', field === 'participant_name')
            .attr('data-field', field)
            .text(label)
            .on('click', function () { addField(field); })
            .appendTo('#cdAdd');
        $('#cdInsert').append($('<option/>').val(field).text(label));
    });
    $.each(fontLabels, function (font, label) {
        $('#cdFont').append($('<option/>').val(font).text(label));
    });

    function fill(text) {
        return text.replace(/\{([a-z_]+)\}/g, function (m, field) {
            if (sampleIndex === 'fields') {
                return '[' + (fieldLabels[field] || field) + ']';
            }
            var sample = samples[sampleIndex] || {};
            return sample[field] !== undefined ? sample[field] : '';
        });
    }

    function markDirty() {
        dirty = true;
        $('#cdStatus').text("<?= $this->jsTranslate("Unsaved changes"); ?>");
        renderChecks();
    }

    function newBox(text, opts) {
        var w = opts.w || page.width * 0.5;
        elements.push($.extend({
            text: text,
            x: Math.round((page.width - w) / 2 * 10) / 10,
            y: Math.round(page.height * 0.45),
            w: w,
            h: opts.h || 12,
            font: 'helvetica',
            size: opts.size || 16,
            bold: !!opts.bold,
            italic: false,
            color: '#000000',
            align: 'C',
            fit: opts.fit || 'shrink'
        }, opts.extra || {}));
        selected = elements.length - 1;
        markDirty();
        render();
        $('#cdText').focus();
    }

    function addField(field) {
        if (field === 'participant_name') {
            newBox('{participant_name}', { w: page.width * 0.6, h: 16, size: 28, bold: true });
        } else {
            newBox('{' + field + '}', { w: page.width * 0.35, h: 10, size: 14 });
        }
    }

    $('#cdAddText').on('click', function () {
        newBox("<?= $this->jsTranslate("Your text"); ?>", { w: page.width * 0.5, h: 10, size: 14, fit: 'wrap' });
        $('#cdText').select();
    });

    // Draw every box at its place on the page, with its text styled and
    // shrunk the way the PDF prints it.
    function render() {
        $stage.find('.cd-box').remove();
        $.each(elements, function (i, el) {
            var $box = $('<div class="cd-box"><div class="cd-text"></div><div class="cd-handle"></div></div>')
                .toggleClass('is-selected', i === selected)
                .toggleClass('is-wrap', el.fit === 'wrap')
                .attr('data-index', i)
                .css({
                    left: el.x * scale,
                    top: el.y * scale,
                    width: el.w * scale,
                    height: el.h * scale,
                    color: el.color,
                    fontFamily: cssFonts[el.font],
                    fontWeight: el.bold ? 'bold' : 'normal',
                    fontStyle: el.italic ? 'italic' : 'normal',
                    textAlign: { L: 'left', C: 'center', R: 'right' }[el.align]
                });
            var text = fill(el.text);
            var $text = $box.find('.cd-text').text(text);
            $stage.append($box);
            var size = el.size;
            var px = function (pt) { return pt * PT_TO_MM * scale; };
            $text.css('font-size', px(size) + 'px');
            if (el.fit === 'wrap') {
                while (size > 4 && $text[0].scrollHeight > $box.innerHeight() + 1) {
                    size -= 0.5;
                    $text.css('font-size', px(size) + 'px');
                }
            } else {
                // Same rule as the PDF: shrink to 60% of the size at most,
                // then wrap, centred on the box.
                var minSize = Math.max(4, el.size * <?= Application_Service_CertificateTemplates::MIN_SHRINK; ?>);
                var fontAt = function (pt) { return (el.italic ? 'italic ' : '') + (el.bold ? 'bold ' : '') + px(pt) + 'px ' + cssFonts[el.font]; };
                measure.font = fontAt(size);
                while (size > minSize && measure.measureText(text).width > el.w * scale) {
                    size -= 0.5;
                    measure.font = fontAt(size);
                }
                $text.css('font-size', px(size) + 'px');
                if (measure.measureText(text).width > el.w * scale) {
                    $box.addClass('is-overflow');
                }
            }
        });
        renderProps();
        renderChecks();
    }

    function renderProps() {
        var el = elements[selected];
        $('#cdProps').toggle(!!el);
        if (!el) {
            return;
        }
        if (document.activeElement !== $('#cdText')[0]) {
            $('#cdText').val(el.text);
        }
        $('#cdFont').val(el.font);
        if (document.activeElement !== $('#cdSize')[0]) {
            $('#cdSize').val(el.size);
        }
        $('#cdBold').toggleClass('is-on', el.bold);
        $('#cdItalic').toggleClass('is-on', el.italic);
        $('#cdColor').val(el.color);
        $('[data-align]').each(function () { $(this).toggleClass('is-on', $(this).data('align') === el.align); });
        $('[data-fit]').each(function () { $(this).toggleClass('is-on', $(this).data('fit') === el.fit); });
    }

    function renderChecks() {
        var all = elements.map(function (el) { return el.text; }).join(' ');
        var $list = $('#cdCheck').empty();
        var hasName = all.indexOf('{participant_name}') !== -1;
        $list.append($('<li/>').addClass(hasName ? 'is-ok' : 'is-missing')
            .append(hasName ? '<i class="icon-ok"></i> ' : '<i class="icon-remove"></i> ')
            .append($('<span/>').text(hasName
                ? "<?= $this->jsTranslate("The participant name is on the design."); ?>"
                : "<?= $this->jsTranslate("Add the participant name. Certificates cannot print without it."); ?>")));
        $list.append($('<li class="is-ok"/>').append('<i class="icon-eye-open"></i> ')
            .append($('<span/>').text("<?= $this->jsTranslate("Switch Showing to each participant, to check that long names fit."); ?>")));
        $('#cdAdd .btn').each(function () {
            $(this).toggleClass('is-used', all.indexOf('{' + $(this).data('field') + '}') !== -1);
        });
    }

    function update(changes) {
        if (!elements[selected]) {
            return;
        }
        $.extend(elements[selected], changes);
        markDirty();
        render();
    }

    $('#cdText').on('input', function () { update({ text: this.value }); });
    $('#cdInsert').on('change', function () {
        if (!this.value) {
            return;
        }
        var ta = $('#cdText')[0];
        var token = '{' + this.value + '}';
        var at = ta.selectionStart || ta.value.length;
        ta.value = ta.value.slice(0, at) + token + ta.value.slice(ta.selectionEnd || at);
        this.value = '';
        update({ text: ta.value });
    });
    $('#cdFont').on('change', function () { update({ font: this.value }); });
    $('#cdSize').on('input', function () {
        var v = parseFloat(this.value);
        if (v >= 4 && v <= 120) {
            update({ size: v });
        }
    });
    $('#cdBold').on('click', function () { update({ bold: !elements[selected].bold }); });
    $('#cdItalic').on('click', function () { update({ italic: !elements[selected].italic }); });
    $('#cdColor').on('input', function () { update({ color: this.value }); });
    $('[data-align]').on('click', function () { update({ align: $(this).data('align') }); });
    $('[data-fit]').on('click', function () { update({ fit: $(this).data('fit') }); });
    $('#cdCenter').on('click', function () {
        var el = elements[selected];
        update({ x: Math.round((page.width - el.w) / 2 * 100) / 100 });
    });
    $('#cdDelete').on('click', function () {
        elements.splice(selected, 1);
        selected = -1;
        markDirty();
        render();
    });

    // Drag a box to move it, or its corner handle to resize it. The box
    // snaps to the page's centre line when it comes within 2 mm of it.
    var drag = null;
    $stage.on('pointerdown', '.cd-box', function (e) {
        selected = parseInt($(this).attr('data-index'), 10);
        var el = elements[selected];
        drag = {
            resize: $(e.target).hasClass('cd-handle'),
            startX: e.clientX,
            startY: e.clientY,
            orig: $.extend({}, el)
        };
        // Capture on the stage: render() replaces the box while it moves.
        $stage[0].setPointerCapture(e.pointerId);
        render();
        e.preventDefault();
    });
    $stage.on('pointermove', function (e) {
        if (!drag || !elements[selected]) {
            return;
        }
        var dx = (e.clientX - drag.startX) / scale;
        var dy = (e.clientY - drag.startY) / scale;
        var el = elements[selected];
        var o = drag.orig;
        if (drag.resize) {
            el.w = Math.max(5, Math.round((o.w + dx) * 10) / 10);
            el.h = Math.max(4, Math.round((o.h + dy) * 10) / 10);
        } else {
            el.x = Math.max(0, Math.min(page.width - el.w, Math.round((o.x + dx) * 10) / 10));
            el.y = Math.max(0, Math.min(page.height - el.h, Math.round((o.y + dy) * 10) / 10));
        }
        var center = (page.width - el.w) / 2;
        var snapped = !drag.resize && Math.abs(el.x - center) < 2;
        if (snapped) {
            el.x = Math.round(center * 100) / 100;
        }
        $('#cdGuide').css('left', page.width / 2 * scale).toggle(snapped);
        markDirty();
        render();
    });
    $stage.on('pointerup pointercancel', function () {
        drag = null;
        $('#cdGuide').hide();
    });
    $stage.on('pointerdown', function (e) {
        if (e.target === $('#cdCanvas')[0]) {
            selected = -1;
            render();
        }
    });

    $(document).on('keydown', function (e) {
        var el = elements[selected];
        if (!el || $(e.target).is('input, textarea, select')) {
            return;
        }
        var step = e.shiftKey ? 5 : 0.5;
        var moves = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] };
        if (moves[e.key]) {
            update({
                x: Math.max(0, Math.round((el.x + moves[e.key][0]) * 10) / 10),
                y: Math.max(0, Math.round((el.y + moves[e.key][1]) * 10) / 10)
            });
            e.preventDefault();
        } else if (e.key === 'Delete' || e.key === 'Backspace') {
            $('#cdDelete').click();
            e.preventDefault();
        }
    });

    function payload() {
        return JSON.stringify({ version: 1, elements: elements });
    }

    $('#cdSave').on('click', function () {
        var $btn = $(this).prop('disabled', true);
        $.post("<?= $saveUrl; ?>", { scheme: <?= $json($this->scheme); ?>, type: <?= $json($this->type); ?>, layout: payload() }, function (response) {
            if (response && response.success) {
                dirty = false;
                $('#cdStatus').text(response.hasName
                    ? "<?= $this->jsTranslate("Saved"); ?>"
                    : "<?= $this->jsTranslate("Saved. Add the participant name before generating certificates."); ?>");
            } else {
                alert((response && response.message) || "<?= $this->jsTranslate("The design could not be saved. Please try again."); ?>");
            }
        }, 'json').fail(function () {
            alert("<?= $this->jsTranslate("The design could not be saved. Please try again."); ?>");
        }).always(function () {
            $btn.prop('disabled', false);
        });
    });

    $('#cdPreview').on('click', function () {
        $('#cdPreviewLayout').val(payload());
        // submit() skips the submit handlers, including the one that adds the CSRF token.
        if (typeof addCsrfTokenToForm === 'function') {
            addCsrfTokenToForm($('#cdPreviewForm'));
        }
        $('#cdPreviewForm')[0].submit();
    });

    window.addEventListener('beforeunload', function (e) {
        if (dirty) {
            e.preventDefault();
            e.returnValue = '';
        }
    });

    // Draw the design's first page to fit the column, sharp on high-density
    // screens, and redraw when the window size changes.
    pdfjsLib.GlobalWorkerOptions.workerSrc = "<?= $this->baseUrl('js/pdfjs/pdf.worker.min.js'); ?>";
    var pdfPage = null;
    function drawPage() {
        if (!pdfPage) {
            return;
        }
        var width = $stage.width();
        var base = pdfPage.getViewport({ scale: 1 });
        var viewport = pdfPage.getViewport({ scale: width / base.width * (window.devicePixelRatio || 1) });
        var canvas = document.getElementById('cdCanvas');
        canvas.width = viewport.width;
        canvas.height = viewport.height;
        scale = width / page.width;
        pdfPage.render({ canvasContext: canvas.getContext('2d'), viewport: viewport }).promise.then(render);
    }
    pdfjsLib.getDocument("<?= $designUrl; ?>").promise.then(function (doc) {
        return doc.getPage(1);
    }).then(function (p) {
        pdfPage = p;
        $('#cdLoading').remove();
        drawPage();
    }).catch(function () {
        $('#cdLoading').text("<?= $this->jsTranslate("The design could not be shown. Upload it again from the templates page."); ?>");
    });
    var resizeTimer = null;
    $(window).on('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(drawPage, 150);
    });
    renderChecks();
})();
</script>
