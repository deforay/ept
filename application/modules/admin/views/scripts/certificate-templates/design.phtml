$query = '?scheme=' . urlencode($this->scheme) . '&type=' . urlencode($this->type);
$backUrl = $this->url(['module' => 'admin', 'controller' => 'certificate-templates'], 'default', true) . '#scheme-' . urlencode($this->scheme);
$designUrl = $this->url(['module' => 'admin', 'controller' => 'certificate-templates', 'action' => 'download'], 'default', true) . $query;
$saveUrl = $this->url(['module' => 'admin', 'controller' => 'certificate-templates', 'action' => 'save-layout'], 'default', true);
$previewUrl = $this->url(['module' => 'admin', 'controller' => 'certificate-templates', 'action' => 'preview'], 'default', true) . $query;
$fieldLabels = [
    'participant_name' => $this->translate->_("Participant name"),
    'lab_id' => $this->translate->_("Lab ID"),
    'city' => $this->translate->_("City"),
    'country' => $this->translate->_("Country"),
    'scheme_name' => $this->translate->_("Scheme name"),
    'assay' => $this->translate->_("Assay"),
    'shipment_year' => $this->translate->_("Shipment year"),
    'issue_date' => $this->translate->_("Issue date"),
    'signatory_name' => $this->translate->_("Signatory name"),
    'signatory_title' => $this->translate->_("Signatory title"),
];
$fontLabels = [
    'helvetica' => $this->translate->_("Sans"),
    'times' => $this->translate->_("Serif"),
    'dejavusans' => $this->translate->_("Sans, all languages"),
    'dejavuserif' => $this->translate->_("Serif, all languages"),
];
$json = fn ($v) => json_encode($v, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE);
