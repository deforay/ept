<script type="text/javascript">
$(document).ready(function() {
    var uploadUrl = '<?= $uploadUrl; ?>';
    var removeUrl = '<?= $removeUrl; ?>';
    var previewUrl = '<?= $previewUrl; ?>';

    // Highlight a scheme's row when the page is reached from a link such as
    // /admin/certificate-templates#scheme-vl
    if (window.location.hash.indexOf('#scheme-') === 0) {
        $(window.location.hash).css('background', '#fffbea');
    }

    $('.btn-upload-trigger').on('click', function() {
        $('#' + $(this).data('target')).slideToggle(150);
    });

    $('.upload-zone').on('click', function(e) {
        if (e.target.tagName !== 'INPUT') {
            $(this).find('input[type="file"]').click();
        }
    });

    $('.upload-zone').on('dragover dragenter', function(e) {
        e.preventDefault();
        e.stopPropagation();
        $(this).addClass('dragover');
    }).on('dragleave drop', function(e) {
        e.preventDefault();
        e.stopPropagation();
        $(this).removeClass('dragover');
    }).on('drop', function(e) {
        var files = e.originalEvent.dataTransfer.files;
        if (files.length > 0) {
            uploadFile(files[0], $(this).data('scheme'), $(this).data('type'), $(this).closest('.upload-container'));
        }
    });

    $('.upload-zone input[type="file"]').on('change', function() {
        if (this.files.length > 0) {
            var zone = $(this).closest('.upload-zone');
            uploadFile(this.files[0], zone.data('scheme'), zone.data('type'), zone.closest('.upload-container'));
        }
    });

    function uploadFile(file, scheme, type, container) {
        var progressBar = container.find('.progress-bar');
        var progressContainer = container.find('.upload-progress');
        var resultContainer = container.find('.validation-result');

        if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
            showResult(resultContainer, false, '<?= $this->jsTranslate("Please upload a PDF file"); ?>');
            return;
        }

        progressContainer.show();
        progressBar.css('width', '0%');
        resultContainer.hide();

        var formData = new FormData();
        formData.append('template', file);
        formData.append('scheme', scheme);
        formData.append('type', type);

        $.ajax({
            url: uploadUrl,
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            xhr: function() {
                var xhr = new window.XMLHttpRequest();
                xhr.upload.addEventListener('progress', function(e) {
                    if (e.lengthComputable) {
                        progressBar.css('width', Math.round((e.loaded / e.total) * 100) + '%');
                    }
                }, false);
                return xhr;
            },
            success: function(response) {
                progressContainer.hide();
                if (!response.success) {
                    showResult(resultContainer, false, response.message);
                    return;
                }
                var $msg = $('<div/>').append($('<strong/>').text("<?= $this->jsTranslate("Template saved."); ?>"));
                if (response.fields && response.fields.length > 0) {
                    $msg.append($('<div/>').text("<?= $this->jsTranslate("Fields found:"); ?> " + response.fields.join(', ')));
                }
                if (response.unknown && response.unknown.length > 0) {
                    $msg.append($('<div class="ct-note"/>').text("<?= $this->jsTranslate("ePT does not fill these fields, so they print as they are in the template. If one is meant to show participant details, rename it and upload again:"); ?> " + response.unknown.join(', ')));
                }
                $msg.append($('<div style="margin-top:8px;"/>')
                    .append($('<a class="btn btn-primary btn-xs" target="_blank"/>')
                        .attr('href', previewUrl + '?scheme=' + encodeURIComponent(scheme) + '&type=' + encodeURIComponent(type))
                        .text("<?= $this->jsTranslate("Preview with a real participant"); ?>"))
                    .append(' ')
                    .append($('<button type="button" class="btn btn-default btn-xs"/>')
                        .text("<?= $this->jsTranslate("Done"); ?>")
                        .on('click', function () { location.reload(); })));
                resultContainer.removeClass('error').addClass('success').empty().append($msg).show();
            },
            error: function(xhr, status, error) {
                progressContainer.hide();
                showResult(resultContainer, false, '<?= $this->jsTranslate("Upload failed:"); ?> ' + error);
            }
        });
    }

    function showResult(container, success, message) {
        container.removeClass('success error').addClass(success ? 'success' : 'error').text(message).show();
    }

    $('.btn-remove').on('click', function() {
        var scheme = $(this).data('scheme');
        var type = $(this).data('type');
        var typeName = type === 'participation' ? '<?= $this->jsTranslate("participation") ?>' : '<?= $this->jsTranslate("excellence") ?>';

        if (confirm('<?= $this->jsTranslate("Are you sure you want to remove this %s certificate template?") ?>'.replace('%s', function () { return typeName; }))) {
            $.ajax({
                url: removeUrl,
                type: 'POST',
                data: { scheme: scheme, type: type },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert(response.message || '<?= $this->jsTranslate("Failed to remove template") ?>');
                    }
                },
                error: function() {
                    alert('<?= $this->jsTranslate("Failed to remove template") ?>');
                }
            });
        }
    });
});
</script>
