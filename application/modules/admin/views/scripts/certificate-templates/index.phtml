<?php
$ct = $this->certificateTemplates;
$downloadUrl = $this->url(array('module' => 'admin', 'controller' => 'certificate-templates', 'action' => 'download'), 'default', true);
$uploadUrl = $this->url(array('module' => 'admin', 'controller' => 'certificate-templates', 'action' => 'upload'), 'default', true);
$removeUrl = $this->url(array('module' => 'admin', 'controller' => 'certificate-templates', 'action' => 'remove'), 'default', true);
$previewUrl = $this->url(array('module' => 'admin', 'controller' => 'certificate-templates', 'action' => 'preview'), 'default', true);
$batchesUrl = $this->url(array('module' => 'admin', 'controller' => 'certificate-batches'), 'default', true);
$templateDir = SCHEDULED_JOBS_FOLDER . DIRECTORY_SEPARATOR . 'certificate-templates' . DIRECTORY_SEPARATOR;

// Every field name and alias ePT fills, to mark the fields it ignores.
$knownFields = [];
foreach (Application_Service_CertificateTemplates::FIELDS as $field => $aliases) {
    foreach (array_merge([$field], $aliases) as $name) {
        $knownFields[$name] = true;
    }
}
$fieldHelp = [
    'participant_name' => $this->translate->_("The lab name, or the person's name for individual participants. Required."),
    'lab_id' => $this->translate->_("The participant's Lab ID"),
    'city' => $this->translate->_("The participant's city"),
    'country' => $this->translate->_("The participant's country"),
    'scheme_name' => $this->translate->_("The scheme name"),
    'assay' => $this->translate->_("The VL or EID assay the participant used"),
    'shipment_year' => $this->translate->_("The year of the shipments the certificate covers"),
    'issue_date' => $this->translate->_("The date the certificates are generated"),
    'signatory_name' => $this->translate->_("Certificate Signatory Name, from Global Settings"),
    'signatory_title' => $this->translate->_("Certificate Signatory Title, from Global Settings"),
];

// One slot per scheme and certificate type, Excellence first.
$types = [
    'excellence' => ['label' => $this->translate->_("Excellence"), 'column' => 'excellence_certificate', 'fields' => 'e_detected_fields', 'suffix' => '-e.pdf'],
    'participation' => ['label' => $this->translate->_("Participation"), 'column' => 'participation_certificate', 'fields' => 'p_detected_fields', 'suffix' => '-p.pdf'],
];
$rows = [];
$uploaded = 0;
foreach ($this->schemes as $scheme) {
    $schemeType = $scheme['scheme_id'];
    $slots = [];
    foreach ($types as $type => $def) {
        $file = $ct[$schemeType][$def['column']] ?? '';
        if ($file === '' || !is_file($templateDir . $file)) {
            $file = is_file($templateDir . $schemeType . $def['suffix']) ? $schemeType . $def['suffix'] : '';
        }
        $fields = !empty($ct[$schemeType][$def['fields']]) ? (array) Pt_Commons_JsonUtility::safeDecode($ct[$schemeType][$def['fields']]) : [];
        $unknown = array_values(array_filter($fields, fn ($f) => !isset($knownFields[strtolower((string) $f)])));
        $slots[$type] = ['file' => $file, 'fields' => $fields, 'unknown' => $unknown];
        if ($file !== '') {
            $uploaded++;
        }
    }
    $rows[] = ['type' => $schemeType, 'name' => $scheme['scheme_name'], 'slots' => $slots];
}
$total = count($rows) * count($types);
