<script type="text/javascript">


var currentStep = 1;
var totalSteps = 3;

    $('#fileName').on('change', function() {
        showSelectedFiles(this.files);
    });

    function showSelectedFiles(files) {
        var html = '';
        for (var i = 0; i < files.length; i++) {
            var file = files[i];
            var ext = file.name.split('.').pop().toUpperCase();
            html +=
                '<div class="bi-filecard active">' +
                '<div class="bi-file-icon">' + $('<div>').text(ext).html() + '</div>' +
                '<div class="bi-file-meta">' +
                '<div class="bi-file-name">' + $('<div>').text(file.name).html() + '</div>' +
                '<div class="bi-file-size">' + formatBytes(file.size) + '</div>' +
                '</div></div>';
        }
        $('.cardDiv').html(html);
    }

    function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1024 / 1024).toFixed(2) + ' MB';
    }

        function getShipmentCodes() {
		schemeType = $("#scheme").select2("val");
		$('#shipmentId').select2('data', null);

		$.blockUI();
		$.post("<?php echo $this->url(array('module' => 'reports', 'controller' => 'common', 'action' => 'get-shipments-by-scheme')); ?>", {
			schemeType: schemeType,
			format: "html"
		},
			function (data) {
				if (data == 0) {
					shipmentCode = false;
				} else {
					$("#shipmentId").html(data);
					shipmentCode = true;
				}

				$.unblockUI();
			});
	}




/*
|--------------------------------------------------------------------------
| SHOW STEP
|--------------------------------------------------------------------------
*/
function showStep(step)
{
    /*
     * Hide all contents
     */
    $('.wizard-content').removeClass('active');


    /*
     * Show current step
     */
    $('.wizard-content[data-step="' + step + '"]')
        .addClass('active');


    /*
     * Update step indicators
     */
    $('.wizard-step').each(function () {

        var stepNumber =
            parseInt($(this).data('step'));

        $(this).removeClass(
            'active completed'
        );

        if (stepNumber < step) {

            $(this).addClass('completed');

        } else if (stepNumber === step) {

            $(this).addClass('active');

        }

    });


    /*
     * Previous button
     */
    if (step === 1) {

        $('#previousButton').hide();

    } else {

        $('#previousButton').show();

    }


    /*
     * Next / Submit
     */
    if (step === 1) {

        // Step 1
        $('#nextButton').show();
        $('#submitButton').hide();

    } else if (step === 2) {

        // Step 2
        $('#nextButton').show();
        $('#submitButton').hide();

    } else if (step === 3) {

        // Step 3 - Review
        $('#nextButton').hide();
        $('#submitButton').show();

    }
}

/*
|--------------------------------------------------------------------------
| VALIDATE CURRENT STEP
|--------------------------------------------------------------------------
*/

function validateStep(step)
{
    if (step === 1) {

        if ($('.participant-check').length === 0) {
            alert('<?= $this->jsTranslate("Please click Load Participants to load the participant list first."); ?>');
            return false;
        }

        if ($('.participant-check:checked').length === 0) {
            alert('<?= $this->jsTranslate("Please select at least one participant to receive the files."); ?>');
            return false;
        }

        var hasNewFiles = $('#fileName')[0].files.length > 0;
        if (!hasNewFiles && uploadedFileCount === 0) {
            alert('<?= $this->jsTranslate("Please upload at least one file."); ?>');
            $('#fileName').focus();
            return false;
        }

    }

    return true;
}


/*
|--------------------------------------------------------------------------
| NEXT
|--------------------------------------------------------------------------
*/

 
$('#nextButton').on('click', function (e) {
    e.preventDefault();
    if (currentStep === 1) {

        if (!validateStep(1)) {
            return;
        }

        if ($('#fileName')[0].files.length > 0) {
            uploadFilesToTemporaryFolder();
        }

        currentStep = 2;
        showStep(currentStep);

        return;
    }

    if (currentStep === 2) {
        buildConfirmation();

        currentStep = 3;

        showStep(currentStep);

        return;
    }
});

/*
|--------------------------------------------------------------------------
| PREVIOUS
|--------------------------------------------------------------------------
*/

$('#previousButton').on('click', function () {

    if (currentStep > 1) {

        currentStep--;

    }
    showStep(currentStep);


});


/*
|--------------------------------------------------------------------------
| FILE UPLOAD
|--------------------------------------------------------------------------
*/

var uploadedFileCount = 0;
var lastUploadedFiles = [];

function escapeText(value) {
    return $('<div>').text(value == null ? '' : String(value)).html();
}

function getParticipants()
{
    $.blockUI();
    $.post("<?php echo $this->url(array('controller' => 'files-for-participants', 'action' => 'get-participants-for-files')); ?>", {
        scheme: $("#scheme").val(),
        shipmentId: $("#shipmentId").val(),
        country: $("#country").val(),
        region: $("#region").val(),
        state: $("#state").val(),
        district: $("#district").val(),
        result: $("#filterResult").val(),
        format: "html"
    },
    function (response) {
        $.unblockUI();
        var rows = [];
        try {
            rows = (JSON.parse(response).data) || [];
        } catch (e) {
            rows = [];
        }

        $('#participantSearch').val('');
        $('#toggleAllParticipants').prop('checked', true);

        if (rows.length === 0) {
            $('#participantPicker').hide();
            $('#reviewParticipants').empty();
            $('#distributionSummary').empty();
            $('#noParticipantsMessage').html(
                '<div class="alert alert-warning"><?= $this->jsTranslate("No participants match the selected filters. Adjust the filters and load again."); ?></div>'
            );
            updateSelectedCount();
            return;
        }

        var html = '';
        $.each(rows, function (index, row) {
            var participantName = row[0] || '';
            var institute = row[1] || '';
            var labId = row[2] || '';
            var country = row[4] || '';
            var province = row[5] || '';
            var district = row[6] || '';
            var searchText = (participantName + ' ' + labId + ' ' + institute + ' ' +
                country + ' ' + province + ' ' + district).toLowerCase();
            html +=
                '<tr class="participant-row" data-search="' + escapeText(searchText) + '">' +
                '<td><input type="checkbox" class="participant-check" value="' + escapeText(row[3]) + '" checked></td>' +
                '<td>' + escapeText(participantName) + '</td>' +
                '<td>' + escapeText(labId) + '</td>' +
                '<td>' + escapeText(institute) + '</td>' +
                '<td>' + escapeText(country) + '</td>' +
                '<td>' + escapeText(province) + '</td>' +
                '<td>' + escapeText(district) + '</td>' +
                '</tr>';
        });

        $('#noParticipantsMessage').empty();
        $('#reviewParticipants').html(html);
        $('#participantPicker').show();
        updateSelectedCount();
    });
}

function updateSelectedCount()
{
    var total = $('.participant-check').length;
    var checked = $('.participant-check:checked').length;
    $('#selectedCountBadge').text(checked + ' / ' + total + ' <?= $this->jsTranslate("selected"); ?>');
}

/* Read-only recap for step 3: what will be sent, and to whom. */
function buildConfirmation()
{
    var checkedRows = $('.participant-check:checked').closest('.participant-row');

    $('#distributionSummary').html(
        '<p><?= $this->jsTranslate("You are about to distribute"); ?> <strong>' + uploadedFileCount + '</strong> ' +
        '<?= $this->jsTranslate("file(s) to"); ?> <strong>' + checkedRows.length + '</strong> ' +
        '<?= $this->jsTranslate("participant(s)"); ?>.</p>'
    );

    var filesHtml = '<ul class="list-group">';
    $.each(lastUploadedFiles, function (index, file) {
        filesHtml += '<li class="list-group-item">' +
            escapeText(file.original_name || file.file_name) +
            (file.size ? ' <span class="text-muted">(' + formatBytes(file.size) + ')</span>' : '') +
            '</li>';
    });
    filesHtml += '</ul>';
    $('#confirmFiles').html(filesHtml);

    var recipientsHtml = '<ul class="list-group">';
    checkedRows.each(function () {
        var cells = $(this).children('td');
        recipientsHtml += '<li class="list-group-item">' +
            escapeText($(cells[1]).text()) +
            ' <span class="text-muted">(' + escapeText($(cells[2]).text()) + ')</span>' +
            '</li>';
    });
    recipientsHtml += '</ul>';
    $('#confirmParticipants').html(recipientsHtml);
}

/* Row click toggles its checkbox; checkbox changes refresh the count. */
$(document).on('click', '.participant-row', function (e) {
    if (!$(e.target).is('input')) {
        var checkbox = $(this).find('.participant-check');
        checkbox.prop('checked', !checkbox.prop('checked'));
    }
    updateSelectedCount();
});
$(document).on('change', '.participant-check', updateSelectedCount);

/* Select all applies to the rows matching the current search. */
$(document).on('change', '#toggleAllParticipants', function () {
    var checked = $(this).prop('checked');
    $('.participant-row:visible .participant-check').prop('checked', checked);
    updateSelectedCount();
});

/* Debounced so typing stays smooth on instances with thousands of participants. */
var participantSearchTimer = null;
$(document).on('keyup input', '#participantSearch', function () {
    var term = $.trim($(this).val()).toLowerCase();
    clearTimeout(participantSearchTimer);
    participantSearchTimer = setTimeout(function () {
        $('.participant-row').each(function () {
            var matches = term === '' || ($(this).data('search') || '').indexOf(term) !== -1;
            $(this).toggle(matches);
        });
    }, 200);
});

/* Final gate: only checked participants are submitted, never an empty set. */
$('#participantWizardForm').on('submit', function (e) {
    var ids = $('.participant-check:checked').map(function () {
        return this.value;
    }).get();

    if ($('#temp_id').val() === '' || uploadedFileCount === 0) {
        alert('<?= $this->jsTranslate("No files have been uploaded. Please upload files first."); ?>');
        e.preventDefault();
        return false;
    }

    if (ids.length === 0) {
        alert('<?= $this->jsTranslate("Please select at least one participant."); ?>');
        e.preventDefault();
        return false;
    }

    $('#participantId').val(ids.join(','));
    $('#submitButton').prop('disabled', true);
});
 
function uploadFilesToTemporaryFolder() {

    var formData = new FormData();

    var files = $('#fileName')[0].files;

    for (var i = 0; i < files.length; i++) {
        formData.append('fileName[]', files[i]);
    }

    // Reuse the batch when re-visiting step 1 so earlier uploads are kept.
    formData.append('temp_id', $('#temp_id').val());

    $.ajax({
        url: '<?php echo $this->url(array("controller" => "files-for-participants","action" => "upload-temp")); ?>',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        dataType: 'json',

        success: function (response) {
            if (!response.status) {

                alert(response.message);
                currentStep = 1;
                showStep(currentStep);

                return;
            }

            if (response.rejected && response.rejected.length > 0) {
                alert('<?= $this->jsTranslate("These files were not accepted (unsupported file type):"); ?>\n' + response.rejected.join('\n'));
            }

            $('#fileName').val('');
            $('.cardDiv').empty();

            loadTemporaryFiles(response.temp_id);

        },

        error: function (xhr) {
            console.log(xhr.responseText);
            alert('<?= $this->jsTranslate("File upload failed. Please try again."); ?>');
            currentStep = 1;
            showStep(currentStep);
        }
    });
}


/*
|--------------------------------------------------------------------------
| LOAD TEMPORARY FILES
|--------------------------------------------------------------------------
*/

function loadTemporaryFiles(tempId)
{
    $('#uploadedFiles').html(
        '<div class="alert alert-info">' +
        'Loading files...' +
        '</div>'
    );

    $("#temp_id").val(tempId);

    $.ajax({

        url: '<?php echo $this->url(array("controller" => "files-for-participants","action" => "get-temporary-files")); ?>',
        type: 'GET',
        dataType: 'json',
        data: {
            temp_id: tempId
        },
        success: function(response) {

            if (!response.status) {

                $('#uploadedFiles').html(
                    '<div class="alert alert-danger">' +
                    response.message +
                    '</div>'
                );

                return;
            }


            displayTemporaryFiles(
                response.files
            );
            showStep(2);

        },

        error: function(xhr) {

            console.log(xhr.responseText);

            $('#uploadedFiles').html(
                '<div class="alert alert-danger">' +
                'Unable to load uploaded files.' +
                '</div>'
            );
        }

    });
}


/*
|--------------------------------------------------------------------------
| DISPLAY FILES
|--------------------------------------------------------------------------
*/

function displayTemporaryFiles(files)
{
    uploadedFileCount = files ? files.length : 0;
    lastUploadedFiles = files || [];

    if (!files || files.length === 0) {
        $('#uploadedFiles').html(
            '<div class="alert alert-info"><?= $this->jsTranslate("No files uploaded yet. Go back to upload files."); ?></div>'
        );
        return;
    }

    var iconByExtension = {
        pdf: 'icon-file-text',
        doc: 'icon-file-text', docx: 'icon-file-text', txt: 'icon-file-text',
        xls: 'icon-table', xlsx: 'icon-table', csv: 'icon-table',
        ppt: 'icon-list-alt', pptx: 'icon-list-alt',
        jpg: 'icon-picture', jpeg: 'icon-picture',
        png: 'icon-picture', gif: 'icon-picture',
        zip: 'icon-archive'
    };

    var html = '<ul class="list-group file-list">';

    $.each(files, function (index, file) {

        var fileUrl =
            '<?php echo $this->url(array("controller" => "files-for-participants", "action" => "view-temp-file")); ?>' +
            '?temp_id=' + encodeURIComponent(file.temp_id) +
            '&file=' + encodeURIComponent(file.file_name);

        var extension = file.file_name.split('.').pop().toLowerCase();
        var icon = iconByExtension[extension] || 'icon-file';

        html +=
            '<li class="list-group-item uploaded-file">' +
            '<span>' +
            '<i class="' + icon + '"></i> ' +
            '<a href="' + fileUrl + '" target="_blank" rel="noopener noreferrer" class="file-name file-name-link">' +
            $('<div>').text(file.original_name || file.file_name).html() +
            '</a>' +
            (file.size ? ' <span class="text-muted">(' + formatBytes(file.size) + ')</span>' : '') +
            '</span>' +
            '<button type="button" class="btn btn-danger btn-xs remove-temp-file" ' +
            'data-temp-id="' + $('<div>').text(file.temp_id).html() + '" ' +
            'data-file-name="' + $('<div>').text(file.file_name).html() + '">' +
            '<i class="icon-trash"></i> <?= $this->jsTranslate("Remove"); ?>' +
            '</button>' +
            '</li>';
    });

    html += '</ul>';

    $('#uploadedFiles').html(html);
}


/*
|--------------------------------------------------------------------------
| REMOVE TEMP FILE
|--------------------------------------------------------------------------
*/

$(document).on('click', '.remove-temp-file', function () {

    if (!confirm('<?= $this->jsTranslate("Are you sure you want to remove this file?"); ?>')) {
        return;
    }

    var tempId = $(this).data('temp-id');
    var fileName = $(this).data('file-name');

    $.ajax({
        url: '<?php echo $this->url(array('controller' => 'files-for-participants', 'action' => 'remove-temp-file' )); ?>',
        type: 'POST',
        dataType: 'json',
        data: {
            temp_id: tempId,
            file: fileName
        },
        success: function (response) {
            if (!response.status) {
                alert(response.message);
            }
            loadTemporaryFiles(tempId);
        }
    });

});


