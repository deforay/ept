 function getOptions(table, searchfield, returnfield, searchvalue, returnid) {
            $.blockUI();
            if(searchvalue == null || searchvalue == undefined || searchvalue == '') {
                $("#" + returnid).html('<option value="">-- <?= $this->translate->_("Select"); ?> --</option>');
                $.unblockUI();
                return false;
            }
            $.post("<?php echo $this->url(array('module' => 'default', 'controller' => 'common', 'action' => 'get-options-by-value')); ?>", {
                    table: table,
                    searchfield: searchfield,
                    returnfield: returnfield,
                    searchvalue: searchvalue,
                    format: "html"
                },
                function (data) {
                    if (data != 0 && data != '' && data != undefined) {
                        $("#" + returnid).html(data);
                    }
                    $.unblockUI();
                });
        }


