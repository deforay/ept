<script type="text/javascript">


var currentStep = 1;
var totalSteps = 3;

        var $input = $('#fileName');
        var $card = $('#biFileCard');
        var $name = $('#biFileName');
        var $size = $('#biFileSize');
         $input.on('change', function() {
            showFile(this.files);
        });

        

    function showFile(files) {

        for (var i = 0; i < files.length; i++) {

                var file = files[i];

                if (!file) {
                        $card.removeClass('active');
                        $drop.show();
                        return;
                    }
                    $name.text(file.name);
                    $size.text(formatBytes(file.size));
                    $card.addClass('active');

            $(".cardDiv").append(
                    '<div class="bi-filecard active" id="biFileCard"><div class="bi-file-icon">XLS</div><div class="bi-file-meta"><div class="bi-file-name" id="biFileName">'+file.name+'</div><div class="bi-file-size" id="biFileSize">'+file.size+'</div></div></div>');

            }

    }

    function formatBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / 1024 / 1024).toFixed(2) + ' MB';
    }

        function getShipmentCodes() {
		schemeType = $("#scheme").select2("val");
		$('#shipmentId').select2('data', null);

		$.blockUI();
		$.post("<?php echo $this->url(array('module' => 'reports', 'controller' => 'common', 'action' => 'get-shipments-by-scheme')); ?>", {
			schemeType: schemeType,
			format: "html"
		},
			function (data) {
				if (data == 0) {
					shipmentCode = false;
				} else {
					$("#shipmentId").html(data);
					shipmentCode = true;
				}

				$.unblockUI();
			});
	}




/*
|--------------------------------------------------------------------------
| SHOW STEP
|--------------------------------------------------------------------------
*/
function showStep(step)
{
    /*
     * Hide all contents
     */
    $('.wizard-content').removeClass('active');


    /*
     * Show current step
     */
    $('.wizard-content[data-step="' + step + '"]')
        .addClass('active');


    /*
     * Update step indicators
     */
    $('.wizard-step').each(function () {

        var stepNumber =
            parseInt($(this).data('step'));

        $(this).removeClass(
            'active completed'
        );

        if (stepNumber < step) {

            $(this).addClass('completed');

        } else if (stepNumber === step) {

            $(this).addClass('active');

        }

    });


    /*
     * Previous button
     */
    if (step === 1) {

        $('#previousButton').hide();

    } else {

        $('#previousButton').show();

    }


    /*
     * Next / Submit
     */
    if (step === 1) {

        // Step 1
        $('#nextButton').show();
        $('#submitButton').hide();

    } else if (step === 2) {

        // Step 2
        $('#nextButton').show();
        $('#submitButton').hide();

    } else if (step === 3) {

        // Step 3 - Review
        $('#nextButton').hide();
        $('#submitButton').show();

    }
}

/*
|--------------------------------------------------------------------------
| VALIDATE CURRENT STEP
|--------------------------------------------------------------------------
*/

function validateStep(step)
{
    var valid = true;

    if (step === 1) {

        var fileName =
            $.trim($('#fileName').val());

        if (fileName === '') {

            alert('Please upload file.');

            $('#fileName').focus();

            return false;
        }

    }

    return valid;
}


/*
|--------------------------------------------------------------------------
| NEXT
|--------------------------------------------------------------------------
*/

 
$('#nextButton').on('click', function (e) {
    e.preventDefault();
    if (currentStep === 1) {

        uploadFilesToTemporaryFolder();

        currentStep = 2;
        showStep(currentStep);

        return;
    }

    if (currentStep === 2) {
        getParticipants();

        currentStep = 3;

        showStep(currentStep);

        return;
    }
});

/*
|--------------------------------------------------------------------------
| PREVIOUS
|--------------------------------------------------------------------------
*/

$('#previousButton').on('click', function () {

    if (currentStep > 1) {

        currentStep--;

    }
    showStep(currentStep);


});


/*
|--------------------------------------------------------------------------
| FILE UPLOAD
|--------------------------------------------------------------------------
*/

function getParticipants()
{
    shipmentId = $("#shipmentId").val();
    country = $("#country").val();
    region = $("#region").val();
    state = $("#state").val();
    district = $("#district").val();
    result = $("#filterResult").val();
    html = '';
  //  $.blockUI();
		$.post("<?php echo $this->url(array('controller' => 'files-for-participants', 'action' => 'get-participants-for-files')); ?>", {
			shipmentId: shipmentId,
            country:country,
            region: region,
            state: state,
            district: district,
            result: result,
			format: "html"
		},
			function (response) {
                participants = JSON.parse(response);
                result = (participants.data);
         if (result.length === 0) {

            $('#reviewParticipants').html(
                '<div class="alert alert-warning">' +
                'No participants selected.' +
                '</div>'
            );

            return;
        }
        else{


            html += '<ul class="list-group">';

             participantIds = [];            
            $.each(participants, function(index, row) {

                var participantName = row[0];
                var participantId = row[2];
                /*
                * If row[0] is empty, use row[1]
                */
                if (!participantName) {
                    participantName = row[1];
                }


                html +=
                    '<li class="list-group-item">' +

                        '<span class="glyphicon ' +
                        'glyphicon-user"></span> ' +

                        $('<div>')
                            .text(participantName)
                            .html() +

                    '</li>';
                participantIds.push(participantId);
                
            });

            html += '</ul>';
                
                $('#reviewParticipants').html(html);
                  $('#participantId').val(participantIds.join(','));

        }
			});


}
 
function uploadFilesToTemporaryFolder() {

    var formData = new FormData();

    var files = $('#fileName')[0].files;

    for (var i = 0; i < files.length; i++) {
        formData.append('fileName[]', files[i]);
    }
 
    $.ajax({
        url: '<?php echo $this->url(array("controller" => "files-for-participants","action" => "upload-temp")); ?>',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        dataType: 'json',

        success: function (response) {
            if (!response.status) {

                alert(response.message);

                return;
            }

            loadTemporaryFiles(response.temp_id);

        },

        error: function (xhr) {
            console.log(xhr.responseText);
        }
    });
}


/*
|--------------------------------------------------------------------------
| LOAD TEMPORARY FILES
|--------------------------------------------------------------------------
*/

function loadTemporaryFiles(tempId)
{
    $('#uploadedFiles').html(
        '<div class="alert alert-info">' +
        'Loading files...' +
        '</div>'
    );

    $("#temp_id").val(tempId);

    $.ajax({

        url: '<?php echo $this->url(array("controller" => "files-for-participants","action" => "get-temporary-files")); ?>',
        type: 'GET',
        dataType: 'json',
        data: {
            temp_id: tempId
        },
        success: function(response) {

            if (!response.status) {

                $('#uploadedFiles').html(
                    '<div class="alert alert-danger">' +
                    response.message +
                    '</div>'
                );

                return;
            }


            displayTemporaryFiles(
                response.files
            );
            showStep(2);

        },

        error: function(xhr) {

            console.log(xhr.responseText);

            $('#uploadedFiles').html(
                '<div class="alert alert-danger">' +
                'Unable to load uploaded files.' +
                '</div>'
            );
        }

    });
}


/*
|--------------------------------------------------------------------------
| DISPLAY FILES
|--------------------------------------------------------------------------
*/

function displayTemporaryFiles(files)
{
    var html = '';


    if (!files || files.length === 0) {

        $('#uploadedFiles').html(

            '<div class="alert alert-info">' +
            'No files uploaded yet.' +
            '</div>'

        );

        return;
    }


    html +=
        '<ul class="list-group file-list">';


    $.each(files, function (index, file) {


        var fileUrl =
            '<?php echo $this->baseUrl(); ?>' +
            'files-for-participants/view-temp-file' +
            '?temp_id=' +
            encodeURIComponent(
                file.temp_id
            ) +
            '&file=' +
            encodeURIComponent(
                file.file_name
            );


        html +=
            '<li class="list-group-item uploaded-file">';


        html += '<span>';


        /*
         * File icon
         */

        var extension =
            file.file_name
                .split('.')
                .pop()
                .toLowerCase();


        var icon =
            'glyphicon-file';


        if (
            extension === 'pdf'
        ) {

            icon = 'glyphicon-file';

        } else if (
            extension === 'xls' ||
            extension === 'xlsx' ||
            extension === 'csv'
        ) {

            icon = 'glyphicon-list-alt';

        } else if (
            extension === 'jpg' ||
            extension === 'jpeg' ||
            extension === 'png' ||
            extension === 'gif'
        ) {

            icon = 'glyphicon-picture';

        }


        html +=
            '<span class="glyphicon ' +
            icon +
            '"></span>';


        /*
         * Filename
         */

        html +=
            '<a href="' +
            fileUrl +
            '" ' +
            'target="_blank" ' +
            'rel="noopener noreferrer" ' +
            'class="file-name file-name-link">' +

            $('<div>')
                .text(
                    file.original_name ||
                    file.file_name
                )
                .html() +

            '</a>';


        html += '</span>';


        /*
         * Remove button
         */

        html +=
            '<button type="button" ' +
            'class="btn btn-danger btn-xs remove-temp-file" ' +
            'data-temp-id="' +
            $('<div>')
                .text(file.temp_id)
                .html() +
            '" ' +
            'data-file-name="' +
            $('<div>')
                .text(file.file_name)
                .html() +
            '"' +

             'data-row="temp-file-' +
                    index +
                    '">' +

            '<span class="glyphicon ' +
            'glyphicon-trash"></span> ' +
            'Remove' +

            '</button>';


        html += '</li>';

    });


    html += '</ul>';


    $('#uploadedFiles')
        .html(html);
}


/*
|--------------------------------------------------------------------------
| REMOVE TEMP FILE
|--------------------------------------------------------------------------
*/

$(document).on(
    'click',
    '.remove-temp-file',
    function () {

        if (!confirm('Are you sure you want to remove this file?')) {
            return;
        }

        var tempId = $(this).data('temp-id');
        var fileName =  $(this).data('file-name');
        var rowId = $(this).attr('data-row');
        $.ajax({

            url: '<?php echo $this->url(array('controller' => 'files-for-participants', 'action' => 'remove-temp-file' )); ?>',
            type: 'POST',
            dataType: 'json',
            data: {
                temp_id: tempId,
                file: fileName
            },

            success: function (response) {

                 if (response.status) {

                    /*
                     * Remove only this row
                     */
                    $('#' + rowId).remove();

                } else {

                    alert(response.message);
                }

                loadTemporaryFiles(
                    tempId
                );

            }

        });

    }
);


