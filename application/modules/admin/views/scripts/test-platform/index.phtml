    id="testPlatformTable">
    <thead>
        <tr>
            <th scope="col"><?= $this->translate->_("Test platform Name"); ?></th>
            <th scope="col"><?= $this->translate->_("Scheme Name"); ?></th>
            <th scope="col"><?= $this->translate->_("Test Platform Manufacturer"); ?></th>
            <th scope="col"><?= $this->translate->_("Approval Agency"); ?></th>
            <th scope="col"><?= $this->translate->_("Approved"); ?></th>
            <th scope="col"><?= $this->translate->_("Created On"); ?></th>
            <th scope="col"><?= $this->translate->_("Action"); ?></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td colspan="6" class="dataTables_empty"><?= $this->translate->_("Loading data from server"); ?></td>
        </tr>
    </tbody>
</table>
