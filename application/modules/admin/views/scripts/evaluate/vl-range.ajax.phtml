                    $combined = 0;
                    foreach ($members as $m) {
                        $combined += $assayParticipants[$m] ?? 0;
                    }
                    // Stored order is by assay id; show them in name order so the chips read the
                    // way the admin thinks about the platforms.
                    $orderedMembers = $members;
                    usort($orderedMembers, static function ($a, $b) use ($assays) {
                        return strnatcasecmp($assays[$a] ?? '', $assays[$b] ?? '');
                    });
                    ?>
                    <div class="vlGroupRow" data-group>
                        <div class="vlGroupRowHead">
                            <span class="vlGroupTag"><?php echo htmlspecialchars($groupTitle($groupIndex)); ?></span>
