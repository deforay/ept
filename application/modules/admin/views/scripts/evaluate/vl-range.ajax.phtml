    <template id="vlGroupRowTemplate">
        <div class="vlGroupRow" data-group>
            <div class="vlGroupRowHead">
                <span class="vlGroupTag"><?= $this->translate->_("New group"); ?></span>
                <span class="vlGroupTotal" data-total>0 <?= $this->translate->_("participants combined"); ?></span>
            </div>
            <div class="vlGroupMembers" data-members></div>
            <select class="vlGroupPicker form-control input-sm" onchange="addVlChip(this)">
                <option value=""><?= $this->translate->_("Add a platform…"); ?></option>
