                        </div>
                        <div class="vlGroupMembers" data-members>
                            <?php foreach ($orderedMembers as $memberAssayId): ?>
                                <span class="vlChip" data-assay="<?php echo (int) $memberAssayId; ?>" data-n="<?php echo (int) ($assayParticipants[$memberAssayId] ?? 0); ?>">
                                    <?php echo htmlspecialchars($assays[$memberAssayId] ?? ('#' . $memberAssayId)); ?>
                                    <b><?php echo (int) ($assayParticipants[$memberAssayId] ?? 0); ?></b>
