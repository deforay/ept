                        </div>
                        <select class="vlGroupPicker form-control input-sm" onchange="addVlChip(this)">
                            <option value=""><?= $this->translate->_("Add a platform…"); ?></option>
                        </select>
                        <input type="hidden" name="assayGroup[]" value="<?php echo htmlspecialchars(implode(',', $members)); ?>">
                        <a href="javascript:void(0);" class="vlGroupRemove" onclick="removeVlGroupRow(this)"><?= $this->translate->_("Remove group"); ?></a>
                    </div>
                <?php endforeach; ?>
            </div>

            <div class="vlGroupActions">
                <a class="btn btn-default btn-xs" href="javascript:void(0);" onclick="addVlGroupRow()">
                    <i class="icon-plus"></i> <?= $this->translate->_("Add a group"); ?>
                </a>
                <button type="submit" class="btn btn-primary btn-xs">
                    <?= $this->translate->_("Save groups and recalculate"); ?>
