<?php

/**
 * Shipment Management View
 * Displays shipments under PT Survey with evaluation and reporting options
 */

// Validate shipments data
if (empty($this->shipments)) {
	echo '<br><br><br><h4 style="text-align:center;">' . $this->translate->_("Unable to fetch shipments. Please click view shipment or contact system admin for help") . '</h4>';
	return;
}

// Reports can be (re)generated and the shipment can be finalized once it has
// been evaluated. Previously gated on PT Survey Date < today; that gate has been
// removed. The per-shipment generateReportsEnabled / finalizeEnabled flags from
// getShipmentButtonStates() (computed in the row loop below) are the source of
// truth — server-side endpoints still enforce their own status preconditions.

// Determine report button states
$individualReportTitle = $this->translate->_('Generate Reports');
$individualReportClass = '';
$finalReportTitle = $this->translate->_('Finalize');
$finalReportClass = '';

if (isset($this->shipmentStatus['generateReport']['status'])) {
	$reportStatus = $this->shipmentStatus['generateReport']['status'];

	if ($reportStatus === 'pending') {
		$individualReportTitle = $this->translate->_('Processing..');
		$individualReportClass = 'disabled';
	} elseif ($reportStatus === 'evaluated') {
		$individualReportTitle = $this->translate->_('Generate Reports');
	}
}

if (isset($this->shipmentStatus['finalized']['status'])) {
	$finalizedStatus = $this->shipmentStatus['finalized']['status'];

	if ($finalizedStatus === 'pending') {
		$finalReportTitle = $this->translate->_('Processing..');
		$finalReportClass = 'disabled';
	} elseif ($finalizedStatus === 'finalized') {
		$finalReportTitle = $this->translate->_('Finalized');
	}
}
?>

<div class="modal-dialog" style="width:100%;">
	<div class="modal-header">
		<h4 class="modal-title">
			<?= $this->translate->_("Shipments Under PT Survey"); ?>
			<?= htmlspecialchars($this->shipments[0]['distribution_code']); ?>
			(<?= $this->dateFormat($this->shipments[0]['distribution_date']); ?>)
		</h4>
	</div>

	<div class="modal-body">
		<table class="table table-bordered table-striped table-hover">
			<thead>
				<tr>
					<th scope="col" style="text-align: center;"><?= $this->translate->_("Shipment Code"); ?></th>
					<th scope="col" style="text-align: center;"><?= $this->translate->_("Scheme"); ?></th>
					<th scope="col" style="text-align: center;"><?= $this->translate->_("No. of Samples"); ?></th>
					<th scope="col" style="text-align: center;"><?= $this->translate->_("No. of Participants"); ?></th>
					<th scope="col" style="text-align: center;"><?= $this->translate->_("No. of Responses"); ?></th>
					<th scope="col" style="text-align: center;"><?= $this->translate->_("Response%"); ?></th>
					<th scope="col" style="text-align: center;"><?= $this->translate->_("Number Passed"); ?></th>
					<th scope="col" style="text-align: center;"><?= $this->translate->_("Shipment Status"); ?></th>
					<th scope="col" style="text-align: center;"><?= $this->translate->_("Action"); ?></th>
				</tr>
			</thead>
			<tbody>
				<?php foreach ($this->shipments as $shipment): ?>
					<?php
					// Calculate metrics
					$reported = $shipment['reported_count'] ?? 0;
					$totalParticipants = $shipment['participant_count'];
					$passed = $shipment['number_passed'] ?? 0;
					$nonResponse = $totalParticipants - $reported;
					$responsePercentage = $totalParticipants > 0
						? round(($reported / $totalParticipants) * 100, 2)
						: 0;

					// Get button states from common function
					$btnStates = Application_Service_Shipments::getShipmentButtonStates($shipment);
					$isEvaluated = $btnStates['isEvaluated'];
					$hasReportsGenerated = $btnStates['hasReportsGenerated'];
					$isFinalized = $btnStates['isFinalized'];
					$isEphemeral = $btnStates['isEphemeral'];
					$viewEnabled = $btnStates['viewEnabled'];
					$generateReportsEnabled = $btnStates['generateReportsEnabled'];
					$finalizeEnabled = $btnStates['finalizeEnabled'];
					$displayStatus = $this->translate->_($btnStates['displayStatus']);
					$buttonText = $this->translate->_($btnStates['evaluateButtonText']);

					$evaluateButtonClass = $btnStates['evaluateEnabled'] ? '' : 'disabled';
					$generateReportsClass = $generateReportsEnabled ? '' : 'disabled';
					$finalizeClass = $finalizeEnabled ? '' : 'disabled';
					$encodedShipmentId = base64_encode($shipment['shipment_id']);

					// The "Mail Not Responded Participants" button reminds participants to
					// respond, so it only makes sense while the shipment is still open for
					// responses. Hide it when finalized, cancelled, or past the submission
					// due date (response deadline). No deadline set => still open.
					$isCancelled = !empty($shipment['cancelled_at']);
					$submissionCutoff = Pt_Commons_DateUtility::shipmentCutoff($shipment['response_deadline'] ?? null);
					$submissionOpen = ($submissionCutoff === null) || (new DateTimeImmutable('now') <= $submissionCutoff);
					$showMailNonResponders = ($nonResponse > 0 && !$isFinalized && !$isCancelled && $submissionOpen);
					?>

					<tr>
						<td style="text-align: center;"><?= htmlspecialchars($shipment['shipment_code']); ?></td>
						<td style="text-align: center;"><?= htmlspecialchars($shipment['scheme_name']); ?></td>
						<td style="text-align: center;"><?= (int) $shipment['number_of_samples']; ?></td>
						<td style="text-align: center;"><?= (int) $totalParticipants; ?></td>
						<td style="text-align: center;"><?= (int) $reported; ?></td>
						<td style="text-align: center;"><?= $responsePercentage; ?>%</td>
						<td style="text-align: center;"><?= (int) $passed; ?></td>
						<td style="text-align: center;">
							<?= ucfirst($shipment['shipment_status']); ?>
							<?php if (!empty($this->needsReEval[(int) $shipment['shipment_id']])): ?>
								<br>
								<span title="<?= $this->translate->_('New responses arrived after this shipment was last evaluated'); ?>"
									style="display:inline-block;margin-top:4px;font-size:11px;font-weight:600;color:#b06f12;background:#fff3df;border:1px solid #f0d9ad;border-radius:10px;padding:1px 8px;white-space:nowrap;">
									<i class="icon-refresh"></i> <?= $this->translate->_('Needs re-evaluation'); ?>
								</span>
							<?php endif; ?>
						</td>
						<td style="text-align: center;">
							<?php if ($reported > 0): ?>
								<?php
								// Grouped by what the action does rather than run together on one
								// line: looking at the shipment, then producing reports from it,
								// then the one that sends mail. See .row-action-lines in admin.css.
								$evaluationLine = [];
								$reportLine = [];
								$mailLine = [];

								if ($viewEnabled) {
									$evaluationLine[] = '<a class="btn btn-success btn-xs" href="/admin/evaluate/shipment/sid/' . $encodedShipmentId . '">'
										. '<i class="icon-eye-open"></i> ' . $this->translate->_("View") . '</a>';
								}
								if (!$isFinalized) {
									$evaluationLine[] = '<a class="btn btn-success btn-xs ' . $evaluateButtonClass . '"'
										. ' href="javascript:scheduleShipmentEvaluation(\'' . $encodedShipmentId . '\');">'
										. '<i class="icon-edit"></i> ' . $buttonText . '</a>';
								}
								if ($shipment['scheme_type'] === 'vl' && !$isFinalized) {
									$evaluationLine[] = '<a class="btn btn-success btn-xs ' . $evaluateButtonClass . '" href="javascript:void(0);"'
										. ' onclick="getVLReferenceScores(\'' . $encodedShipmentId . '\')">'
										. '<i class="icon-edit"></i> ' . $this->translate->_("VL Range") . '</a>';
								}

								if (!$isFinalized) {
									$generateOnClick = 'generateReports(\'' . $encodedShipmentId . '\', ' . (int) $generateReportsEnabled
										. ', \'' . $this->dateFormat($shipment['distribution_date']) . '\', \'generateReport\')';
									if ($hasReportsGenerated) {
										if (!$isEphemeral) {
											$reportLine[] = '<a class="btn btn-info btn-xs" href="/reports/distribution/shipment/sid/' . $encodedShipmentId . '">'
												. '<i class="icon-eye-open"></i> ' . $this->translate->_("View Reports") . '</a>';
										}
										$reportLine[] = '<a href="javascript:void(0)" class="btn btn-xs btn-warning ' . $generateReportsClass . '"'
											. ' onclick="' . $generateOnClick . '">'
											. '<i class="icon-refresh"></i> ' . $this->translate->_("Regenerate Reports") . '</a>';
									} else {
										$reportLine[] = '<a href="javascript:void(0)" class="btn btn-xs btn-primary ' . $generateReportsClass . '"'
											. ' onclick="' . $generateOnClick . '">'
											. '<i class="icon-ok"></i> ' . $this->translate->_("Generate Reports") . '</a>';
									}
									// Say why finalizing is off when it is a missing feedback form, and
									// offer the one-click way to fix it.
									$finalizeTitle = (!$finalizeEnabled && !empty($btnStates['finalizeBlockedReason']))
										? ' title="' . $this->escape($btnStates['finalizeBlockedReason']) . '"'
										: '';
									// Finalizing records who approved the results and when, and those two fields
									// live only on the finalize page. Going there rather than finalizing in place
									// stops the approval date silently defaulting to the moment of the click.
									$finalizeHref = $finalizeEnabled
										? '/reports/distribution/finalize/sid/' . $encodedShipmentId
										: 'javascript:void(0)';
									$reportLine[] = '<a href="' . $finalizeHref . '" class="btn btn-xs btn-primary ' . $finalizeClass . '"' . $finalizeTitle . '>'
										. '<i class="icon-ok"></i> ' . $finalReportTitle . '</a>';
									if (!empty($btnStates['awaitingFeedbackForm']) && Application_Service_FeedBack::currentAdminCanBuildForms()) {
										$reportLine[] = '<a class="btn btn-xs btn-warning" target="_blank"'
											. ' href="/admin/feedback-responses/feedback-form/id/' . $encodedShipmentId . '">'
											. '<i class="icon-plus"></i> ' . $this->translate->_("Create Feedback Form") . '</a>';
									}
								}

								if ($showMailNonResponders) {
									$mailLine[] = '<a class="btn btn-warning btn-xs ' . $evaluateButtonClass . '" href="javascript:void(0);"'
										. ' title="' . $this->translate->_("Email the participants who have not responded") . '"'
										. ' onclick="mailNonParticipants(\'' . $encodedShipmentId . '\');">'
										. '<i class="icon-envelope"></i> ' . $this->translate->_("Remind") . ' ' . (int) $nonResponse . '</a>';
								}

								$actionHtml = '';
								foreach ([$evaluationLine, $reportLine, $mailLine] as $line) {
									if (empty($line)) {
										continue;
									}
									$actionHtml .= '<div class="row-action-line">' . implode('', $line) . '</div>';
								}
								echo '<div class="row-action-lines">' . $actionHtml . '</div>';
								?>
							<?php else: ?>
								<a class="btn btn-primary btn-xs disabled" href="javascript:void(0)">
									<i class="icon-eye-open"></i> <?= $this->translate->_("View"); ?>
								</a>
							<?php endif; ?>
						</td>
					</tr>
				<?php endforeach; ?>
			</tbody>
		</table>
	</div>
</div>

<div id="vlRangeDiv"></div>

<script>
	function getVLReferenceScores(sid) {
		$.blockUI();
		$.post(
			"<?php echo $this->url(['module' => 'admin', 'controller' => 'evaluate', 'action' => 'vl-range'], 'default', true); ?>", {
			sid: sid,
			format: "html"
		},
			function (data) {
				$("#vlRangeDiv").html(data);
				$.unblockUI();
			}
		).fail(function () {
			$.unblockUI();
			alert("`<?= Pt_Commons_TranslateUtility::jsTranslate("Error loading VL reference scores. Please try again."); ?>");
		});
	}

	function scheduleShipmentEvaluation(sid) {
		$.blockUI();
		$.post(
			"<?php echo $this->url(['module' => 'admin', 'controller' => 'evaluate', 'action' => 'schedule-evaluation'], 'default', true); ?>", {
			sid: sid,
			format: "html"
		},
			function (data) {
				$.unblockUI();
				alert("<?= Pt_Commons_TranslateUtility::jsTranslate("Shipment has been added to the queue. It will be evaluated shortly."); ?>");
				// Refresh only the expanded child row so DataTables filters,
				// search and paging survive; the host page defines getShipments.
				if (typeof getShipments === 'function' && typeof currentHighlighted !== 'undefined' && currentHighlighted) {
					getShipments(currentHighlighted, null, true);
				} else {
					window.location.href = "/admin/evaluate";
				}
			}
		).fail(function () {
			$.unblockUI();
			alert("<?= Pt_Commons_TranslateUtility::jsTranslate("Error scheduling evaluation. Please try again."); ?>");
	});
	}
</script>