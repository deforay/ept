<?php
$schemeId = (string) $this->scheme['scheme_id'];
$listName = $this->listName;
$listLabel = $listName === 'default' ? $this->translate->_('Default') : $listName;
$hasCountries = !empty($this->countries);
$hasProvinces = !empty($this->province);
$hasDistricts = !empty($this->district);
$hasInstitutes = !empty($this->institutes);
$hasNetworks = !empty($this->networksTier);
$hasAffiliations = !empty($this->affiliation);
$hasMoreFilters = $hasInstitutes || $hasNetworks || $hasAffiliations;
?>
<link href="<?php echo $this->baseUrl('css/select2.css'); ?>" rel="stylesheet" />

<div class="data-list mapper-page">
    <div class="data-list-head">
        <h2><?= $this->escape($this->scheme['scheme_name']); ?> &middot; <?= $this->escape($listLabel); ?></h2>
        <div class="data-list-actions">
            <?php if ($listName !== 'default') { ?>
                <button type="button" class="btn btn-default btn-quiet" onclick="renameList();"><i class="icon-edit"></i>&nbsp;&nbsp;<?= $this->translate->_("Rename"); ?></button>
            <?php } ?>
            <a href="/admin/enrollments" class="btn btn-default btn-quiet"><i class="icon-arrow-left"></i>&nbsp;&nbsp;<?= $this->translate->_("Back to Scheme Enrollments"); ?></a>
        </div>
    </div>
    <div class="data-list-body">
        <div class="data-list-filters">
            <?php if ($hasCountries) { ?>
                <div>
                    <label for="country"><?= $this->translate->_("Country"); ?></label>
                    <select style="width:100%;" id="country" onchange="getStats(this.value);loadParticipants();">
                        <option value=""></option>
                        <?php foreach ($this->countries as $country) { ?>
                            <option value="<?php echo $this->escape($country['id']); ?>"><?php echo $this->escape($country['iso_name']); ?></option>
                        <?php } ?>
                    </select>
                </div>
            <?php } ?>
            <?php if ($hasProvinces) { ?>
                <div>
                    <label for="province"><?= $this->translate->_("Province"); ?></label>
                    <select style="width:100%;" id="province" onchange="getDistricts(this.value);loadParticipants();">
                        <option value=""></option>
                        <?php foreach ($this->province as $province) { ?>
                            <option value="<?php echo $this->escape($province['state']); ?>"><?php echo $this->escape($province['state']); ?></option>
                        <?php } ?>
                    </select>
                </div>
            <?php } ?>
            <?php if ($hasDistricts) { ?>
                <div>
                    <label for="district"><?= $this->translate->_("District"); ?></label>
                    <select style="width:100%;" id="district" onchange="getInstitutes();loadParticipants();">
                        <option value=""></option>
                        <?php foreach ($this->district as $district) { ?>
                            <option value="<?php echo $this->escape($district['district']); ?>"><?php echo $this->escape($district['district']); ?></option>
                        <?php } ?>
                    </select>
                </div>
            <?php } ?>
        </div>

        <?php if ($hasMoreFilters) { ?>
            <div class="data-list-filterbar">
                <button type="button" id="moreFiltersBtn" class="btn btn-default btn-sm" aria-expanded="false" aria-controls="moreFilters">
                    <i class="icon-filter"></i>&nbsp;<?= $this->translate->_("More filters"); ?><span id="moreFiltersCount" class="filter-active-count" style="display:none;"></span><i class="icon-chevron-down filterbar-caret"></i>
                </button>
            </div>
            <div id="moreFilters" class="data-list-filters-collapse">
                <div class="data-list-filters">
                    <?php if ($hasInstitutes) { ?>
                        <div>
                            <label for="institute"><?= $this->translate->_("Institute"); ?></label>
                            <select style="width:100%;" id="institute" class="more-filter" onchange="loadParticipants();">
                                <option value=""></option>
                                <?php foreach ($this->institutes as $institute) { ?>
                                    <option value="<?php echo $this->escape($institute['institute_name']); ?>"><?php echo $this->escape($institute['institute_name']); ?></option>
                                <?php } ?>
                            </select>
                        </div>
                    <?php } ?>
                    <?php if ($hasNetworks) { ?>
                        <div>
                            <label for="networkTier"><?= $this->translate->_("Network Tier"); ?></label>
                            <select style="width:100%;" id="networkTier" class="more-filter" onchange="loadParticipants();">
                                <option value=""></option>
                                <?php foreach ($this->networksTier as $networkTier) { ?>
                                    <option value="<?php echo $this->escape($networkTier['network_id']); ?>"><?php echo $this->escape($networkTier['network_name']); ?></option>
                                <?php } ?>
                            </select>
                        </div>
                    <?php } ?>
                    <?php if ($hasAffiliations) { ?>
                        <div>
                            <label for="affiliation"><?= $this->translate->_("Affiliation"); ?></label>
                            <select style="width:100%;" id="affiliation" class="more-filter" onchange="loadParticipants();">
                                <option value=""></option>
                                <?php foreach ($this->affiliation as $affiliation) { ?>
                                    <option value="<?php echo $this->escape($affiliation['affiliate']); ?>"><?php echo $this->escape($affiliation['affiliate']); ?></option>
                                <?php } ?>
                            </select>
                        </div>
                    <?php } ?>
                </div>
            </div>
        <?php } ?>

        <form name="enroll" id="enroll" method="post" action="<?php echo $this->url(['module' => 'admin', 'controller' => 'enrollments', 'action' => 'add'], 'default', true); ?>">
            <input type="hidden" name="schemeId" value="<?= $this->escape($schemeId); ?>" />
            <input type="hidden" name="listName" value="<?= $this->escape($listName); ?>" />
            <input type="hidden" name="selectedForEnrollment" id="selectedForEnrollment" value="" />

            <div id="mapForm">
                <?php
                $this->mapperLabels = [
                    'left' => $this->translate->_("Not on this list"),
                    'right' => $this->translate->_("On this list"),
                    'saved' => $this->translate->_("Saved"),
                    'add' => $this->translate->_("To add"),
                    'remove' => $this->translate->_("To remove"),
                ];
                echo $this->render('partials/dual-mapper.phtml');
                ?>
                <div class="mapper-savebar">
                    <span id="mapperSummary" class="mapper-summary"></span>
                    <button type="button" id="mapperDiscard" class="btn btn-default" onclick="discardChanges();" disabled><?= $this->translate->_("Discard"); ?></button>
                    <button type="button" id="mapperSave" class="btn btn-primary" onclick="saveList();" disabled><?= $this->translate->_("Save changes"); ?></button>
                </div>
            </div>
        </form>
    </div>
</div>

<script type="text/javascript" src="<?php echo $this->baseUrl('js/select2.min.js'); ?>"></script>
<script type="text/javascript" src="<?php echo $this->baseUrl('js/dual-mapper.js'); ?>"></script>
<script>
    var LIST_ITEMS_URL = "<?php echo $this->url(['module' => 'admin', 'controller' => 'enrollments', 'action' => 'list-items'], 'default', true); ?>";
    var SCHEME_ID = <?= json_encode($schemeId, JSON_HEX_TAG | JSON_HEX_AMP); ?>;
    var LIST_NAME = <?= json_encode($listName, JSON_HEX_TAG | JSON_HEX_AMP); ?>;
    var I18N = {
        confirmEmpty: "<?= $this->jsTranslate("Nobody is on this list now. Saving removes every participant from it. Continue?"); ?>",
        confirmDiscard: "<?= $this->jsTranslate("You have unsaved changes. Discard them?"); ?>",
        noChanges: "<?= $this->jsTranslate("No unsaved changes"); ?>",
        changes: "<?= $this->jsTranslate("%1 to add, %2 to remove. Not saved yet."); ?>",
        nothingHere: "<?= $this->jsTranslate("No participants here"); ?>",
        noMatch: "<?= $this->jsTranslate("No participants match the search"); ?>",
        saved: "<?= $this->jsTranslate("List saved: %1 added, %2 removed."); ?>",
        saveFailed: "<?= $this->jsTranslate("Save failed. Please try again, or contact support if it keeps happening."); ?>",
        traceIdLabel: "<?= $this->jsTranslate("Reference"); ?>",
        nameTaken: "<?= $this->jsTranslate("Another scheme already has a list with this name. Each list name can be used in one scheme only. Go back and choose another name."); ?>"
    };
    var mapper = null;

    function getStats(cid) {
        if (!$('#province').length) return;
        $.post("<?php echo $this->url(['module' => 'default', 'controller' => 'common', 'action' => 'get-country-wise-states']); ?>", { cid: cid, format: "html" },
            function(data) {
                if (data != "" && data != undefined) { $('#province').html(data); }
            });
    }

    function getDistricts(pid) {
        if (!$('#district').length) return;
        $.post("<?php echo $this->url(['module' => 'default', 'controller' => 'common', 'action' => 'get-state-wise-districts']); ?>", { pid: pid, format: "html" },
            function(data) {
                if (data != "" && data != undefined) { $('#district').html(data); }
            });
    }

    function getInstitutes() {
        if (!$('#institute').length) return;
        $.post("<?php echo $this->url(['module' => 'default', 'controller' => 'common', 'action' => 'get-state-districts-wise-institute']); ?>", {
                pid: $('#province').val(),
                did: $('#district').val(),
                format: "html"
            },
            function(data) {
                if (data != "" && data != undefined) { $('#institute').html(data); }
            });
    }

    // keepPending is true for filter changes, so narrowing the list never throws
    // away moves that are not saved yet.
    function loadParticipants(keepPending) {
        $.blockUI();
        $.ajax({
            url: LIST_ITEMS_URL,
            type: 'POST',
            dataType: 'json',
            data: {
                scheme: SCHEME_ID,
                list: LIST_NAME,
                country: $('#country').val(),
                province: $('#province').val(),
                district: $('#district').val(),
                network: $('#networkTier').val(),
                affiliation: $('#affiliation').val(),
                institute: $('#institute').val()
            }
        }).done(function(items) {
            mapper.load(items || [], keepPending !== false);
        }).always(function() {
            $.unblockUI();
        });
    }

    function saveList() {
        var $form = $('#enroll');
        $form.find('input[name="allowEmptyList"]').remove();
        var ids = mapper.getSelectedIds();
        if (ids.length === 0) {
            if (!confirm(I18N.confirmEmpty)) return;
            $('<input>').attr({ type: 'hidden', name: 'allowEmptyList', value: '1' }).appendTo($form);
        }
        $('#selectedForEnrollment').val(JSON.stringify(ids));
        $.blockUI();
        $.ajax({
            url: $form.attr('action'),
            type: 'POST',
            data: $form.serialize(),
            dataType: 'json',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        }).done(function(resp) {
            $.unblockUI();
            if (resp && resp.success) {
                showFlash(I18N.saved.replace('%1', resp.added).replace('%2', resp.removed), 'success');
                loadParticipants(false);
            } else if (resp && resp.error === 'name_taken') {
                showFlash(I18N.nameTaken, 'danger');
            } else {
                showFlash(I18N.saveFailed + (resp && resp.trace_id ? ' (' + I18N.traceIdLabel + ': ' + resp.trace_id + ')' : ''), 'danger');
            }
        }).fail(function() {
            $.unblockUI();
            showFlash(I18N.saveFailed, 'danger');
        });
    }

    function showFlash(msg, level) {
        var $flash = $('#listFlash');
        if ($flash.length === 0) {
            $flash = $('<div id="listFlash" class="alert" style="margin:14px 0 0;"></div>').insertBefore('#mapForm .mapper-dual');
        }
        $flash.removeClass('alert-success alert-danger').addClass(level === 'danger' ? 'alert-danger' : 'alert-success').text(msg).show();
        clearTimeout(showFlash._t);
        showFlash._t = setTimeout(function() { $flash.fadeOut(300); }, level === 'danger' ? 10000 : 4000);
    }

    function renameList() {
        if (mapper.isDirty()) {
            alert("<?= $this->jsTranslate("Save or discard your changes before renaming the list."); ?>");
            return;
        }
        bootbox.prompt({
            title: "<?= $this->jsTranslate("Rename list"); ?>",
            value: LIST_NAME,
            callback: function(value) {
                if (value === null) return;
                if ($.trim(value) === '' || $.trim(value) === $.trim(LIST_NAME)) return false;
                var $form = $('<form method="post" action="/admin/enrollments/list-action"></form>').appendTo('body');
                $.each({ op: 'rename', scheme: SCHEME_ID, list: LIST_NAME, newName: value, returnTo: 'edit' }, function(name, val) {
                    $form.append($('<input type="hidden">').attr('name', name).val(val));
                });
                addCsrfTokenToForm($form);
                $.blockUI();
                $form[0].submit();
            }
        });
    }

    function discardChanges() {
        if (mapper.isDirty() && !confirm(I18N.confirmDiscard)) return;
        loadParticipants(false);
    }

    function updateSaveBar(c) {
        var dirty = c.add + c.remove > 0;
        $('#mapperSummary').toggleClass('is-dirty', dirty)
            .text(dirty ? I18N.changes.replace('%1', c.add).replace('%2', c.remove) : I18N.noChanges);
        $('#mapperSave, #mapperDiscard').prop('disabled', !dirty);
    }

    $(window).on('beforeunload', function() {
        if (mapper && mapper.isDirty()) return I18N.confirmDiscard;
    });

    $(document).ready(function() {
        $('#country').select2({ allowClear: true, placeholder: "<?= $this->jsTranslate("All countries"); ?>" });
        $('#province').select2({ allowClear: true, placeholder: "<?= $this->jsTranslate("All provinces"); ?>" });
        $('#district').select2({ allowClear: true, placeholder: "<?= $this->jsTranslate("All districts"); ?>" });
        $('#institute').select2({ allowClear: true, placeholder: "<?= $this->jsTranslate("All institutes"); ?>" });
        $('#networkTier').select2({ allowClear: true, placeholder: "<?= $this->jsTranslate("All network tiers"); ?>" });
        $('#affiliation').select2({ allowClear: true, placeholder: "<?= $this->jsTranslate("All affiliations"); ?>" });
        $('.more-filter').on('change', function() {
            var n = $('.more-filter').filter(function() { return !!$(this).val(); }).length;
            $('#moreFiltersCount').text(n).toggle(n > 0);
        });
        $('#moreFiltersBtn').on('click', function() {
            var open = $('#moreFilters').toggleClass('is-open').hasClass('is-open');
            $(this).toggleClass('is-open', open).attr('aria-expanded', open ? 'true' : 'false');
        });

        mapper = DualMapper.create('#mapForm', {
            nothingHere: I18N.nothingHere,
            noMatch: I18N.noMatch,
            onChange: updateSaveBar
        });
        loadParticipants(false);
    });
</script>
