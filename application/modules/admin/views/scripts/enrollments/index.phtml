<?php
$defaultLabel = $this->translate->_('Default');
$listsByScheme = [];
// Lists grouped under their scheme, schemes in name order. Lists saved without a
// scheme (old Ship It presets) go in their own group at the end.
$groups = [];
$noScheme = [];
$archived = [];
$listNamesByScheme = [];
// List names are unique across schemes. Lists that shared a name before that rule are flagged.
$schemesByName = [];
foreach ($this->lists as $list) {
    if ($list['list_name'] !== 'default') {
        $schemesByName[mb_strtolower($list['list_name'])][] = $list['scheme_name'] ?? $this->translate->_('No scheme');
    }
}
foreach ($this->lists as $list) {
    $schemeId = (string) $list['scheme_id'];
    $listsByScheme[$schemeId][] = $list['list_name'] === 'default' ? $defaultLabel : $list['list_name'];
    $listNamesByScheme[$schemeId][] = $list['list_name'];
    if ($list['scheme_name'] === null) {
        $noScheme[] = $list;
        continue;
    }
    if (!empty($list['archived'])) {
        $archived[] = $list;
        continue;
    }
    if (!isset($groups[$schemeId])) {
        $groups[$schemeId] = [
            'name' => $list['scheme_name'],
            // countEnrollmentSchemes() keys by the upper-cased scheme name
            'enrolled' => (int) ($this->schemeCount[strtoupper($list['scheme_name'])] ?? 0),
            'lists' => [],
        ];
    }
    $groups[$schemeId]['lists'][] = $list;
}

$renderRow = function (array $list, string $mode) use ($defaultLabel, $schemesByName) {
    $schemeId = (string) $list['scheme_id'];
    $isDefault = $list['list_name'] === 'default';
    $editUrl = '/admin/enrollments/add/scheme/' . rawurlencode($schemeId) . '?list=' . rawurlencode($list['list_name']);
    $importUrl = '/admin/enrollments/bulk-enrollment?scheme=' . rawurlencode($schemeId) . '&list=' . rawurlencode($list['list_name']);
    $args = $this->escape(json_encode($schemeId)) . ', ' . $this->escape(json_encode($list['list_name']));
    ?>
    <tr class="enr-list-row" data-scheme="<?= $this->escape($schemeId); ?>">
        <td>
            <span class="enr-list-name"><?= $this->escape($isDefault ? $defaultLabel : $list['list_name']); ?></span>
            <?php if ($isDefault && $mode === 'active') { ?><span class="enr-default" title="<?= $this->htmlTranslate('The list the participant form adds to'); ?>"><?= $this->translate->_("Main"); ?></span><?php } ?>
            <?php if ($mode === 'archived') { ?><span class="enr-scheme-tag"><?= $this->escape($list['scheme_name']); ?></span><?php } ?>
            <?php $sharedWith = $isDefault ? [] : ($schemesByName[mb_strtolower($list['list_name'])] ?? []);
            if (count($sharedWith) > 1) { ?>
                <span class="enr-shared" title="<?= $this->escape(implode(', ', $sharedWith)); ?>"><i class="icon-warning-sign"></i> <?= $this->translate->_("Name also used in another scheme. Rename one of them."); ?></span>
            <?php } ?>
        </td>
        <td class="enr-num"><?= (int) $list['participants']; ?></td>
        <td><?= $this->escape(Pt_Commons_DateUtility::humanReadableDateFormat($list['last_changed'])); ?></td>
        <td class="enr-actions">
            <?php if ($mode === 'active') { ?>
                <a href="<?= $this->escape($editUrl); ?>" class="btn btn-default btn-xs is-edit"><i class="icon-pencil"></i> <?= $this->translate->_("Edit"); ?></a>
            <?php } elseif ($mode === 'legacy') { ?>
                <button type="button" class="btn btn-default btn-xs is-edit" onclick="assignScheme(<?= $this->escape(json_encode($list['list_name'])); ?>);"><i class="icon-tag"></i> <?= $this->translate->_("Assign scheme"); ?></button>
            <?php } else { ?>
                <button type="button" class="btn btn-default btn-xs" onclick="listAction('reactivate', <?= $args; ?>);"><i class="icon-repeat"></i> <?= $this->translate->_("Reactivate"); ?></button>
            <?php } ?>
            <div class="btn-group">
                <button type="button" class="btn btn-default btn-xs dropdown-toggle" data-toggle="dropdown"><?= $this->translate->_("More"); ?> <span class="caret"></span></button>
                <ul class="dropdown-menu enr-menu">
                    <?php if ($mode === 'active') { ?>
                        <li><a href="<?= $this->escape($importUrl); ?>"><i class="icon-upload"></i> <?= $this->translate->_("Import from file"); ?></a></li>
                    <?php } ?>
                    <li><a href="javascript:void(0);" onclick="downloadList(<?= $args; ?>);"><i class="icon-download"></i> <?= $this->translate->_("Download"); ?></a></li>
                    <?php if ($mode !== 'legacy') { ?>
                        <li><a href="javascript:void(0);" onclick="cloneList(<?= $args; ?>);"><i class="icon-copy"></i> <?= $this->translate->_("Clone list"); ?></a></li>
                    <?php } ?>
                    <?php if (!$isDefault || $mode === 'legacy') { ?>
                        <li class="divider"></li>
                        <?php if ($mode !== 'legacy') { ?>
                            <li><a href="javascript:void(0);" onclick="listAction('rename', <?= $args; ?>);"><i class="icon-edit"></i> <?= $this->translate->_("Rename"); ?></a></li>
                            <li><a href="javascript:void(0);" onclick="listAction('merge', <?= $args; ?>);"><i class="icon-code-fork"></i> <?= $this->translate->_("Merge into another list"); ?></a></li>
                        <?php } ?>
                        <?php if ($mode === 'active') { ?>
                            <li><a href="javascript:void(0);" onclick="listAction('archive', <?= $args; ?>);"><i class="icon-folder-close"></i> <?= $this->translate->_("Archive"); ?></a></li>
                        <?php } ?>
                        <li class="divider"></li>
                        <li><a href="javascript:void(0);" class="enr-danger" onclick="listAction('delete', <?= $args; ?>);"><i class="icon-trash"></i> <?= $this->translate->_("Delete"); ?></a></li>
                    <?php } ?>
                </ul>
            </div>
        </td>
    </tr>
    <?php
};
?>
