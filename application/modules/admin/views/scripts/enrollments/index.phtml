<script type="text/javascript">
    var LISTS_BY_SCHEME = <?= json_encode($listsByScheme, JSON_HEX_TAG | JSON_HEX_AMP); ?>;
    var oTable = null;

    function showTab(tab) {
        $('.enr-tabs li').removeClass('active').filter('[data-tab="' + tab + '"]').addClass('active');
        $('#tabLists').toggle(tab === 'lists');
        $('#tabParticipants').toggle(tab === 'participants');
        // Built on first view so the page opens on the lists without a server round trip.
        if (tab === 'participants' && oTable === null) {
            drawTable();
        }
    }

    function openNewList(schemeId) {
        var dialog = bootbox.dialog({
            title: "<?= $this->jsTranslate("New enrollment list"); ?>",
            message: $('#newListTpl').html(),
            buttons: {
                cancel: { label: "<?= $this->jsTranslate("Cancel"); ?>", className: 'btn-default' },
                next: {
                    label: "<?= $this->jsTranslate("Choose participants"); ?>",
                    className: 'btn-primary',
                    callback: function() {
                        var scheme = $('#newListScheme').val();
                        if (!scheme) {
                            alert("<?= $this->jsTranslate("Please choose a scheme"); ?>");
                            return false;
                        }
                        var owner = listNameOwner($('#newListName').val(), scheme);
                        if (owner !== null) {
                            nameTakenAlert(owner);
                            return false;
                        }
                        window.location.href = '/admin/enrollments/add/scheme/' + encodeURIComponent(scheme) +
                            '?list=' + encodeURIComponent($.trim($('#newListName').val()));
                    }
                }
            }
        });
        dialog.on('change', '#newListScheme', function() {
            var $datalist = $('#newListSuggestions').empty();
            $.each(LISTS_BY_SCHEME[$(this).val()] || [], function(_, name) {
                $datalist.append($('<option>').attr('value', name));
            });
        });
        if (schemeId) {
            dialog.find('#newListScheme').val(schemeId).trigger('change');
        }
    }

    var LIST_NAMES_BY_SCHEME = <?= json_encode($listNamesByScheme, JSON_HEX_TAG | JSON_HEX_AMP); ?>;
    var SCHEME_NAMES = <?= json_encode(array_column($this->lists, 'scheme_name', 'scheme_id'), JSON_HEX_TAG | JSON_HEX_AMP); ?>;
    var DEFAULT_LABEL = <?= json_encode($defaultLabel, JSON_HEX_TAG | JSON_HEX_AMP); ?>;

    // List names are unique across schemes, except Default. Returns the scheme that
    // already uses the name outside exceptScheme ('' for a list without a scheme), or null.
    function listNameOwner(name, exceptScheme) {
        var key = $.trim(name).toLowerCase();
        if (key === '' || key === 'default' || key === DEFAULT_LABEL.toLowerCase()) return null;
        var owner = null;
        $.each(LIST_NAMES_BY_SCHEME, function(scheme, names) {
            if (scheme === exceptScheme) return;
            $.each(names, function(_, n) {
                if (n.toLowerCase() === key) { owner = scheme; return false; }
            });
            if (owner !== null) return false;
        });
        return owner;
    }

    function nameTakenAlert(owner) {
        if (owner === '') {
            alert("<?= $this->jsTranslate("A list without a scheme already uses this name. Choose another name, or assign that list a scheme first."); ?>");
            return;
        }
        alert("<?= $this->jsTranslate("The scheme %s already has a list with this name. Each list name can be used in one scheme only. Choose another name."); ?>".replace('%s', SCHEME_NAMES[owner] || owner));
    }

    function postListAction(fields) {
        var $form = $('<form method="post" action="/admin/enrollments/list-action"></form>').appendTo('body');
        $.each(fields, function(name, value) {
            $form.append($('<input type="hidden">').attr('name', name).val(value));
        });
        addCsrfTokenToForm($form);
        $.blockUI();
        $form[0].submit();
    }

    function listAction(op, scheme, list) {
        var base = { op: op, scheme: scheme, list: list };
        var name = $('<div>').text(list).html();
        if (op === 'reactivate') {
            postListAction(base);
            return;
        }
        if (op === 'archive') {
            bootbox.confirm("<?= $this->jsTranslate("Archive %s? It moves to the Archived group and is no longer offered in Ship It. Its participants stay enrolled."); ?>".replace('%s', '<strong>' + name + '</strong>'), function(yes) {
                if (yes) postListAction(base);
            });
            return;
        }
        if (op === 'rename') {
            bootbox.prompt({
                title: "<?= $this->jsTranslate("Rename list"); ?>",
                value: list,
                callback: function(value) {
                    if (value === null) return;
                    if ($.trim(value) === '' || $.trim(value) === $.trim(list)) return false;
                    var owner = listNameOwner(value, scheme);
                    if (owner !== null) {
                        nameTakenAlert(owner);
                        return false;
                    }
                    postListAction($.extend(base, { newName: value }));
                }
            });
            return;
        }
        if (op === 'merge') {
            var others = $.grep(LIST_NAMES_BY_SCHEME[scheme] || [], function(n) { return n !== list; });
            if (others.length === 0) {
                bootbox.alert("<?= $this->jsTranslate("This scheme has no other list to merge into."); ?>");
                return;
            }
            var $select = $('<select id="mergeInto" class="form-control"></select>');
            $.each(others, function(_, n) {
                $select.append($('<option>').val(n).text(n === 'default' ? DEFAULT_LABEL : n));
            });
            bootbox.dialog({
                title: "<?= $this->jsTranslate("Merge %s into another list"); ?>".replace('%s', name),
                message: '<p><?= $this->jsTranslate("Everyone on this list is added to the list you choose. This list is then removed."); ?></p>' + $select[0].outerHTML,
                buttons: {
                    cancel: { label: "<?= $this->jsTranslate("Cancel"); ?>", className: 'btn-default' },
                    ok: {
                        label: "<?= $this->jsTranslate("Merge"); ?>",
                        className: 'btn-primary',
                        callback: function() { postListAction($.extend(base, { into: $('#mergeInto').val() })); }
                    }
                }
            });
            return;
        }
        if (op === 'delete') {
            bootbox.dialog({
                title: "<?= $this->jsTranslate("Delete %s"); ?>".replace('%s', name),
                message: '<p><?= $this->jsTranslate("This removes the list. Its participants stay enrolled on any other list they are on. Type the list name to confirm."); ?></p>' +
                    '<input type="text" id="deleteConfirm" class="form-control" autocomplete="off">',
                buttons: {
                    cancel: { label: "<?= $this->jsTranslate("Cancel"); ?>", className: 'btn-default' },
                    ok: {
                        label: "<?= $this->jsTranslate("Delete"); ?>",
                        className: 'btn-danger',
                        callback: function() {
                            var value = $('#deleteConfirm').val();
                            if ($.trim(value) !== $.trim(list)) {
                                alert("<?= $this->jsTranslate("The name did not match."); ?>");
                                return false;
                            }
                            postListAction($.extend(base, { confirmName: value }));
                        }
                    }
                }
            });
        }
    }

    function cloneList(scheme, list) {
        var dialog = bootbox.dialog({
            title: "<?= $this->jsTranslate("Clone %s"); ?>".replace('%s', $('<div>').text(list === 'default' ? DEFAULT_LABEL : list).html()),
            message: $('#cloneListTpl').html(),
            buttons: {
                cancel: { label: "<?= $this->jsTranslate("Cancel"); ?>", className: 'btn-default' },
                ok: {
                    label: "<?= $this->jsTranslate("Clone"); ?>",
                    className: 'btn-primary',
                    callback: function() {
                        var toScheme = $('#cloneScheme').val();
                        var newName = $.trim($('#cloneName').val());
                        if (newName === '') {
                            alert("<?= $this->jsTranslate("Please enter a name for the new list"); ?>");
                            return false;
                        }
                        var taken = $.grep(LIST_NAMES_BY_SCHEME[toScheme] || [], function(n) {
                            var label = n === 'default' ? DEFAULT_LABEL : n;
                            return $.trim(label).toLowerCase() === newName.toLowerCase();
                        });
                        if (taken.length > 0) {
                            alert("<?= $this->jsTranslate("That scheme already has a list with this name."); ?>");
                            return false;
                        }
                        var owner = listNameOwner(newName, toScheme);
                        if (owner !== null) {
                            nameTakenAlert(owner);
                            return false;
                        }
                        postListAction({ op: 'clone', scheme: scheme, list: list, toScheme: toScheme, newName: newName });
                    }
                }
            }
        });
        dialog.find('#cloneScheme').val(scheme);
        dialog.find('#cloneName').val((list === 'default' ? DEFAULT_LABEL : $.trim(list)) + " <?= $this->jsTranslate("(copy)"); ?>");
    }

    function assignScheme(list) {
        bootbox.dialog({
            title: "<?= $this->jsTranslate("Assign a scheme"); ?>",
            message: $('#assignSchemeTpl').html(),
            buttons: {
                cancel: { label: "<?= $this->jsTranslate("Cancel"); ?>", className: 'btn-default' },
                save: {
                    label: "<?= $this->jsTranslate("Assign"); ?>",
                    className: 'btn-primary',
                    callback: function() {
                        var scheme = $('#assignSchemeSelect').val();
                        if (!scheme) {
                            alert("<?= $this->jsTranslate("Please choose a scheme"); ?>");
                            return false;
                        }
                        var $form = $('<form method="post" action="/admin/enrollments/assign-scheme"></form>')
                            .append($('<input type="hidden" name="list">').val(list))
                            .append($('<input type="hidden" name="scheme">').val(scheme))
                            .appendTo('body');
                        addCsrfTokenToForm($form);
                        $.blockUI();
                        $form[0].submit();
                    }
                }
            }
        });
    }

    function downloadList(scheme, list) {
        $.blockUI();
        $.post("<?php echo $this->url(['module' => 'admin', 'controller' => 'enrollments', 'action' => 'export-list'], 'default', true); ?>", { scheme: scheme, list: list },
            function(data) {
                $.unblockUI();
                if (data && data.file) {
                    document.location.href = '/temporary/' + data.file;
                }
            }, 'json').fail(function() { $.unblockUI(); });
    }

    function drawTable() {
        oTable = $('#usersTable').dataTable({
            "bAutoWidth": false,
            "bSortCellsTop": true,
            "bInfo": true,
            "sPaginationType": "bootstrap",
            "bDestroy": true,
            "aoColumns": [
                { "sClass": "center" },
                { "sClass": "" },
                { "sClass": "center" },
                { "sClass": "center" },
                { "sClass": "center" },
                { "sClass": "center" }
            ],
            "aaSorting": [[1, "asc"]],
            "bProcessing": true,
            "bServerSide": true,
            "sAjaxSource": "<?php echo $this->url(['module' => 'admin', 'controller' => 'enrollments', 'action' => 'index', 'format' => 'html']); ?>",
            "fnServerParams": function(aoData) {
                aoData.push({ "name": "scheme", "value": $('#schemeFilter').val() });
            },
            "fnServerData": function(sSource, aoData, fnCallback) {
                $.ajax({ "dataType": 'json', "type": "POST", "url": sSource, "data": aoData, "success": fnCallback });
            }
        });
        bindColSearch('#usersTable', function(value, colIdx) {
            oTable.fnFilter(value, colIdx);
        });
    }

    $(document).ready(function() {
        // One scheme filter for both tabs.
        // Lists button: the participant's lists in a row underneath, each linking to its editor.
        $('#usersTable tbody').on('click', 'button.toggle-lists', function() {
            var tr = $(this).closest('tr')[0];
            if (oTable.fnIsOpen(tr)) {
                oTable.fnClose(tr);
                return;
            }
            var rows = $.map($(this).data('lists'), function(l) {
                var name = l.list === 'default' ? DEFAULT_LABEL : l.list;
                var cell = l.schemeName
                    ? '<a href="/admin/enrollments/add/scheme/' + encodeURIComponent(l.scheme) + '?list=' + encodeURIComponent(l.list) + '">' + $('<div>').text(name).html() + '</a>'
                    : $('<div>').text(name).html();
                return '<tr><td>' + $('<div>').text(l.schemeName || "<?= $this->jsTranslate("No scheme"); ?>").html() + '</td><td>' + cell + '</td></tr>';
            }).join('');
            oTable.fnOpen(tr, '<table class="table table-condensed enr-child"><thead><tr><th><?= $this->jsTranslate("Scheme"); ?></th><th><?= $this->jsTranslate("List"); ?></th></tr></thead><tbody>' + rows + '</tbody></table>', 'enr-child-cell');
        });

        $('#schemeFilter').on('change', function() {
            var scheme = $(this).val();
            $('#listsTable > tbody').each(function() {
                var match = scheme === '' || $(this).attr('data-scheme') === scheme;
                // Collapsed groups stay collapsed; their own header row opens them.
                if ($(this).hasClass('enr-legacy') || $(this).hasClass('enr-archived')) {
                    return;
                }
                $(this).toggle(match);
            });
            if (oTable) {
                oTable.fnDraw();
            }
        });
    });
</script>
