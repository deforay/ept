<script type="text/javascript">
	var vadTable = null;
	var vadRequest = null;
	var vadGroupBy = '';
	var vadOutcomes = <?= json_encode(array_map(fn ($o) => ['label' => $o[0], 'color' => $o[1]], $outcomes), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT); ?>;
	var vadNotReported = "<?= $this->jsTranslate("No assay reported"); ?>";

	function vadNumber(n) {
		return Number(n || 0).toLocaleString();
	}

	function vadEscape(value) {
		return $('<div/>').text(value == null ? '' : String(value)).html();
	}

	function vadRate(n, of) {
		if (!of) {
			return '<span class="cell-muted"><?= $this->jsTranslate("Not evaluated yet"); ?></span>';
		}
		var pct = Math.round(n * 100 / of);
		return '<span class="rate-figure">' + pct + '%</span>'
			+ '<span class="rate-bar is-pass"><span style="width:' + pct + '%"></span></span>'
			+ '<span class="cell-sub">' + "<?= $this->jsTranslate("%s of %s"); ?>".replace('%s', vadNumber(n)).replace('%s', vadNumber(of)) + '</span>';
	}

	function vadAssayCell(r) {
		if (!r.assay) {
			return '<span class="cell-muted">' + vadEscape(vadNotReported) + '</span>';
		}
		var sub = r.assayName && r.assayName !== r.assay ? '<span class="cell-sub">' + vadEscape(r.assayName) + '</span>' : '';
		return vadEscape(r.assay) + sub;
	}

	// One bar per assay, split by outcome. Years add up into one bar.
	function drawVadChart(rows) {
		var byAssay = {};
		var order = [];
		$.each(rows, function (i, r) {
			var key = r.assay || '';
			if (!byAssay[key]) {
				byAssay[key] = { assay: r.assay, enrolled: 0 };
				$.each(vadOutcomes, function (o) { byAssay[key][o] = 0; });
				order.push(key);
			}
			byAssay[key].enrolled += r.enrolled;
			$.each(vadOutcomes, function (o) { byAssay[key][o] += r[o]; });
		});
		var assays = $.map(order, function (key) { return byAssay[key]; });
		assays.sort(function (a, b) {
			if (!a.assay !== !b.assay) {
				return a.assay ? -1 : 1;
			}
			return b.enrolled - a.enrolled;
		});
		if (!assays.length || typeof Highcharts === 'undefined') {
			$('#vadChart').empty().hide();
			return;
		}
		$('#vadChart').show().css('height', Math.max(180, assays.length * 26 + 90) + 'px');
		Highcharts.chart('vadChart', {
			chart: { type: 'bar', style: { fontFamily: 'inherit' } },
			title: { text: null },
			credits: { enabled: false },
			xAxis: {
				categories: $.map(assays, function (a) { return a.assay || vadNotReported; }),
				labels: { style: { fontSize: '12px' } }
			},
			yAxis: { title: { text: null }, allowDecimals: false, reversedStacks: false },
			legend: { reversed: false },
			tooltip: { shared: true },
			plotOptions: { bar: { stacking: 'normal', borderWidth: 0, pointPadding: 0.1, groupPadding: 0.05 } },
			series: $.map(vadOutcomes, function (o, key) {
				return [{ name: o.label, color: o.color, data: $.map(assays, function (a) { return a[key]; }) }];
			})
		});
	}

	function drawVadTotal(rows) {
		var total = { enrolled: 0 };
		$.each(vadOutcomes, function (o) { total[o] = 0; });
		$.each(rows, function (i, r) {
			total.enrolled += r.enrolled;
			$.each(vadOutcomes, function (o) { total[o] += r[o]; });
		});
		var $row = $('#vadTotal').toggle(rows.length > 1);
		$row.find('[data-total="enrolled"]').text(vadNumber(total.enrolled));
		$row.find('[data-total="rate"]').html(vadRate(total.pass, total.pass + total.fail));
		$.each(vadOutcomes, function (o) {
			$row.find('[data-total="' + o + '"]').text(vadNumber(total[o]));
		});
	}

	function loadVlAssays() {
		if (vadRequest) {
			vadRequest.abort();
		}
		var params = reportFilters.values();
		params.groupBy = vadGroupBy;
		vadTable.fnSetColumnVis(0, vadGroupBy === 'year', false);
		vadTable.fnClearTable();
		$('#vadTable_processing').css('visibility', 'visible');
		vadRequest = $.post("<?= $vadDataUrl; ?>", params, function (rows) {
			rows = rows || [];
			drawVadChart(rows);
			drawVadTotal(rows);
			// fnAddData([]) reads an empty array as one row with no cells.
			if (!rows.length) {
				return;
			}
			vadTable.fnAddData($.map(rows, function (r) {
				var evaluated = r.pass + r.fail;
				return [[
					r.year || '',
					vadAssayCell(r),
					vadNumber(r.enrolled),
					r.assay ? vadRate(r.pass, evaluated) : '<span class="cell-muted">&ndash;</span>',
					r.fail > 0 ? '<span class="vad-failed">' + vadNumber(r.fail) + '</span>' : '0',
					vadNumber(r.excluded),
					vadNumber(r.nottested),
					vadNumber(r.none),
					vadNumber(r.pending),
					r.enrolled,
					evaluated ? r.pass / evaluated : -1,
					r.fail,
					r.excluded,
					r.nottested,
					r.none,
					r.pending
				]];
			}));
		}, 'json').always(function () {
			vadRequest = null;
			$('#vadTable_processing').css('visibility', 'hidden');
		});
	}

	$(function () {
		$('#vadGroupBy').on('click', 'button', function () {
			vadGroupBy = String($(this).data('group') || '');
			$('#vadGroupBy button').removeClass('active');
			$(this).addClass('active');
			if (vadTable) {
				loadVlAssays();
			}
		});
	});

	reportFilters.onChange(loadVlAssays);

	reportFilters.ready(function () {
		// Columns 9 to 15 hold the raw numbers the visible columns sort by.
		var hidden = function () { return { "bVisible": false, "sType": "numeric" }; };
		vadTable = $('#vadTable').dataTable({
			"oLanguage": reportZeroState.dataTableLanguage(),
			"bAutoWidth": false,
			"bPaginate": false,
			"bFilter": false,
			"bInfo": false,
			"bProcessing": true,
			"sDom": "rt",
			"aoColumns": [
				{ "sWidth": "7%", "bVisible": false },
				{ "sWidth": "25%" },
				{ "sWidth": "10%", "iDataSort": 9 },
				{ "sWidth": "18%", "iDataSort": 10 },
				{ "sWidth": "8%", "iDataSort": 11 },
				{ "sWidth": "8%", "iDataSort": 12 },
				{ "sWidth": "9%", "iDataSort": 13 },
				{ "sWidth": "9%", "iDataSort": 14 },
				{ "sWidth": "9%", "iDataSort": 15 },
				hidden(), hidden(), hidden(), hidden(), hidden(), hidden(), hidden()
			],
			// Keep the server order: by year, then the busiest assay first.
			"aaSorting": []
		});
		loadVlAssays();
	});

	function exportVlAssays() {
		var params = reportFilters.values();
		params.groupBy = vadGroupBy;
		$.blockUI();
		$.post("<?= $vadExportUrl; ?>", params, function (data) {
			$.unblockUI();
			if (!data || !data.file) {
				alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
			} else {
				window.open('/temporary/' + data.file, '_blank');
			}
		}, 'json').fail(function () {
			$.unblockUI();
			alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
		});
	}
</script>
