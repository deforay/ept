<style>
	@media print {

		.dontPrint,
		#shipmentTable_filter,
		#shipmentTable_info {
			display: none;

		}
	}

	/* Eleven columns, two of them button stacks — stretch past the shared
	   container-wide 90% cap on this page only. */
	@media (min-width: 1200px) {
		.container.container-wide {
			width: 97%;
			max-width: 97%;
		}
	}

	#shipmentTable {
		table-layout: fixed;
		width: 100%;
	}

	#shipmentTable th,
	#shipmentTable td {
		word-wrap: break-word;
		overflow-wrap: break-word;
	}

	/* Don't break heading words mid-word — wrap on whitespace only. */
	#shipmentTable thead th {
		word-break: keep-all;
		overflow-wrap: normal;
		word-wrap: normal;
	}

	/* Column widths - total 100% */
	#shipmentTable th:nth-child(1),
	#shipmentTable td:nth-child(1) {
		width: 10%;
	}

	/* PT Survey Code */

	#shipmentTable th:nth-child(2),
	#shipmentTable td:nth-child(2) {
		width: 7%;
	}

	/* PT Survey Date */

	#shipmentTable th:nth-child(3),
	#shipmentTable td:nth-child(3) {
		width: 9%;
	}

	/* Shipment Code */

	#shipmentTable th:nth-child(4),
	#shipmentTable td:nth-child(4) {
		width: 7%;
	}

	/* Result Due Date */

	#shipmentTable th:nth-child(5),
	#shipmentTable td:nth-child(5) {
		width: 15%;
	}

	/* Scheme */

	#shipmentTable th:nth-child(6),
	#shipmentTable td:nth-child(6) {
		width: 9%;
	}

	/* No. of Participants */

	#shipmentTable th:nth-child(7),
	#shipmentTable td:nth-child(7) {
		width: 8%;
	}

	/* Responses */

	#shipmentTable th:nth-child(8),
	#shipmentTable td:nth-child(8) {
		width: 6%;
	}

	/* Number Passed */

	#shipmentTable th:nth-child(9),
	#shipmentTable td:nth-child(9) {
		width: 7%;
	}

	/* Shipment Status */

	#shipmentTable th:nth-child(10),
	#shipmentTable td:nth-child(10) {
		width: 10%;
	}

	/* Download Participant Reports */

	#shipmentTable th:nth-child(11),
	#shipmentTable td:nth-child(11) {
		width: 12%;
	}

	/* Download Excel */

	/* Keep the report action buttons inside their own column instead of
	   overflowing into the neighbouring one (Bootstrap .btn is white-space:nowrap,
	   so long labels like "Summary Report (DRAFT)" spill past the fixed cell width). */
	#shipmentTable td:nth-child(10),
	#shipmentTable td:nth-child(11) {
		overflow: hidden;
	}

	#shipmentTable td:nth-child(10) .btn,
	#shipmentTable td:nth-child(11) .btn {
		display: inline-block;
		white-space: normal !important;
		word-break: break-word;
		overflow-wrap: anywhere;
		max-width: 100%;
		box-sizing: border-box;
	}

	/* Breakdown slideout — detach the participation-stats child row from the
	   sibling data rows so it reads as a detail drawer of the row above it.
	   fnOpen() tags the inserted <td> with .stats-child-container. */
	#shipmentTable td.stats-child-container {
		background: #eef2f7 !important;
		/* override .table-striped zebra */
		border-left: 4px solid #3f6fb0;
		box-shadow: inset 0 7px 9px -9px rgba(0, 0, 0, .45), inset 0 -7px 9px -9px rgba(0, 0, 0, .3);
		padding: 14px 18px;
	}

	/* Don't let table-hover wash out the tinted drawer band. */
	#shipmentTable.table-hover tbody tr:hover>td.stats-child-container {
		background: #eef2f7 !important;
	}

	/* Lift the stats panel to a white card so it stands out on the tinted band. */
	#shipmentTable td.stats-child-container .pstats {
		background: #fff;
		box-shadow: 0 1px 3px rgba(0, 0, 0, .1);
	}

	/* Keep the parent row visually connected to its open drawer. */
	#shipmentTable tbody tr.stats-parent-open>td {
		background: #eef2f7 !important;
	}

	/* The .data-list quiet-button treatment flattens btn-warning / btn-default,
	   but this page's report buttons are colour-coded — green Overview, red
	   No Response, orange DRAFT downloads, blue finalized — so restore the two
	   colours it claims (theme values, same as .row-action-lines.is-colored). */
	#shipmentTable.dataTable .btn-warning {
		background: #efb73e;
		border: 1px solid #efb73e;
		color: #fff;
	}

	#shipmentTable.dataTable .btn-warning:hover,
	#shipmentTable.dataTable .btn-warning:focus {
		background: #e7a413;
		border-color: #dd9d12;
		color: #fff;
	}

	#shipmentTable.dataTable .btn-default {
		background: #aea79f;
		border: 1px solid #aea79f;
		color: #fff;
	}

	#shipmentTable.dataTable .btn-default:hover,
	#shipmentTable.dataTable .btn-default:focus {
		background: #978e83;
		border-color: #92897e;
		color: #fff;
	}
</style>
