<script type="text/javascript" src="<?php echo $this->baseUrl('js/select2.min.js'); ?>"></script>
<script type="text/javascript">
	var vsaScores = <?= json_encode(array_map(fn ($s) => ['label' => $s[0], 'color' => $s[1]], $scores), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT); ?>;
	var vsaNotReported = "<?= $this->jsTranslate("No assay reported"); ?>";
	var vsaRequest = null;

	function vsaNumber(n) {
		return Number(n || 0).toLocaleString();
	}

	function vsaEscape(value) {
		return $('<div/>').text(value == null ? '' : String(value)).html();
	}

	// Scoring counts a warning as a pass.
	function vsaRate(r) {
		var passed = r.pass + r.warn;
		var scored = passed + r.fail;
		if (!scored) {
			return '<span class="cell-muted"><?= $this->jsTranslate("Not evaluated yet"); ?></span>';
		}
		var pct = Math.round(passed * 100 / scored);
		return '<span class="rate-figure">' + pct + '%</span>'
			+ '<span class="rate-bar is-pass"><span style="width:' + pct + '%"></span></span>'
			+ '<span class="cell-sub">' + "<?= $this->jsTranslate("%s of %s"); ?>".replace('%s', vsaNumber(passed)).replace('%s', vsaNumber(scored)) + '</span>';
	}

	function vsaScoreCells(r) {
		return $.map(vsaScores, function (s, key) {
			var n = r[key] || 0;
			return '<td>' + (key === 'fail' && n > 0 ? '<span class="vsa-failed">' + vsaNumber(n) + '</span>' : vsaNumber(n)) + '</td>';
		}).join('');
	}

	function vsaAssayName(r) {
		return r.assay || vsaNotReported;
	}

	function drawVsaAssayChart(assays) {
		if (!assays.length || typeof Highcharts === 'undefined') {
			$('#vsaAssayChart').empty().hide();
			return;
		}
		$('#vsaAssayChart').show().css('height', Math.max(160, assays.length * 26 + 90) + 'px');
		Highcharts.chart('vsaAssayChart', {
			chart: { type: 'bar', style: { fontFamily: 'inherit' } },
			title: { text: null },
			credits: { enabled: false },
			xAxis: { categories: $.map(assays, vsaAssayName), labels: { style: { fontSize: '12px' } } },
			yAxis: { title: { text: null }, allowDecimals: false, reversedStacks: false },
			tooltip: { shared: true },
			plotOptions: { bar: { stacking: 'normal', borderWidth: 0, pointPadding: 0.1, groupPadding: 0.05 } },
			series: $.map(vsaScores, function (s, key) {
				return [{ name: s.label, color: s.color, data: $.map(assays, function (a) { return a[key]; }) }];
			})
		});
	}

	function showVsaDistributions(shipmentId) {
		$('#vlAssayDistributions').html('<div class="vl-assay-meta"><?= $this->jsTranslate("Loading data from server"); ?></div>');
		$.post("<?= $vsaPlotUrl; ?>", { shipmentId: shipmentId, format: 'html' }, function (html) {
			$('#vlAssayDistributions').html(html);
		});
	}

	function loadVlSamples() {
		var shipmentId = $('#vsaShipment').val();
		if (vsaRequest) {
			vsaRequest.abort();
		}
		if (!shipmentId) {
			$('#vsaReport').hide();
			reportZeroState.show('#vsaZeroState', 'noShipments', "<?= $this->jsTranslate("There are no VL shipments yet."); ?>");
			return;
		}
		$.blockUI();
		vsaRequest = $.post("<?= $vsaDataUrl; ?>", { shipmentId: shipmentId }, function (data) {
			var samples = (data && data.samples) || [];
			var assays = (data && data.assays) || [];
			if (!samples.length) {
				$('#vsaReport').hide();
				reportZeroState.show('#vsaZeroState', 'pending', "<?= $this->jsTranslate("No participant has submitted results for this shipment yet."); ?>");
				return;
			}
			$('#vsaZeroState').empty();
			$('#vsaReport').show();
			$('#vsaSamples tbody').html($.map(samples, function (r) {
				return '<tr><td>' + vsaEscape(r.label || r.sample_id) + '</td>'
					+ '<td>' + vsaNumber(r.results) + '</td>'
					+ '<td>' + vsaRate(r) + '</td>'
					+ vsaScoreCells(r) + '</tr>';
			}).join(''));
			$('#vsaAssays tbody').html($.map(assays, function (r) {
				var name = r.assay
					? vsaEscape(r.assay) + (r.assayName && r.assayName !== r.assay ? '<span class="cell-sub">' + vsaEscape(r.assayName) + '</span>' : '')
					: '<span class="cell-muted">' + vsaEscape(vsaNotReported) + '</span>';
				return '<tr><td>' + name + '</td>'
					+ '<td>' + vsaNumber(r.participants) + '</td>'
					+ '<td>' + vsaNumber(r.results) + '</td>'
					+ '<td>' + vsaRate(r) + '</td>'
					+ vsaScoreCells(r) + '</tr>';
			}).join(''));
			drawVsaAssayChart(assays);
			showVsaDistributions(shipmentId);
		}, 'json').always(function () {
			vsaRequest = null;
			$.unblockUI();
		});
	}

	$(function () {
		$('#vsaShipment').select2().on('change', loadVlSamples);
		$('#vlScatterAxisMode').on('click', 'button', function () {
			$('#vlScatterAxisMode button').removeClass('active');
			$(this).addClass('active');
			if (window.renderVlAssayCharts) {
				window.renderVlAssayCharts($(this).data('mode'));
			}
		});
	});

	// Highcharts loads at the end of the page.
	$(window).on('load', loadVlSamples);

	function exportVlSamples() {
		var shipmentId = $('#vsaShipment').val();
		if (!shipmentId) {
			return;
		}
		$.blockUI();
		$.post("<?= $vsaExportUrl; ?>", { shipmentId: shipmentId }, function (data) {
			$.unblockUI();
			if (!data || !data.file) {
				alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
			} else {
				window.open('/temporary/' + data.file, '_blank');
			}
		}, 'json').fail(function () {
			$.unblockUI();
			alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
		});
	}
</script>
