<script type="text/javascript" src="<?php echo $this->assetUrl('js/daterangepicker.js'); ?>"></script>
<script type="text/javascript">
    var startDate = "";
    var endDate = "";
    var paginate = true;
    $(document).ready(function () {
        $('#dateRange').daterangepicker({
            locale: {
                cancelLabel: 'Clear',
                format: 'DD-MMM-YYYY',
                separator: ' to ',
            },
            autoApply: true,
            showDropdowns: true,
            alwaysShowCalendars: true,
            autoUpdateInput: true,
            startDate: moment().subtract(179, 'days'),
            endDate: moment(),
            maxDate: moment(),
            ranges: eptDateRanges()
        },
            function (start, end) {
                startDate = start.format('DD-MMM-YYYY');
                endDate = end.format('DD-MMM-YYYY');
            });
        // Start from the range the picker shows, so the shipment list matches it
        // even before a range is picked (for example when the only scheme is pre-selected).
        var initialRange = ($('#dateRange').val() || '').split(' to ');
        startDate = initialRange[0] || '';
        endDate = initialRange[1] || '';
    });

    function getShipmentCodes(schemeType) {
        if (schemeType == "") {
            $("#shipmentId").html("<option value=''>-- Select Date Range and Scheme to populate this list --</option>");
            return false;
        }
        if ($('#dateRange').val() == "") {
            alert("<?= $this->jsTranslate("Please pick a date range to fetch shipment list"); ?>");
            $('#dateRange').focus();
            return false;
        }

        $.blockUI();
        $.post("<?php echo $this->url(array('module' => 'reports', 'controller' => 'common', 'action' => 'get-shipments-by-scheme')); ?>", {
            schemeType: schemeType,
            startDate: startDate,
            endDate: endDate,
            format: "html"
        },
            function (data) {
                if (data == 0 || data == "0") {
                    $("#shipmentId").html("<option value=''>-- No Shipments Available --</option>");
                    $("#getReportBtn").addClass("disabled");
                    $("#shipmentTable_wrapper").addClass("hide");
                    $("#totalTable").addClass("hide");
                    if (oTable != null) {
                        oTable.dataTable().fnClearTable();

                    }

                } else {
                    $("#shipmentId").html(data);
                    $("#getReportBtn").removeClass("disabled");
                }
                $.unblockUI();
            });
    }

    function drawTable() {
        reportZeroState.hide();
        var dateRange = $("#dateRange").val();
        var _dateRange = dateRange.split(" to ");
        startDate = _dateRange[0];
        endDate = _dateRange[1];

        $("#totalTable").removeClass("hide");
        $("#shipmentTable_wrapper").removeClass("hide");
        $("#shipmentTable").removeClass("hide");
        $.blockUI;
        oTable = $('#shipmentTable').dataTable({
            "oLanguage": reportZeroState.dataTableLanguage(),
            "bPaginate": paginate,
            "bJQueryUI": false,
            "bAutoWidth": false,
            "bInfo": true,
            "bScrollCollapse": true,
            "sPaginationType": "bootstrap",
            "bRetrieve": false,
            "bDestroy": true,
            "aoColumns": [{
                "sClass": "left"
            },
            {
                "sClass": "center"
            }
            ],
            "aaSorting": [
                [0, "desc"]
            ],
            "bProcessing": true,
            "bServerSide": true,
            "sAjaxSource": "<?php echo $this->url(array('module' => 'reports', 'controller' => 'corrective-actions', 'action' => 'index', 'format' => 'html')); ?>",
            "fnServerParams": function (aoData) {
                aoData.push({
                    "name": "scheme",
                    "value": $("#scheme").val()
                });
                aoData.push({
                    "name": "shipmentId",
                    "value": $("#shipmentId").val()
                });
                aoData.push({
                    "name": "startDate",
                    "value": startDate
                });
                aoData.push({
                    "name": "endDate",
                    "value": endDate
                });
            },
            "fnServerData": function (sSource, aoData, fnCallback) {
                $.ajax({
                    "dataType": 'json',
                    "type": "POST",
                    "url": sSource,
                    "data": aoData,
                    "success": function (json) {
                        if (json.totalResponses == 0 && json.validResponses == 0 && json.averageScore == 0) {
                            $(".totalCountTd").html("");
                            $("#totalTable").addClass("hide");
                        } else {
                            $("#totalShippedDiv").html("<strong><?= $this->htmlTranslate("Total shipped"); ?></strong> : " + json.totalShipped);
                            $("#totalRespDiv").html("<strong><?= $this->htmlTranslate("Total number of responses"); ?></strong> : " + json.totalResponses);
                            $("#validRespDiv").html("<strong><?= $this->htmlTranslate("Total number of valid responses"); ?></strong>: " + json.validResponses);
                            $("#avgScoreDiv").html("<strong><?= $this->htmlTranslate("Average score"); ?> </strong>: " + json.averageScore);
                        }
                        fnCallback(json);
                    }
                });
            },
            "fnRowCallback": function (nRow, aData, iDisplayIndex) {
                $.unblockUI;
            },
        });
        $('#exportExcel').removeClass('hide');
        correctiveExportPdf();
    }

    function correctiveExcel() {
        if (startDate == "" || endDate == "" || $("#scheme").val() == "" || $("#scheme").val() == null || $("#scheme").val() == undefined) {
            alert("<?= $this->jsTranslate("Please pick date range and Scheme Type to proceed"); ?>");
            return false;
        } else {
            var dateRange = $("#dateRange").val();
            var scheme = $("#scheme").val();
            var dateStartDate = startDate;
            var dateEndDate = endDate;
            var shipmentId = $("#shipmentId").val();
            shipmentName = "";
            if ($("#shipmentId").val() != "") {
                shipmentName = $("#shipmentId option:selected").text();
            }
            $.post("<?php echo $this->url(array('module' => 'reports', 'controller' => 'corrective-actions', 'action' => 'corrective-actions-export'), 'default', true); ?>", {
                dateRange: dateRange,
                scheme: scheme,
                dateStartDate: dateStartDate,
                dateEndDate: dateEndDate,
                shipmentId: shipmentId,
                shipmentName: shipmentName,
                format: "html"
            },
                function (data) {
                    if (data == "" || data == null) {
                        alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
                    } else {
                        document.location.href = '/temporary/' + data;
                    }
                });
        }
    }

    function correctiveExportPdf() {
        var dateRange = $("#dateRange").val();
        var scheme = $("#scheme").val();
        var dateStartDate = startDate;
        var dateEndDate = endDate;
        var shipmentId = $("#shipmentId").val();
        shipmentName = "";
        if ($("#shipmentId").val() != "") {
            shipmentName = $("#shipmentId option:selected").text();
        }
        $.post("<?php echo $this->url(array('module' => 'reports', 'controller' => 'corrective-actions', 'action' => 'corrective-actions-export-pdf'), 'default', true); ?>", {
            dateRange: dateRange,
            scheme: scheme,
            dateStartDate: dateStartDate,
            dateEndDate: dateEndDate,
            shipmentId: shipmentId,
            shipmentName: shipmentName,
            format: "html"
        },
            function (data) {
                if (data == "" || data == null) {
                    alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
                } else {
                    $('#exportPdf').attr('href', '/temporary/' + data);
                    $('#exportPdf').removeClass('hide');
                }
            });
    }
</script>
