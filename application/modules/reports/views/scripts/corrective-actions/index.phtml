<script type="text/javascript">
	var caTable = null;
	var caRequest = null;

	function caNumber(n) {
		return Number(n || 0).toLocaleString();
	}

	function caEscape(value) {
		return $('<div/>').text(value == null ? '' : String(value)).html();
	}

	function loadCorrectiveActions() {
		if (caRequest) {
			caRequest.abort();
		}
		caTable.fnClearTable();
		$('#caTable_processing').css('visibility', 'visible');
		caRequest = $.post("<?= $caDataUrl; ?>", reportFilters.values(), function (data) {
			var responses = data.responses || 0;
			var share = function (n) {
				return responses > 0 ? Math.round(n * 100 / responses) : 0;
			};
			$('#caStats [data-stat="shipments"]').text(caNumber(data.shipments));
			$('#caStats [data-stat="responses"]').text(caNumber(responses));
			$('#caStats [data-stat="failed"]').text(responses > 0 ? "<?= $this->jsTranslate("%s failed"); ?>".replace('%s', caNumber(data.failed)) : '');
			$('#caStats [data-stat="withAction"]').text(caNumber(data.withAction));
			$('#caStats [data-stat="withActionShare"]').text(responses > 0 ? "<?= $this->jsTranslate("%s of responses"); ?>".replace('%s', share(data.withAction) + '%') : '');
			$('#caStats [data-stat="averageScore"]').text(data.averageScore === null ? '–' : data.averageScore);

			var rows = $.map(data.actions || [], function (action) {
				var pct = share(action.responses);
				return [[
					'<div class="ca-action" data-action-id="' + action.action_id + '"><span class="ca-toggle" aria-hidden="true"><i class="icon-chevron-right"></i></span>'
						+ '<span class="cell-main">' + caEscape(action.corrective_action) + '</span></div>',
					'<span class="rate-figure">' + caNumber(action.responses) + '</span>'
						+ '<span class="rate-bar"><span style="width:' + pct + '%"></span></span>'
						+ '<span class="cell-sub">' + "<?= $this->jsTranslate("%s of responses"); ?>".replace('%s', pct + '%') + '</span>',
					caNumber(action.participants),
					action.failed > 0 ? '<span class="ca-failed">' + caNumber(action.failed) + '</span>' : '0',
					action.responses
				]];
			});
			// fnAddData([]) reads an empty array as one row with no cells.
			if (rows.length) {
				caTable.fnAddData(rows);
			}
		}, 'json').always(function () {
			caRequest = null;
			$('#caTable_processing').css('visibility', 'hidden');
		});
	}

	$(function () {
		// A corrective action opens the responses that received it.
		$('#caTable tbody').on('click', 'tr', function () {
			var $action = $(this).find('.ca-action');
			if (!$action.length) {
				return;
			}
			var tr = this;
			if (caTable.fnIsOpen(tr)) {
				caTable.fnClose(tr);
				$(tr).removeClass('ca-open');
				return;
			}
			caTable.fnOpen(tr, '<div style="padding:4px;color:#888;"><?= $this->jsTranslate("Loading data from server"); ?></div>', 'ca-detail');
			$(tr).addClass('ca-open');
			var params = reportFilters.values();
			params.actionId = $action.data('action-id');
			$.post("<?= $caResponsesUrl; ?>", params, function (data) {
				$(tr).next('tr').find('td.ca-detail').html(data.html);
			}, 'json').fail(function () {
				$(tr).next('tr').find('td.ca-detail').html('<div style="padding:4px;color:#a94442;"><?= $this->jsTranslate("Failed to load. Please try again."); ?></div>');
			});
		});
	});

	reportFilters.onChange(loadCorrectiveActions);

	reportFilters.ready(function () {
		caTable = $('#caTable').dataTable({
			"oLanguage": reportZeroState.dataTableLanguage(),
			"bAutoWidth": false,
			"bPaginate": false,
			"bFilter": false,
			"bInfo": false,
			"bProcessing": true,
			"sDom": "rt",
			"aoColumns": [
				{ "sWidth": "58%" },
				{ "sWidth": "18%", "iDataSort": 4 },
				{ "sWidth": "12%" },
				{ "sWidth": "12%" },
				{ "bVisible": false }
			],
			"aaSorting": [[4, "desc"]]
		});
		loadCorrectiveActions();
	});

	function downloadCorrectiveActions(url) {
		var params = reportFilters.values();
		// The PDF prints the filters as the chips show them.
		params.filterSummary = $.map($('.js-filter-summary .filter-tag'), function (tag) {
			return $(tag).find('.filter-tag-label').text() + ': ' + $(tag).find('.filter-tag-value').text();
		}).join(' · ');
		$.blockUI();
		$.post(url, params, function (data) {
			$.unblockUI();
			if (!data || !data.file) {
				alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
			} else {
				window.open('/temporary/' + data.file, '_blank');
			}
		}, 'json').fail(function () {
			$.unblockUI();
			alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
		});
	}
</script>
