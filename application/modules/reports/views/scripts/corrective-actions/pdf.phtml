<?php

if (!class_exists('CorrectiveActionsPdf')) {
    class CorrectiveActionsPdf extends TCPDF
    {
        private string $reportHeader = '';
        private string $reportLogo = '';

        public function setReportHeader(?string $header, ?string $logo): void
        {
            $this->reportHeader = trim((string) $header);
            $this->reportLogo = trim((string) $logo);
        }

        public function Header()
        {
            $logoFile = UPLOAD_PATH . DIRECTORY_SEPARATOR . 'logo' . DIRECTORY_SEPARATOR . $this->reportLogo;
            if ($this->reportLogo !== '' && file_exists($logoFile)) {
                $this->Image($logoFile, 10, 10, 30, '', '', '', 'T', false, 300, '', false, false, 0, false, false, false);
            }
            $this->SetFont('dejavusans', '', 9);
            $this->writeHTMLCell(0, 0, 25, 10, preg_replace('/<br>$/', '', nl2br($this->reportHeader)), 0, 0, 0, true, 'C', true);
            $this->writeHTMLCell(0, 0, 10, 30, '<hr/>', 0, 0, 0, true, 'J', true);
        }

        public function Footer()
        {
            $this->SetY(-15);
            $this->SetFont('dejavusans', '', 8);
            $this->Cell(0, 10, $this->getAliasNumPage() . ' / ' . $this->getAliasNbPages(), 0, false, 'C', 0, '', 0, false, 'T', 'M');
        }
    }
}

// DejaVu Sans covers the accented and Vietnamese letters the translations use.
$pdf = new CorrectiveActionsPdf(PDF_PAGE_ORIENTATION, PDF_UNIT, PDF_PAGE_FORMAT, true, 'UTF-8', false);
$pdf->SetCreator(PDF_CREATOR);
$pdf->SetAuthor('ePT');
$pdf->SetTitle($this->translate->_("Corrective Actions Report"));
$pdf->SetMargins(PDF_MARGIN_LEFT, 50, PDF_MARGIN_RIGHT);
$pdf->SetHeaderMargin(PDF_MARGIN_HEADER);
$pdf->SetFooterMargin(PDF_MARGIN_FOOTER);
$pdf->SetAutoPageBreak(true, PDF_MARGIN_BOTTOM);
$pdf->setImageScale(PDF_IMAGE_SCALE_RATIO);
$pdf->setReportHeader($this->header, $this->logo);
$pdf->SetFont('dejavusans', '', 10);
$pdf->AddPage();

$esc = fn ($v) => htmlspecialchars((string) $v, ENT_QUOTES, 'UTF-8', false);
$summary = $this->summary;
$responses = $summary['responses'];
$share = fn (int $n) => $responses > 0 ? round($n * 100 / $responses) . '%' : '';

$html = '<p style="font-weight:bold;font-size:16px;text-align:center;">' . $esc($this->translate->_("Corrective Actions Report")) . '</p>';
if (trim((string) $this->filters) !== '') {
    $html .= '<p style="font-size:11px;">' . $esc($this->filters) . '</p>';
}
$html .= '<table cellpadding="4" style="font-size:11px;"><tr>'
    . '<td><b>' . $esc($this->translate->_("Shipments")) . '</b><br/>' . number_format($summary['shipments']) . '</td>'
    . '<td><b>' . $esc($this->translate->_("Responses")) . '</b><br/>' . number_format($responses) . '</td>'
    . '<td><b>' . $esc($this->translate->_("With a corrective action")) . '</b><br/>' . number_format($summary['withAction']) . ' (' . $share($summary['withAction']) . ')</td>'
    . '<td><b>' . $esc($this->translate->_("Average score")) . '</b><br/>' . ($summary['averageScore'] !== null ? $summary['averageScore'] : '') . '</td>'
    . '</tr></table><br/>';

$html .= '<table border="1" cellpadding="4" style="font-size:11px;"><thead><tr style="font-weight:bold;background-color:#eef2f7;">'
    . '<th width="58%">' . $esc($this->translate->_("Corrective Action")) . '</th>'
    . '<th width="16%" align="right">' . $esc($this->translate->_("Responses")) . '</th>'
    . '<th width="14%" align="right">' . $esc($this->translate->_("Participants")) . '</th>'
    . '<th width="12%" align="right">' . $esc($this->translate->_("Failed")) . '</th>'
    . '</tr></thead><tbody>';
if (empty($summary['actions'])) {
    $html .= '<tr><td colspan="4">' . $esc($this->translate->_("No corrective actions")) . '</td></tr>';
}
foreach ($summary['actions'] as $action) {
    $html .= '<tr nobr="true">'
        . '<td width="58%">' . $esc($action['corrective_action']) . '</td>'
        . '<td width="16%" align="right">' . number_format($action['responses']) . ' (' . $share($action['responses']) . ')</td>'
        . '<td width="14%" align="right">' . number_format($action['participants']) . '</td>'
        . '<td width="12%" align="right">' . number_format($action['failed']) . '</td>'
        . '</tr>';
}
$html .= '</tbody></table>';
$pdf->writeHTML($html, true, false, true, false, '');

$fileName = 'corrective-actions-' . date('d-M-Y-H-i-s') . '.pdf';
$pdf->Output(TEMP_UPLOAD_PATH . DIRECTORY_SEPARATOR . $fileName, 'F');
echo json_encode(['file' => $fileName]);
