<script type="text/javascript" src="<?php echo $this->assetUrl('js/daterangepicker.js'); ?>"></script>
<script type="text/javascript">
    var trendsText = {
        notEvaluated: "<?= $this->jsTranslate("Not evaluated yet"); ?>",
        ofEnrolled: "<?= $this->jsTranslate("%s of %s enrolled"); ?>",
        ofResponded: "<?= $this->jsTranslate("%s of %s responses"); ?>",
        ofEvaluated: "<?= $this->jsTranslate("%s of %s evaluated"); ?>",
        acrossShipments: "<?= $this->jsTranslate("across %s shipments"); ?>",
        oneShipment: "<?= $this->jsTranslate("in 1 shipment"); ?>",
        noRegion: "<?= $this->jsTranslate("No region"); ?>",
        region: "<?= $this->jsTranslate("Region"); ?>",
        noRegions: "<?= $this->jsTranslate("No participants in this shipment match the filters."); ?>",
        loading: "<?= $this->jsTranslate("Loading..."); ?>",
        responseRate: "<?= $this->jsTranslate("Response rate"); ?>",
        onTime: "<?= $this->jsTranslate("On time"); ?>",
        passRate: "<?= $this->jsTranslate("Pass rate"); ?>",
        excellent: "<?= $this->jsTranslate("Excellent"); ?>",
        satisfactory: "<?= $this->jsTranslate("Satisfactory"); ?>",
        unsatisfactory: "<?= $this->jsTranslate("Unsatisfactory"); ?>",
        acrossSchemes: "<?= $this->jsTranslate("across %s shipments in %s schemes"); ?>",
        shipmentCount: "<?= $this->jsTranslate("%s shipments"); ?>",
        trendByShipment: "<?= $this->jsTranslate("Trend by shipment"); ?>",
        passRateByScheme: "<?= $this->jsTranslate("Pass rate by scheme"); ?>",
        selectDateRange: "<?= $this->jsTranslate("Please select a date range"); ?>",
        downloadFailed: "<?= $this->jsTranslate("Unable to generate download"); ?>",
        allShipments: "<?= $this->jsTranslate("All Shipments in the selected period"); ?>"
    };
    var trendsUrls = {
        summary: "<?php echo $this->url(['module' => 'reports', 'controller' => 'participant-trends', 'action' => 'summary'], 'default', true); ?>",
        regions: "<?php echo $this->url(['module' => 'reports', 'controller' => 'participant-trends', 'action' => 'regions'], 'default', true); ?>",
        exportFile: "<?php echo $this->url(['module' => 'reports', 'controller' => 'participant-trends', 'action' => 'export'], 'default', true); ?>",
        shipments: "<?php echo $this->url(['module' => 'reports', 'controller' => 'common', 'action' => 'get-shipments-by-scheme'], 'default', true); ?>"
    };
    var trendsFilters = null;

    $(function () {
        reportZeroState.showAfter(".js-filter-panel", "start");

        $('#dateRange').daterangepicker({
            locale: {
                cancelLabel: "<?= $this->jsTranslate("Clear"); ?>",
                format: 'DD-MMM-YYYY',
                separator: ' to ',
            },
            autoApply: true,
            showDropdowns: true,
            alwaysShowCalendars: true,
            autoUpdateInput: true,
            // Some programmes run only one or two rounds a year, so three years
            // shows enough of them for a trend.
            startDate: moment().subtract(3, 'year'),
            endDate: moment(),
            maxDate: moment(),
            ranges: eptDateRanges()
        }).on('apply.daterangepicker', loadShipmentList);

        $('#scheme').on('change', loadShipmentList);

        $('#trendsRows').on('click', 'tr.js-shipment-row', function () {
            toggleRegions($(this));
        });

        // A scheme row opens the shipment view for that scheme.
        $('#trendsSchemeRows').on('click', 'tr.js-scheme-row', function () {
            var scheme = String($(this).data('scheme') || '');
            if (!scheme) {
                return;
            }
            $('#scheme').val(scheme).trigger('change');
            loadTrends();
        });
    });

    // The collapsible filter panel selects the scheme when only one is active.
    // It runs after this page's ready handlers, so load once the page has loaded.
    // Without a scheme the page opens on the overview of every scheme.
    $(window).on('load', function () {
        if ($('#dateRange').val()) {
            loadTrends();
        }
    });

    function dateRangeParts() {
        var parts = ($('#dateRange').val() || '').split(' to ');
        return { startDate: parts[0] || '', endDate: parts[1] || '' };
    }

    function loadShipmentList() {
        var $shipment = $('#shipmentId');
        var blank = '<option value="">-- ' + escapeText(trendsText.allShipments) + ' --</option>';
        var scheme = $('#scheme').val();
        if (!scheme) {
            $shipment.html(blank).trigger('change');
            return;
        }
        var range = dateRangeParts();
        $.post(trendsUrls.shipments, {
            schemeType: scheme,
            startDate: range.startDate,
            endDate: range.endDate,
            format: 'html'
        }, function (data) {
            $shipment.html($.trim(data) === '0' ? blank : data).trigger('change');
        });
    }

    function loadTrends() {
        var range = dateRangeParts();
        if (!range.startDate || !range.endDate) {
            alert(trendsText.selectDateRange);
            return;
        }
        trendsFilters = {
            scheme: $('#scheme').val(),
            shipmentId: $('#shipmentId').val(),
            startDate: range.startDate,
            endDate: range.endDate
        };
        $.blockUI();
        $.post(trendsUrls.summary, trendsFilters, function (rows) {
            $.unblockUI();
            if (!rows || !rows.length) {
                $('#trendsResults').addClass('hide');
                reportZeroState.showAfter(".js-filter-panel", "noShipments");
                return;
            }
            reportZeroState.hide();
            renderTrends(rows);
        }, 'json').fail(function () {
            $.unblockUI();
        });
    }

    function exportTrends() {
        if (!trendsFilters) {
            return;
        }
        $.blockUI();
        $.post(trendsUrls.exportFile, trendsFilters, function (data) {
            $.unblockUI();
            if (!data || !data.file) {
                alert(trendsText.downloadFailed);
                return;
            }
            document.location.href = '/temporary/' + encodeURIComponent(data.file);
        }, 'json').fail(function () {
            $.unblockUI();
            alert(trendsText.downloadFailed);
        });
    }

    // ---- Rendering ----

    function escapeText(value) {
        return $('<div/>').text(value == null ? '' : String(value)).html();
    }

    function fmt(n) {
        return Number(n || 0).toLocaleString();
    }

    function sprintf(template) {
        var args = Array.prototype.slice.call(arguments, 1);
        return template.replace(/%s/g, function () {
            return args.length ? args.shift() : '';
        });
    }

    // Percentage, or null when there is nothing to divide by.
    function pct(part, whole) {
        return whole > 0 ? Math.round(part / whole * 1000) / 10 : null;
    }

    function pctText(value) {
        return value === null ? '<span class="muted-dash">&ndash;</span>' : value + '%';
    }

    function totals(rows) {
        var sum = { enrolled: 0, responded: 0, on_time: 0, passed: 0, failed: 0, excellent: 0 };
        rows.forEach(function (row) {
            Object.keys(sum).forEach(function (key) {
                sum[key] += Number(row[key] || 0);
            });
        });
        return sum;
    }

    // The shipment rows of each scheme. The rows carry the scheme name, and
    // the Scheme filter gives its id.
    function groupByScheme(rows) {
        var ids = {};
        $('#scheme option').each(function () {
            ids[$(this).text()] = this.value;
        });
        var groups = [];
        var index = {};
        rows.forEach(function (row) {
            if (!(row.scheme_name in index)) {
                index[row.scheme_name] = groups.length;
                groups.push({ scheme_type: ids[row.scheme_name] || '', scheme_name: row.scheme_name, rows: [] });
            }
            groups[index[row.scheme_name]].rows.push(row);
        });
        return groups.sort(function (a, b) {
            return String(a.scheme_name).localeCompare(String(b.scheme_name));
        });
    }

    function renderTrends(rows) {
        var sum = totals(rows);
        var evaluated = sum.passed + sum.failed;
        var overview = !trendsFilters.scheme;
        var schemes = groupByScheme(rows);

        $('#trendsCaption').html(
            '<strong>' + escapeText($('#scheme option:selected').text()) + '</strong> &middot; ' +
            escapeText($('#dateRange').val())
        );

        $('#kpiEnrolled').text(fmt(sum.enrolled));
        $('#kpiEnrolledNote').text(
            overview && schemes.length > 1 ? sprintf(trendsText.acrossSchemes, rows.length, schemes.length)
                : rows.length === 1 ? trendsText.oneShipment : sprintf(trendsText.acrossShipments, rows.length)
        );
        $('#kpiResponse').html(pctText(pct(sum.responded, sum.enrolled)));
        $('#kpiResponseNote').text(sprintf(trendsText.ofEnrolled, fmt(sum.responded), fmt(sum.enrolled)));
        $('#kpiOnTime').html(pctText(pct(sum.on_time, sum.responded)));
        $('#kpiOnTimeNote').text(sprintf(trendsText.ofResponded, fmt(sum.on_time), fmt(sum.responded)));
        $('#kpiPass').html(pctText(pct(sum.passed, evaluated)));
        $('#kpiPassNote').text(evaluated > 0 ? sprintf(trendsText.ofEvaluated, fmt(sum.passed), fmt(evaluated)) : trendsText.notEvaluated);

        // Shipments of different schemes do not compare, so the overview
        // lists the schemes and draws one pass rate line per scheme.
        $('#trendsSchemesPanel').toggleClass('hide', !overview);
        $('#trendsShipmentsPanel').toggleClass('hide', overview);
        if (overview) {
            $('#trendsSchemeRows').html(schemes.map(schemeRowHtml).join(''));
        } else {
            $('#trendsRows').html(rows.map(shipmentRowHtml).join(''));
        }
        $('#trendsResults').removeClass('hide');

        // A trend needs at least two points.
        $('#trendsChartPanel').toggleClass('hide', rows.length < 2);
        if (rows.length >= 2) {
            $('#trendsChartTitle').text(overview ? trendsText.passRateByScheme : trendsText.trendByShipment);
            if (overview) {
                drawSchemeChart(schemes);
            } else {
                drawChart(rows);
            }
        }
    }

    function schemeRowHtml(group) {
        var sum = totals(group.rows);
        return '<tr class="js-scheme-row" data-scheme="' + escapeText(group.scheme_type) + '">' +
            '<td><i class="icon-chevron-right toggle-icon" aria-hidden="true"></i> <strong>' + escapeText(group.scheme_name) + '</strong>' +
            '<span class="sub">' + escapeText(group.rows.length === 1 ? trendsText.oneShipment : sprintf(trendsText.shipmentCount, group.rows.length)) + '</span></td>' +
            figureCells(sum) +
            '</tr>';
    }

    function figureCells(row) {
        var evaluated = row.passed + row.failed;
        var cells = '<td class="num">' + fmt(row.enrolled) + '</td>' +
            '<td class="num">' + fmt(row.responded) + '<span class="sub">' + pctText(pct(row.responded, row.enrolled)) + '</span></td>' +
            '<td class="num">' + pctText(pct(row.on_time, row.responded)) + '</td>';
        if (!evaluated) {
            return cells + '<td colspan="2" class="not-evaluated">' + escapeText(trendsText.notEvaluated) + '</td>';
        }
        var passRate = pct(row.passed, evaluated);
        return cells +
            '<td class="num">' + passRate + '%<span class="rate-bar"><span style="width:' + passRate + '%"></span></span></td>' +
            '<td>' + ratingBarHtml(row) + '</td>';
    }

    function shipmentRowHtml(row) {
        return '<tr class="js-shipment-row" data-shipment-id="' + escapeText(row.shipment_id) + '">' +
            '<td><i class="icon-chevron-right toggle-icon" aria-hidden="true"></i> <strong>' + escapeText(row.shipment_code) + '</strong>' +
            '<span class="sub">' + escapeText(moment(row.shipment_date, 'YYYY-MM-DD').format('DD-MMM-YYYY')) + '</span></td>' +
            figureCells(row) +
            '</tr>';
    }

    function ratingBarHtml(row) {
        var evaluated = row.passed + row.failed;
        var parts = [
            ['rating-excellent', row.excellent, trendsText.excellent],
            ['rating-satisfactory', row.passed - row.excellent, trendsText.satisfactory],
            ['rating-unsatisfactory', row.failed, trendsText.unsatisfactory]
        ];
        var title = parts.map(function (p) {
            return p[2] + ': ' + fmt(p[1]) + ' (' + pct(p[1], evaluated) + '%)';
        }).join('\n');
        return '<div class="rating-bar" title="' + escapeText(title) + '">' + parts.map(function (p) {
            return p[1] > 0 ? '<span class="' + p[0] + '" style="width:' + (p[1] / evaluated * 100) + '%"></span>' : '';
        }).join('') + '</div>';
    }

    function toggleRegions($row) {
        var $next = $row.next('tr.region-row');
        if ($next.length) {
            $next.remove();
            $row.removeClass('is-open');
            return;
        }
        $row.addClass('is-open');
        var $holder = $('<tr class="region-row"><td colspan="6"><p class="sub" style="padding:10px 0">' + escapeText(trendsText.loading) + '</p></td></tr>');
        $row.after($holder);
        $.post(trendsUrls.regions, $.extend({}, trendsFilters, { shipmentId: $row.data('shipment-id') }), function (regions) {
            if (!regions || !regions.length) {
                $holder.find('td').html('<p class="sub" style="padding:10px 0">' + escapeText(trendsText.noRegions) + '</p>');
                return;
            }
            $holder.find('td').html('<table class="table table-condensed"><thead><tr>' +
                '<th scope="col">' + escapeText(trendsText.region) + '</th>' +
                $row.closest('table').find('thead th').slice(1).map(function () {
                    return '<th scope="col" class="' + this.className + '">' + escapeText($(this).text()) + '</th>';
                }).get().join('') +
                '</tr></thead><tbody>' +
                regions.map(function (r) {
                    return '<tr><td>' + escapeText(r.region || trendsText.noRegion) + '</td>' + figureCells(r) + '</tr>';
                }).join('') +
                '</tbody></table>');
        }, 'json');
    }

    function drawSchemeChart(schemes) {
        Highcharts.chart('trendsChart', {
            chart: { type: 'line', style: { fontFamily: 'inherit' } },
            title: { text: null },
            credits: { enabled: false },
            exporting: { enabled: false },
            xAxis: { type: 'datetime' },
            yAxis: {
                min: 0,
                max: 100,
                title: { text: null },
                labels: { format: '{value}%' }
            },
            tooltip: {
                pointFormat: '<span style="color:{point.color}">\u25CF</span> {series.name}: <b>{point.y}%</b><br/>{point.code}'
            },
            legend: { align: 'left', verticalAlign: 'top' },
            plotOptions: { line: { marker: { radius: 4 } } },
            series: schemes.map(function (group) {
                return {
                    name: group.scheme_name,
                    // Shipments not evaluated yet have no pass rate.
                    data: group.rows.filter(function (r) {
                        return r.passed + r.failed > 0;
                    }).map(function (r) {
                        return { x: moment.utc(r.shipment_date, 'YYYY-MM-DD').valueOf(), y: pct(r.passed, r.passed + r.failed), code: r.shipment_code };
                    })
                };
            })
        });
    }

    function drawChart(rows) {
        var series = function (name, color, valueOf) {
            return {
                name: name,
                color: color,
                data: rows.map(valueOf)
            };
        };
        Highcharts.chart('trendsChart', {
            chart: { type: 'line', style: { fontFamily: 'inherit' } },
            title: { text: null },
            credits: { enabled: false },
            exporting: { enabled: false },
            xAxis: { categories: rows.map(function (r) { return r.shipment_code; }) },
            yAxis: {
                min: 0,
                max: 100,
                title: { text: null },
                labels: { format: '{value}%' }
            },
            tooltip: { shared: true, valueSuffix: '%' },
            legend: { align: 'left', verticalAlign: 'top' },
            plotOptions: { line: { marker: { radius: 4 } } },
            series: [
                series(trendsText.responseRate, '#3b6fb6', function (r) { return pct(r.responded, r.enrolled); }),
                series(trendsText.onTime, '#8a9bb8', function (r) { return pct(r.on_time, r.responded); }),
                series(trendsText.passRate, '#2e8b57', function (r) { return pct(r.passed, r.passed + r.failed); })
            ]
        });
    }
</script>
