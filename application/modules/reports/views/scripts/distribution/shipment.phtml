            function manualOverride(value) {
                $.blockUI();
                var url = '/admin/evaluate/shipment/sid/<?php echo $this->id; ?>';
                val = '';
                if (value == 'yes') {
                    val = "eWVz";
                }
                if (value == 'no') {
                    val = "bm8=";
                }
                if (val != '') {
                    window.location.href = url + "/override/" + val;
                } else {
                    window.location.href = url;
                }
                $.unblockUI();
            }
            function fnFormatDetails(oTable, nTr) {
                var aData = oTable.fnGetData(nTr);
                var sOut = '<div class="text-center"><i class="icon-spinner icon-spin"></i> Loading...</div>';
                // map_id is in the hidden last column (index 11).
                var mapId = aData[11];
                // Load corrective actions via AJAX
                $.ajax({
                    url: '/common/get-corrective-actions/mid/' + mapId,
                    data: { format: 'html' },
                    async: false,
                    success: function (html) {
                        sOut = '<div style="padding-left:50px;">' + html + '</div>';
                    },
                    error: function () {
                        sOut = '<div class="text-muted">Failed to load corrective actions</div>';
                    }
                });
                return sOut;
            }

            // The reports carry this comment, but the generate request never sent it, so
            // typing one and going straight to Generate silently dropped it. Save first.
            function generateShipmentReports(sid, checkReportDate, surveyDate) {
                if (!(checkReportDate == 1 || checkReportDate === true)) {
                    generateReports(sid, checkReportDate, surveyDate, 'generateReport');
                    return;
                }
                $.blockUI();
                $.post("<?php echo $this->url(array('module' => 'admin', 'controller' => 'evaluate', 'action' => 'update-shipment-comment'), 'default', true); ?>", {
                    sid: sid,
                    comment: $("#shipmentComment").val(),
                    format: "html"
                }).always(function () {
                    $.unblockUI();
                    generateReports(sid, checkReportDate, surveyDate, 'generateReport');
                });
            }

