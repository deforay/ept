	    <script type="text/javascript" src="<?php echo $this->baseUrl('js/select2.min.js'); ?>"></script>

        <script type="text/javascript" charset="utf-8">
            var oTable = null;
            var nTr = null;
            $("#filterResponseStatus").select2({
                placeholder: "<?= $this->translate->_("Select one or more response status"); ?>",
                allowClear: true
            });
            $("#filterResult").select2({
                placeholder: "<?= $this->translate->_("Select one or more results"); ?>",
                allowClear: true
            });
            $("#country").select2({
                placeholder: "<?= $this->translate->_("Select one or more countries"); ?>",
                allowClear: true
            });
            $("#state").select2({
                placeholder: "<?= $this->translate->_("Select one or more states"); ?>",
                allowClear: true
            });
            $("#district").select2({
                placeholder: "<?= $this->translate->_("Select one or more districts"); ?>",
                allowClear: true
            });
            $(document).ready(function () {
                $('#dateRange').daterangepicker({
                    locale: {
                        cancelLabel: 'Clear',
                        format: 'DD-MMM-YYYY',
                        separator: ' to ',
                    },
                    autoApply: true,
                    showDropdowns: true,
                    alwaysShowCalendars: true,
                    autoUpdateInput: false,
                    startDate: moment().subtract(179, 'days'),
                    endDate: moment(),
                    maxDate: moment(),
                    ranges: {
                        'This Month': [moment().startOf('month'), moment().endOf('month')],
                        'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')],
                        'Last 60 Days': [moment().subtract(59, 'days'), moment()],
                        'Last 90 Days': [moment().subtract(89, 'days'), moment()],
                        'Last 180 Days': [moment().subtract(179, 'days'), moment()],
                        'Last 12 Months': [moment().subtract(12, 'month'), moment()],
                        'Last 18 Months': [moment().subtract(18, 'month'), moment()],
                    }
                },
                function(start, end) {
                    // Only now, when the admin actually applies a range, do we write it into the
                    // field and ask the table to redraw with it.
                    startDate = start.format('DD-MMM-YYYY');
                    endDate = end.format('DD-MMM-YYYY');
                    $('#dateRange').val(startDate + ' to ' + endDate);
                    applyShipmentFilters();
                });

                // The "Clear" button (cancelLabel above) fires this event, not the apply callback.
                // Blank the field and redraw so the date filter is fully removed again.
                $('#dateRange').on('cancel.daterangepicker', function () {
                    $(this).val('');
                    applyShipmentFilters();
                });

                $('#shipmentEvaluation').on('click', ".clicker", function () {
                    nTr = $(this).parents('tr')[0];
                    // console.log(nTr);
                    aData = oTable.fnGetData(nTr);
                    if (oTable.fnIsOpen(nTr)) {
                        //console.log(aData[6]);
                        /* This row is already open - close it */
                        $(this).find('i').addClass("icon-plus");
                        $(this).find('i').removeClass("icon-minus");
                        //$(this).removeClass('btn-danger');

                        // Preserve the original state color so excluded / not evaluated rows stay neutral.
                        $(this)
                            .removeClass('btn-success btn-danger btn-warning btn-default')
                            .addClass($(this).data('btn-class'));

                        oTable.fnClose(nTr);
                    } else {
                        /* Open this row */
                        $(this).find('i').addClass("icon-minus");
                        $(this).find('i').removeClass("icon-add");
                        //$(this).removeClass('btn-success');
                        //$(this).addClass('btn-danger');
                        oTable.fnOpen(nTr, fnFormatDetails(oTable, nTr), 'details');
                    }
                });



                oTable = $("#shipmentEvaluation").dataTable({
                    "bJQueryUI": false,
                    "bAutoWidth": false,
                    "bInfo": true,
                    "bScrollCollapse": true,
                    "sPaginationType": "bootstrap",
                    "bRetrieve": false,
                    "bDestroy": true,
                    "bProcessing": true,
                    "bServerSide": true,
                    "sAjaxSource": "<?php echo $this->url(['module' => 'reports', 'controller' => 'distribution', 'action' => 'shipment', 'sid' => base64_encode($this->shipmentId), 'format' => 'html']); ?>",
                    "fnServerParams": function (aoData) {
                        // Universal filters (all schemes / countries).
                        var rs = $('#filterResponseStatus').val() || '';
                        var rr = $('#filterResult').val() || '';
                        var reg = $('#region').val() || '';
                        var st = $('#state').val() || '';
                        var dis = $('#district').val() || '';
                        var con = $('#country').val() || '';

                        var dateRange = $("#dateRange").val();
                        var sd = '';
                        var ed = '';
                        if (dateRange) {
                            var _dateRange = dateRange.split(" to ");
                            sd = _dateRange[0];
                            ed = _dateRange[1];
                        }

                        if (rs) { aoData.push({ "name": "filterResponseStatus", "value": rs }); }
                        if (rr) { aoData.push({ "name": "filterResult", "value": rr }); }
                        if (sd) { aoData.push({ "name": "startDate", "value": sd }); }
					    if (ed) { aoData.push({ "name": "endDate", "value": ed }); }
                        if (reg) { aoData.push({ "name": "region", "value": reg }); }
                        if (st) { aoData.push({ "name": "state", "value": st }); }
                        if (dis) { aoData.push({ "name": "district", "value": dis }); }
                        if (con) { aoData.push({ "name": "country", "value": con }); }
                        <?php if (($this->dtsSchemeType ?? '') === 'vietnam') { ?>
                            var tier = $('#vietnamTier').val() || '';
                            var kit  = $('#vietnamNonStandardKit').val() || '';
                            if (tier) { aoData.push({ "name": "vietnamTier", "value": tier }); }
                            if (kit)  { aoData.push({ "name": "vietnamNonStandardKit", "value": kit }); }
                        <?php } ?>
                    },
                    "fnServerData": function (sSource, aoData, fnCallback) {
                        $.ajax({
                            "dataType": "json",
                            "type": "POST",
                            "url": sSource,
                            "data": aoData,
                            "success": fnCallback
                        });
                    },
                    "aoColumns": [
                        { "bSortable": false },
                        { "sClass": "" },
                        { "sClass": "center" },
                        { "sClass": "center" },
                        { "sClass": "center" },
                        { "sClass": "center" },
                        { "sClass": "center" },
                        { "sClass": "" },
                        { "sClass": "" },
                        { "sClass": "center", "bSearchable": false, "bSortable": false },
                        { "sClass": "center" },
                        { "bSearchable": false, "bVisible": false }
                    ],
                    "aaSorting": [
                        [1, "asc"]
                    ]
                });
            });

            // Universal + per-scheme listing filters — redraw the DataTable; fnServerParams reads the dropdown values.
            function applyShipmentFilters() {
                var $t = $('#shipmentEvaluation');
                if ($t.length && $.fn.DataTable && $.fn.DataTable.isDataTable($t)) {
                    $t.dataTable().fnDraw();
                }
            }

            function manualOverride(value) {
                $.blockUI();
                var url = '/admin/evaluate/shipment/sid/<?php echo $this->id; ?>';
                val = '';
                if (value == 'yes') {
                    val = "eWVz";
                }
                if (value == 'no') {
                    val = "bm8=";
                }
                if (val != '') {
                    window.location.href = url + "/override/" + val;
                } else {
                    window.location.href = url;
                }
                $.unblockUI();
            }
            function fnFormatDetails(oTable, nTr) {
                var aData = oTable.fnGetData(nTr);
                var sOut = '<div class="text-center"><i class="icon-spinner icon-spin"></i> Loading...</div>';
                // map_id is in the hidden last column (index 11).
                var mapId = aData[11];
                // Load corrective actions via AJAX
                $.ajax({
                    url: '/common/get-corrective-actions/mid/' + mapId,
                    data: { format: 'html' },
                    async: false,
                    success: function (html) {
                        sOut = '<div style="padding-left:50px;">' + html + '</div>';
                    },
                    error: function () {
                        sOut = '<div class="text-muted">Failed to load corrective actions</div>';
                    }
                });
                return sOut;
            }

            function updateComment(sid) {
                // if ($.trim($("#shipmentComment").val()) == "") {
                //     alert("Please enter comment to proceed");
                //     return;
                // }
                $.blockUI();
                $.post("<?php echo $this->url(['module' => 'admin', 'controller' => 'evaluate', 'action' => 'update-shipment-comment'], 'default', true); ?>", {
                    sid: sid,
                    comment: $("#shipmentComment").val(),
                    format: "html"
                },
                    function (data) {
                        alert(data);
                        $.unblockUI();
                    });
            }
            function getOptions(table, searchfield, returnfield, searchvalue, returnid) {
                $.blockUI();
                if(searchvalue == null || searchvalue == undefined || searchvalue == '') {
                    $("#" + returnid).html('<option value="">-- <?= $this->translate->_("Select"); ?> --</option>');
                    $.unblockUI();
                    return false;
                }
                $.post("<?php echo $this->url(array('module' => 'default', 'controller' => 'common', 'action' => 'get-options-by-value')); ?>", {
                        table: table,
                        searchfield: searchfield,
                        returnfield: returnfield,
                        searchvalue: searchvalue,
                        format: "html"
                    },
                    function(data) {
                        if (data != 0 && data != '' && data != undefined) {
                            $("#" + returnid).html(data);
                        }
                        $.unblockUI();
                    });
            }
        </script>
