        // In-progress covers the whole async window: 'pending' (queued, waiting for the
        // worker) through 'generating'/'finalizing' (worker actively producing PDFs).
        // The button must stay disabled across ALL of them -- previously only 'pending'
        // was caught, so it re-enabled the moment the worker started, letting an admin
        // re-trigger a run that was still going.
        $reportInProgress = in_array($queueStatus, ['pending', 'generating', 'finalizing'], true);
        $reportFailed = ($queueStatus === 'failed');
        $reportQueue = $reportInProgress ? 'disabled' : '';
        if ($queueStatus === 'finalizing') {
            $reportTitle = 'Finalizing Reports ...';
        } elseif ($reportInProgress) {
            $reportTitle = 'Generating Participant Reports ...';
        } else {
            $reportTitle = 'Generate Participant Reports';
        }
        if (!$reportInProgress && $this->shipment[0]['report_generated'] == 'yes') {
            $reportTitle = 'Generate Reports';
