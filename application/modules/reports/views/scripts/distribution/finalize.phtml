                var $tr = $(this);
                if (!$tr.is('[data-response-status]')) {
                    return;
                }
                var ok = true;
                if (rs.length && rs.indexOf($tr.data('response-status')) === -1) { ok = false; }
                if (ok && rr.length && rr.indexOf(String($tr.data('result'))) === -1) { ok = false; }
                if (ok && mo && $tr.data('manual-override') !== mo) { ok = false; }
                if (ok && con.length && con.indexOf(String($tr.data('country'))) === -1) { ok = false; }
                if (ok && reg.length && reg.indexOf(String($tr.data('region'))) === -1) { ok = false; }
                if (ok && st.length && st.indexOf($tr.data('state')) === -1) { ok = false; }
                if (ok && dis.length && dis.indexOf($tr.data('district')) === -1) { ok = false; }
                if (ok && tier && $tr.data('tier') !== tier) { ok = false; }
                if (ok && kit && $tr.data('nonref-kit') !== kit) { ok = false; }
                if (ok && sd && ed) {
                    var rowDate = moment($tr.data('responded-on'), 'YYYY-MM-DD');
                    if (!rowDate.isValid() || rowDate.isBefore(sd, 'day') || rowDate.isAfter(ed, 'day')) { ok = false; }
                }
                $tr.toggle(ok);
            });
        }

        function getOptions(table, searchfield, returnfield, searchvalue, returnid) {
            $.blockUI();
            if(searchvalue == null || searchvalue == undefined || searchvalue == '') {
                $("#" + returnid).html('<option value="">-- <?= $this->translate->_("Select"); ?> --</option>');
                $.unblockUI();
                return false;
            }
            $.post("<?php echo $this->url(array('module' => 'default', 'controller' => 'common', 'action' => 'get-options-by-value')); ?>", {
                    table: table,
                    searchfield: searchfield,
                    returnfield: returnfield,
                    searchvalue: searchvalue,
                    format: "html"
                },
                function (data) {
                    if (data != 0 && data != '' && data != undefined) {
                        $("#" + returnid).html(data);
                    }
                    $.unblockUI();
                });
        }

