<script type="text/javascript">
	var tkTable = null;
	var tkRequest = null;
	var tkPosition = '';

	function tkNumber(n) {
		return Number(n || 0).toLocaleString();
	}

	function tkEscape(value) {
		return $('<div/>').text(value == null ? '' : String(value)).html();
	}

	function tkParams() {
		var params = reportFilters.values();
		params.position = tkPosition;
		return params;
	}

	function tkPassRate(k) {
		var evaluated = k.passed + k.failed;
		if (!evaluated) {
			return '<span class="cell-muted"><?= $this->jsTranslate("Not evaluated yet"); ?></span>';
		}
		var pct = Math.round(k.passed * 100 / evaluated);
		return '<span class="rate-figure">' + pct + '%</span>'
			+ '<span class="rate-bar is-pass"><span style="width:' + pct + '%"></span></span>'
			+ '<span class="cell-sub">' + "<?= $this->jsTranslate("%s of %s"); ?>".replace('%s', tkNumber(k.passed)).replace('%s', tkNumber(evaluated)) + '</span>';
	}

	function loadTestKits() {
		if (tkRequest) {
			tkRequest.abort();
		}
		tkTable.fnClearTable();
		$('#tkTable_processing').css('visibility', 'visible');
		tkRequest = $.post("<?= $tkDataUrl; ?>", tkParams(), function (data) {
			var responses = data.responses || 0;
			$('#tkStats [data-stat="responses"]').text(tkNumber(responses));
			$('#tkStats [data-stat="participants"]').text(tkNumber(data.participants));
			$('#tkStats [data-stat="kits"]').text(tkNumber(data.kits));

			var rows = $.map(data.rows || [], function (k) {
				var pct = responses > 0 ? Math.round(k.responses * 100 / responses) : 0;
				var name = k.name
					? '<span class="cell-main">' + tkEscape(k.name) + '</span>'
					: '<span class="cell-main cell-muted">' + tkEscape("<?= $this->jsTranslate("Unknown kit"); ?>") + '</span><span class="cell-sub">' + tkEscape(k.id) + '</span>';
				var evaluated = k.passed + k.failed;
				return [[
					'<div class="tk-kit" data-kit-id="' + tkEscape(k.id) + '"><span class="tk-toggle" aria-hidden="true"><i class="icon-chevron-right"></i></span><span>' + name + '</span></div>',
					'<span class="rate-figure">' + tkNumber(k.responses) + '</span>'
						+ '<span class="rate-bar"><span style="width:' + pct + '%"></span></span>'
						+ '<span class="cell-sub">' + "<?= $this->jsTranslate("%s of responses"); ?>".replace('%s', pct + '%') + '</span>',
					tkNumber(k.participants),
					tkNumber(k.test1),
					tkNumber(k.test2),
					tkNumber(k.test3),
					tkPassRate(k),
					k.failed > 0 ? '<span class="tk-failed">' + tkNumber(k.failed) + '</span>' : '0',
					k.responses,
					evaluated ? k.passed / evaluated : -1
				]];
			});
			// fnAddData([]) reads an empty array as one row with no cells.
			if (rows.length) {
				tkTable.fnAddData(rows);
			}
		}, 'json').always(function () {
			tkRequest = null;
			$('#tkTable_processing').css('visibility', 'hidden');
		});
	}

	$(function () {
		$('#tkPosition').on('click', 'button', function () {
			tkPosition = String($(this).data('position') || '');
			$('#tkPosition button').removeClass('active');
			$(this).addClass('active');
			if (tkTable) {
				loadTestKits();
			}
		});

		// A test kit opens the responses that used it.
		$('#tkTable tbody').on('click', 'tr', function () {
			var $kit = $(this).find('.tk-kit');
			if (!$kit.length) {
				return;
			}
			var tr = this;
			if (tkTable.fnIsOpen(tr)) {
				tkTable.fnClose(tr);
				$(tr).removeClass('tk-open');
				return;
			}
			tkTable.fnOpen(tr, '<div style="padding:4px;color:#888;"><?= $this->jsTranslate("Loading data from server"); ?></div>', 'tk-detail');
			$(tr).addClass('tk-open');
			var params = tkParams();
			params.kitId = $kit.data('kit-id');
			$.post("<?= $tkResponsesUrl; ?>", params, function (data) {
				$(tr).next('tr').find('td.tk-detail').html(data.html);
			}, 'json').fail(function () {
				$(tr).next('tr').find('td.tk-detail').html('<div style="padding:4px;color:#a94442;"><?= $this->jsTranslate("Failed to load. Please try again."); ?></div>');
			});
		});
	});

	reportFilters.onChange(loadTestKits);

	reportFilters.ready(function () {
		var hidden = function () { return { "bVisible": false, "sType": "numeric" }; };
		tkTable = $('#tkTable').dataTable({
			"oLanguage": reportZeroState.dataTableLanguage(),
			"bAutoWidth": false,
			"bPaginate": false,
			"bFilter": false,
			"bInfo": false,
			"bProcessing": true,
			"sDom": "rt",
			"aoColumns": [
				{ "sWidth": "28%" },
				{ "sWidth": "16%", "iDataSort": 8 },
				{ "sWidth": "9%" },
				{ "sWidth": "8%" },
				{ "sWidth": "8%" },
				{ "sWidth": "8%" },
				{ "sWidth": "15%", "iDataSort": 9 },
				{ "sWidth": "8%" },
				hidden(),
				hidden()
			],
			"aaSorting": [[8, "desc"]]
		});
		loadTestKits();
	});

	function exportTestKits() {
		$.blockUI();
		$.post("<?= $tkExportUrl; ?>", tkParams(), function (data) {
			$.unblockUI();
			if (!data || !data.file) {
				alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
			} else {
				window.open('/temporary/' + data.file, '_blank');
			}
		}, 'json').fail(function () {
			$.unblockUI();
			alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
		});
	}
</script>
