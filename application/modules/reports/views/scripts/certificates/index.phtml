<script type="text/javascript">
(function () {
    var urls = {
        shipments: "<?= $u('shipments'); ?>",
        check: "<?= $u('check'); ?>",
        generate: "<?= $u('generate'); ?>",
        status: "<?= $u('status'); ?>",
        review: "<?= $u('review'); ?>",
        approve: "<?= $u('approve'); ?>",
        discard: "<?= $u('discard'); ?>",
        spreadsheet: "<?= $u('spreadsheet'); ?>",
        templates: "<?= $templatesUrl; ?>"
    };
    var T = {
        excellence: "<?= $this->jsTranslate("Excellence"); ?>",
        participation: "<?= $this->jsTranslate("Participation"); ?>",
        none: "<?= $this->jsTranslate("No certificate"); ?>"
    };
    var activeBatch = <?= $json($this->activeBatch ? ['batch_id' => (int) $this->activeBatch['batch_id'], 'name' => $this->activeBatch['batch_name'], 'status' => $this->activeBatch['status'], 'created_on' => Pt_Commons_DateUtility::humanReadableDateFormat($this->activeBatch['created_on'])] : null); ?>;
    var state = { step: 1, shipments: {}, check: null, batch: null, review: null, tab: 'certificates' };
    var poll = null;

    // Show the current step open, finished steps as one-line summaries and
    // later steps hidden, with the stepper marking each.
    function go(step) {
        state.step = step;
        $('#acStepper li').each(function () {
            var n = +$(this).data('step');
            $(this).toggleClass('is-current', n === step).toggleClass('is-done', n < step);
        });
        $('.ac-step').each(function () {
            var n = +$(this).data('step');
            $(this).toggleClass('is-current', n === step).toggleClass('is-done', n < step).toggleClass('is-todo', n > step);
        });
        // Before generating, earlier choices can still change. After, they cannot.
        $('.ac-change').toggle(step <= 3);
    }

    function summary(step, text) {
        $('.ac-step[data-step="' + step + '"] .ac-summary span').text(text);
    }

    function pickedIds() {
        return $('#acShipments input:checked').map(function () { return this.value; }).get();
    }

    // Step 1: the year's shipments, all ticked to start with.
    function loadShipments() {
        $('#acShipments').html('<p class="ac-muted"><?= $this->jsTranslate("Loading..."); ?></p>');
        $.getJSON(urls.shipments, { year: $('#acYear').val() }, function (schemes) {
            var $box = $('#acShipments').empty();
            state.shipments = schemes || {};
            if ($.isEmptyObject(state.shipments)) {
                $box.append($('<p class="ac-bad"/>').text("<?= $this->jsTranslate("No finalized shipments in this year. Pick another year."); ?>"));
                return;
            }
            $.each(state.shipments, function (scheme, data) {
                var $s = $('<div class="ac-scheme"/>').append($('<strong/>').text(data.name));
                $.each(data.shipments, function (i, sh) {
                    $s.append($('<label/>')
                        .append($('<input type="checkbox" checked/>').val(sh.id))
                        .append($('<span/>').text(sh.code))
                        .append($('<span class="ac-muted"/>').text(sh.date + ' · ' + "<?= $this->jsTranslate("%d of %d labs responded"); ?>".replace('%d', sh.counted).replace('%d', sh.enrolled))));
                });
                $box.append($s);
            });
        });
    }
    $('#acYear').on('change', loadShipments);

    $('#acToTemplates').on('click', function () {
        var ids = pickedIds();
        if (!ids.length) {
            alert("<?= $this->jsTranslate("Tick at least one shipment."); ?>");
            return;
        }
        var codes = $('#acShipments input:checked').map(function () { return $(this).next().text(); }).get();
        summary(1, $('#acYear').val() + ': ' + codes.join(', '));
        runCheck(function () { go(2); });
    });

    // Steps 2 and 3 share one check: templates, counts and skipped labs.
    function runCheck(done) {
        $.post(urls.check, { shipmentId: pickedIds(), year: $('#acYear').val() }, function (result) {
            state.check = result;
            renderTemplates();
            renderCounts();
            if (done) {
                done();
            }
        }, 'json').fail(function () {
            alert("<?= $this->jsTranslate("The check could not run. Please try again."); ?>");
        });
    }

    function templatesReady() {
        var ready = true;
        $.each(state.check.schemes, function (scheme, s) {
            if (s.excellence !== 'ready' || s.participation !== 'ready') {
                ready = false;
            }
        });
        return ready;
    }

    function renderTemplates() {
        var $box = $('#acTemplates').empty();
        var labels = {
            ready: "<?= $this->jsTranslate("ready"); ?>",
            missing: "<?= $this->jsTranslate("missing, upload it"); ?>",
            needs_layout: "<?= $this->jsTranslate("place the participant name on it"); ?>"
        };
        $.each(state.check.schemes, function (scheme, s) {
            var name = (state.shipments[scheme] || {}).name || scheme;
            var $row = $('<div class="ac-scheme"/>').append($('<strong/>').text(name));
            $.each({ excellence: T.excellence, participation: T.participation }, function (type, label) {
                var ok = s[type] === 'ready';
                $row.append($('<div/>').addClass(ok ? 'ac-ok' : 'ac-bad')
                    .append(ok ? '<i class="icon-ok"></i> ' : '<i class="icon-remove"></i> ')
                    .append($('<span/>').text(label + ': ' + (labels[s[type]] || s[type]))));
            });
            if (s.excellence !== 'ready' || s.participation !== 'ready') {
                $row.append($('<a target="_blank" rel="noopener"/>').attr('href', urls.templates + '#scheme-' + encodeURIComponent(scheme))
                    .text("<?= $this->jsTranslate("Fix the templates (opens in a new tab)"); ?>"));
            }
            $box.append($row);
        });
        var ready = templatesReady();
        $('#acToCheck').prop('disabled', !ready);
        summary(2, ready ? "<?= $this->jsTranslate("All templates ready"); ?>" : '');
    }

    $('#acRecheck').on('click', function () { runCheck(); });
    $('#acToCheck').on('click', function () {
        runCheck(function () {
            if (templatesReady()) {
                go(3);
            }
        });
    });

    function renderCounts() {
        var c = state.check;
        var $box = $('#acCounts').empty();
        var $t = $('<table class="table table-condensed ac-table"/>').append(
            $('<tr/>').append($('<th/>').text("<?= $this->jsTranslate("Scheme"); ?>"), $('<th/>').text(T.excellence), $('<th/>').text(T.participation), $('<th/>').text(T.none)));
        var totals = { excellence: 0, participation: 0, skipped: 0 };
        var heavy = [];
        $.each(c.counts, function (scheme, n) {
            var name = (state.shipments[scheme] || {}).name || scheme;
            $t.append($('<tr/>').append($('<td/>').text(name), $('<td/>').text(n.excellence), $('<td/>').text(n.participation), $('<td/>').text(n.skipped)));
            totals.excellence += n.excellence;
            totals.participation += n.participation;
            totals.skipped += n.skipped;
            var all = n.excellence + n.participation + n.skipped;
            if (c.schemes[scheme].shipments.length > 1 && all > 0 && n.skipped / all > 0.3) {
                heavy.push(name);
            }
        });
        $box.append($t);
        if (heavy.length) {
            $box.append($('<div class="ac-warn"/>').text("<?= $this->jsTranslate("Many labs missed one of the ticked shipments of: %s. If these shipments went to different labs, click Change in step 1, tick one group and make a separate batch for the other."); ?>".replace('%s', heavy.join(', '))));
        }
        if (c.skipped.length) {
            var $details = $('<details/>').append($('<summary/>').text("<?= $this->jsTranslate("Show the %d participants who get no certificate"); ?>".replace('%d', c.skipped.length)));
            $details.append($('<div class="ac-list"/>').append(skippedTable(c.skipped)));
            $box.append($details);
        }
        $('#acName').val(c.name);
        summary(3, T.excellence + ' ' + totals.excellence + ' · ' + T.participation + ' ' + totals.participation + ' · ' + T.none + ' ' + totals.skipped);
    }

    function skippedTable(rows) {
        var $t = $('<table class="table table-condensed ac-table"/>').append($('<tr/>').append(
            $('<th/>').text("<?= $this->jsTranslate("Lab ID"); ?>"), $('<th/>').text("<?= $this->jsTranslate("Participant"); ?>"),
            $('<th/>').text("<?= $this->jsTranslate("Scheme"); ?>"), $('<th/>').text("<?= $this->jsTranslate("Reason"); ?>")));
        $.each(rows, function (i, r) {
            $t.append($('<tr/>').append($('<td/>').text(r.unique_identifier), $('<td/>').text(r.participant_name), $('<td/>').text(r.scheme_name),
                $('<td/>').text("<?= $this->jsTranslate("Did not respond to %s"); ?>".replace('%s', (r.missed || []).join(', ')))));
        });
        return $t;
    }

    $('#acSpreadsheet').on('click', function () {
        $.getJSON(urls.spreadsheet, { year: $('#acYear').val(), shipmentId: pickedIds() }, function (r) {
            if (r && r.fileName) {
                window.location = "<?= $this->baseUrl('temporary/annual-reports/'); ?>" + encodeURIComponent(r.fileName);
            }
        });
    });

    $('#acGenerate').on('click', function () {
        var name = $('#acName').val();
        if (!/^[A-Za-z0-9-]{1,100}$/.test(name)) {
            alert("<?= $this->jsTranslate("The batch name can only contain letters, numbers and hyphens."); ?>");
            return;
        }
        var $btn = $(this).prop('disabled', true);
        $.post(urls.generate, { shipmentId: pickedIds(), name: name }, function (r) {
            if (r && r.success) {
                startBatch({ batch_id: r.batchId, name: name, status: 'pending' });
            } else {
                alert((r && r.message) || "<?= $this->jsTranslate("Certificates could not be queued. Please try again."); ?>");
            }
        }, 'json').always(function () { $btn.prop('disabled', false); });
    });

    $('.ac-change').on('click', function () {
        var step = +$(this).closest('.ac-step').data('step');
        go(step);
    });

    // Steps 4 to 6 follow the batch's status on the server.
    function startBatch(batch) {
        state.batch = batch;
        $('.ac-change').hide();
        summary(1, "<?= $this->jsTranslate("Batch %s"); ?>".replace('%s', batch.name));
        summary(2, "<?= $this->jsTranslate("All templates ready"); ?>");
        summary(3, "<?= $this->jsTranslate("Checked"); ?>");
        follow();
    }

    function follow() {
        clearTimeout(poll);
        $.getJSON(urls.status, { batch: state.batch.batch_id }, function (b) {
            if (!b || !b.success) {
                return;
            }
            state.batch = b;
            var again = true;
            if (b.status === 'pending' || b.status === 'generating') {
                go(4);
                $('#acGenError').hide();
                $('#acGenBar').show();
                $('#acCancel').show();
                $('#acGenMessage').text(b.status === 'pending'
                    ? "<?= $this->jsTranslate("Waiting to start. Generation starts within a minute. You can leave this page. Generation carries on without you."); ?>"
                    : "<?= $this->jsTranslate("Generating the certificates. This takes a few minutes for a large programme. You can leave this page. Generation carries on without you."); ?>");
            } else if (b.status === 'failed') {
                go(4);
                again = false;
                $('#acGenBar, #acCancel').hide();
                $('#acGenMessage').text("<?= $this->jsTranslate("Generation stopped."); ?>");
                $('#acGenError').show().empty().append($('<div/>').text(b.error || ''))
                    .append($('<button type="button" class="btn btn-primary btn-sm" style="margin-top:8px;"/>').text("<?= $this->jsTranslate("Start again"); ?>").on('click', restart));
            } else if (b.status === 'generated') {
                again = false;
                summary(4, T.excellence + ' ' + b.excellence + ' · ' + T.participation + ' ' + b.participation);
                go(5);
                loadReview();
            } else if (b.status === 'approved' || b.status === 'distributing' || b.status === 'distributed') {
                summary(4, T.excellence + ' ' + b.excellence + ' · ' + T.participation + ' ' + b.participation);
                summary(5, "<?= $this->jsTranslate("Approved"); ?>");
                go(6);
                var finished = b.status === 'distributed';
                again = !finished;
                $('#acDoneBar').toggle(!finished);
                $('#acNew').toggle(finished);
                $('#acDoneMessage').text(finished
                    ? "<?= $this->jsTranslate("Done. Each participant can now download their certificate from Downloads in their account."); ?>" + (b.error ? ' ' + b.error : '')
                    : "<?= $this->jsTranslate("Approved. ePT is copying each certificate to its participant. This starts within a minute."); ?>");
            } else {
                // Cancelled or rejected: back to the start.
                again = false;
                restart();
            }
            if (again) {
                poll = setTimeout(follow, 3000);
            }
        });
    }

    function loadReview() {
        $('#acReviewCounts').text(T.excellence + ': ' + state.batch.excellence + ' · ' + T.participation + ': ' + state.batch.participation + ' · ' + T.none + ': ' + state.batch.skipped);
        if (state.batch.download_url) {
            $('#acZip').attr('href', "<?= $this->baseUrl(); ?>" + state.batch.download_url).show();
        }
        $.getJSON(urls.review, { batch: state.batch.batch_id }, function (r) {
            state.review = r;
            $('[data-tab="certificates"]').text("<?= $this->jsTranslate("Certificates (%d)"); ?>".replace('%d', r.certificates.length));
            $('[data-tab="skipped"]').text("<?= $this->jsTranslate("No certificate (%d)"); ?>".replace('%d', r.skipped.length));
            renderReview();
        });
    }

    function renderReview() {
        var q = ($('#acSearch').val() || '').toLowerCase();
        var match = function (r) { return !q || (r.unique_identifier + ' ' + r.participant_name).toLowerCase().indexOf(q) !== -1; };
        var $t = $('#acReviewTable').empty();
        if (state.tab === 'skipped') {
            $t.append(skippedTable($.grep(state.review.skipped, match)).children());
            return;
        }
        $t.append($('<tr/>').append($('<th/>').text("<?= $this->jsTranslate("Lab ID"); ?>"), $('<th/>').text("<?= $this->jsTranslate("Participant"); ?>"),
            $('<th/>').text("<?= $this->jsTranslate("Scheme"); ?>"), $('<th/>').text("<?= $this->jsTranslate("Certificate"); ?>"), $('<th/>')));
        $.each($.grep(state.review.certificates, match).slice(0, 500), function (i, r) {
            $t.append($('<tr/>').append($('<td/>').text(r.unique_identifier), $('<td/>').text(r.participant_name),
                $('<td/>').text(r.scheme_type.toUpperCase()), $('<td/>').text(T[r.certificate_type] || r.certificate_type),
                $('<td/>').append($('<a target="_blank" rel="noopener"/>').attr('href', "<?= $this->baseUrl(); ?>" + r.url).text("<?= $this->jsTranslate("View"); ?>"))));
        });
    }
    $('#acSearch').on('input', renderReview);
    $('.ac-tabs [data-tab]').on('click', function () {
        state.tab = $(this).data('tab');
        $('.ac-tabs [data-tab]').removeClass('is-on');
        $(this).addClass('is-on');
        renderReview();
    });

    $('#acApprove').on('click', function () {
        if (!confirm("<?= $this->jsTranslate("Approve this batch? Each participant can then download their certificate from their account. ePT does not email them."); ?>")) {
            return;
        }
        $.post(urls.approve, { batch: state.batch.batch_id }, function (r) {
            if (r && r.success) {
                follow();
            } else {
                alert((r && r.message) || "<?= $this->jsTranslate("The batch could not be approved. Please try again."); ?>");
            }
        }, 'json');
    });

    function discard(question) {
        if (!confirm(question)) {
            return;
        }
        $.post(urls.discard, { batch: state.batch.batch_id }, function () { restart(); }, 'json');
    }
    $('#acDiscard').on('click', function () {
        discard("<?= $this->jsTranslate("Discard this batch? Participants never see it. You can start again from step 1."); ?>");
    });
    $('#acCancel').on('click', function () {
        discard("<?= $this->jsTranslate("Stop generating this batch? You can start again from step 1."); ?>");
    });

    function restart() {
        clearTimeout(poll);
        state.batch = null;
        $('#acResume').hide();
        $('.ac-summary span').text('');
        go(1);
        loadShipments();
    }
    $('#acNew').on('click', restart);

    // Open where the admin stopped.
    if (activeBatch) {
        $('#acResume').show().text((activeBatch.status === 'distributed'
            ? "<?= $this->jsTranslate("The last batch, %s, started on %s, is done."); ?>"
            : "<?= $this->jsTranslate("Continuing the batch %s, started on %s."); ?>").replace('%s', activeBatch.name).replace('%s', activeBatch.created_on));
        startBatch(activeBatch);
    } else {
        go(1);
        loadShipments();
    }
})();
</script>
