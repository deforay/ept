<script type="text/javascript">
	$(document).ready(function () {
		$(".datepicker").datepicker({
			dateFormat: '<?php echo $dtFormat; ?>',
		});
	});

	function validateNow() {
		flag = deforayValidator.init({
			formId: 'capaForm'
		});
		if (flag) {
			$.blockUI();
			document.getElementById('capaForm').submit();
		}
	}
	function generateReport() {
		$.blockUI();
		$.post("<?php echo $this->url(array('module' => 'reports', 'controller' => 'corrective-preventive-actions', 'action' => 'capa-export')); ?>", {
			type: "view",
			originatedFrom: "admin",
			format: "html"
		},
			function (data) {
				if (data != "") {
					document.location.href = '/temporary/' + data;
				}
				$.unblockUI();
			});
	}
</script>