<script type="text/javascript" src="<?php echo $this->assetUrl('js/daterangepicker.js'); ?>"></script>
<script type="text/javascript" src="<?php echo $this->baseUrl('js/select2.min.js'); ?>"></script>
<script type="text/javascript">
	var currentBatchId = null;
	// Which certificate templates each scheme has, and the scheme of each
	// shipment in the list, to warn before certificates are generated.
	var templateStatus = <?= json_encode($this->templateStatus ?? new stdClass()); ?>;
	var templatesUrl = "<?= $this->url(['module' => 'admin', 'controller' => 'certificate-templates'], 'default', true); ?>";
	var shipmentSchemes = {};
	var templatesMissing = false;
	var pollingInterval = null;
	var shipmentRequest = null;

	function annualParams() {
		var range = ($('#dateRange').val() || '').split(' to ');
		return {
			startDate: range[0] || '',
			endDate: range[1] || '',
			scheme: $('#scheme').val() || [],
			shipmentId: $('#shipmentId').val() || []
		};
	}

	// The shipment list follows the date range and the schemes. Picked
	// shipments stay picked while they are still in the list.
	function loadShipments() {
		var params = annualParams();
		delete params.shipmentId;
		if (shipmentRequest) {
			shipmentRequest.abort();
		}
		shipmentRequest = $.post("<?= $this->url(['module' => 'reports', 'controller' => 'annual', 'action' => 'shipments'], 'default', true); ?>", params, function (shipments) {
			var picked = $('#shipmentId').val() || [];
			var $select = $('#shipmentId').empty();
			var kept = [];
			shipmentSchemes = {};
			$.each(shipments || [], function (i, shipment) {
				shipmentSchemes[shipment.id] = shipment.scheme;
				$select.append($('<option/>').val(shipment.id).text(shipment.text));
				if (picked.indexOf(String(shipment.id)) !== -1) {
					kept.push(String(shipment.id));
				}
			});
			$select.val(kept).trigger('change.select2');
			var count = (shipments || []).length;
			$('#shipmentHint').text(count
				? "<?= $this->jsTranslate("%s finalized shipments in this range."); ?>".replace('%s', count)
				: "<?= $this->jsTranslate("No finalized shipments in this range."); ?>");
			$('#getReportBtn').prop('disabled', !count);
			renderTemplateReadiness();
		}, 'json').always(function () {
			shipmentRequest = null;
		});
	}

	$(function () {
		$('#scheme').select2({ placeholder: "<?= $this->jsTranslate("All schemes"); ?>", allowClear: true });
		$('#shipmentId').select2({ placeholder: "<?= $this->jsTranslate("All finalized shipments in the range"); ?>", allowClear: true });

		$('#certificateName').on('input', function () {
			allowOnlyAlphaNumericAndHyphen('#certificateName');
		});

		$('#dateRange').daterangepicker({
			locale: {
				cancelLabel: "<?= $this->jsTranslate("Clear"); ?>",
				format: 'DD-MMM-YYYY',
				separator: ' to '
			},
			showDropdowns: true,
			autoApply: true,
			alwaysShowCalendars: true,
			startDate: moment().subtract(1, 'year'),
			endDate: moment(),
			maxDate: moment(),
			ranges: eptDateRanges()
		}).on('apply.daterangepicker', function () {
			$(this).trigger('change');
		});

		$('#dateRange, #scheme').on('change', function () {
			resetResult();
			loadShipments();
		});
		$('#shipmentId').on('change', resetResult);
		$('input[name="reportType"]').on('change', function () {
			$('.an-type').removeClass('is-active');
			$(this).closest('.an-type').addClass('is-active');
			resetResult();
		});

		loadShipments();
	});

	// A changed choice makes the generated file and the certificate step stale.
	function resetResult() {
		$('#summaryDiv').empty();
		$('.certificate-btn').hide();
		renderTemplateReadiness();
	}

	// The schemes the certificates would cover: those of the picked
	// shipments, or of every shipment in the list.
	function selectedSchemes() {
		var picked = $('#shipmentId').val() || [];
		var ids = picked.length ? picked : Object.keys(shipmentSchemes);
		var schemes = [];
		$.each(ids, function (i, id) {
			var scheme = shipmentSchemes[id];
			if (scheme && schemes.indexOf(scheme) === -1) {
				schemes.push(scheme);
			}
		});
		return schemes;
	}

	// With "For Certification" picked, list each scheme's templates, and
	// link to Certificate Templates for any that are missing.
	function renderTemplateReadiness() {
		var $box = $('#templateReadiness').empty();
		templatesMissing = false;
		if ($('input[name="reportType"]:checked').val() !== 'excel') {
			return;
		}
		var schemes = selectedSchemes();
		if (!schemes.length) {
			return;
		}
		var $list = $('<ul/>');
		$.each(schemes, function (i, scheme) {
			var status = templateStatus[scheme] || { name: scheme, excellence: false, participation: false };
			var missing = [];
			if (!status.excellence) {
				missing.push("<?= $this->jsTranslate("Excellence"); ?>");
			}
			if (!status.participation) {
				missing.push("<?= $this->jsTranslate("Participation"); ?>");
			}
			var $item = $('<li/>');
			if (missing.length) {
				templatesMissing = true;
				$item.addClass('is-missing')
					.append('<i class="icon-remove"></i> ')
					.append($('<span/>').text(status.name + ": " + "<?= $this->jsTranslate("no %s template."); ?>".replace('%s', missing.join(' / '))))
					.append(' ')
					.append($('<a target="_blank" rel="noopener"/>').attr('href', templatesUrl + '#scheme-' + encodeURIComponent(scheme)).text("<?= $this->jsTranslate("Upload it"); ?>"));
			} else {
				$item.addClass('is-ok')
					.append('<i class="icon-ok"></i> ')
					.append($('<span/>').text(status.name + ": " + "<?= $this->jsTranslate("templates ready"); ?>"));
			}
			$list.append($item);
		});
		$box.append($('<strong/>').text("<?= $this->jsTranslate("Certificate templates"); ?>")).append($list);
		if (templatesMissing) {
			$box.append($('<div class="an-hint"/>').text("<?= $this->jsTranslate("Certificates need both templates for each scheme. Upload the missing templates, then reload this page."); ?>"));
		}
	}

	function getAnnualReport() {
		var params = annualParams();
		if (!params.startDate || !params.endDate) {
			alert("<?= $this->jsTranslate("Please pick a date range to fetch shipment list"); ?>");
			return;
		}
		params.reportType = $('input[name="reportType"]:checked').val();
		$.blockUI();
		$.post("<?= $this->url(['module' => 'reports', 'controller' => 'annual', 'action' => 'index'], 'default', true); ?>", $.extend({ format: 'html' }, params), function (data) {
			$.unblockUI();
			data = typeof data === 'string' ? $.parseJSON(data) : data;
			if (!data || !data.fileName) {
				reportZeroState.show('#summaryDiv', 'empty');
				$('.certificate-btn').hide();
				return;
			}
			var $link = $('<a class="btn btn-success btn-sm" target="_blank" rel="noopener"/>')
				.attr('href', "<?= $this->baseUrl('temporary/annual-reports/'); ?>" + encodeURIComponent(data.fileName))
				.append('<i class="icon-download-alt"></i> ')
				.append($('<span/>').text("<?= $this->jsTranslate("Download"); ?> " + data.fileName));
			$('#summaryDiv').empty().append($link);
			$('.certificate-btn').toggle(data.reportType === 'excel');
			$('.certificate-anchor').attr('disabled', false);
		}).fail(function () {
			$.unblockUI();
			alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
		});
	}

	function genarateCertificate(obj) {
		var certificateName = $('#certificateName').val();
		if (certificateName === '') {
			alert("<?= $this->jsTranslate("Please enter the certificate name to proceed"); ?>");
			return;
		}
		if (templatesMissing) {
			alert("<?= $this->jsTranslate("Some schemes have no certificate template. Upload the missing templates first. The list above the Generate report button shows which ones."); ?>");
			return;
		}
		if (!/^[a-zA-Z0-9-]+$/.test(certificateName)) {
			alert("<?= $this->jsTranslate("The certificate name can only contain letters, numbers and hyphens."); ?>");
			return;
		}
		var params = annualParams();
		params.certificateName = certificateName;
		params.format = 'html';
		$.blockUI();
		$.post("<?= $this->url(['module' => 'reports', 'controller' => 'annual', 'action' => 'save-scheduled-jobs'], 'default', true); ?>", params, function (data) {
			$.unblockUI();
			if (data > 0) {
				currentBatchId = parseInt(data, 10);
				$(obj).attr('disabled', true);
				resetCertificateUI();
				$('#certificateProgressSection').show();
				$('#certificateProgressIndicator').show();
				$('#progressMessage').text("<?= $this->jsTranslate("Generating certificates..."); ?>");
				startStatusPolling();
			} else {
				alert("<?= $this->jsTranslate("No matched shipment for selected date range."); ?>");
			}
		}).fail(function () {
			$.unblockUI();
			alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
		});
	}

	function resetCertificateUI() {
		$('#certificateProgressIndicator, #certificateErrorSection, #certificateStatsSection, #certificateDistributionSection').hide();
	}

	function startStatusPolling() {
		stopStatusPolling();
		pollingInterval = setInterval(checkCertificateStatus, 3000);
	}

	function stopStatusPolling() {
		if (pollingInterval) {
			clearInterval(pollingInterval);
			pollingInterval = null;
		}
	}

	function checkCertificateStatus() {
		if (!currentBatchId) {
			stopStatusPolling();
			return;
		}
		$.get("<?= $this->url(['module' => 'reports', 'controller' => 'annual', 'action' => 'get-certificate-status'], 'default', true); ?>", {
			batch_id: currentBatchId,
			format: 'json'
		}, function (response) {
			if (!response.success) {
				stopStatusPolling();
				showCertificateError(response.error_message || "<?= $this->jsTranslate("Failed to get status"); ?>");
				return;
			}
			switch (response.status) {
				case 'pending':
				case 'generating':
					$('#progressMessage').text(response.status === 'generating'
						? "<?= $this->jsTranslate("Generating certificates..."); ?>"
						: "<?= $this->jsTranslate("Waiting to start..."); ?>");
					break;
				case 'generated':
					stopStatusPolling();
					showCertificateStats(response);
					break;
				case 'failed':
					stopStatusPolling();
					showCertificateError(response.error_message || "<?= $this->jsTranslate("Certificate generation failed"); ?>");
					break;
				case 'approved':
				case 'distributing':
					// Keep polling until the distribution job finishes.
					showDistributionStatus(response.status);
					break;
				case 'distributed':
					stopStatusPolling();
					showDistributionStatus(response.status, response.error_message);
					break;
				case 'cancelled':
				case 'rejected':
					stopStatusPolling();
					showCertificateError(response.status === 'cancelled'
						? "<?= $this->jsTranslate("This batch was cancelled."); ?>"
						: "<?= $this->jsTranslate("This batch was rejected. Its certificates are not distributed."); ?>");
					break;
			}
		}).fail(function () {
			// Keep polling. The next check may get through.
			console.error('Failed to check certificate status');
		});
	}

	function showCertificateError(message) {
		resetCertificateUI();
		$('#certificateProgressSection').show();
		$('#certificateErrorSection').show();
		$('#certificateErrorMessage').text(message);
	}

	function showCertificateStats(data) {
		resetCertificateUI();
		$('#certificateProgressSection').show();
		$('#certificateStatsSection').show();
		$('#excellenceCount').text(data.excellence_count);
		$('#participationCount').text(data.participation_count);
		$('#skippedCount').text(data.skipped_count);
		if (data.download_url) {
			$('#downloadZipBtn').attr('href', "<?= $this->baseUrl(); ?>" + data.download_url).show();
		} else {
			$('#downloadZipBtn').hide();
		}
	}

	function showDistributionStatus(status, problem) {
		var messages = {
			approved: "<?= $this->jsTranslate("Certificates approved. Distribution is scheduled and starts within a minute."); ?>",
			distributing: "<?= $this->jsTranslate("Certificates are being distributed..."); ?>",
			distributed: "<?= $this->jsTranslate("Certificates are distributed. Participants can download them from their Certificates page."); ?>"
		};
		resetCertificateUI();
		$('#certificateProgressSection').show();
		$('#certificateDistributionSection').show();
		$('#distributionMessage').text((messages[status] || messages.approved) + (problem ? ' ' + problem : ''));
	}

	function approveCertificates() {
		if (!currentBatchId) {
			alert("<?= $this->jsTranslate("No batch selected"); ?>");
			return;
		}
		if (!confirm("<?= $this->jsTranslate("Approve these certificates? Each participant can then download theirs from the Certificates page. No email is sent."); ?>")) {
			return;
		}
		$.blockUI();
		$.post("<?= $this->url(['module' => 'reports', 'controller' => 'annual', 'action' => 'approve-certificates'], 'default', true); ?>", {
			batch_id: currentBatchId,
			format: 'json'
		}, function (response) {
			$.unblockUI();
			if (response.success) {
				showDistributionStatus('approved');
				startStatusPolling();
			} else {
				alert(response.message || "<?= $this->jsTranslate("Failed to approve certificates. Please try again."); ?>");
			}
		}).fail(function () {
			$.unblockUI();
			alert("<?= $this->jsTranslate("Failed to approve certificates. Please try again."); ?>");
		});
	}
</script>
