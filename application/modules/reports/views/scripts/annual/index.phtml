<script type="text/javascript" src="<?php echo $this->baseUrl('js/select2.min.js'); ?>"></script>
<script type="text/javascript">
	var shipmentRequest = null;

	function annualParams() {
		var range = ($('#dateRange').val() || '').split(' to ');
		return {
			startDate: range[0] || '',
			endDate: range[1] || '',
			scheme: $('#scheme').val() || [],
			shipmentId: $('#shipmentId').val() || []
		};
	}

	// The shipment list follows the date range and the schemes. Picked
	// shipments stay picked while they are still in the list.
	function loadShipments() {
		var params = annualParams();
		delete params.shipmentId;
		if (shipmentRequest) {
			shipmentRequest.abort();
		}
		shipmentRequest = $.post("<?= $this->url(['module' => 'reports', 'controller' => 'annual', 'action' => 'shipments'], 'default', true); ?>", params, function (shipments) {
			var picked = $('#shipmentId').val() || [];
			var $select = $('#shipmentId').empty();
			var kept = [];
			$.each(shipments || [], function (i, shipment) {
				$select.append($('<option/>').val(shipment.id).text(shipment.text));
				if (picked.indexOf(String(shipment.id)) !== -1) {
					kept.push(String(shipment.id));
				}
			});
			$select.val(kept).trigger('change.select2');
			var count = (shipments || []).length;
			$('#shipmentHint').text(count
				? "<?= $this->jsTranslate("%s finalized shipments in this range."); ?>".replace('%s', count)
				: "<?= $this->jsTranslate("No finalized shipments in this range."); ?>");
			$('#getReportBtn').prop('disabled', !count);
		}, 'json').always(function () {
			shipmentRequest = null;
		});
	}

	$(function () {
		$('#scheme').select2({ placeholder: "<?= $this->jsTranslate("All schemes"); ?>", allowClear: true });
		$('#shipmentId').select2({ placeholder: "<?= $this->jsTranslate("All finalized shipments in the range"); ?>", allowClear: true });


		$('#dateRange').daterangepicker({
			locale: {
				cancelLabel: "<?= $this->jsTranslate("Clear"); ?>",
				format: 'DD-MMM-YYYY',
				separator: ' to '
			},
			showDropdowns: true,
			autoApply: true,
			alwaysShowCalendars: true,
			startDate: moment().subtract(1, 'year'),
			endDate: moment(),
			maxDate: moment(),
			ranges: eptDateRanges()
		}).on('apply.daterangepicker', function () {
			$(this).trigger('change');
		});

		$('#dateRange, #scheme').on('change', function () {
			resetResult();
			loadShipments();
		});
		$('#shipmentId').on('change', resetResult);
		$('input[name="reportType"]').on('change', function () {
			$('.an-type').removeClass('is-active');
			$(this).closest('.an-type').addClass('is-active');
			resetResult();
		});

		loadShipments();
	});

	// A changed choice makes the generated file stale.
	function resetResult() {
		$('#summaryDiv').empty();
	}

	function getAnnualReport() {
		var params = annualParams();
		if (!params.startDate || !params.endDate) {
			alert("<?= $this->jsTranslate("Please pick a date range to fetch shipment list"); ?>");
			return;
		}
		params.reportType = $('input[name="reportType"]:checked').val();
		$.blockUI();
		$.post("<?= $this->url(['module' => 'reports', 'controller' => 'annual', 'action' => 'index'], 'default', true); ?>", $.extend({ format: 'html' }, params), function (data) {
			$.unblockUI();
			data = typeof data === 'string' ? $.parseJSON(data) : data;
			if (!data || !data.fileName) {
				reportZeroState.show('#summaryDiv', 'empty');
				return;
			}
			var $link = $('<a class="btn btn-success btn-sm" target="_blank" rel="noopener"/>')
				.attr('href', "<?= $this->baseUrl('temporary/annual-reports/'); ?>" + encodeURIComponent(data.fileName))
				.append('<i class="icon-download-alt"></i> ')
				.append($('<span/>').text("<?= $this->jsTranslate("Download"); ?> " + data.fileName));
			$('#summaryDiv').empty().append($link);
		}).fail(function () {
			$.unblockUI();
			alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
		});
	}
</script>
