<?php
$downloads = $this->downloads ?? [];
$heading = $this->reportType === 'summary' ? $this->translate->_('Summary report downloads') : $this->translate->_('Participant report downloads');
?>
<div class="downloads-child-row">
    <?php if (empty($downloads)) { ?>
        <em class="text-muted"><?= $this->translate->_('No downloads by this participant\'s data managers.'); ?></em>
    <?php } else { ?>
        <div class="child-row-header">
            <i class="icon-download-alt"></i>
            <span><?= htmlspecialchars($heading, ENT_QUOTES, 'UTF-8'); ?> (<?= count($downloads); ?>)</span>
        </div>
        <div style="max-height:260px;overflow-y:auto;">
            <table class="table table-condensed" style="margin:0;">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col"><?= $this->translate->_('Downloaded By'); ?></th>
                        <th scope="col"><?= $this->translate->_('Primary Email'); ?></th>
                        <th scope="col"><?= $this->translate->_('Downloaded On'); ?></th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($downloads as $i => $row) { ?>
                        <tr>
                            <td><?= $i + 1; ?></td>
                            <td><?= htmlspecialchars($row['name'] !== '' ? $row['name'] : $this->translate->_('Unknown'), ENT_QUOTES, 'UTF-8'); ?></td>
                            <td><?= htmlspecialchars($row['email'] ?? '', ENT_QUOTES, 'UTF-8'); ?></td>
                            <td><?= htmlspecialchars((string) Pt_Commons_DateUtility::humanReadableDateFormat($row['downloaded_on'], true), ENT_QUOTES, 'UTF-8'); ?></td>
                        </tr>
                    <?php } ?>
                </tbody>
            </table>
        </div>
    <?php } ?>
</div>
