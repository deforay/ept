<script type="text/javascript">
	var summaryTable = null;
	var participantTable = null;
	var responseFilter = '';

	$(function () {
		$('.srr-response').on('click', 'button', function () {
			setResponseFilter($(this).data('response'));
			if (participantTable) {
				participantTable.fnDraw();
			}
		});

		// A shipment code lists that shipment's participants. A count lists the
		// participants behind it.
		$('#responseSummaryTable').on('click', '.js-pick-shipment', function (e) {
			e.preventDefault();
			var sid = String($(this).data('sid'));
			var response = $(this).data('response') || '';
			var picked = $('#shipmentId').val() || [];
			var already = picked.length === 1 && picked[0] === sid;
			setResponseFilter(response);
			// A second click on the code of the only picked shipment lists every shipment again.
			$('#shipmentId').val(already && !response ? [] : [sid]).trigger('change');
			if (already && response) {
				participantTable.fnDraw();
			}
			if (response) {
				$('html, body').animate({ scrollTop: $('#participantTable').closest('.srr-participants').offset().top - 70 }, 200);
			}
		});
	});

	function setResponseFilter(response) {
		responseFilter = response || '';
		$('.srr-response button').each(function () {
			$(this).toggleClass('active', String($(this).data('response')) === responseFilter);
		});
	}

	<?php if ($srrStatsUrl) { ?>
	// Breakdown: the whole row opens the participation breakdown of the
	// shipment, except clicks on the row's own links.
	$(function () {
		$('#responseSummaryTable tbody').on('click', 'tr', function (e) {
			var $toggle = $(this).find('a.toggle-stats-row');
			if (!$toggle.length || $(e.target).closest('a, button').not($toggle).length) {
				return;
			}
			e.preventDefault();
			var tr = this;
			if (summaryTable.fnIsOpen(tr)) {
				summaryTable.fnClose(tr);
				$(tr).removeClass('stats-parent-open');
				return;
			}
			summaryTable.fnOpen(tr, '<div style="padding:12px;color:#888;"><?= $this->jsTranslate("Loading breakdown…"); ?></div>', 'stats-child-container');
			$(tr).addClass('stats-parent-open');
			$.post("<?= $srrStatsUrl; ?>", { sid: $toggle.data('sid') }, function (html) {
				$(tr).next('tr').find('td').first().html(html);
			}).fail(function () {
				$(tr).next('tr').find('td').first().html('<div style="padding:12px;color:#a94442;"><?= $this->jsTranslate("Failed to load breakdown. Please try again."); ?></div>');
			});
		});
	});
	<?php } ?>

	reportFilters.onChange(function () {
		showSchemeColumn();
		summaryTable.fnDraw();
		participantTable.fnDraw();
	});

	// With one scheme picked, every row has the same scheme.
	function showSchemeColumn() {
		summaryTable.fnSetColumnVis(1, !$('#scheme').val(), false);
	}

	function postJson(sSource, aoData, fnCallback) {
		$.ajax({ "dataType": 'json', "type": "POST", "url": sSource, "data": aoData, "success": fnCallback });
	}

	reportFilters.ready(function () {
		summaryTable = $('#responseSummaryTable').dataTable({
			"oLanguage": reportZeroState.dataTableLanguage(),
			"bAutoWidth": false,
			"sPaginationType": "bootstrap",
			"iDisplayLength": 25,
			"sDom": "rtp",
			"aoColumns": [
				{ "sWidth": "18%" },
				{ "sWidth": "22%" },
				{ "sWidth": "10%" },
				{ "sWidth": "15%" },
				{ "sWidth": "12%" },
				{ "sWidth": "15%" },
				{ "sWidth": "8%" }
			],
			"aaSorting": [[0, "desc"]],
			"bProcessing": true,
			"bServerSide": true,
			"sAjaxSource": "<?= $srrSummaryUrl; ?>",
			"fnServerParams": reportFilters.params,
			"fnServerData": postJson,
			"fnDrawCallback": function (settings) {
				$('#responseSummaryTable_wrapper .dataTables_paginate')
					.toggleClass('is-single-page', settings.fnRecordsDisplay() <= settings._iDisplayLength);
<?php if (!$srrStatsUrl) { ?>
				$('#responseSummaryTable a.toggle-stats-row').remove();
<?php } ?>
				var picked = $('#shipmentId').val() || [];
				$('#responseSummaryTable .js-pick-shipment').each(function () {
					$(this).closest('tr').toggleClass('is-picked', picked.indexOf(String($(this).data('sid'))) !== -1);
				});
			}
		});

		showSchemeColumn();

		participantTable = $('#participantTable').dataTable({
			"oLanguage": reportZeroState.dataTableLanguage(),
			"bAutoWidth": false,
			"sPaginationType": "bootstrap",
			"aoColumns": [
				{ "sWidth": "26%" },
				{ "sWidth": "22%" },
				{ "sWidth": "14%" },
				{ "sWidth": "13%" },
				{ "sWidth": "13%" },
				{ "sWidth": "12%" }
			],
			"aaSorting": [[2, "desc"]],
			"bProcessing": true,
			"bServerSide": true,
			"sAjaxSource": "<?= $srrParticipantsUrl; ?>",
			"fnServerParams": function (aoData) {
				reportFilters.params(aoData);
				aoData.push({ "name": "response", "value": responseFilter });
			},
			"fnServerData": postJson
		});
	});

	function exportParticipantData() {
		$.blockUI();
		$.post("<?= $srrExportUrl; ?>", {}, function (data) {
			$.unblockUI();
			if (!data || $.trim(data) == 'not-found') {
				alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
			} else {
				window.open('/temporary/' + data, '_blank');
			}
		});
	}
</script>
