<script type="text/javascript" src="<?php echo $this->baseUrl('js/select2.min.js'); ?>"></script>
<script type="text/javascript">
	var summaryTable = null;
	var participantTable = null;
	var responseFilter = '';

	$(function () {
		$('#shipmentId').select2({
			placeholder: "<?= $this->jsTranslate("All shipments in the date range"); ?>"
		});
		$('.js-srr-location').each(function () {
			$(this).select2({
				placeholder: "<?= $this->jsTranslate("All"); ?>",
				allowClear: true
			});
		});

		$('#dateRange').daterangepicker({
			locale: {
				cancelLabel: "<?= $this->jsTranslate("Clear"); ?>",
				format: 'DD-MMM-YYYY',
				separator: ' to '
			},
			autoApply: true,
			showDropdowns: true,
			alwaysShowCalendars: true,
			// Some programmes run only one or two rounds a year, so three years
			// shows enough of them.
			startDate: moment().subtract(3, 'year'),
			endDate: moment(),
			maxDate: moment(),
			ranges: eptDateRanges()
		}).on('apply.daterangepicker', function () {
			$(this).trigger('change');
		}).on('cancel.daterangepicker', function () {
			$(this).val('').trigger('change');
		});

		// The date range and the scheme decide which shipments can be picked,
		// so they reload the Shipment list before the report redraws.
		$('#dateRange, #scheme').on('change', function () {
			if (summaryTable) {
				loadShipments().always(redraw);
			}
		});
		$('#shipmentId, .js-srr-location').on('change', function () {
			if (summaryTable) {
				redraw();
			}
		});

		$('.srr-response').on('click', 'button', function () {
			setResponseFilter($(this).data('response'));
			if (participantTable) {
				participantTable.fnDraw();
			}
		});

		// A shipment code lists that shipment's participants. A count lists the
		// participants behind it.
		$('#responseSummaryTable').on('click', '.js-pick-shipment', function (e) {
			e.preventDefault();
			var sid = String($(this).data('sid'));
			var response = $(this).data('response') || '';
			var picked = $('#shipmentId').val() || [];
			var already = picked.length === 1 && picked[0] === sid;
			setResponseFilter(response);
			// A second click on the code of the only picked shipment lists every shipment again.
			$('#shipmentId').val(already && !response ? [] : [sid]).trigger('change');
			if (already && response) {
				participantTable.fnDraw();
			}
			if (response) {
				$('html, body').animate({ scrollTop: $('#participantTable').closest('.srr-participants').offset().top - 70 }, 200);
			}
		});
	});

	function setResponseFilter(response) {
		responseFilter = response || '';
		$('.srr-response button').each(function () {
			$(this).toggleClass('active', String($(this).data('response')) === responseFilter);
		});
	}

	<?php if ($srrStatsUrl) { ?>
	// Breakdown: the whole row opens the participation breakdown of the
	// shipment, except clicks on the row's own links.
	$(function () {
		$('#responseSummaryTable tbody').on('click', 'tr', function (e) {
			var $toggle = $(this).find('a.toggle-stats-row');
			if (!$toggle.length || $(e.target).closest('a, button').not($toggle).length) {
				return;
			}
			e.preventDefault();
			var tr = this;
			if (summaryTable.fnIsOpen(tr)) {
				summaryTable.fnClose(tr);
				$(tr).removeClass('stats-parent-open');
				return;
			}
			summaryTable.fnOpen(tr, '<div style="padding:12px;color:#888;"><?= $this->jsTranslate("Loading breakdown…"); ?></div>', 'stats-child-container');
			$(tr).addClass('stats-parent-open');
			$.post("<?= $srrStatsUrl; ?>", { sid: $toggle.data('sid') }, function (html) {
				$(tr).next('tr').find('td').first().html(html);
			}).fail(function () {
				$(tr).next('tr').find('td').first().html('<div style="padding:12px;color:#a94442;"><?= $this->jsTranslate("Failed to load breakdown. Please try again."); ?></div>');
			});
		});
	});
	<?php } ?>

	// Several filters can change in one go (clearing a filter chip, say), so
	// redraw once.
	var redrawTimer = null;
	function redraw() {
		clearTimeout(redrawTimer);
		redrawTimer = setTimeout(function () {
			showSchemeColumn();
			summaryTable.fnDraw();
			participantTable.fnDraw();
		}, 50);
	}

	// With one scheme picked, every row has the same scheme.
	function showSchemeColumn() {
		summaryTable.fnSetColumnVis(1, !$('#scheme').val(), false);
	}

	function dateRangeParams() {
		var range = ($('#dateRange').val() || '').split(' to ');
		return { startDate: range[0] || '', endDate: range[1] || '' };
	}

	function loadShipments() {
		var params = dateRangeParams();
		params.scheme = $('#scheme').val();
		return $.post("<?= $srrShipmentsUrl; ?>", params, function (shipments) {
			var picked = $('#shipmentId').val() || [];
			var $select = $('#shipmentId').empty();
			var kept = [];
			$.each(shipments || [], function (i, shipment) {
				$select.append($('<option/>').val(shipment.id).text(shipment.text));
				if (picked.indexOf(String(shipment.id)) !== -1) {
					kept.push(String(shipment.id));
				}
			});
			// Keep the picked shipments that are still in range. The chips read
			// the select, so set the value the plain way too.
			$select.val(kept);
			$select.select2('val', kept);
		}, 'json');
	}

	function reportParams(aoData) {
		var dates = dateRangeParams();
		aoData.push({ "name": "startDate", "value": dates.startDate });
		aoData.push({ "name": "endDate", "value": dates.endDate });
		aoData.push({ "name": "scheme", "value": $('#scheme').val() });
		$.each($('#shipmentId').val() || [], function (i, sid) {
			aoData.push({ "name": "shipmentId[]", "value": sid });
		});
		$('.js-srr-location').each(function () {
			aoData.push({ "name": this.name, "value": $(this).val() || '' });
		});
	}

	function postJson(sSource, aoData, fnCallback) {
		$.ajax({ "dataType": 'json', "type": "POST", "url": sSource, "data": aoData, "success": fnCallback });
	}

	// The first draw waits for the page to load, after collapsible-filters.phtml
	// has pre-selected the only scheme, so the report loads once with it.
	$(window).on('load', function () {
		loadShipments().always(drawTables);
	});

	function drawTables() {
		summaryTable = $('#responseSummaryTable').dataTable({
			"oLanguage": reportZeroState.dataTableLanguage(),
			"bAutoWidth": false,
			"sPaginationType": "bootstrap",
			"iDisplayLength": 25,
			"sDom": "rtp",
			"aoColumns": [
				{ "sWidth": "18%" },
				{ "sWidth": "22%" },
				{ "sWidth": "10%" },
				{ "sWidth": "15%" },
				{ "sWidth": "12%" },
				{ "sWidth": "15%" },
				{ "sWidth": "8%" }
			],
			"aaSorting": [[0, "desc"]],
			"bProcessing": true,
			"bServerSide": true,
			"sAjaxSource": "<?= $srrSummaryUrl; ?>",
			"fnServerParams": reportParams,
			"fnServerData": postJson,
			"fnDrawCallback": function (settings) {
				$('#responseSummaryTable_wrapper .dataTables_paginate')
					.toggleClass('is-single-page', settings.fnRecordsDisplay() <= settings._iDisplayLength);
<?php if (!$srrStatsUrl) { ?>
				$('#responseSummaryTable a.toggle-stats-row').remove();
<?php } ?>
				var picked = $('#shipmentId').val() || [];
				$('#responseSummaryTable .js-pick-shipment').each(function () {
					$(this).closest('tr').toggleClass('is-picked', picked.indexOf(String($(this).data('sid'))) !== -1);
				});
			}
		});

		showSchemeColumn();

		participantTable = $('#participantTable').dataTable({
			"oLanguage": reportZeroState.dataTableLanguage(),
			"bAutoWidth": false,
			"sPaginationType": "bootstrap",
			"aoColumns": [
				{ "sWidth": "26%" },
				{ "sWidth": "22%" },
				{ "sWidth": "14%" },
				{ "sWidth": "13%" },
				{ "sWidth": "13%" },
				{ "sWidth": "12%" }
			],
			"aaSorting": [[2, "desc"]],
			"bProcessing": true,
			"bServerSide": true,
			"sAjaxSource": "<?= $srrParticipantsUrl; ?>",
			"fnServerParams": function (aoData) {
				reportParams(aoData);
				aoData.push({ "name": "response", "value": responseFilter });
			},
			"fnServerData": postJson
		});
	}

	function exportParticipantData() {
		$.blockUI();
		$.post("<?= $srrExportUrl; ?>", {}, function (data) {
			$.unblockUI();
			if (!data || $.trim(data) == 'not-found') {
				alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
			} else {
				window.open('/temporary/' + data, '_blank');
			}
		});
	}
</script>
