<script type="text/javascript">
	var performanceTable = null;
	var performanceFilter = '';

	$(function () {
		$('#performanceFilter').on('click', 'button', function () {
			performanceFilter = String($(this).data('performance') || '');
			$('#performanceFilter button').removeClass('active');
			$(this).addClass('active');
			if (performanceTable) {
				performanceTable.fnDraw();
			}
		});

		// A row opens the participant's shipments under it.
		$('#performanceTable tbody').on('click', 'tr', function () {
			if (!performanceTable || $(this).find('td.dataTables_empty, td.perf-detail').length) {
				return;
			}
			var data = performanceTable.fnGetData(this);
			if (!data) {
				return;
			}
			if (performanceTable.fnIsOpen(this)) {
				performanceTable.fnClose(this);
				$(this).removeClass('perf-open');
			} else {
				performanceTable.fnOpen(this, data[7], 'perf-detail');
				$(this).addClass('perf-open');
			}
		});
	});

	reportFilters.onChange(function () {
		performanceTable.fnDraw();
	});

	reportFilters.ready(function () {
		performanceTable = $('#performanceTable').dataTable({
			"oLanguage": reportZeroState.dataTableLanguage(),
			"bAutoWidth": false,
			"sPaginationType": "bootstrap",
			"aoColumns": [
				{ "sWidth": "22%" },
				{ "sWidth": "15%" },
				{ "sWidth": "9%" },
				{ "sWidth": "11%" },
				{ "sWidth": "7%" },
				{ "sWidth": "9%" },
				{ "sWidth": "27%", "bSortable": false },
				{ "bVisible": false, "bSortable": false }
			],
			"aaSorting": [[4, "desc"]],
			"bProcessing": true,
			"bServerSide": true,
			"sAjaxSource": "<?= $pprDataUrl; ?>",
			"fnServerParams": function (aoData) {
				reportFilters.params(aoData);
				aoData.push({ "name": "performance", "value": performanceFilter });
			},
			"fnServerData": function (sSource, aoData, fnCallback) {
				$.ajax({
					"dataType": 'json',
					"type": "POST",
					"url": sSource,
					"data": aoData,
					"success": function (json) {
						$('#performanceAxis').html(json.axis || '');
						$.each(json.counts || {}, function (key, count) {
							$('#performanceFilter [data-count="' + key + '"]').text(count.toLocaleString());
						});
						fnCallback(json);
					},
					"error": function () {
						$('#performanceAxis').empty();
					}
				});
			}
		});
	});

	function exportPerformance() {
		var params = reportFilters.values();
		params.performance = performanceFilter;
		var search = performanceTable ? performanceTable.fnSettings().oPreviousSearch.sSearch : '';
		params.sSearch = search;
		$.blockUI();
		$.post("<?= $pprExportUrl; ?>", params, function (data) {
			$.unblockUI();
			if (!data || !data.file) {
				alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
			} else {
				window.open('/temporary/' + data.file, '_blank');
			}
		}, 'json').fail(function () {
			$.unblockUI();
			alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
		});
	}
</script>
