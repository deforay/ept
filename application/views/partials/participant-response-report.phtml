<script type="text/javascript" src="<?php echo $this->assetUrl('js/daterangepicker.js'); ?>"></script>
<script type="text/javascript">
	var prrText = {
		notSet: "<?= $this->jsTranslate("Not set"); ?>",
		notEvaluated: "<?= $this->jsTranslate("Not evaluated yet"); ?>",
		of: "<?= $this->jsTranslate("%s of %s"); ?>",
		onTime: "<?= $this->jsTranslate("On time"); ?>",
		late: "<?= $this->jsTranslate("Late"); ?>",
		notTested: "<?= $this->jsTranslate("Could not test"); ?>",
		notResponded: "<?= $this->jsTranslate("Not responded"); ?>",
		enrolled: "<?= $this->jsTranslate("Enrolled"); ?>",
		loading: "<?= $this->jsTranslate("Loading data from server"); ?>",
		failed: "<?= $this->jsTranslate("Failed to load. Please try again."); ?>",
		chartNote: "<?= $this->jsTranslate("The chart shows the first %s groups of the table. The table lists every group."); ?>",
		noData: "<?= $this->jsTranslate("No results for these filters"); ?>",
		download: "<?= $this->jsTranslate("Unable to generate download"); ?>"
	};
	var prrGroupLabels = <?= json_encode($groupings); ?>;
	var prrChartLimit = 15;
	var prrGroupBy = 'region';
	var prrRequest = null;
	var prrReady = false;

	try {
		prrGroupBy = localStorage.getItem('prrGroupBy') || prrGroupBy;
	} catch (e) { }
	if (!prrGroupLabels[prrGroupBy]) {
		prrGroupBy = 'region';
	}

	$(function () {
		$('#dateRange').daterangepicker({
			locale: {
				cancelLabel: "<?= $this->jsTranslate("Clear"); ?>",
				format: 'DD-MMM-YYYY',
				separator: ' to '
			},
			autoApply: true,
			showDropdowns: true,
			alwaysShowCalendars: true,
			// Some programmes run only one or two rounds a year, so three years
			// shows enough of them.
			startDate: moment().subtract(3, 'year'),
			endDate: moment(),
			maxDate: moment(),
			ranges: eptDateRanges()
		}).on('apply.daterangepicker', function () {
			$(this).trigger('change');
		}).on('cancel.daterangepicker', function () {
			$(this).val('').trigger('change');
		});

		$('#dateRange, #scheme').on('change', function () {
			if (prrReady) {
				loadParticipantResponse();
			}
		});

		$('#prrGroupBy').on('click', 'button', function () {
			prrGroupBy = $(this).data('group-by');
			try {
				localStorage.setItem('prrGroupBy', prrGroupBy);
			} catch (e) { }
			loadParticipantResponse();
		});

		// A group row lists the group's shipments under it.
		$('#prrTable tbody').on('click', 'tr.prr-group', function () {
			toggleGroupShipments($(this));
		});
	});

	// The first load waits for the page to load, after collapsible-filters.phtml
	// has pre-selected the only scheme, so the report loads once with it.
	$(window).on('load', function () {
		prrReady = true;
		loadParticipantResponse();
	});

	function prrParams(extra) {
		var range = ($('#dateRange').val() || '').split(' to ');
		return $.extend({
			groupBy: prrGroupBy,
			startDate: range[0] || '',
			endDate: range[1] || '',
			scheme: $('#scheme').val() || ''
		}, extra || {});
	}

	function prrEscape(value) {
		return $('<div/>').text(value == null ? '' : String(value)).html();
	}

	function prrNumber(n) {
		return Number(n).toLocaleString();
	}

	function prrOf(n, total) {
		return prrText.of.replace('%s', prrNumber(n)).replace('%s', prrNumber(total));
	}

	function prrRate(n, total, barClass) {
		if (!total) {
			return '<span class="cell-muted">' + prrEscape(prrText.notEvaluated) + '</span>';
		}
		var pct = Math.round(n * 100 / total);
		return '<span class="rate-figure">' + pct + '%</span>' +
			'<span class="rate-bar ' + (barClass || '') + '"><span style="width:' + pct + '%"></span></span>' +
			'<span class="cell-sub">' + prrEscape(prrOf(n, total)) + '</span>';
	}

	function prrCount(n, bad) {
		return n > 0 && bad ? '<span class="is-bad">' + prrNumber(n) + '</span>' : prrNumber(n);
	}

	function prrFigures(row) {
		return '<td>' + prrRate(row.responded, row.enrolled) + '</td>' +
			'<td>' + prrCount(row.late) + '</td>' +
			'<td>' + prrCount(row.not_tested) + '</td>' +
			'<td>' + prrCount(row.not_responded, true) + '</td>' +
			'<td>' + prrRate(row.passed, row.passed + row.failed, 'is-pass') + '</td>' +
			'<td>' + prrCount(row.failed, true) + '</td>' +
			'<td>' + prrCount(row.excluded) + '</td>';
	}

	function prrGroupName(name) {
		return name === '' ? '<span class="is-unset">' + prrEscape(prrText.notSet) + '</span>' : prrEscape(name);
	}

	function loadParticipantResponse() {
		$('#prrGroupBy button').each(function () {
			$(this).toggleClass('active', $(this).data('group-by') === prrGroupBy);
		});
		$('#prrGroupHeading').text(prrGroupLabels[prrGroupBy]);
		prrShowLoading();

		if (prrRequest) {
			prrRequest.abort();
		}
		prrRequest = $.post("<?= $prrDataUrl; ?>", prrParams(), function (rows) {
			rows = rows || [];
			prrHideLoading();
			if (!rows.length) {
				// The chart and rows still in the page are for older filters.
				$('#prrTable').removeData('group-by');
				$('#prrResult').hide();
				reportZeroState.show('#prrEmpty', 'empty');
				return;
			}
			$('#prrEmpty').empty();
			$('#prrResult').show();
			drawParticipantResponseTable(rows);
			drawParticipantResponseChart(rows);
		}, 'json').fail(function (xhr, status) {
			if (status !== 'abort') {
				prrHideLoading();
				$('#prrTable tbody').html('<tr><td colspan="9" class="is-bad">' + prrEscape(prrText.failed) + '</td></tr>');
			}
		});
	}

	// The first load shows skeletons. A reload dims the chart and table that are
	// shown, unless the grouping changed: then the rows no longer match.
	function prrShowLoading() {
		var hasChart = $('#prrChart').find('.highcharts-container').length > 0;
		var sameGrouping = $('#prrTable').data('group-by') === prrGroupBy;
		$('#prrEmpty').empty();
		$('#prrResult').show();
		if (hasChart && sameGrouping) {
			rptSkeleton.dim($('#prrChart'), true);
			rptSkeleton.dim($('#prrTable tbody'), true);
		} else {
			rptSkeleton.block($('#prrChart'), 260);
			rptSkeleton.rows($('#prrTable'));
		}
	}

	function prrHideLoading() {
		$('#prrChart .rpt-skel-block').remove();
		rptSkeleton.dim($('#prrChart'), false);
		rptSkeleton.dim($('#prrTable tbody'), false);
	}

	function drawParticipantResponseTable(rows) {
		var html = '';
		$.each(rows, function (i, row) {
			html += '<tr class="prr-group" data-group="' + prrEscape(row.group_name) + '">' +
				'<td><div class="prr-name"><span class="prr-toggle"><i class="icon-chevron-right" aria-hidden="true"></i></span>' +
				'<span>' + prrGroupName(row.group_name) + '</span></div></td>' +
				'<td>' + prrNumber(row.participants) + '</td>' +
				prrFigures(row) + '</tr>';
		});
		$('#prrTable').data('group-by', prrGroupBy).children('tbody').html(html);
	}

	function toggleGroupShipments($row) {
		if ($row.hasClass('is-open')) {
			$row.removeClass('is-open').nextUntil('tr.prr-group').remove();
			return;
		}
		$row.addClass('is-open');
		var $loading = $('<tr class="prr-shipment"><td colspan="9" class="cell-muted">' + prrEscape(prrText.loading) + '</td></tr>');
		$row.after($loading);
		$.post("<?= $prrShipmentsUrl; ?>", prrParams({ group: $row.attr('data-group') }), function (rows) {
			var html = '';
			$.each(rows || [], function (i, row) {
				html += '<tr class="prr-shipment">' +
					'<td>' + prrEscape(row.shipment_code) + '<span class="cell-sub">' +
					prrEscape(moment(row.shipment_date).format('DD-MMM-YYYY')) +
					($('#scheme').val() ? '' : ' · ' + prrEscape(row.scheme_name)) + '</span></td>' +
					'<td>' + prrNumber(row.participants) + '</td>' +
					prrFigures(row) + '</tr>';
			});
			$loading.replaceWith(html);
		}, 'json').fail(function () {
			$loading.find('td').attr('class', 'is-bad').text(prrText.failed);
		});
	}

	// One stacked bar per group. The four parts add up to the enrolments.
	function drawParticipantResponseChart(rows) {
		var shown = rows.slice(0, prrChartLimit);
		$('#prrChartNote').toggle(rows.length > prrChartLimit)
			.text(prrText.chartNote.replace('%s', prrChartLimit));
		var series = function (key) {
			return $.map(shown, function (row) { return row[key]; });
		};
		Highcharts.chart('prrChart', {
			chart: { type: 'bar', height: 70 + shown.length * 34, style: { fontFamily: 'inherit' } },
			title: { text: null },
			credits: { enabled: false },
			exporting: { enabled: false },
			colors: ['#3b6fb6', '#e0a526', '#8e9aab', '#d9534f'],
			xAxis: {
				categories: $.map(shown, function (row) { return row.group_name === '' ? prrText.notSet : row.group_name; }),
				labels: { style: { fontSize: '12px' } }
			},
			yAxis: {
				min: 0,
				allowDecimals: false,
				title: { text: prrText.enrolled },
				reversedStacks: false
			},
			legend: { align: 'left', verticalAlign: 'top', itemStyle: { fontWeight: '400' } },
			tooltip: { shared: true },
			plotOptions: { series: { stacking: 'normal', borderWidth: 0, pointPadding: 0.05, groupPadding: 0.08 } },
			series: [
				{ name: prrText.onTime, data: series('on_time') },
				{ name: prrText.late, data: series('late') },
				{ name: prrText.notTested, data: series('not_tested') },
				{ name: prrText.notResponded, data: series('not_responded') }
			]
		});
	}

	function exportParticipantResponse() {
		$.blockUI();
		$.post("<?= $prrExportUrl; ?>", prrParams(), function (data) {
			$.unblockUI();
			if (data && data.file) {
				document.location.href = '/temporary/' + data.file;
			} else {
				alert(prrText.download);
			}
		}, 'json').fail(function () {
			$.unblockUI();
			alert(prrText.download);
		});
	}
</script>
