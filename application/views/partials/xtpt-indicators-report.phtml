<p class="xtpt-intro">
	<?= $this->htmlTranslate("Builds an Excel workbook for one TB shipment. The workbook has two sheets: Panel Statistics, with the XTPT indicators, and All Sites' Results."); ?>
</p>

<div class="xtpt-form">
	<div class="xtpt-field">
		<label for="xtptShipment"><?= $this->htmlTranslate("Shipment"); ?></label>
		<select id="xtptShipment" style="width:100%;">
			<?php foreach ($this->shipments as $shipment) { ?>
				<option value="<?= (int) $shipment['id']; ?>"><?= $this->escape($shipment['text']); ?></option>
			<?php } ?>
		</select>
	</div>
	<button type="button" class="btn btn-primary" id="xtptGenerate" <?= empty($this->shipments) ? 'disabled' : ''; ?>>
		<i class="icon-file"></i> <?= $this->htmlTranslate("Generate workbook"); ?>
	</button>
</div>
<p class="xtpt-status" id="xtptStatus" role="status">
	<?php if (empty($this->shipments)) { ?>
		<?= $this->htmlTranslate("There are no TB shipments yet."); ?>
	<?php } ?>
</p>

<div class="xtpt-files-head" id="xtptFilesHead" style="display:none;"><?= $this->htmlTranslate("Workbooks"); ?></div>
<ul class="xtpt-files" id="xtptFiles"></ul>

<script type="text/javascript" src="<?php echo $this->baseUrl('js/select2.min.js'); ?>"></script>
<script type="text/javascript">
	$(function () {
		$('#xtptShipment').select2();

		$('#xtptGenerate').on('click', function () {
			var $button = $(this);
			var shipment = $('#xtptShipment option:selected').text();
			$button.prop('disabled', true);
			$('#xtptStatus').removeClass('is-error').text("<?= $this->jsTranslate("Building the workbook. This can take a minute."); ?>");

			$.post("<?= $xtptGenerateUrl; ?>", { shipmentId: $('#xtptShipment').val() }, function (data) {
				if (!data || !data.file) {
					$('#xtptStatus').addClass('is-error').text("<?= $this->jsTranslate("Unable to generate download"); ?>");
					return;
				}
				$('#xtptStatus').text('');
				var href = '/temporary/generated-tb-reports/' + encodeURIComponent(data.file);
				var $item = $('<li class="xtpt-file"/>');
				$('<div/>')
					.append($('<span class="xtpt-file-name"/>').text(data.file))
					.append($('<span class="xtpt-file-meta"/>').text(shipment + ' · ' + new Date().toLocaleTimeString()))
					.appendTo($item);
				$('<a class="btn btn-success btn-sm" target="_blank" rel="noopener"/>')
					.attr('href', href)
					.html('<i class="icon-download-alt"></i> ' + $('<span/>').text("<?= $this->jsTranslate("Download"); ?>").html())
					.appendTo($item);
				$('#xtptFiles').prepend($item);
				$('#xtptFilesHead').show();
			}, 'json').fail(function () {
				$('#xtptStatus').addClass('is-error').text("<?= $this->jsTranslate("Unable to generate download"); ?>");
			}).always(function () {
				$button.prop('disabled', false);
			});
		});
	});
</script>
