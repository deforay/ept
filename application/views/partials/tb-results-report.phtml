<script type="text/javascript">
	var tbrTable = null;
	var tbrOutcome = '';

	$(function () {
		$('#tbrOutcome').on('click', 'button', function () {
			tbrOutcome = String($(this).data('outcome') || '');
			$('#tbrOutcome button').removeClass('active');
			$(this).addClass('active');
			if (tbrTable) {
				tbrTable.fnDraw();
			}
		});
	});

	reportFilters.onChange(function () {
		tbrTable.fnDraw();
	});

	reportFilters.ready(function () {
		tbrTable = $('#tbrTable').dataTable({
			"oLanguage": reportZeroState.dataTableLanguage(),
			"bAutoWidth": false,
			"sPaginationType": "bootstrap",
			"aoColumns": [
				{ "sWidth": "32%" },
				{ "sWidth": "22%" },
				{ "sWidth": "18%" },
				{ "sWidth": "10%" },
				{ "sWidth": "18%" }
			],
			"aaSorting": [[2, "desc"]],
			"bProcessing": true,
			"bServerSide": true,
			"sAjaxSource": "<?= $tbrDataUrl; ?>",
			"fnServerParams": function (aoData) {
				reportFilters.params(aoData);
				aoData.push({ "name": "outcome", "value": tbrOutcome });
			},
			"fnServerData": function (sSource, aoData, fnCallback) {
				$.ajax({
					"dataType": 'json',
					"type": "POST",
					"url": sSource,
					"data": aoData,
					"success": function (json) {
						var counts = json.counts || {};
						var all = counts.all || 0;
						$.each(counts, function (key, count) {
							$('#tbrOutcome [data-count="' + key + '"]').text(Number(count).toLocaleString());
							$('#tbrStrip [data-outcome="' + key + '"]').css('width', all ? (count * 100 / all) + '%' : 0);
						});
						fnCallback(json);
					},
					"error": function () {
						rptSkeleton.failed($('#tbrTable'));
					}
				});
			}
		});
	});

	function exportTbResults() {
		var params = reportFilters.values();
		params.outcome = tbrOutcome;
		params.sSearch = tbrTable ? tbrTable.fnSettings().oPreviousSearch.sSearch : '';
		$.blockUI();
		$.post("<?= $tbrExportUrl; ?>", params, function (data) {
			$.unblockUI();
			if (!data || !data.file) {
				alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
			} else {
				window.open('/temporary/' + data.file, '_blank');
			}
		}, 'json').fail(function () {
			$.unblockUI();
			alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
		});
	}
</script>
