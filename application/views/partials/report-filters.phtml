<script type="text/javascript" src="<?php echo $this->assetUrl('js/daterangepicker.js'); ?>"></script>
<script type="text/javascript" src="<?php echo $this->baseUrl('js/select2.min.js'); ?>"></script>
<script type="text/javascript">
	var reportFilters = (function () {
		var isReady = false;
		var readyCallbacks = [];
		var changeCallbacks = [];
		var changeTimer = null;

		// Several filters can change in one go (clearing a filter chip, say),
		// so the page hears about it once.
		function changed() {
			if (!isReady) {
				return;
			}
			clearTimeout(changeTimer);
			changeTimer = setTimeout(function () {
				$.each(changeCallbacks, function (i, fn) { fn(); });
			}, 50);
		}

		function dates() {
			var range = ($('#dateRange').val() || '').split(' to ');
			return { startDate: range[0] || '', endDate: range[1] || '' };
		}

		function values() {
			var v = dates();
			v.scheme = $('#scheme').val() || '';
			v.shipmentId = $('#shipmentId').val() || [];
			$('.js-rpt-location').each(function () {
				v[this.name] = $(this).val() || '';
			});
			return v;
		}

		function params(aoData) {
			$.each(values(), function (name, value) {
				if ($.isArray(value)) {
					$.each(value, function (i, item) {
						aoData.push({ "name": name + "[]", "value": item });
					});
				} else {
					aoData.push({ "name": name, "value": value });
				}
			});
		}

		function loadShipments() {
			var request = dates();
			request.scheme = $('#scheme').val();
			return $.post("<?= $rfShipmentsUrl; ?>", request, function (shipments) {
				var picked = $('#shipmentId').val() || [];
				var $select = $('#shipmentId').empty();
				var kept = [];
				$.each(shipments || [], function (i, shipment) {
					$select.append($('<option/>').val(shipment.id).text(shipment.text));
					if (picked.indexOf(String(shipment.id)) !== -1) {
						kept.push(String(shipment.id));
					}
				});
				// Keep the picked shipments that are still in range. The chips read
				// the select, so set the value the plain way too.
				$select.val(kept);
				$select.select2('val', kept);
			}, 'json');
		}

		$(function () {
			$('#shipmentId').select2({
				placeholder: "<?= $this->jsTranslate("All shipments in the date range"); ?>"
			});
			$('.js-rpt-location').each(function () {
				$(this).select2({
					placeholder: "<?= $this->jsTranslate("All"); ?>",
					allowClear: true
				});
			});

			$('#dateRange').daterangepicker({
				locale: {
					cancelLabel: "<?= $this->jsTranslate("Clear"); ?>",
					format: 'DD-MMM-YYYY',
					separator: ' to '
				},
				autoApply: true,
				showDropdowns: true,
				alwaysShowCalendars: true,
				// Some programmes run only one or two rounds a year, so three years
				// shows enough of them.
				startDate: moment().subtract(3, 'year'),
				endDate: moment(),
				maxDate: moment(),
				ranges: eptDateRanges()
			}).on('apply.daterangepicker', function () {
				$(this).trigger('change');
			}).on('cancel.daterangepicker', function () {
				$(this).val('').trigger('change');
			});

			// The date range and the scheme decide which shipments can be picked,
			// so they reload the Shipment list first.
			$('#dateRange, #scheme').on('change', function () {
				if (isReady) {
					loadShipments().always(changed);
				}
			});
			$('#shipmentId, .js-rpt-location').on('change', changed);
		});

		// The first load waits for the page to load, after
		// collapsible-filters.phtml has pre-selected the only scheme, so the
		// report loads once with it.
		$(window).on('load', function () {
			loadShipments().always(function () {
				isReady = true;
				$.each(readyCallbacks, function (i, fn) { fn(); });
			});
		});

		return {
			ready: function (fn) { readyCallbacks.push(fn); },
			onChange: function (fn) { changeCallbacks.push(fn); },
			params: params,
			values: values
		};
	})();
</script>
