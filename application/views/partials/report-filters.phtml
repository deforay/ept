<?php

/**
 * The filter panel shared by the Shipment Response Report and the Participant
 * Performance Report: shipment date, scheme, shipment and the participant's
 * place.
 *
 * Set before including:
 *
 *   $rfShipmentsUrl  the action that returns the Shipment filter options
 *   $this->schemes, ->countries, ->regions, ->states, ->districts
 *
 * The page talks to the filters through window.reportFilters:
 *
 *   reportFilters.ready(fn)     runs fn once, after the first Shipment list loads
 *   reportFilters.onChange(fn)  runs fn after any filter changes
 *   reportFilters.params(aoData) adds the filter values to a DataTables request
 *   reportFilters.values()      the filter values as an object
 *
 * The page includes collapsible-filters.phtml last.
 */
$locationFilters = [
	['country', $this->translate->_("Country"), array_map(fn ($c) => [$c['id'], ucwords((string) $c['iso_name'])], $this->countries ?? [])],
	['region', $this->translate->_("Region"), array_map(fn ($r) => [$r['region'], $r['region']], $this->regions ?? [])],
	['state', $this->translate->_("Province"), array_map(fn ($r) => [$r['state'], $r['state']], $this->states ?? [])],
	['district', $this->translate->_("District"), array_map(fn ($r) => [$r['district'], $r['district']], $this->districts ?? [])],
];
?>
