<script type="text/javascript" src="<?php echo $this->assetUrl('js/daterangepicker.js'); ?>"></script>
<script type="text/javascript" src="<?php echo $this->baseUrl('js/select2.min.js'); ?>"></script>
<script type="text/javascript">
	var oTable = null;

	$(function () {
		$('#stages').select2({
			placeholder: "<?= $this->jsTranslate("All statuses"); ?>"
		});

		$('#dateRange').daterangepicker({
			locale: {
				cancelLabel: "<?= $this->jsTranslate("Clear"); ?>",
				format: 'DD-MMM-YYYY',
				separator: ' to '
			},
			autoApply: true,
			showDropdowns: true,
			alwaysShowCalendars: true,
			// Some programmes run only one or two rounds a year, so three years
			// shows enough of them.
			startDate: moment().subtract(3, 'year'),
			endDate: moment(),
			maxDate: moment(),
			ranges: eptDateRanges()
		}).on('apply.daterangepicker', function () {
			$(this).trigger('change');
		}).on('cancel.daterangepicker', function () {
			$(this).val('').trigger('change');
		});

		// Filters apply as soon as they change. Several can change in one go
		// (clearing a filter chip, say), so redraw once.
		var redraw = null;
		$(document).on('change', '.js-grid-filter', function () {
			if (!oTable) {
				return;
			}
			clearTimeout(redraw);
			redraw = setTimeout(function () {
				oTable.fnDraw();
			}, 50);
		});

		<?php if ($gridStatsUrl) { ?>
		// Breakdown: expand the row with the participation breakdown (enrolled,
		// responded, tested, passed and failed), fetched on demand.
		// The whole row toggles it, except clicks on the row's own links and buttons.
		$('#shipmentTable tbody').on('click', 'tr', function (e) {
			var $toggle = $(this).find('a.toggle-stats-row');
			if (!$toggle.length || $(e.target).closest('a, button, input, select').not($toggle).length) {
				return;
			}
			e.preventDefault();
			var tr = this;
			if (oTable.fnIsOpen(tr)) {
				oTable.fnClose(tr);
				$(tr).removeClass('stats-parent-open');
				return;
			}
			oTable.fnOpen(tr, '<div style="padding:12px;color:#888;"><?= $this->jsTranslate("Loading breakdown…"); ?></div>', 'stats-child-container');
			$(tr).addClass('stats-parent-open');
			$.post("<?= $gridStatsUrl; ?>", { sid: $toggle.data('sid') }, function (html) {
				$(tr).next('tr').find('td').first().html(html);
			}).fail(function () {
				$(tr).next('tr').find('td').first().html('<div style="padding:12px;color:#a94442;"><?= $this->jsTranslate("Failed to load breakdown. Please try again."); ?></div>');
			});
		});
		<?php } ?>
	});

	// The first draw waits for the page to load, after collapsible-filters.phtml
	// has pre-selected the only scheme, so the grid loads once with it.
	$(window).on('load', drawShipmentsTable);

	function drawShipmentsTable() {
		oTable = $('#shipmentTable').dataTable({
			"oLanguage": reportZeroState.dataTableLanguage(),
			"bAutoWidth": false,
			"bInfo": true,
			"sPaginationType": "bootstrap",
			"bDestroy": true,
			"aoColumns": [
				{ "sWidth": "15%" },
				{ "sWidth": "14%" },
				{ "sWidth": "11%" },
				{ "sWidth": "13%" },
				{ "sWidth": "12%" },
				{ "sWidth": "11%" },
				{ "bSortable": false }
			],
			"aaSorting": [[0, "desc"]],
			"bProcessing": true,
			"bServerSide": true,
			"sAjaxSource": "<?= $gridAjaxUrl; ?>",
			"fnServerParams": function (aoData) {
				var range = ($('#dateRange').val() || '').split(' to ');
				aoData.push({ "name": "startDate", "value": range[0] || '' });
				aoData.push({ "name": "endDate", "value": range[1] || '' });
				aoData.push({ "name": "scheme", "value": $('#scheme').val() });
				$.each($('#stages').val() || [], function (i, stage) {
					aoData.push({ "name": "stages[]", "value": stage });
				});
				aoData.push({ "name": "needsAttention", "value": $('#needsAttention').is(':checked') ? 'yes' : 'no' });
				aoData.push({ "name": "includeCancelled", "value": $('#includeCancelled').is(':checked') ? 'yes' : 'no' });
			},
			"fnServerData": function (sSource, aoData, fnCallback) {
				$.ajax({
					"dataType": 'json',
					"type": "POST",
					"url": sSource,
					"data": aoData,
					"success": fnCallback
				});
			}
		});
	}

	function generateShipmentParticipantList(shipmentId, schemeType) {
		$.blockUI();
		$.post("<?= $gridListUrl; ?>", {
			shipmentId: shipmentId,
			schemeType: schemeType,
			format: "html"
		}, function (data) {
			if (data != "") {
				document.location.href = '/temporary/' + data;
			}
			$.unblockUI();
		});
	}

	function downloadFeedbackReport(shipmentId) {
		$.blockUI();
		$.post("/admin/feedback-responses/get-feedback-response-report", {
			sid: shipmentId,
			format: "html"
		}, function (data) {
			if (data != "") {
				document.location.href = '/temporary/' + data;
			} else {
				alert("<?= $this->jsTranslate("No feedback responses found for this shipment"); ?>");
			}
			$.unblockUI();
		});
	}

	function exportNotRespondedShipment(_shipmentId, _shipmentCode, _shipmentDate) {
		$.blockUI();
		$.post("<?php echo $this->url(['module' => 'admin', 'controller' => 'shipment', 'action' => 'export-shipment-not-responded-participants']); ?>", {
			shipmentId: atob(_shipmentId),
			shipmentCode: atob(_shipmentCode),
			shipmentDate: atob(_shipmentDate),
			format: "html"
		}, function (data) {
			if (data == "" || data == null || data == undefined) {
				alert("<?= $this->jsTranslate("Unable to generate download"); ?>");
			} else {
				document.location.href = '/temporary/' + data;
			}
			$.unblockUI();
		});
	}
</script>
