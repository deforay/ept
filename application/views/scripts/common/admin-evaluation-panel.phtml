            <?= $this->htmlTranslate('Yes'); ?>
        </label>
        <label class="eval-radio">
            <input type="radio" name="isFollowUp" id="followUpNo" value="no" <?= ($shipment['is_followup'] ?? '') === 'no' ? "checked='checked'" : ''; ?> />
