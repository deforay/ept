<details class="eval-panel" <?= $adminActionsOpen ? 'open' : ''; ?>>
    <summary class="eval-panel-title"><?= $this->htmlTranslate('Admin actions'); ?></summary>
    <p class="eval-help"><?= $this->htmlTranslate("Change these only to correct an evaluation. Both change the participant's result."); ?></p>
    <div class="eval-field eval-field-inline">
        <label for="manualOverride" class="eval-field-label"><?= $this->htmlTranslate('Manually Override Results'); ?></label>
        <select name="manualOverride" id="manualOverride" class="form-control eval-select-short"
            title="<?= $this->htmlTranslate('Please choose manual override yes or no'); ?>">
