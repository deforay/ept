<?php

/**
 * The evaluation section an administrator sees at the bottom of a response page opened
 * from evaluate: the result and scores, the findings with their corrective actions, the
 * feedback to the participant, and the two admin actions (manual override, exclude).
 * Participants never see it.
 *
 * Include it inside the response form:
 *   echo $this->partial('common/admin-evaluation-panel.phtml', [
 *       'scheme' => 'dts',                       // reads <scheme>.passPercentage
 *       'viewOnly' => $viewOnly,                 // values as text, no inputs
 *       'shipment' => $this->shipment,           // shipment_participant_map row
 *       'evalComments' => $this->evaluateData['evalComments'],
 *   ]);
 *
 * The field names and ids are the ones every response save reads. The override
 * switch shows and hides .manualOverrideRow and .scoreReadOnlyRow itself.
 */

$shipment = $this->shipment ?? [];
$overrideOn = ($shipment['manual_override'] ?? '') === 'yes';
$show = $overrideOn ? '' : 'display: none;';
$showReadOnly = $overrideOn ? 'display: none;' : '';
$shipmentScore = (float) ($shipment['shipment_score'] ?? 0);
$documentationScore = (float) ($shipment['documentation_score'] ?? 0);
// Custom tests set their own pass marks, so they show none here.
$passMark = in_array($this->scheme ?? '', ['dts', 'vl', 'eid', 'tb', 'recency', 'covid19'], true)
    ? Pt_Commons_SchemeConfig::get($this->scheme . '.passPercentage')
    : null;
// final_result: 1 Pass, 2 Fail, 3 Excluded, 4 Not Evaluated. The label is the
// instance's own name for the result in r_results, since countries word it
// differently (Pass or Satisfactory, for example).
$finalResult = (int) ($shipment['final_result'] ?? 0);
$resultBadge = null;
if ($finalResult > 0) {
    $db = Zend_Db_Table_Abstract::getDefaultAdapter();
    $resultName = (string) $db->fetchOne($db->select()->from('r_results', ['result_name'])->where('result_id = ?', $finalResult));
    $resultBadge = [
        match ($finalResult) {
            1 => 'eval-result-pass icon-ok-circle',
            2 => 'eval-result-fail icon-remove-circle',
            default => 'eval-result-other icon-ban-circle',
        },
        $this->htmlTranslate($resultName !== '' ? $resultName : (string) $finalResult),
    ];
}
$warnings = json_decode((string) ($shipment['failure_reason'] ?? ''), true);
// Findings grouped by the sample they name, so each sample label shows once. Coded
// findings store the sample. Older ones start with it in bold ("For <strong>A1</strong>",
// "Sample <strong>A1</strong>", "<strong>A1</strong> - ..."). The rest are general.
$findingGroups = [];
$generalFindings = [];
$findingNo = 0;
foreach (is_array($warnings) ? $warnings : [] as $findingKey => $warning) {
    $findingNo++;
    $html = Pt_Evaluation_FailureReason::warningHtml($warning);
    $sample = is_array($warning) ? ($warning['params']['sample'] ?? null) : null;
    if ($sample === null && preg_match('~^\s*(?:For\s+|Sample\s+)?<strong>(.*?)</strong>~u', $html, $m)) {
        $sample = html_entity_decode(strip_tags($m[1]), ENT_QUOTES | ENT_HTML5, 'UTF-8');
    }
    $finding = [
        'no' => $findingNo,
        'token' => Application_Service_Shipments::overrideFindingToken($findingKey, $warning),
        'html' => $html,
        'action' => Pt_Evaluation_FailureReason::correctiveActionHtml($warning),
    ];
    if ($sample === null || trim((string) $sample) === '') {
        $generalFindings[] = $finding;
    } else {
        $findingGroups[(string) $sample][] = $finding;
    }
}
if ($generalFindings !== []) {
    $findingGroups[''] = $generalFindings;
}
// Evaluation always sets final_result (1 to 4). Before that, the card says so instead
// of showing a score of 0 and no findings. shipment_score can already hold 0.00.
$evaluated = (int) ($shipment['final_result'] ?? 0) > 0;
$adminActionsOpen = $overrideOn || ($shipment['is_excluded'] ?? '') === 'yes';
$evalComments = [];
foreach ($this->evalComments ?: [] as $evl) {
    $evalComments[$evl['comment_id']] = $evl['comment'];
}
$selected = static fn ($field, $value) => (($shipment[$field] ?? '') === $value) ? " selected='selected'" : '';
?>
