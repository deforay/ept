            <option value="no"<?= $selected('manual_override', 'no'); ?>><?= $this->htmlTranslate('No'); ?></option>
            <option value="yes"<?= $selected('manual_override', 'yes'); ?>><?= $this->htmlTranslate('Yes'); ?></option>
        </select>
    </div>
    <div class="eval-field eval-field-inline">
        <label for="isExcluded" class="eval-field-label"><?= $this->htmlTranslate('Do you want to exclude this response from evaluation?'); ?></label>
