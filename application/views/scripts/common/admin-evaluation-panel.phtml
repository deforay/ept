            title="<?= $this->htmlTranslate('Please choose whether this response is excluded from evaluation or not'); ?>">
            <option value="no"<?= $selected('is_excluded', 'no'); ?>><?= $this->htmlTranslate('No'); ?></option>
            <option value="yes"<?= $selected('is_excluded', 'yes'); ?>><?= $this->htmlTranslate('Yes'); ?></option>
        </select>
    </div>
</details>
<script>
    // Override on: the scores and the keep/drop ticks become editable.
    $(function () {
        $('#manualOverride').on('change', function () {
            var on = this.value === 'yes';
            $('.manualOverrideRow').toggle(on);
            $('.scoreReadOnlyRow').toggle(!on);
        });
    });
</script>
