    <div class="eval-summary">
        <?php if ($resultBadge !== null) { ?>
            <span class="badge eval-result-badge <?= $resultBadge[0]; ?>"><?= $resultBadge[1]; ?></span>
        <?php } ?>
        <div class="eval-score scoreReadOnlyRow" style="<?= $showReadOnly; ?>">
            <span class="eval-score-label"><?= $this->htmlTranslate('Total score'); ?></span>
            <span class="eval-score-value"><?= $this->escape((string) round($shipmentScore + $documentationScore, 2)); ?></span>
            <?php if ($passMark !== null && $passMark !== '') { ?>
                <span class="eval-score-note"><?= sprintf($this->htmlTranslate('Pass mark %s'), $this->escape((string) $passMark)); ?></span>
            <?php } ?>
        </div>
        <div class="eval-score scoreReadOnlyRow" style="<?= $showReadOnly; ?>">
            <span class="eval-score-label"><?= $this->htmlTranslate('Shipment Score'); ?></span>
            <span class="eval-score-value"><?= $this->escape((string) ($shipment['shipment_score'] ?? '')); ?></span>
        </div>
        <div class="eval-score scoreReadOnlyRow" style="<?= $showReadOnly; ?>">
            <span class="eval-score-label"><?= $this->htmlTranslate('Documentation Score'); ?></span>
            <span class="eval-score-value"><?= $this->escape((string) ($shipment['documentation_score'] ?? '')); ?></span>
        </div>
        <div class="eval-score manualOverrideRow" style="<?= $show; ?>">
            <label class="eval-score-label" for="shipmentScore"><?= $this->htmlTranslate('Shipment Score'); ?> <span class="mandatory">*</span></label>
            <input type="text" value="<?= $this->escape((string) ($shipment['shipment_score'] ?? '')); ?>" name="shipmentScore"
                id="shipmentScore" class="form-control" placeholder="<?= $this->htmlTranslate('Enter the shipment score'); ?>"
                title="<?= $this->htmlTranslate('Please enter the shipment score'); ?>">
        </div>
        <div class="eval-score manualOverrideRow" style="<?= $show; ?>">
            <label class="eval-score-label" for="documentationScore"><?= $this->htmlTranslate('Documentation Score'); ?> <span class="mandatory">*</span></label>
            <input type="text" value="<?= $this->escape((string) ($shipment['documentation_score'] ?? '')); ?>"
                name="documentationScore" id="documentationScore" class="form-control"
                placeholder="<?= $this->htmlTranslate('Enter the documentation score'); ?>" title="<?= $this->htmlTranslate('Please enter the documentation score'); ?>">
        </div>
    </div>

    <?php if (!empty($warnings) && is_array($warnings)) { ?>
        <h4 class="eval-subtitle"><?= $this->htmlTranslate('Findings and corrective actions'); ?></h4>
        <p class="eval-help manualOverrideRow" style="<?= $show; ?>"><?= $this->htmlTranslate('Untick a finding to leave it out of the report.'); ?></p>
        <ul class="eval-findings">
            <?php $i = 1;
            foreach ($warnings as $warning) {
                $action = Pt_Evaluation_FailureReason::correctiveActionHtml($warning); ?>
                <li>
                    <span class="manualOverrideRow" style="<?= $show; ?>">
                        <input type="checkbox" id="manualCorrective<?= $i; ?>"
                            name="manualCorrective[<?= $this->escape((string) (is_array($warning) ? ($warning['warning'] ?? '') : $warning)); ?>]"
                            value="<?= $this->escape((string) (is_array($warning) ? ($warning['correctiveAction'] ?? '') : '')); ?>" checked>
                    </span>
                    <label for="manualCorrective<?= $i; ?>" class="eval-finding">
                        <span class="eval-finding-warning"><?= Pt_Evaluation_FailureReason::warningHtml($warning); ?></span>
                        <?php if (trim(strip_tags($action)) !== '') { ?>
                            <span class="eval-finding-action"><?= $action; ?></span>
                        <?php } ?>
                    </label>
                </li>
                <?php $i++;
            } ?>
        </ul>
    <?php } else { ?>
        <p class="eval-help"><?= $this->htmlTranslate('No findings for this response.'); ?></p>
    <?php } ?>
</div>

