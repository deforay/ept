<?php if (empty($this->warnings)): ?>
    <div class="text-muted text-center p-2"><?= $this->htmlTranslate('No Warnings or Corrective Actions'); ?></div>
<?php else: ?>
    <table class="table table-bordered table-striped table-compressed" style="margin-bottom:0;">
        <thead>
            <tr>
                <th scope="col"><?= $this->htmlTranslate('Failure Reasons (or) Warnings'); ?></th>
                <th scope="col"><?= $this->htmlTranslate('Corrective Actions (if any)'); ?></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($this->warnings as $warning): ?>
                <tr>
                    <td><?= Pt_Evaluation_FailureReason::warningHtml($warning) ?></td>
                    <td><?= Pt_Evaluation_FailureReason::correctiveActionHtml($warning) ?></td>
                </tr>
            <?php endforeach; ?>
        </tbody>
    </table>
<?php endif; ?>
