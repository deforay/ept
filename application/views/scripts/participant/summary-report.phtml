<script type="text/javascript" src="<?php echo $this->baseUrl('js/select2.min.js'); ?>"></script>

<script>
    var startDate = "";
    var endDate = "";
    var oTable = null;
    // Full DM-scoped option lists so clearing a parent filter restores them
    var defaultLocationOptions = {};
    $(document).ready(function () {
        $("#country").select2({
            placeholder: "<?= $this->jsTranslate("Select Country"); ?>",
            allowClear: true
        });
        $("#region").select2({
            placeholder: "<?= $this->jsTranslate("Select Region"); ?>",
            allowClear: true
        });
        $("#district").select2({
            placeholder: "<?= $this->jsTranslate("Select District"); ?>",
            allowClear: true
        });
        ['region', 'district'].forEach(function (id) {
            if ($('#' + id).length) {
                defaultLocationOptions[id] = $('#' + id).html();
            }
        });

        $('#dateRange').daterangepicker({
            locale: {
                cancelLabel: 'Clear',
                format: 'DD-MMM-YYYY',
                separator: ' to ',
            },
            autoApply: true,
            showDropdowns: true,
            alwaysShowCalendars: true,
            autoUpdateInput: true,
            startDate: moment().subtract(179, 'days'),
            endDate: moment(),
            maxDate: moment(),
            ranges: {
                'This Month': [moment().startOf('month'), moment().endOf('month')],
                'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')],
                'Last 60 Days': [moment().subtract(59, 'days'), moment()],
                'Last 90 Days': [moment().subtract(89, 'days'), moment()],
                'Last 180 Days': [moment().subtract(179, 'days'), moment()],
                'Last 12 Months': [moment().subtract(12, 'month'), moment()],
                'Last 18 Months': [moment().subtract(18, 'month'), moment()],
            }
        },
            function (start, end) {
                startDate = start.format('DD-MMM-YYYY');
                endDate = end.format('DD-MMM-YYYY');
            });
        $('#dateRange').val("");

        oTable = $('#summaryReportTable').dataTable({

            "bJQueryUI": false,
            "bAutoWidth": false,
            "bSortCellsTop": true,
            "bInfo": true,
            "bScrollCollapse": true,
            "sPaginationType": "full_numbers",
            "bRetrieve": false,
            "bDestroy": true,
            "aoColumns": [{
                "sClass": "center",
            },
            {
                // Sortable so it can act as the tie-breaker within a shipment date.
                // The server maps this column to shipment_code but skips any column
                // DataTables reports as unsortable, so this has to stay true.
                "sClass": "center"
            },
            {
                "sClass": "center"
            },
            {
                "sClass": "center",
                "bSortable": false
            }
            ],
            "aaSorting": [
                [2, "desc"],
                [1, "asc"]
            ],
            "bProcessing": true,
            "bServerSide": true,
            "sAjaxSource": "<?php echo $this->url(array('module' => 'default', 'controller' => 'participant', 'action' => 'summary-report', 'format' => 'html')); ?>",
            "fnServerParams": function (aoData) {
                aoData.push({
                    "name": "scheme",
                    "value": $("#scheme").val()
                });
                aoData.push({
                    "name": "startDate",
                    "value": startDate
                });
                aoData.push({
                    "name": "endDate",
                    "value": endDate
                });
                aoData.push({
                    "name": "country",
                    "value": $("#country").val() || ''
                });
                aoData.push({
                    "name": "region",
                    "value": $("#region").val() || ''
                });
                aoData.push({
                    "name": "district",
                    "value": $("#district").val() || ''
                });
            },
            "fnServerData": function (sSource, aoData, fnCallback) {
                $.ajax({
                    "dataType": 'json',
                    "type": "POST",
                    "url": sSource,
                    "data": aoData,
                    "success": fnCallback
                });
            },
            "fnRowCallback": function (nRow, aData) {
                // Rows are replaced by DataTables on every draw, so Bootstrap tooltip
                // bindings on the "Downloaded" badges (title/data-toggle="tooltip")
                // need to be re-applied here each time.
                $('#summaryReportTable [data-toggle="tooltip"]').tooltip({
                    html: true,
                    container: 'body',
                    placement: 'top',
                    sanitize: false
                });
                
                // Highlight rows with no mapped data managers (the DM column emits
                // <em class="unmapped-tag">…</em> when the count is 0)
                if ($(nRow).find('.unmapped-tag').length > 0) {
                    $(nRow).addClass('row-unmapped');
                } else {
                    $(nRow).removeClass('row-unmapped');
                }
                return nRow;
            }
        });

         $("#mappingFilter").change(function () {
        oTable.fnDraw();
    });

    bindColSearch('#summaryReportTable', function (value, colIdx) {
        oTable.fnFilter(value, colIdx);
    });

     // Data Managers column — expand/collapse child row with on-demand AJAX fetch
        $('#summaryReportTable tbody').on('click', 'a.toggle-dm-row', function (e) {
            e.preventDefault();
            var $btn = $(this);
            var participantId = $btn.data('participant-id');
            var tr = $btn.closest('tr')[0];
            if (oTable.fnIsOpen(tr)) {
                oTable.fnClose(tr);
                $btn.removeClass('btn-success').addClass('btn-primary');
                return;
            }
            // Inject a placeholder child row, then populate via AJAX
            var placeholder = '<div style="padding:12px;color:#888;"><i class="icon-refresh"></i> <?= $this->translate->_("Loading data managers…"); ?></div>';
            oTable.fnOpen(tr, placeholder, 'dm-child-container');
            $btn.removeClass('btn-primary').addClass('btn-success');
            $.post(
                "<?php echo $this->url(array('module' => 'default', 'controller' => 'participant', 'action' => 'summary-report', 'format' => 'html')); ?>",
                { id: participantId },
                function (html) {
                    // fnOpen wraps our content in a td inside a tr — replace that td's content
                    var $childTr = $(tr).next('tr');
                    $childTr.find('td').first().html(html);
                }
            ).fail(function () {
                var $childTr = $(tr).next('tr');
                $childTr.find('td').first().html('<div style="padding:12px;color:#a94442;"><?= $this->translate->_("Failed to load data managers. Please try again."); ?></div>');
            });
        });

        // Inline filter for the expanded DM list (only present when > 5 mapped DMs)
        $('#summaryReportTable tbody').on('input', 'input.dm-filter-input', function () {
            var q = $(this).val().toLowerCase().trim();
            var $rows = $(this).closest('.dm-child-row').find('tr.dm-row');
            if (q === '') {
                $rows.show();
                return;
            }
            $rows.each(function () {
                var blob = $(this).attr('data-dm-search') || '';
                $(this).toggle(blob.indexOf(q) !== -1);
            });
        });
    });

    function summarySchemes() {
        // if (startDate == "" || endDate == "" || $("#scheme").val() == "" || $("#scheme").val() == null || $("#scheme").val() == undefined) {
        //     alert("<?= $this->translate->_("Please pick date range and Scheme Type to proceed"); ?>");
        //     return false;
        // }
        oTable.fnDraw();
    }

    function getOptions(table, searchfield, returnfield, searchvalue, returnid) {
        var $target = $("#" + returnid);
        if ($target.length === 0) {
            return;
        }
        if (searchvalue === "" || searchvalue === null || searchvalue === undefined) {
            // Parent filter cleared — restore the full DM-scoped list
            $target.html(defaultLocationOptions[returnid] || '<option value=""></option>');
            $target.val('').trigger('change.select2');
            return;
        }
        $.blockUI();
        $.post("<?php echo $this->url(array('module' => 'default', 'controller' => 'common', 'action' => 'get-options-by-value')); ?>", {
                table: table,
                searchfield: searchfield,
                returnfield: returnfield,
                searchvalue: searchvalue,
                format: "html"
            },
            function(data) {
                if (data != 0 && data != '' && data != undefined) {
                    $target.html(data);
                } else {
                    $target.html('<option value=""></option>');
                }
                $target.val('').trigger('change.select2');
                $.unblockUI();
            });
    }

    function updateReportDownloadDateTime(id, type) {
        if (id != "") {
            //$.blockUI();
            $.post("<?php echo $this->url(array('module' => 'default', 'controller' => 'common', 'action' => 'update-report-download-datetime'), 'default', true); ?>", {
                id: id,
                type: type,
                format: "html"
            },
                function (data) {
                    $.unblockUI();
                }
            );
        }
    }
</script>
