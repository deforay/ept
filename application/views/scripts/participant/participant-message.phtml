<script>
    function validateNow() {
        var fileInput = document.getElementById('file-input');
        var allowedExtensions = ['pdf', 'doc', 'docx', 'xls', 'xlsx', 'jpg', 'jpeg', 'png'];
        var files = fileInput.files;
        var flag = true;

        // Check if more than 3 files are selected
        if (files.length > 3) {
            flag = false;
            alert("<?= $this->jsTranslate("You can only upload a maximum of 3 files.") ?>");
            return false;
        }

        // Check if the file extensions are valid
        for (var i = 0; i < files.length; i++) {
            var file = files[i];
            var fileExtension = file.name.split('.').pop().toLowerCase();

            if (allowedExtensions.indexOf(fileExtension) === -1) {
                flag = false;
                alert("<?= $this->jsTranslate("Invalid file type. Only PDF, DOC, DOCX, XLS, XLSX, JPG, JPEG, and PNG are allowed.") ?>");
                break;
            }
        }

        // Loose shape check so a typo doesn't cost the message on a server round-trip;
        // the server does the real validation.
        var replyEmail = document.getElementById('replyEmail');
        if (flag && replyEmail.value.trim() !== '' && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(replyEmail.value.trim())) {
            alert("<?= $this->jsTranslate("Please enter a valid email address so we can reply to you") ?>");
            replyEmail.focus();
            return false;
        }

        // If all validation passes, submit the form
        if (flag) {
            var formIsValid = deforayValidator.init({
                formId: 'mailChange'
            });

            if (formIsValid) {
                $.blockUI();
                document.getElementById('mailChange').submit();
            }
        }
    }

    $(document).ready(function() {
        $("#file-input").fileinput({
            theme: 'fa',
            showUpload: false,
            maxFileCount: 3, // Limit to 3 files
            allowedFileExtensions: ['pdf', 'doc', 'docx', 'xls', 'xlsx', 'jpg', 'jpeg', 'png'], // Restrict file types
        });
    });
</script>
