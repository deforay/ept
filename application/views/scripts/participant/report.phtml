<script type="text/javascript" src="<?php echo $this->baseUrl('js/select2.min.js'); ?>"></script>

<script>
    var startDate = "";
    var endDate = "";
    var oTable = null;
    // Full DM-scoped option lists so clearing a parent filter restores them
    var defaultLocationOptions = {};
    $(document).ready(function() {
        $("#country").select2({
            placeholder: "<?= $this->jsTranslate("Select Country"); ?>",
            allowClear: true
        });
        $("#region").select2({
            placeholder: "<?= $this->jsTranslate("Select Region"); ?>",
            allowClear: true
        });
        $("#district").select2({
            placeholder: "<?= $this->jsTranslate("Select District"); ?>",
            allowClear: true
        });
        $("#finalResult").select2({
            placeholder: "<?= $this->jsTranslate("Select Result Outcome"); ?>",
            allowClear: true
        });
        ['region', 'district'].forEach(function(id) {
            if ($('#' + id).length) {
                defaultLocationOptions[id] = $('#' + id).html();
            }
        });
        $('#dateRange').daterangepicker({
                locale: {
                    cancelLabel: 'Clear',
                    format: 'DD-MMM-YYYY',
                    separator: ' to ',
                },
                autoApply: true,
                showDropdowns: true,
                alwaysShowCalendars: true,
                autoUpdateInput: true,
                startDate: moment().subtract(179, 'days'),
                endDate: moment(),
                maxDate: moment(),
                ranges: {
                    'This Month': [moment().startOf('month'), moment().endOf('month')],
                    'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')],
                    'Last 60 Days': [moment().subtract(59, 'days'), moment()],
                    'Last 90 Days': [moment().subtract(89, 'days'), moment()],
                    'Last 180 Days': [moment().subtract(179, 'days'), moment()],
                    'Last 12 Months': [moment().subtract(12, 'month'), moment()],
                    'Last 18 Months': [moment().subtract(18, 'month'), moment()],
                }
            },
            function(start, end) {
                startDate = start.format('DD-MMM-YYYY');
                endDate = end.format('DD-MMM-YYYY');
            });
        $('#dateRange').val("");
        oTable = $('#individualReportTable').dataTable({
            //"paging": paging,
            "bJQueryUI": false,
            "bAutoWidth": false,
            "bSortCellsTop": true,
            "bInfo": true,
            "bScrollCollapse": true,
            "sPaginationType": "full_numbers",
            "bRetrieve": false,
            "bDestroy": true,
            "aoColumns": [
                { "sClass": "center", "bSortable": false, "bSearchable": false },
                { "sClass": "center" },
                { "sClass": "center" },
                { "sClass": "center" },
                { "sClass": "center" },
                { "sClass": "center" },
                { "sClass": "center" },
                { "sClass": "center" },
                { "sClass": "center", "bSortable": false }
            ],
            "aaSorting": [
                [3, "desc"],
                [2, "asc"]
            ],
            "bProcessing": true,
            "bServerSide": true,
            "sAjaxSource": "<?php echo $this->url(array('module' => 'default', 'controller' => 'participant', 'action' => 'report', 'format' => 'html')); ?>",
            "fnServerParams": function(aoData) {
                aoData.push({ "name": "scheme", "value": $("#scheme").val() });
                aoData.push({ "name": "startDate", "value": startDate });
                aoData.push({ "name": "endDate", "value": endDate });
                aoData.push({ "name": "country", "value": $("#country").val() || '' });
                aoData.push({ "name": "region", "value": $("#region").val() || '' });
                aoData.push({ "name": "district", "value": $("#district").val() || '' });
                aoData.push({ "name": "finalResult", "value": $("#finalResult").val() || '' });
            },
            "fnServerData": function(sSource, aoData, fnCallback) {
                $.ajax({
                    "dataType": 'json',
                    "type": "POST",
                    "url": sSource,
                    "data": aoData,
                    "success": fnCallback
                });
            },
            "fnRowCallback": function (nRow, aData) {
                // Highlight rows with no mapped data managers (the DM column emits
                // <em class="unmapped-tag">…</em> when the count is 0)
                if ($(nRow).find('.unmapped-tag').length > 0) {
                    $(nRow).addClass('row-unmapped');
                } else {
                    $(nRow).removeClass('row-unmapped');
                }
                return nRow;
            },
            "fnDrawCallback": function () {
                // Runs once per draw, AFTER every row for this page has been inserted
                // into the DOM — unlike fnRowCallback, which fires per-row *before*
                // that row is attached, and so misses binding the last row(s) of
                // each page. Re-bind the "Downloaded"/report-history tooltips here.
                $('#individualReportTable [data-toggle="tooltip"]').tooltip({
                    html: true,
                    container: 'body',
                    placement: 'top',
                    sanitize: false
                });
                restoreReportCheckboxes();
            }
        });
    $("#mappingFilter").change(function () {
        oTable.fnDraw();
    });

    bindColSearch('#individualReportTable', function (value, colIdx) {
        oTable.fnFilter(value, colIdx);
    });

    // Bulk report selection — map_id -> true, kept across paging/redraws
    $('#individualReportTable tbody').on('change', 'input.rpt-select', function () {
        if (this.checked) {
            selectedReports[this.value] = true;
        } else {
            delete selectedReports[this.value];
        }
        syncReportMasterCheckbox();
        updateReportBulkUI();
    });

    $('#rptCheckAll').on('change', function () {
        var on = this.checked;
        $('#individualReportTable tbody input.rpt-select').each(function () {
            this.checked = on;
            if (on) {
                selectedReports[this.value] = true;
            } else {
                delete selectedReports[this.value];
            }
        });
        updateReportBulkUI();
    });

    // Data Managers column — expand/collapse child row with on-demand AJAX fetch
    $('#individualReportTable tbody').on('click', 'a.toggle-dm-row', function (e) {
            e.preventDefault();
            var $btn = $(this);
            var participantId = $btn.data('participant-id');
            var tr = $btn.closest('tr')[0];
            if (oTable.fnIsOpen(tr)) {
                oTable.fnClose(tr);
                $btn.removeClass('btn-success').addClass('btn-primary');
                return;
            }
            // Inject a placeholder child row, then populate via AJAX
            var placeholder = '<div style="padding:12px;color:#888;"><i class="icon-refresh"></i> <?= $this->translate->_("Loading data managers…"); ?></div>';
            oTable.fnOpen(tr, placeholder, 'dm-child-container');
            $btn.removeClass('btn-primary').addClass('btn-success');
            $.post(
                "<?php echo $this->url(array('module' => 'admin', 'controller' => 'participant', 'action' => 'report', 'format' => 'html')); ?>",
                { id: participantId },
                function (html) {
                    // fnOpen wraps our content in a td inside a tr — replace that td's content
                    var $childTr = $(tr).next('tr');
                    $childTr.find('td').first().html(html);
                }
            ).fail(function () {
                var $childTr = $(tr).next('tr');
                $childTr.find('td').first().html('<div style="padding:12px;color:#a94442;"><?= $this->translate->_("Failed to load data managers. Please try again."); ?></div>');
            });
        });

        // Inline filter for the expanded DM list (only present when > 5 mapped DMs)
        $('#individualReportTable tbody').on('input', 'input.dm-filter-input', function () {
            var q = $(this).val().toLowerCase().trim();
            var $rows = $(this).closest('.dm-child-row').find('tr.dm-row');
            if (q === '') {
                $rows.show();
                return;
            }
            $rows.each(function () {
                var blob = $(this).attr('data-dm-search') || '';
                $(this).toggle(blob.indexOf(q) !== -1);
            });
        });

    });

    function individualSchemes() {
        if ($('#dateRange').val() && $("#scheme").val() == "") {
            alert("<?= $this->translate->_("Please pick date range and Scheme Type to proceed"); ?>");
            return false;
        }
        oTable.fnDraw();
    }

    var selectedReports = {};

    function updateReportBulkUI() {
        var n = Object.keys(selectedReports).length;
        $("#rptBulkCount").text(n);
        $("#rptBulkBtn").prop("disabled", n === 0);
        $("#rptBulkToolbar").toggle(n > 0);
    }

    function syncReportMasterCheckbox() {
        var $all = $('#individualReportTable tbody input.rpt-select');
        var checked = $all.filter(':checked').length;
        $('#rptCheckAll')
            .prop('indeterminate', checked > 0 && checked < $all.length)
            .prop('checked', $all.length > 0 && checked === $all.length);
    }

    // Re-tick the rows on the current page from the kept selection (paging/redraw)
    function restoreReportCheckboxes() {
        $('#individualReportTable tbody input.rpt-select').each(function () {
            this.checked = !!selectedReports[this.value];
        });
        syncReportMasterCheckbox();
        updateReportBulkUI();
    }

    function clearReportSelection() {
        selectedReports = {};
        $('#individualReportTable tbody input.rpt-select, #rptCheckAll').prop('checked', false);
        $('#rptCheckAll').prop('indeterminate', false);
        updateReportBulkUI();
    }

    function bulkDownloadReports() {
        var ids = Object.keys(selectedReports);
        if (ids.length === 0) {
            return;
        }
        $.blockUI();
        $.post(
            "<?php echo $this->url(array('module' => 'default', 'controller' => 'participant', 'action' => 'report-bulk-download', 'format' => 'html'), 'default', true); ?>", {
                mapIds: ids,
                format: "html"
            },
            function (data) {
                $.unblockUI();
                data = (data || "").trim();
                if (data !== "") {
                    document.location.href = "/temporary/" + data;
                } else {
                    alert("<?= $this->jsTranslate('No downloadable reports found for the selected rows'); ?>");
                }
            }
        ).fail(function () {
            $.unblockUI();
            alert("<?= $this->jsTranslate('Unable to generate the bulk download. Please try again.'); ?>");
        });
    }

    function getOptions(table, searchfield, returnfield, searchvalue, returnid) {
        var $target = $("#" + returnid);
        if ($target.length === 0) {
            return;
        }
        if (searchvalue === "" || searchvalue === null || searchvalue === undefined) {
            // Parent filter cleared — restore the full DM-scoped list
            $target.html(defaultLocationOptions[returnid] || '<option value=""></option>');
            $target.val('').trigger('change.select2');
            return;
        }
        $.blockUI();
        $.post("<?php echo $this->url(array('module' => 'default', 'controller' => 'common', 'action' => 'get-options-by-value')); ?>", {
                table: table,
                searchfield: searchfield,
                returnfield: returnfield,
                searchvalue: searchvalue,
                format: "html"
            },
            function(data) {
                if (data != 0 && data != '' && data != undefined) {
                    $target.html(data);
                } else {
                    $target.html('<option value=""></option>');
                }
                $target.val('').trigger('change.select2');
                $.unblockUI();
            });
    }

    function updateReportDownloadDateTime(id, type) {
        if (id != "") {
            // $.blockUI();
            $.post("<?php echo $this->url(array('module' => 'default', 'controller' => 'common', 'action' => 'update-report-download-datetime'), 'default', true); ?>", {
                    id: id,
                    type: type,
                    format: "html"
                },
                function(data) {
                    $.unblockUI();
                }
            );
        }
    }
</script>
