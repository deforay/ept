<section class="content-header">
	<h1>
		<?= $this->translate->_("PT Certificates"); ?>
		<small><?= $this->translate->_("Download Certificates"); ?></small>
		<input class="btn btn-danger" type="button" onclick="document.location='/participant/testers'"
			style="float:right;" value="<?= $this->translate->_("Back"); ?>">
	</h1>
</section>
<section class="content">
	<div class="box">
		<div class="box-body">
			<?php
			//$folderPath = "downloads" . DIRECTORY_SEPARATOR . "certificate";
			$folderPath = DOWNLOADS_FOLDER . DIRECTORY_SEPARATOR;
			?>

			<table id="participantCertificateTable" class="table table-striped table-bordered">
				<thead>
					<tr align="CENTER">
						<th scope="col"><?= $this->translate->_("Year"); ?></th>
						<th scope="col"><?= $this->translate->_("Scheme Type"); ?></th>
						<th scope="col"><?= $this->translate->_("Certificate"); ?></th>
					</tr>
				</thead>
				<?php
				// Files an exact batch-name match will take, so the fallback
				// below never hands one row another row's certificate.
				$claimedFiles = [];
				$exactFiles = [];
				foreach ($this->certificate as $val) {
					if (!empty($val['batch_name'])) {
						$exactFiles[] = str_replace('/', '_', $val['unique_identifier']) . "-" . strtoupper($val['scheme_type']) . "-" . $val['batch_name'] . ".pdf";
					}
				}
				foreach ($this->certificate as $val) {
				?>
					<tr>
						<td style="width:20%"><?php echo $val['year']; ?></td>
						<td style="width:20%"><?php echo strtoupper($val['scheme_type']); ?></td>
						<td><?php
							// generate-certificates names files {uid}-{SCHEME}-{batch name}.
							// Batches renamed after generation leave the files under the
							// old name, so fall back to this lab's {uid}-{SCHEME}-*{year}*
							// files that no other row has claimed.
							$certDir = $folderPath . $val['unique_identifier'] . DIRECTORY_SEPARATOR . 'certificates' . DIRECTORY_SEPARATOR;
							$filePrefix = str_replace('/', '_', $val['unique_identifier']) . "-" . strtoupper($val['scheme_type']) . "-";
							$filePath = '';
							if (!empty($val['batch_name']) && is_file($certDir . $filePrefix . $val['batch_name'] . ".pdf")) {
								$filePath = $certDir . $filePrefix . $val['batch_name'] . ".pdf";
							} elseif (is_dir($certDir)) {
								foreach (scandir($certDir) as $candidate) {
									if (
										str_starts_with($candidate, $filePrefix) && str_ends_with(strtolower($candidate), '.pdf')
										&& str_contains(substr($candidate, strlen($filePrefix)), (string) $val['year'])
										&& !in_array($candidate, $claimedFiles, true) && !in_array($candidate, $exactFiles, true)
									) {
										$filePath = $certDir . $candidate;
										break;
									}
								}
							}
							if ($filePath !== '') {
								$claimedFiles[] = $fileName = basename($filePath);
							?>
								<a href="<?php echo $this->baseUrl(Pt_Commons_SignedDownload::url($filePath)); ?>" target="_BLANK"
									download><?php echo $this->escape($fileName); ?></a>
							<?php
							}
							?>
						</td>
					</tr>
				<?php
				}
				?>
			</table>
		</div>
	</div>
</section>
<script type="text/javascript">
	$(document).ready(function() {
		$('#participantCertificateTable').dataTable({

			"bJQueryUI": false,
			"bAutoWidth": false,
			"bInfo": true,
			"bScrollCollapse": true,
			"sPaginationType": "full_numbers",
			"bRetrieve": true,
			"aaSorting": [
				[0, "desc"]
			]

		});
	});
</script>