#: application/languages/db-translation-strings.php:423
msgid ""
"Review all testing procedures prior to performing client testing and contact "
"your supervisor for improvement."
msgstr ""
"Hãy rà soát lại tất cả các quy trình xét nghiệm trước khi tiến hành xét "
"nghiệm cho khách hàng và liên hệ với người quản lý của bạn để đề xuất các "
"biện pháp cải thiện."

