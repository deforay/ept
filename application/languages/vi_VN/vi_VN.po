msgstr ""
"Đảm bảo tên bộ sinh phẩm được ghi lại cho tất cả các xét nghiệm đã thực hiện."

#: application/languages/db-translation-strings.php:93
msgid "Ensure test type lot number is reported for all performed tests."
msgstr ""
"Đảm bảo ghi lại số lô của sinh phẩm xét nghiệm cho tất cả các xét nghiệm đã "
"thực hiện."

#: application/languages/db-translation-strings.php:95
msgid "Ensure test type name is reported for all performed tests."
msgstr ""
"Đảm bảo tên sinh phẩm xét nghiệm được ghi lại cho tất cả các xét nghiệm đã "
"thực hiện."

