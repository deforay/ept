#: application/languages/db-translation-strings.php:83
msgid ""
"Ensure expired test kit are not be used for testing. If test kits are not "
"available, please contact your superior."
msgstr ""
"Đảm bảo không sử dụng sinh phẩm xét nghiệm đã hết hạn để xét nghiệm. Nếu "
"không tìm thấy tên sinh phẩm xét nghiệm, vui lòng liên hệ với nhà cung cấp "
"(NIHE)."

#: application/languages/db-translation-strings.php:85
msgid ""
"Ensure expired test type are not be used for testing. If test types are not "
"available, please contact your superior."
msgstr ""
"Đảm bảo không sử dụng sinh phẩm xét nghiệm đã hết hạn để xét nghiệm. Nếu "
"không tìm thấy tên sinh phẩm xét nghiệm, vui lòng liên hệ với nhà cung cấp "
"(NIHE)."

#: application/languages/db-translation-strings.php:87
msgid "Ensure expiry date information is submitted for all performed tests."
msgstr ""
"Đảm bảo cung cấp thông tin về ngày hết hạn cho tất cả các xét nghiệm đã thực "
"hiện."

#: application/languages/db-translation-strings.php:89
msgid "Ensure test kit lot number is reported for all performed tests."
msgstr ""
"Đảm bảo ghi lại số lô của bộ sinh phẩm cho tất cả các xét nghiệm đã thực "
"hiện."

#: application/languages/db-translation-strings.php:91
