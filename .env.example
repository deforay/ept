# ePT Docker Configuration
# Copy this file to .env and adjust values as needed.

# Host port to expose the application on (default: 80)
APP_PORT=80

# Application URL (include trailing slash)
APP_DOMAIN=http://localhost/

# Database credentials
DB_HOST=ept-db
DB_USER=root
DB_PASSWORD=ept_secret
DB_NAME=ept

# MySQL root password (should match DB_PASSWORD if using root)
MYSQL_ROOT_PASSWORD=ept_secret

# SSL (only needed with --profile ssl)
# Domain name for SSL certificate
#APP_HOSTNAME=ept.example.org

# Optional AI translation prefill for refresh-translations.php
# Set these only if you want empty PO entries to be pre-translated automatically.
# The endpoint must support an OpenAI-compatible chat completions API.
#EPT_AI_API_URL=https://api.deepseek.com/chat/completions
#EPT_AI_API_KEY=your_api_key_here
#EPT_AI_MODEL=deepseek-chat

# --- Local review tooling (not read by the application) ---
# Names the CLI that bin/dev/review invokes. Local only — this is deliberately not
# wired into GitHub Actions. Left empty here so no tool name is committed; set it in
# your own untracked .env, or export it from your shell profile:
#
#   REVIEW_AGENT=<the command>
#   REVIEW_AGENT_ARGS=<subcommand or flags, space separated; empty is fine>
#
# REVIEW_AGENT_ARGS is how one CLI gets its review subcommand and another gets its
# non-interactive flag. Only these two keys are read from .env — something reading a
# diff has no business inheriting DB_PASSWORD or EPT_AI_API_KEY.
REVIEW_AGENT=
REVIEW_AGENT_ARGS=
