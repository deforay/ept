#!/usr/bin/env bash
#
# review — run the adversarial review pass with this repository's standing brief.
#
# Usage:
#   bin/dev/review                 # review the working branch against master
#   bin/dev/review <commit-sha>    # review one commit
#   bin/dev/review --uncommitted   # review the working tree before committing
#
# This is a local developer tool. It is deliberately not wired into CI: a review pass
# that gates a merge needs branch protection to mean anything, and master has none yet.
#
# The reviewing CLI is named by $REVIEW_AGENT rather than hard-coded, so the repository
# carries no vendor name and the reviewer can be swapped without editing anything here.
# ePT ships to the sites that run it, so this file travels further than most.
#
# $REVIEW_AGENT_ARGS carries whatever that CLI needs between its own name and the prompt —
# a subcommand for one, a non-interactive flag for another. It exists because the shape of
# the invocation is as vendor-specific as the name, and baking one shape in would mean the
# script only works with the tool it was written against, which is the thing being avoided.
#
# The brief is EXTRACTED from docs/engineering-standards.md §1 rather than duplicated here.
# Two copies of a review checklist means the one nobody edits is the one that gets used.
# That document describes the bar for changes and says nothing about this script.
set -euo pipefail

cd "$(dirname "$0")/../.."

# Read from the untracked .env, so the reviewer's name lives on the machine rather than in
# the repository. Only these two keys are read: something reading a diff has no business
# inheriting DB_PASSWORD or EPT_AI_API_KEY, which share that file.
read_env() {
    [ -f .env ] || return 0

    # Trailing whitespace is stripped BEFORE the surrounding quotes, so that a value written
    # as `REVIEW_AGENT="my-cli" ` with a stray space still yields my-cli rather than a name
    # with a quote welded onto the end and an unhelpful "command not found".
    awk -F= -v key="$1" '$0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
        sub(/^[^=]*=[[:space:]]*/, ""); sub(/[[:space:]]+$/, "");
        gsub(/^["'\'']|["'\'']$/, ""); print; exit }' .env
}

if [ -z "${REVIEW_AGENT:-}" ]; then
    REVIEW_AGENT="$(read_env REVIEW_AGENT)"
fi

# An empty value in the environment is treated as unset rather than as "no arguments", so
# that an exported blank does not silently override a value set in .env.
if [ -z "${REVIEW_AGENT_ARGS:-}" ]; then
    REVIEW_AGENT_ARGS="$(read_env REVIEW_AGENT_ARGS)"
fi

if [ -z "${REVIEW_AGENT:-}" ]; then
    echo "REVIEW_AGENT is not set — it names the CLI that performs the review." >&2
    echo >&2
    echo "Set it in the untracked .env:" >&2
    echo "    REVIEW_AGENT=<your-review-cli>" >&2
    echo "    REVIEW_AGENT_ARGS=<what that CLI needs before the prompt, if anything>" >&2
    echo >&2
    echo "REVIEW_AGENT_ARGS is how one CLI gets its review subcommand and another gets its" >&2
    echo "non-interactive flag. Leave it empty for a CLI that takes the prompt directly." >&2
    exit 1
fi

BRIEF="$(awk '/^\*\*The review brief/{found=1; next} found && /^> /{sub(/^> /,""); gsub(/^"|"$/,""); print; exit}' \
    docs/engineering-standards.md)"

if [ -z "$BRIEF" ]; then
    echo "Could not extract the review brief from docs/engineering-standards.md §1." >&2
    echo "Has the '**The review brief**' heading changed?" >&2
    exit 1
fi

# The reviewer reads the repository itself, so it gets pointers rather than pasted files.
# Naming where the invariants live is the difference between a review of this system and a
# review of some PHP: without them it cannot know that an admin grid query missing the data
# manager scope, or a non-responder stamped as a failure, is a bug rather than a style
# choice. Several of these invariants live in code rather than prose, so the pointers name
# the code.
CONTEXT="Before reviewing, read these for the rules this codebase is held to:
- docs/engineering-standards.md — the bar, what counts as a finding, and where each
  invariant lives
- docs/ARCHITECTURE.md — module layout and how a request is actually handled in this
  Zend Framework 1 application
- docs/SchemeArchitecture.md — how a scheme's configuration, evaluation algorithm and
  report layout fit together, and why the layout is a template picker rather than an
  instance identity
- application/services/Common.php and application/services/Evaluation.php — the data
  manager scoping helper and the non-responder guard: the two invariants most often
  bypassed by a query written in a hurry
- database/migrations/ — every schema change belongs here and must replay on a fresh
  install; sql/init.sql is a seed and is never edited to make a schema change
- docs/TranslationGuide.md — the translation and escaping helpers, and which is correct
  for which output context

A finding is a defect with a failure scenario: concrete inputs or state, and the wrong
output or lost data that results. A trade-off these documents already record is a
rebuttal, not a fix — say so rather than reporting it.

$BRIEF"

# The scope travels inside the prompt rather than as a --base/--commit flag: those flags
# select a built-in review mode and are mutually exclusive with custom instructions, and
# the instructions are the entire point of this script.
case "${1:-}" in
    --uncommitted) SCOPE="Review the staged, unstaged and untracked changes in the working tree (\`git status\`, \`git diff\`, \`git diff --cached\`)." ;;
    "")            SCOPE="Review the changes on the current branch relative to master: \`git diff master...HEAD\`. Ignore code outside that diff except where you need it to judge the diff." ;;
    *)             SCOPE="Review the changes introduced by commit $1: \`git show $1\`. Ignore code outside that diff except where you need it to judge the diff." ;;
esac

PROMPT="$SCOPE

$CONTEXT"

# Split on whitespace deliberately: REVIEW_AGENT_ARGS is a short list of flat arguments, not
# a shell fragment. The +"${...}" guard is for bash 3.2, which macOS still ships and which
# treats an empty array under `set -u` as an unbound variable.
read -r -a AGENT_ARGS <<< "$REVIEW_AGENT_ARGS"

exec "$REVIEW_AGENT" ${AGENT_ARGS[@]+"${AGENT_ARGS[@]}"} "$PROMPT"
