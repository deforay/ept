#!/usr/bin/env bash
#
# pre-commit: three guards on the staged changes, scoped for speed. Blocks the
# commit (exit 1) on any failure.
#
#   1. Merge-conflict markers — all staged files, any type. Uses git's own
#      detector (`git diff --cached --check`) so a half-resolved conflict can't
#      be committed.
#   2. Debug-leftover guard — scans ONLY newly-added lines of staged PHP for
#      stray debug statements (die / var_dump / dd / dump) so a forgotten
#      `die($x)` can't be committed. Deliberately does NOT flag `exit` (200+
#      legit redirect/CLI uses), commented-out lines, or the legacy
#      `... or die("msg")` fallback idiom.
#   3. PHP-CS-Fixer (dry-run), mirroring CI's `composer cs-check`, so style
#      violations can't reach CI. Respects .php-cs-fixer.dist.php via
#      --path-mode=intersection.
#
# Tracked here; .git/hooks/pre-commit is a symlink to this file (installed via
# `composer install-hooks` / bin/install-hooks.sh). The user's global hooksPath
# dispatcher exec()s the repo-local hook after its own checks.
#
# Bypass once with:  git commit --no-verify
set -uo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$root" || exit 0

# --- guard 1: merge-conflict markers --------------------------------------
# git's own detector, language-agnostic and covering EVERY staged file (not just
# PHP). Runs before the PHP-only early-exit so a conflicted .neon/.phtml/.json/md
# is caught even when no PHP is staged. `--check` also reports whitespace errors;
# grep isolates the conflict-marker lines so those are all we block on here.
conflicts="$(git diff --cached --check 2>/dev/null | grep -i 'conflict marker' || true)"
if [ -n "$conflicts" ]; then
    printf '\n\033[31m✋ commit blocked\033[0m — merge-conflict markers in staged changes:\n' >&2
    printf '%s\n' "$conflicts" | sed 's/^/  /' >&2
    printf '\n  Resolve the conflict, then re-stage — or bypass once: \033[36mgit commit --no-verify\033[0m\n\n' >&2
    exit 1
fi

# Collect staged, still-present PHP files (added/copied/modified). NUL-safe and
# bash 3.2 compatible (macOS ships 3.2, so no mapfile).
files=()
while IFS= read -r -d '' f; do
    files+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.php')

[ "${#files[@]}" -eq 0 ] && exit 0

# --- guard 2: debug leftovers ---------------------------------------------
# Only ADDED lines (git diff -U0, '+' but not the '+++' header) are inspected,
# so existing legit die()/exit stays untouched — you can only trip this on debug
# you're introducing in THIS commit. Matches a bare-ish call to one of the debug
# tokens; the leading [^>_:a-zA-Z] rejects method/member calls (->dump, ::dump)
# and identifiers that merely end in the token (mydump, $died).
debug_re='(^|[^>_:a-zA-Z])(die[[:space:]]*[(;]|var_dump[[:space:]]*\(|dd[[:space:]]*\(|dump[[:space:]]*\()'
debug_hits=""
for f in "${files[@]}"; do
    while IFS= read -r line; do
        content="${line#+}"                                   # strip the leading '+'
        trimmed="${content#"${content%%[![:space:]]*}"}"      # left-trim for comment test
        case "$trimmed" in
            //*|'#'*|'*'*|/\**) continue ;;                   # skip comment lines
        esac
        case "$content" in
            *'or die'*) continue ;;                           # legacy `... or die("msg")` idiom
        esac
        if printf '%s\n' "$content" | grep -qE "$debug_re"; then
            [ -z "$debug_hits" ] && printf '\n\033[31m✋ commit blocked\033[0m — debug leftovers in staged changes:\n' >&2
            printf '  \033[33m%s\033[0m: %s\n' "$f" "$trimmed" >&2
            debug_hits="1"
        fi
    done < <(git diff --cached -U0 --diff-filter=ACM -- "$f" | grep -E '^\+[^+]')
done
if [ -n "$debug_hits" ]; then
    printf '\n  Remove them, or bypass once: \033[36mgit commit --no-verify\033[0m\n\n' >&2
    exit 1
fi

# --- guard 3: PHP-CS-Fixer (auto-fix + re-stage) --------------------------
# Rather than block on style, fix the staged PHP in place and re-stage it, so the
# commit is always clean without a manual `composer cs-fix` round-trip. The one
# case we won't silently touch is a partially-staged file (git add -p): fixing
# rewrites the whole file, and re-staging would sweep the unstaged remainder into
# the commit — so those we fix on disk but block on, for you to review.
fixer="vendor/bin/php-cs-fixer"
if [ ! -x "$fixer" ]; then
    echo "ℹ pre-commit: $fixer not found — skipping CS auto-fix (run 'composer install')." >&2
    exit 0
fi

# Snapshot files that already had UNSTAGED changes before we touch anything —
# those are the partially-staged ones we must not auto-restage. NUL-safe.
partially_staged=$'\n'
while IFS= read -r -d '' f; do
    partially_staged="${partially_staged}${f}"$'\n'
done < <(git diff --name-only -z -- "${files[@]}")

# PHP_CS_FIXER_IGNORE_ENV: don't abort if the local PHP differs from what the
# fixer pins — the rules still apply. --config is explicit because php-cs-fixer
# refuses to auto-discover the config when >1 path is passed. No --dry-run: fix.
PHP_CS_FIXER_IGNORE_ENV=1 "$fixer" fix --config=.php-cs-fixer.dist.php --path-mode=intersection -- "${files[@]}" >/dev/null 2>&1 || true

blocked=0
for f in "${files[@]}"; do
    git diff --quiet -- "$f" && continue          # fixer left this file unchanged
    case "$partially_staged" in
        *$'\n'"$f"$'\n'*)
            # partially staged — can't safely re-stage; surface it for review
            [ "$blocked" -eq 0 ] && printf '\n\033[31m✋ commit blocked\033[0m — CS fixes need review in partially-staged files:\n' >&2
            printf '  \033[33m%s\033[0m — fixed on disk; re-stage it (or run \033[36mcomposer cs-fix\033[0m)\n' "$f" >&2
            blocked=1
            ;;
        *)
            git add -- "$f"                        # fully staged — safe to re-stage the fix
            printf '  \033[36m✓ auto-fixed & re-staged\033[0m %s\n' "$f" >&2
            ;;
    esac
done
[ "$blocked" -ne 0 ] && exit 1
exit 0
