#!/usr/bin/env bash
#
# pre-commit: two guards on staged PHP files, both scoped to the staged changes
# for speed. Blocks the commit (exit 1) on either failure.
#
#   1. Debug-leftover guard — scans ONLY newly-added lines for stray debug
#      statements (die / var_dump / dd / dump) so a forgotten `die($x)` can't be
#      committed. Deliberately does NOT flag `exit` (200+ legit redirect/CLI uses),
#      commented-out lines, or the legacy `... or die("msg")` fallback idiom.
#   2. PHP-CS-Fixer (dry-run), mirroring CI's `composer cs-check`, so style
#      violations can't reach CI. Respects .php-cs-fixer.dist.php via
#      --path-mode=intersection.
#
# Tracked here; .git/hooks/pre-commit is a symlink to this file (installed via
# `composer install-hooks` / bin/install-hooks.sh). The user's global hooksPath
# dispatcher exec()s the repo-local hook after its own checks.
#
# Bypass once with:  git commit --no-verify
set -uo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$root" || exit 0

# Collect staged, still-present PHP files (added/copied/modified). NUL-safe and
# bash 3.2 compatible (macOS ships 3.2, so no mapfile).
files=()
while IFS= read -r -d '' f; do
    files+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.php')

[ "${#files[@]}" -eq 0 ] && exit 0

# --- guard 1: debug leftovers ---------------------------------------------
# Only ADDED lines (git diff -U0, '+' but not the '+++' header) are inspected,
# so existing legit die()/exit stays untouched — you can only trip this on debug
# you're introducing in THIS commit. Matches a bare-ish call to one of the debug
# tokens; the leading [^>_:a-zA-Z] rejects method/member calls (->dump, ::dump)
# and identifiers that merely end in the token (mydump, $died).
debug_re='(^|[^>_:a-zA-Z])(die[[:space:]]*[(;]|var_dump[[:space:]]*\(|dd[[:space:]]*\(|dump[[:space:]]*\()'
debug_hits=""
for f in "${files[@]}"; do
    while IFS= read -r line; do
        content="${line#+}"                                   # strip the leading '+'
        trimmed="${content#"${content%%[![:space:]]*}"}"      # left-trim for comment test
        case "$trimmed" in
            //*|'#'*|'*'*|/\**) continue ;;                   # skip comment lines
        esac
        case "$content" in
            *'or die'*) continue ;;                           # legacy `... or die("msg")` idiom
        esac
        if printf '%s\n' "$content" | grep -qE "$debug_re"; then
            [ -z "$debug_hits" ] && printf '\n\033[31m✋ commit blocked\033[0m — debug leftovers in staged changes:\n' >&2
            printf '  \033[33m%s\033[0m: %s\n' "$f" "$trimmed" >&2
            debug_hits="1"
        fi
    done < <(git diff --cached -U0 --diff-filter=ACM -- "$f" | grep -E '^\+[^+]')
done
if [ -n "$debug_hits" ]; then
    printf '\n  Remove them, or bypass once: \033[36mgit commit --no-verify\033[0m\n\n' >&2
    exit 1
fi

# --- guard 2: PHP-CS-Fixer -------------------------------------------------
fixer="vendor/bin/php-cs-fixer"
if [ ! -x "$fixer" ]; then
    echo "ℹ pre-commit: $fixer not found — skipping CS check (run 'composer install')." >&2
    exit 0
fi

# PHP_CS_FIXER_IGNORE_ENV: don't abort if the local PHP differs from what the
# fixer pins — the rules still apply, which is all we care about pre-commit.
# --config is passed explicitly because php-cs-fixer refuses to auto-discover
# .php-cs-fixer.dist.php when more than one path is given on the command line
# ("For multiple paths config parameter is required"), which fires on any commit
# touching 2+ PHP files.
if ! PHP_CS_FIXER_IGNORE_ENV=1 "$fixer" fix --dry-run --diff --config=.php-cs-fixer.dist.php --path-mode=intersection -- "${files[@]}"; then
    printf '\n\033[31m✋ commit blocked\033[0m — PHP-CS-Fixer found style issues (diff above).\n  Fix:    \033[36mcomposer cs-fix\033[0m   then re-stage and commit\n  Bypass: git commit --no-verify\n\n' >&2
    exit 1
fi
exit 0
